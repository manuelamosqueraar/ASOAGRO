@code {
    [Parameter]
    public string? Seccion { get; set; }

    private string seccionActiva = "supervision";
    private string nombreUsuario = "Administrador";
    private string correoUsuario = "admin@asoagro-faaua.org";
    private string filtroAsociacion = "";

    private List<string> listaAsociaciones = new();
    private List<LogAuditoriaItem> listaLogsAuditoria = new();

    // Métricas
    private int conteoProductores = 0;
    private int conteoAsociadosVinculados = 0;
    private int conteoAsociadosPendientes = 0;
    private int conteoProductoresBpa = 0;

    private int conteoDocumentos = 0;
    private int conteoDocumentosVigentes = 0;
    private int conteoDocumentosPorVencer = 0;
    private int conteoDocumentosVencidos = 0;

    private decimal totalSaldoDisponible = 0m;
    private decimal totalIngresos = 0m;
    private decimal totalCostos = 0m;
    private decimal totalPorCobrar = 0m;

    private int conteoSeguimientos = 0;
    private int conteoProximosEncuentros = 0;
    private int conteoProductoresConSeguimiento = 0;
    private int conteoAlertasDocumento = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            nombreUsuario = user.Identity.Name
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? "Administrador ASOAGRO";
            correoUsuario = user.FindFirst(ClaimTypes.Email)?.Value
                ?? "admin@asoagro-faaua.org";
        }

        listaAsociaciones = DocumentoService.ObtenerAsociaciones().ToList();
        ActualizarMetricas();
        CargarBitacoraAuditoria();
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Seccion))
        {
            var sec = Seccion.Trim().ToLowerInvariant();
            if (sec is "supervision" or "usuarios" or "auditoria" or "catalogos")
            {
                seccionActiva = sec;
            }
        }
    }

    private void CargarBitacoraAuditoria()
    {
        var ahora = DateTime.Now;
        listaLogsAuditoria = new List<LogAuditoriaItem>
        {
            new() { Fecha = ahora.AddMinutes(-5), Usuario = "Administrador Central", Correo = "admin@asoagro-faaua.org", Rol = "Administrador", Modulo = "Supervisión Central", Accion = "Consulta de KPIs consolidados", IpTerminal = "192.168.1.10", Exitoso = true },
            new() { Fecha = ahora.AddMinutes(-25), Usuario = "Carlos Mostrador FAAUA", Correo = "pdv@asoagro-faaua.org", Rol = "AdministradorPdv", Modulo = "Punto de Venta", Accion = "Registro de venta TKT-1003", IpTerminal = "192.168.1.25", Exitoso = true },
            new() { Fecha = ahora.AddMinutes(-45), Usuario = "Tesorería General", Correo = "tesoreria@asoagro-faaua.org", Rol = "Tesorera", Modulo = "Gestión Financiera", Accion = "Conciliación y validación de comprobante", IpTerminal = "192.168.1.14", Exitoso = true },
            new() { Fecha = ahora.AddHours(-1).AddMinutes(-12), Usuario = "Secretaría General", Correo = "secretaria@asoagro-faaua.org", Rol = "Secretaria", Modulo = "Padrón Asociativo", Accion = "Vinculación de productor a asociación", IpTerminal = "192.168.1.12", Exitoso = true },
            new() { Fecha = ahora.AddHours(-2).AddMinutes(-30), Usuario = "Juan Padilla", Correo = "juan.padillamo@amigo.edu.co", Rol = "Presidente", Modulo = "Actas y Estatutos", Accion = "Consulta de acuerdos asamblearios", IpTerminal = "186.28.140.22", Exitoso = true },
            new() { Fecha = ahora.AddHours(-3).AddMinutes(-15), Usuario = "Carlos Mostrador FAAUA", Correo = "pdv@asoagro-faaua.org", Rol = "AdministradorPdv", Modulo = "Recepción de Cosechas", Accion = "Ingreso de lote de plátano verde con remisión", IpTerminal = "192.168.1.25", Exitoso = true },
            new() { Fecha = ahora.AddHours(-5).AddMinutes(-5), Usuario = "Tesorería General", Correo = "tesoreria@asoagro-faaua.org", Rol = "Tesorera", Modulo = "Costos y Gastos", Accion = "Registro de adquisición de insumos con factura proveedor", IpTerminal = "192.168.1.14", Exitoso = true }
        };
    }

    public class LogAuditoriaItem
    {
        public DateTime Fecha { get; set; } = DateTime.Now;
        public string Usuario { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public string Rol { get; set; } = string.Empty;
        public string Modulo { get; set; } = string.Empty;
        public string Accion { get; set; } = string.Empty;
        public string IpTerminal { get; set; } = "127.0.0.1";
        public bool Exitoso { get; set; } = true;
    }

    private void ActualizarMetricas()
    {
        var todosProductores = AsociadoService.ObtenerTodos();
        var queryProductores = todosProductores.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroAsociacion))
        {
            queryProductores = queryProductores.Where(p =>
                string.Equals(p.AsociacionPertenece, filtroAsociacion, StringComparison.OrdinalIgnoreCase));
        }

        var listaProdFiltrada = queryProductores.ToList();
        conteoProductores = listaProdFiltrada.Count;
        conteoAsociadosVinculados = listaProdFiltrada.Count(p => !string.IsNullOrWhiteSpace(p.AsociacionPertenece));
        conteoAsociadosPendientes = listaProdFiltrada.Count(p => string.IsNullOrWhiteSpace(p.AsociacionPertenece));
        conteoProductoresBpa = listaProdFiltrada.Count(p => p.TieneBPA);

        // Documentos institucionales
        var todosDocumentos = DocumentoService.ObtenerTodos();
        var queryDocumentos = todosDocumentos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroAsociacion))
        {
            queryDocumentos = queryDocumentos.Where(d =>
                string.Equals(d.NombreAsociacion, filtroAsociacion, StringComparison.OrdinalIgnoreCase));
        }

        var listaDocsFiltrada = queryDocumentos.ToList();
        conteoDocumentos = listaDocsFiltrada.Count;
        conteoDocumentosVigentes = listaDocsFiltrada.Count(d => d.Aplica && d.EstadoCalculado == "Vigente");
        conteoDocumentosPorVencer = listaDocsFiltrada.Count(d => d.Aplica && d.EstadoCalculado == "Por vencer");
        conteoDocumentosVencidos = listaDocsFiltrada.Count(d => d.Aplica && d.EstadoCalculado == "Vencido");

        // Alertas de documentos
        var alertas = DocumentoService.ObtenerAlertas(DateTime.Today);
        conteoAlertasDocumento = string.IsNullOrWhiteSpace(filtroAsociacion)
            ? alertas.Count
            : alertas.Count(a => string.Equals(a.NombreAsociacion, filtroAsociacion, StringComparison.OrdinalIgnoreCase));

        // Finanzas
        var asocParam = string.IsNullOrWhiteSpace(filtroAsociacion) ? null : filtroAsociacion;
        var resumenFinanciero = FinanzasService.ObtenerResumen(asocParam);
        totalIngresos = resumenFinanciero.TotalIngresos;
        totalCostos = resumenFinanciero.TotalCostosGastos;
        totalSaldoDisponible = resumenFinanciero.SaldoNeto;
        totalPorCobrar = resumenFinanciero.CuentasPorCobrar;

        // Seguimientos
        var todosSeguimientos = SeguimientoService.ObtenerTodos();
        var querySeguimientos = todosSeguimientos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(filtroAsociacion))
        {
            var idsAsoc = listaProdFiltrada.Select(p => p.Id).ToHashSet();
            querySeguimientos = querySeguimientos.Where(s => idsAsoc.Contains(s.AsociadoId));
        }

        var listaSegFiltrada = querySeguimientos.ToList();
        conteoSeguimientos = listaSegFiltrada.Count;
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        conteoProximosEncuentros = listaSegFiltrada.Count(s => s.ProximaGestion.HasValue && s.ProximaGestion.Value >= hoy);
        conteoProductoresConSeguimiento = listaSegFiltrada.Select(s => s.AsociadoId).Distinct().Count();
    }

    private void LimpiarFiltroAsociacion()
    {
        filtroAsociacion = "";
        ActualizarMetricas();
    }
}


