    private void MostrarAlerta(string msg, bool error)
    {
        mensajeGlobal = msg;
        esErrorGlobal = error;
    }

    private static bool CoincideFiltroRol(string? actual, string? filtro)
    {
        if (string.IsNullOrWhiteSpace(filtro)) return true;
        if (string.IsNullOrWhiteSpace(actual)) return false;

        var a = actual.Trim().ToLowerInvariant();
        var f = filtro.Trim().ToLowerInvariant();
        if (a == f) return true;

        return (a is "presidente" or "presidenta" or "directora" or "director" &&
                f is "presidente" or "presidenta" or "directora" or "director")
            || (a is "administrador" or "admin" or "administrador_sistema" &&
                f is "administrador" or "admin" or "administrador_sistema")
            || (a is "tesorero" or "tesorera" && f is "tesorero" or "tesorera")
            || (a is "secretaria" or "secretaría" && f is "secretaria" or "secretaría")
            || (a is "administradorpdv" or "puntoventa" or "vendedor" or "pdv" &&
                f is "administradorpdv" or "puntoventa" or "vendedor" or "pdv");
    }

    private static string NombreRolLegible(string? rol) => (rol ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "administrador" or "admin" or "administrador_sistema" => "Administrador del Sistema",
        "presidenta" or "presidente" or "directora" or "director" => "Presidencia / Dirección",
        "secretaria" or "secretaría" => "Secretaría General",
        "tesorero" or "tesorera" => "Tesorería",
        "administradorpdv" or "puntoventa" or "vendedor" or "pdv" => "Admin. Punto de Venta",
        "" => "Sin rol",
        _ => CultureInfo.CurrentCulture.TextInfo.ToTitleCase(rol!.Trim())
    };

    private static string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AD";
        var p = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (p.Length == 1) return p[0][..Math.Min(2, p[0].Length)].ToUpperInvariant();
        return $"{p[0][0]}{p[1][0]}".ToUpperInvariant();
    }

    private static string FormatearFechaLocal(DateTime utc) =>
        DateTime.SpecifyKind(utc, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss");

    private static string FormatearDuracion(TimeSpan t)
    {
        if (t.TotalDays >= 1) return $"{(int)t.TotalDays} d {t.Hours} h {t.Minutes} m";
        if (t.TotalHours >= 1) return $"{t.Hours} h {t.Minutes} m";
        return $"{t.Minutes} m {t.Seconds} s";
    }

    private sealed class DonutSegmento
    {
        public string Clave { get; set; } = string.Empty;
        public string ClaveFiltro { get; set; } = string.Empty;
        public string Etiqueta { get; set; } = string.Empty;
        public int Valor { get; set; }
        public int Cantidad { get; set; }
        public int Porcentaje { get; set; }
        public string Color { get; set; } = "#10B981";
        public string Detalle { get; set; } = string.Empty;
        public string DashArray { get; set; } = string.Empty;
        public string DashOffset { get; set; } = "0";
    }

    private sealed record ActividadBucket(string Etiqueta, string EtiquetaCorta, int Normales, int Alertas)
    {
        public int Total => Normales + Alertas;
    }

    private sealed record AuditoriaBucket(string Etiqueta, string EtiquetaCorta, int Autorizados, int Denegados, int Errores)
    {
        public int Total => Autorizados + Denegados + Errores;
    }
