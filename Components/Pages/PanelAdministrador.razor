@page "/panel-administrador"
@page "/panel-administrador/{Seccion}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador,Admin")]
@rendermode InteractiveServer
@using System.Globalization
@using System.Security.Claims
@using Asoagro.Models
@using Asoagro.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject AdminSistemaService AdminService
@inject SistemaMonitoreoService MonitoreoService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Administración del Sistema · ASOAGRO</PageTitle>

<div class="container-fluid px-0 pb-5 adm-shell">

    <!-- ENCABEZADO TÉCNICO DEL ADMINISTRADOR DEL SISTEMA -->
    <div class="card aso-hero-card mb-4" style="border-top: 4px solid #10B981 !important;">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="aso-hero-icon-box" style="background: #10B981 !important; border: 1.5px solid #34D399 !important; color: #FFFFFF !important;">
                        <i class="bi bi-cpu-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="aso-hero-kicker" style="background: #065F46 !important; border-color: #34D399 !important; color: #ECFDF5 !important;">
                                <i class="bi bi-shield-lock me-1"></i> Administración Técnica y Seguridad
                            </span>
                            <span class="badge px-2.5 py-1 rounded-pill fw-bold bg-success bg-opacity-75" style="font-size: 0.7rem;">
                                <i class="bi bi-check-circle me-1"></i> @rolLegible
                            </span>
                        </div>
                        <h1 class="aso-hero-title">Centro de Operación Técnica del Sistema</h1>
                        <p class="aso-hero-desc">
                            Supervisión de plataforma, cuentas y mínimo privilegio, bitácora de auditoría inmutable, catálogos maestros e integraciones reales de ASOAGRO.
                        </p>
                    </div>
                </div>

                <!-- IDENTIDAD REAL DEL OPERADOR AUTENTICADO -->
                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-4 d-inline-block text-start w-100" style="min-width: 280px; max-width: 350px; background: rgba(255, 255, 255, 0.09); border: 1.5px solid rgba(255, 255, 255, 0.2); backdrop-filter: blur(10px);">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold position-relative overflow-hidden flex-shrink-0"
                                 style="width: 44px; height: 44px; background: #059669; box-shadow: 0 4px 10px rgba(0,0,0,0.25); font-size: 0.9rem;">
                                @inicialesUsuario
                                @if (!string.IsNullOrWhiteSpace(fotoUsuario))
                                {
                                    <img src="@fotoUsuario" alt="@nombreUsuario" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;" onerror="this.remove();" />
                                }
                            </div>
                            <div class="min-w-0">
                                <span class="d-block text-white-50" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Operador Autenticado</span>
                                <span class="fw-bold text-white small d-block text-truncate" title="@nombreUsuario">@nombreUsuario</span>
                                @if (!string.IsNullOrWhiteSpace(correoUsuario))
                                {
                                    <span class="badge bg-white text-dark mt-1 text-truncate" style="font-size: 0.65rem; font-weight: 700; max-width: 225px;">@correoUsuario</span>
                                }
                            </div>
                        </div>
                        <div class="pt-2 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center" style="font-size: 0.72rem;">
                            <span class="text-white-50">Fuente de datos:</span>
                            <span class="fw-bold text-white">@(AdminService.UsaSupabase ? "Supabase (PostgreSQL)" : "Almacenamiento local")</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- NAVEGACIÓN PRINCIPAL DE LOS 5 MÓDULOS TÉCNICOS -->
    <nav class="adm-tabs-bar mb-4" aria-label="Módulos del Administrador del Sistema">
        <button type="button" class="adm-tab-btn @(seccionActiva == "supervision" ? "is-active" : "")"
                @onclick='() => CambiarSeccion("supervision")'>
            <i class="bi bi-activity"></i>
            <span>1. Supervisión del sistema</span>
            @if (estadoSistema != null && estadoSistema.ErroresRecientes.Count > 0)
            {
                <span class="adm-tab-count bg-danger text-white border-0">@estadoSistema.ErroresRecientes.Count</span>
            }
        </button>
        <button type="button" class="adm-tab-btn @(seccionActiva == "usuarios" ? "is-active" : "")"
                @onclick='() => CambiarSeccion("usuarios")'>
            <i class="bi bi-people-fill"></i>
            <span>2. Usuarios, roles y permisos</span>
            <span class="adm-tab-count">@usuarios.Count</span>
        </button>
        <button type="button" class="adm-tab-btn @(seccionActiva == "auditoria" ? "is-active" : "")"
                @onclick='() => CambiarSeccion("auditoria")'>
            <i class="bi bi-shield-shaded"></i>
            <span>3. Auditoría y seguridad</span>
            <span class="adm-tab-count">@eventosResumenSistema.Count</span>
        </button>
        <button type="button" class="adm-tab-btn @(seccionActiva == "catalogos" ? "is-active" : "")"
                @onclick='() => CambiarSeccion("catalogos")'>
            <i class="bi bi-sliders"></i>
            <span>4. Catálogos y parámetros</span>
        </button>
        <button type="button" class="adm-tab-btn @(seccionActiva == "integraciones" ? "is-active" : "")"
                @onclick='() => CambiarSeccion("integraciones")'>
            <i class="bi bi-hdd-network-fill"></i>
            <span>5. Estado de datos e integraciones</span>
        </button>
    </nav>

    <!-- ALERTA GLOBAL DEL MÓDULO -->
    @if (!string.IsNullOrWhiteSpace(mensajeGlobal))
    {
        <div class="alert @(esErrorGlobal ? "alert-danger" : "alert-success") alert-dismissible fade show rounded-4 shadow-sm mb-4 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @(esErrorGlobal ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
                <span class="small fw-semibold">@mensajeGlobal</span>
            </div>
            <button type="button" class="btn-close" @onclick="() => mensajeGlobal = string.Empty" aria-label="Cerrar"></button>
        </div>
    }

    <!-- =================================================================== -->
    <!-- MÓDULO 1: SUPERVISIÓN DEL SISTEMA                                   -->
    <!-- =================================================================== -->
    @if (seccionActiva == "supervision")
    {
        <div class="adm-section-head mb-3">
            <div>
                <h2 class="adm-section-title">
                    <i class="bi bi-speedometer2 text-success"></i>
                    Estado Técnico de la Plataforma
                </h2>
                <p class="adm-section-sub">
                    Última revisión verificada:
                    <strong>@(estadoSistema != null ? FormatearFechaLocal(estadoSistema.FechaRevisionUtc) : "Pendiente")</strong>
                </p>
            </div>
            <button type="button" class="btn btn-success btn-sm rounded-pill px-3 py-2 fw-bold text-nowrap"
                    style="background-color: #14532D; border-color: #14532D;"
                    disabled="@cargandoEstado"
                    @onclick="() => EjecutarDiagnosticoAsync(true)">
                <i class="bi bi-arrow-clockwise me-1"></i> @(cargandoEstado ? "Verificando..." : "Ejecutar revisión ahora")
            </button>
        </div>

        @if (estadoSistema is not null)
        {
            <!-- TARJETAS DE ESTADO TÉCNICO REAL -->
            <section class="adm-kpi-grid mb-4">
                <article class="adm-kpi-card">
                    <div class="adm-kpi-header">
                        <span class="adm-kpi-icon adm-kpi-icon-green"><i class="bi bi-hdd-rack fs-5"></i></span>
                        <span class="adm-kpi-tag">@estadoSistema.Entorno</span>
                    </div>
                    <div class="adm-kpi-body">
                        <span class="adm-kpi-value" style="font-size: 1.45rem;">Activo</span>
                        <h3 class="adm-kpi-title">Aplicación Web (.NET)</h3>
                        <p class="adm-kpi-desc">@estadoSistema.RuntimeDotNet</p>
                    </div>
                    <ul class="adm-kpi-details">
                        <li><span>Tiempo en línea</span><strong>@FormatearDuracion(estadoSistema.TiempoActivo)</strong></li>
                        <li><span>Inicio (hora local)</span><strong>@FormatearFechaLocal(estadoSistema.InicioAplicacionUtc)</strong></li>
                    </ul>
                </article>

                <article class="adm-kpi-card">
                    <div class="adm-kpi-header">
                        <span class="adm-kpi-icon @(estadoSistema.SupabaseConectado ? "adm-kpi-icon-emerald" : "adm-kpi-icon-amber")">
                            <i class="bi bi-database-check fs-5"></i>
                        </span>
                        <span class="adm-kpi-tag">Supabase</span>
                    </div>
                    <div class="adm-kpi-body">
                        <span class="adm-kpi-value" style="font-size: 1.45rem;">
                            @(!estadoSistema.SupabaseConfigurado ? "No configurada" : (estadoSistema.SupabaseConectado ? "Conectada" : "Error"))
                        </span>
                        <h3 class="adm-kpi-title">Base de Datos PostgreSQL</h3>
                        <p class="adm-kpi-desc">@estadoSistema.SupabaseMensaje</p>
                    </div>
                    <ul class="adm-kpi-details">
                        <li><span>Latencia</span><strong>@(estadoSistema.SupabaseLatenciaMs.HasValue ? $"{estadoSistema.SupabaseLatenciaMs} ms" : "N/A")</strong></li>
                        <li><span>Último intento</span><strong>@(estadoSistema.UltimoIntentoSupabaseUtc.HasValue ? FormatearFechaLocal(estadoSistema.UltimoIntentoSupabaseUtc.Value) : "Sin intentos")</strong></li>
                    </ul>
                </article>

                <article class="adm-kpi-card">
                    <div class="adm-kpi-header">
                        <span class="adm-kpi-icon @(estadoSistema.AlmacenamientoLocalDisponible ? "adm-kpi-icon-blue" : "adm-kpi-icon-amber")">
                            <i class="bi bi-folder-check fs-5"></i>
                        </span>
                        <span class="adm-kpi-tag">Almacenamiento</span>
                    </div>
                    <div class="adm-kpi-body">
                        <span class="adm-kpi-value" style="font-size: 1.45rem;">
                            @(estadoSistema.AlmacenamientoLocalDisponible ? "Operativo" : "Con alerta")
                        </span>
                        <h3 class="adm-kpi-title">Repositorio Local (Data/)</h3>
                        <p class="adm-kpi-desc">@estadoSistema.AlmacenamientoLocalDetalle</p>
                    </div>
                    <ul class="adm-kpi-details">
                        <li><span>Google OAuth</span><strong>@(estadoSistema.GoogleOAuthConfigurado ? "Configurado" : "Pendiente")</strong></li>
                        <li><span>Correo SMTP</span><strong>@(estadoSistema.SmtpConfigurado ? "Configurado" : "No configurado")</strong></li>
                    </ul>
                </article>

                <article class="adm-kpi-card">
                    <div class="adm-kpi-header">
                        <span class="adm-kpi-icon @(estadoSistema.ErroresRecientes.Count == 0 ? "adm-kpi-icon-green" : "adm-kpi-icon-amber")">
                            <i class="bi bi-exclamation-octagon fs-5"></i>
                        </span>
                        <span class="adm-kpi-tag">Diagnóstico</span>
                    </div>
                    <div class="adm-kpi-body">
                        <span class="adm-kpi-value">@estadoSistema.ErroresRecientes.Count</span>
                        <h3 class="adm-kpi-title">Errores Técnicos Recientes</h3>
                        <p class="adm-kpi-desc">Eventos capturados desde el último arranque y actividad general de usuarios.</p>
                    </div>
                    <ul class="adm-kpi-details">
                        <li><span>Cuentas activas</span><strong>@usuarios.Count(u => u.Activo) de @usuarios.Count</strong></li>
                        <li><span>Eventos auditados</span><strong>@eventosResumenSistema.Count registro(s)</strong></li>
                    </ul>
                </article>
            </section>

            <!-- VISUALIZACIONES DE SUPERVISIÓN (DISPONIBILIDAD + ACTIVIDAD REAL) -->
            var serviciosOperativos = estadoSistema.Integraciones.Count(i => i.Operativo);
            var totalServicios = Math.Max(1, estadoSistema.Integraciones.Count);
            var pctDisponibilidad = (int)Math.Round(serviciosOperativos * 100.0 / totalServicios);
            var bucketsSupervision = ObtenerBucketsActividad(eventosResumenSistema, estadoSistema.ErroresRecientes, periodoSupervision);

            <section class="adm-viz-grid">
                <!-- GRÁFICO 1A: DISPONIBILIDAD DE COMPONENTES -->
                <article class="adm-viz-card adm-viz-col-5">
                    <div class="adm-viz-header">
                        <div>
                            <h3 class="adm-viz-title">Disponibilidad de Componentes</h3>
                            <p class="adm-viz-desc">Servicios verificados en la revisión actual (@estadoSistema.Integraciones.Count componentes).</p>
                        </div>
                        <span class="adm-chip-meta">@serviciosOperativos / @estadoSistema.Integraciones.Count operativos</span>
                    </div>

                    <div class="adm-donut-layout">
                        <div class="adm-donut-wrap">
                            <svg viewBox="0 0 160 160" width="158" height="158" aria-label="Disponibilidad de servicios">
                                <circle cx="80" cy="80" r="56" fill="none" stroke="#E9F0EC" stroke-width="18" />
                                @foreach (var seg in CalcularSegmentosDisponibilidad(estadoSistema.Integraciones))
                                {
                                    <circle cx="80" cy="80" r="56" fill="none"
                                            stroke="@seg.Color"
                                            stroke-width="@(hoveredServicioSlice == seg.Clave ? "22" : "18")"
                                            stroke-dasharray="@seg.DashArray"
                                            stroke-dashoffset="@seg.DashOffset"
                                            transform="rotate(-90 80 80)"
                                            style="cursor: pointer; transition: stroke-width 0.15s ease;"
                                            @onmouseenter="() => hoveredServicioSlice = seg.Clave"
                                            @onmouseleave="() => hoveredServicioSlice = null">
                                        <title>@seg.Etiqueta: @seg.Valor servicio(s) (@seg.Porcentaje%)</title>
                                    </circle>
                                }
                            </svg>
                            <div class="adm-donut-center">
                                <span class="adm-donut-total">@pctDisponibilidad%</span>
                                <span class="adm-donut-caption">Operativos</span>
                            </div>
                        </div>

                        <div class="adm-legend-list">
                            @foreach (var seg in CalcularSegmentosDisponibilidad(estadoSistema.Integraciones))
                            {
                                <button type="button"
                                        class="adm-legend-item @(hoveredServicioSlice == seg.Clave ? "is-selected" : "")"
                                        @onmouseenter="() => hoveredServicioSlice = seg.Clave"
                                        @onmouseleave="() => hoveredServicioSlice = null">
                                    <span class="adm-legend-left">
                                        <span class="adm-swatch" style="background: @seg.Color;"></span>
                                        <span class="adm-legend-label">@seg.Etiqueta</span>
                                    </span>
                                    <span class="adm-legend-val">@seg.Valor (@seg.Porcentaje%)</span>
                                </button>
                            }
                            <div class="small text-muted pt-1">
                                <i class="bi bi-clock-history me-1"></i> Copias automáticas: <strong>No disponibles</strong>
                            </div>
                        </div>
                    </div>

                    <div class="adm-tooltip-box @(hoveredServicioSlice == null ? "adm-tooltip-muted" : "")">
                        @if (hoveredServicioSlice != null)
                        {
                            var activoSeg = CalcularSegmentosDisponibilidad(estadoSistema.Integraciones).FirstOrDefault(s => s.Clave == hoveredServicioSlice);
                            if (activoSeg != null)
                            {
                                <span><strong>@activoSeg.Etiqueta:</strong> @activoSeg.Valor componente(s) (@activoSeg.Porcentaje%)</span>
                                <span>@activoSeg.Detalle</span>
                            }
                        }
                        else
                        {
                            <span>Pasa el cursor sobre el anillo o leyenda para inspeccionar el desglose real.</span>
                        }
                    </div>
                </article>

                <!-- GRÁFICO 1B: ACTIVIDAD RECIENTE Y ERRORES POR PERIODO -->
                <article class="adm-viz-card adm-viz-col-7">
                    <div class="adm-viz-header">
                        <div>
                            <h3 class="adm-viz-title">Actividad Reciente y Alertas</h3>
                            <p class="adm-viz-desc">Eventos de auditoría y errores técnicos reales por ventana de tiempo.</p>
                        </div>
                        <div class="adm-period-group" role="group" aria-label="Periodo de actividad">
                            <button type="button" class="adm-period-btn @(periodoSupervision == "24h" ? "is-active" : "")" @onclick='() => { periodoSupervision = "24h"; hoveredBucketSupervision = null; }'>24 h</button>
                            <button type="button" class="adm-period-btn @(periodoSupervision == "7d" ? "is-active" : "")" @onclick='() => { periodoSupervision = "7d"; hoveredBucketSupervision = null; }'>7 días</button>
                            <button type="button" class="adm-period-btn @(periodoSupervision == "30d" ? "is-active" : "")" @onclick='() => { periodoSupervision = "30d"; hoveredBucketSupervision = null; }'>30 días</button>
                        </div>
                    </div>

                    @if (bucketsSupervision.All(b => b.Total == 0))
                    {
                        <div class="adm-empty-state my-auto">
                            <i class="bi bi-bar-chart"></i>
                            <strong class="d-block small text-dark">Sin actividad o errores registrados en esta ventana (@EtiquetaPeriodo(periodoSupervision))</strong>
                            <span class="small">Los indicadores se actualizarán automáticamente con inicios de sesión, acciones administrativas o alertas reales.</span>
                        </div>
                    }
                    else
                    {
                        var maxVal = Math.Max(1, bucketsSupervision.Max(b => b.Total));
                        <!-- Vista Desktop SVG -->
                        <div class="adm-chart-stage d-none d-md-flex">
                            <svg class="adm-bar-chart-svg" viewBox="0 0 600 170" preserveAspectRatio="none" aria-label="Actividad reciente por periodo">
                                <line x1="0" y1="160" x2="600" y2="160" stroke="#CBD5E1" stroke-width="1" />
                                <line x1="0" y1="85" x2="600" y2="85" stroke="#EEF3F0" stroke-dasharray="4 4" stroke-width="1" />
                                <line x1="0" y1="15" x2="600" y2="15" stroke="#EEF3F0" stroke-dasharray="4 4" stroke-width="1" />
                                @for (int idx = 0; idx < bucketsSupervision.Count; idx++)
                                {
                                    var b = bucketsSupervision[idx];
                                    var stepW = 600.0 / bucketsSupervision.Count;
                                    var barW = Math.Max(12, Math.Min(42, stepW * 0.62));
                                    var xPos = idx * stepW + (stepW - barW) / 2.0;
                                    var totalH = b.Total == 0 ? 0 : Math.Max(6, (b.Total / (double)maxVal) * 140.0);
                                    var alertH = b.Alertas == 0 ? 0 : Math.Max(4, (b.Alertas / (double)b.Total) * totalH);
                                    var normH = Math.Max(0, totalH - alertH);
                                    var yNorm = 160.0 - normH;
                                    var yAlert = 160.0 - totalH;
                                    var activeOpacity = hoveredBucketSupervision == null || hoveredBucketSupervision == b ? "1" : "0.45";

                                    <g style="cursor: pointer; opacity: @activeOpacity;"
                                       @onmouseenter="() => hoveredBucketSupervision = b"
                                       @onmouseleave="() => hoveredBucketSupervision = null">
                                        <rect x="@xPos.ToString("0.##", CultureInfo.InvariantCulture)" y="10" width="@barW.ToString("0.##", CultureInfo.InvariantCulture)" height="150" fill="transparent" />
                                        @if (normH > 0)
                                        {
                                            <rect x="@xPos.ToString("0.##", CultureInfo.InvariantCulture)"
                                                  y="@yNorm.ToString("0.##", CultureInfo.InvariantCulture)"
                                                  width="@barW.ToString("0.##", CultureInfo.InvariantCulture)"
                                                  height="@normH.ToString("0.##", CultureInfo.InvariantCulture)"
                                                  rx="4" fill="#10B981" />
                                        }
                                        @if (alertH > 0)
                                        {
                                            <rect x="@xPos.ToString("0.##", CultureInfo.InvariantCulture)"
                                                  y="@yAlert.ToString("0.##", CultureInfo.InvariantCulture)"
                                                  width="@barW.ToString("0.##", CultureInfo.InvariantCulture)"
                                                  height="@alertH.ToString("0.##", CultureInfo.InvariantCulture)"
                                                  rx="4" fill="#DC2626" />
                                        }
                                        <title>@b.Etiqueta: @b.Normales normales, @b.Alertas alertas/errores</title>
                                    </g>
                                }
                            </svg>
                            <div class="adm-axis-labels" style="grid-template-columns: repeat(@bucketsSupervision.Count, minmax(0, 1fr));">
                                @foreach (var b in bucketsSupervision)
                                {
                                    <span class="text-truncate" title="@b.Etiqueta">@b.EtiquetaCorta</span>
                                }
                            </div>
                        </div>

                        <!-- Vista Móvil Alternativa -->
                        <div class="adm-hbar-list d-md-none">
                            @foreach (var b in bucketsSupervision.Where(x => x.Total > 0))
                            {
                                var wNorm = (b.Normales * 100.0 / maxVal).ToString("0.##", CultureInfo.InvariantCulture);
                                var wAlt = (b.Alertas * 100.0 / maxVal).ToString("0.##", CultureInfo.InvariantCulture);
                                <div class="adm-hbar-row">
                                    <div class="adm-hbar-top">
                                        <strong class="text-dark">@b.Etiqueta</strong>
                                        <span class="text-muted">@b.Total evento(s) (@b.Alertas alerta/s)</span>
                                    </div>
                                    <div class="adm-hbar-track">
                                        <div class="adm-hbar-fill" style="width: @(wNorm)%; background: #10B981;"></div>
                                        <div class="adm-hbar-fill" style="width: @(wAlt)%; background: #DC2626;"></div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-3 align-items-center mt-2 small text-muted">
                            <span><span class="adm-swatch d-inline-block me-1" style="background: #10B981;"></span> Actividad normal (@bucketsSupervision.Sum(x => x.Normales))</span>
                            <span><span class="adm-swatch d-inline-block me-1" style="background: #DC2626;"></span> Denegados y errores técnicos (@bucketsSupervision.Sum(x => x.Alertas))</span>
                        </div>

                        <div class="adm-tooltip-box @(hoveredBucketSupervision == null ? "adm-tooltip-muted" : "")">
                            @if (hoveredBucketSupervision != null)
                            {
                                <span><strong>@hoveredBucketSupervision.Etiqueta:</strong> @hoveredBucketSupervision.Total evento(s) reales</span>
                                <span>Normales: <strong>@hoveredBucketSupervision.Normales</strong> · Alertas/Errores: <strong>@hoveredBucketSupervision.Alertas</strong></span>
                            }
                            else
                            {
                                <span>Pasa el cursor por cada barra para consultar la actividad y errores exactos del tramo.</span>
                            }
                        </div>
                    }
                </article>
            </section>

            <!-- INTEGRACIONES Y ERRORES RECIENTES -->
            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <div class="adm-surface h-100">
                        <div class="adm-section-head">
                            <div>
                                <h3 class="adm-section-title fs-6">
                                    <i class="bi bi-plug-fill text-success"></i> Resumen de Integraciones y Servicios
                                </h3>
                                <p class="adm-section-sub">Estado técnico sin exposición de secretos.</p>
                            </div>
                        </div>
                        <div class="table-responsive aso-table-wrap mb-0">
                            <table class="table table-sm align-middle mb-0" style="font-size: 0.82rem;">
                                <thead class="aso-thead-unified">
                                    <tr>
                                        <th style="width: 34%;">Componente</th>
                                        <th style="width: 22%;">Estado real</th>
                                        <th>Detalle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in estadoSistema.Integraciones)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-dark">@item.Nombre</td>
                                            <td>
                                                <span class="badge rounded-pill @(item.Operativo ? "bg-success" : "bg-warning text-dark")">
                                                    @item.Estado
                                                </span>
                                            </td>
                                            <td class="text-muted small">@item.Detalle</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="adm-surface h-100">
                        <div class="adm-section-head">
                            <div>
                                <h3 class="adm-section-title fs-6">
                                    <i class="bi bi-bug-fill text-danger"></i> Errores Técnicos Recientes
                                </h3>
                                <p class="adm-section-sub">Registro en memoria del host actual.</p>
                            </div>
                            <span class="adm-result-pill">@estadoSistema.ErroresRecientes.Count registro(s)</span>
                        </div>

                        @if (estadoSistema.ErroresRecientes.Count == 0)
                        {
                            <div class="adm-empty-state">
                                <i class="bi bi-check-circle-fill"></i>
                                <strong class="text-dark d-block small">Sin errores técnicos registrados</strong>
                                <span class="small">No se han capturado excepciones ni errores críticos durante esta ejecución.</span>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive aso-table-wrap mb-0" style="max-height: 290px;">
                                <table class="table table-sm align-middle mb-0" style="font-size: 0.78rem;">
                                    <thead class="aso-thead-unified">
                                        <tr>
                                            <th style="width: 140px;">Fecha</th>
                                            <th style="width: 120px;">Origen</th>
                                            <th>Mensaje técnico (sin secretos)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var err in estadoSistema.ErroresRecientes.Take(20))
                                        {
                                            <tr>
                                                <td class="font-monospace text-muted text-nowrap">@FormatearFechaLocal(err.FechaUtc)</td>
                                                <td><span class="badge bg-danger-subtle text-danger">@err.Categoria</span></td>
                                                <td class="text-dark">@err.Mensaje</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- NOTA DE SEPARACIÓN DE FUNCIONES -->
            <div class="adm-notice-box">
                <div class="adm-notice-icon">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
                <div class="adm-notice-text">
                    <strong>Separación de Funciones y Principio de Mínimo Privilegio</strong>
                    <p>
                        El Administrador del sistema gestiona la operación técnica, cuentas, matriz de permisos, catálogos maestros y auditoría de seguridad. Las operaciones de negocio pertenecen exclusivamente a Secretaría, Tesorería, Presidencia y Administrador del Punto de Venta según sus roles asignados.
                    </p>
                </div>
            </div>
        }
    }

    <!-- =================================================================== -->
    <!-- MÓDULO 2: USUARIOS, ROLES Y PERMISOS                                -->
    <!-- =================================================================== -->
    @if (seccionActiva == "usuarios")
    {
        var gruposRol = ObtenerDistribucionRoles();
        var totalUsuariosActivos = usuarios.Count(u => u.Activo);
        var totalUsuariosInactivos = usuarios.Count - totalUsuariosActivos;
        var totalConAcceso = usuarios.Count(u => u.UltimoAccesoUtc.HasValue);
        var totalRecuperacion = usuarios.Count(u => u.RecuperacionPendiente);

        <!-- VISUALIZACIONES INTERACTIVAS DE USUARIOS Y PERMISOS -->
        <section class="adm-viz-grid">
            <article class="adm-viz-card adm-viz-col-6">
                <div class="adm-viz-header">
                    <div>
                        <h3 class="adm-viz-title">Distribución de Cuentas por Rol</h3>
                        <p class="adm-viz-desc">Haz clic en un rol para filtrar automáticamente el directorio inferior.</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(filtroRolUsuario))
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill py-0.5 px-2.5" style="font-size: 0.72rem;" @onclick="() => filtroRolUsuario = string.Empty">
                            Quitar filtro
                        </button>
                    }
                </div>

                @if (usuarios.Count == 0)
                {
                    <div class="adm-empty-state my-auto">
                        <i class="bi bi-people"></i>
                        <strong class="d-block small text-dark">Sin cuentas registradas</strong>
                    </div>
                }
                else
                {
                    <div class="adm-donut-layout">
                        <div class="adm-donut-wrap">
                            <svg viewBox="0 0 160 160" width="158" height="158" aria-label="Distribución de usuarios por rol">
                                <circle cx="80" cy="80" r="56" fill="none" stroke="#E9F0EC" stroke-width="18" />
                                @foreach (var g in gruposRol)
                                {
                                    var seleccionado = CoincideFiltroRol(g.ClaveFiltro, filtroRolUsuario);
                                    <circle cx="80" cy="80" r="56" fill="none"
                                            stroke="@g.Color"
                                            stroke-width="@(hoveredRolSlice == g.ClaveFiltro || seleccionado ? "22" : "18")"
                                            stroke-dasharray="@g.DashArray"
                                            stroke-dashoffset="@g.DashOffset"
                                            transform="rotate(-90 80 80)"
                                            style="cursor: pointer; transition: stroke-width 0.15s ease;"
                                            @onclick="() => AlternarFiltroRolDesdeGrafico(g.ClaveFiltro)"
                                            @onmouseenter="() => hoveredRolSlice = g.ClaveFiltro"
                                            @onmouseleave="() => hoveredRolSlice = null">
                                        <title>@g.Etiqueta: @g.Cantidad usuario(s) (@g.Porcentaje%)</title>
                                    </circle>
                                }
                            </svg>
                            <div class="adm-donut-center">
                                <span class="adm-donut-total">@usuarios.Count</span>
                                <span class="adm-donut-caption">Cuentas</span>
                            </div>
                        </div>

                        <div class="adm-legend-list">
                            @foreach (var g in gruposRol)
                            {
                                var activo = CoincideFiltroRol(g.ClaveFiltro, filtroRolUsuario);
                                <button type="button"
                                        class="adm-legend-item @(activo || hoveredRolSlice == g.ClaveFiltro ? "is-selected" : "")"
                                        @onclick="() => AlternarFiltroRolDesdeGrafico(g.ClaveFiltro)"
                                        @onmouseenter="() => hoveredRolSlice = g.ClaveFiltro"
                                        @onmouseleave="() => hoveredRolSlice = null">
                                    <span class="adm-legend-left">
                                        <span class="adm-swatch" style="background: @g.Color;"></span>
                                        <span class="adm-legend-label">@g.Etiqueta</span>
                                    </span>
                                    <span class="adm-legend-val">@g.Cantidad (@g.Porcentaje%)</span>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="adm-tooltip-box @(hoveredRolSlice == null ? "adm-tooltip-muted" : "")">
                        @if (hoveredRolSlice != null)
                        {
                            var sel = gruposRol.FirstOrDefault(x => x.ClaveFiltro == hoveredRolSlice);
                            if (sel != null)
                            {
                                <span><strong>@sel.Etiqueta:</strong> @sel.Cantidad cuenta(s) (@sel.Porcentaje% del total)</span>
                                <span>Clic para filtrar tabla</span>
                            }
                        }
                        else
                        {
                            <span>Pasa el cursor sobre un segmento o haz clic en un rol para filtrar las cuentas.</span>
                        }
                    </div>
                }
            </article>

            <article class="adm-viz-card adm-viz-col-6">
                <div class="adm-viz-header">
                    <div>
                        <h3 class="adm-viz-title">Estado de Acceso y Cobertura por Mínimo Privilegio</h3>
                        <p class="adm-viz-desc">Indicadores reales de habilitación, actividad de ingreso y sesiones.</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(filtroEstadoUsuario))
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill py-0.5 px-2.5" style="font-size: 0.72rem;" @onclick="() => filtroEstadoUsuario = string.Empty">
                            Mostrar todos
                        </button>
                    }
                </div>

                <div class="adm-mini-stats">
                    <button type="button" class="adm-mini-stat text-start border @(filtroEstadoUsuario == "Activo" ? "border-success bg-success-subtle" : "")"
                            @onclick='() => filtroEstadoUsuario = filtroEstadoUsuario == "Activo" ? "" : "Activo"'>
                        <span class="adm-mini-stat-label">Cuentas Activas</span>
                        <span class="adm-mini-stat-val text-success">@totalUsuariosActivos</span>
                        <span class="adm-mini-stat-hint">Clic para filtrar</span>
                    </button>
                    <button type="button" class="adm-mini-stat text-start border @(filtroEstadoUsuario == "Inactivo" ? "border-secondary bg-secondary-subtle" : "")"
                            @onclick='() => filtroEstadoUsuario = filtroEstadoUsuario == "Inactivo" ? "" : "Inactivo"'>
                        <span class="adm-mini-stat-label">Desactivadas</span>
                        <span class="adm-mini-stat-val text-secondary">@totalUsuariosInactivos</span>
                        <span class="adm-mini-stat-hint">Acceso bloqueado</span>
                    </button>
                    <div class="adm-mini-stat">
                        <span class="adm-mini-stat-label">Con Acceso Reciente</span>
                        <span class="adm-mini-stat-val">@totalConAcceso</span>
                        <span class="adm-mini-stat-hint">Ingreso verificado</span>
                    </div>
                    <div class="adm-mini-stat">
                        <span class="adm-mini-stat-label">Recuperación Vigente</span>
                        <span class="adm-mini-stat-val text-primary">@totalRecuperacion</span>
                        <span class="adm-mini-stat-hint">Ventana de 30 min</span>
                    </div>
                </div>

                @{
                    var rolesEnMatriz = matrizPermisos.GroupBy(m => m.Rol).OrderBy(g => g.Key).ToList();
                    var maxModulos = Math.Max(1, rolesEnMatriz.Select(g => g.Count()).DefaultIfEmpty(1).Max());
                }
                <div class="adm-hbar-list mt-1">
                    <div class="small fw-bold text-dark">Módulos habilitados (Ver) según matriz de mínimo privilegio</div>
                    @foreach (var rm in rolesEnMatriz)
                    {
                        var conVer = rm.Count(x => x.PuedeVer);
                        var pct = (int)Math.Round(conVer * 100.0 / Math.Max(1, rm.Count()));
                        <div class="adm-hbar-row">
                            <div class="adm-hbar-top">
                                <span class="fw-semibold text-dark">@NombreRolLegible(rm.Key)</span>
                                <span class="text-muted">@conVer de @rm.Count() módulos (@pct%)</span>
                            </div>
                            <div class="adm-hbar-track">
                                <div class="adm-hbar-fill" style="width: @(pct)%; background: #14532D;"></div>
                            </div>
                        </div>
                    }
                </div>
            </article>
        </section>

        <!-- TABLA DETALLADA DE CUENTAS -->
        <section class="adm-surface mb-4">
            <div class="adm-section-head">
                <div>
                    <h2 class="adm-section-title">
                        <i class="bi bi-people-fill text-success"></i> Cuentas de Usuario y Asignaciones
                    </h2>
                    <p class="adm-section-sub">
                        Administra las cuentas autorizadas, asociación asignada, estado de acceso, revocación de sesiones y recuperación segura (sin contraseñas visibles).
                    </p>
                </div>
                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 py-2 fw-bold text-nowrap"
                        style="background-color: #14532D; border-color: #14532D;"
                        @onclick="AbrirModalNuevoUsuario">
                    <i class="bi bi-person-plus-fill me-1"></i> Nueva cuenta
                </button>
            </div>

            <!-- FILTROS LIMPIOS SIN RECORTES -->
            <div class="adm-filter-toolbar">
                <div>
                    <input type="text" class="form-control" placeholder="Buscar por nombre, correo o documento..."
                           aria-label="Buscar usuario por nombre, correo o documento"
                           @bind="filtroTextoUsuario" @bind:event="oninput" />
                </div>
                <div>
                    <select class="form-select" aria-label="Filtrar por rol" @bind="filtroRolUsuario">
                        <option value="">Todos los roles</option>
                        @foreach (var r in RolesFiltroDisponibles)
                        {
                            <option value="@r">@NombreRolLegible(r)</option>
                        }
                    </select>
                </div>
                <div>
                    <select class="form-select" aria-label="Filtrar por estado" @bind="filtroEstadoUsuario">
                        <option value="">Todos los estados</option>
                        <option value="Activo">Activos</option>
                        <option value="Inactivo">Desactivados</option>
                    </select>
                </div>
                <div class="d-flex justify-content-end">
                    <span class="adm-result-pill">
                        <i class="bi bi-funnel"></i> @UsuariosFiltrados.Count resultado(s)
                    </span>
                </div>
            </div>

            <!-- TABLA ALINEADA CON ACCIONES UNIFORMES -->
            <div class="table-responsive aso-table-wrap mb-0">
                <table id="adm-users-table" class="table table-hover align-middle mb-0 adm-table">
                    <thead class="aso-thead-unified">
                        <tr>
                            <th style="width: 27%;">Usuario / Documento</th>
                            <th style="width: 17%;">Rol</th>
                            <th style="width: 16%;">Asociación</th>
                            <th style="width: 12%;">Último acceso</th>
                            <th class="text-center" style="width: 8%;">Estado</th>
                            <th class="text-end" style="width: 20%;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (UsuariosFiltrados.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-search d-block fs-4 mb-2 opacity-75"></i>
                                    No se encontraron cuentas con los criterios seleccionados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var u in UsuariosFiltrados)
                            {
                                <tr>
                                    <td>
                                        <div class="adm-user-cell">
                                            <span class="adm-user-mini-avatar">@ObtenerIniciales(u.NombreCompleto)</span>
                                            <div class="min-w-0">
                                                <strong class="text-dark d-block" style="line-height: 1.25;">@u.NombreCompleto</strong>
                                                <small class="text-muted d-block" style="font-size: 0.72rem; overflow-wrap: anywhere;">@u.Correo</small>
                                                <small class="text-muted font-monospace" style="font-size: 0.7rem;">Doc: @u.DocumentoId</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="adm-role-badge">@NombreRolLegible(u.Rol)</span>
                                    </td>
                                    <td>
                                        <span class="small text-dark fw-medium d-block" style="line-height: 1.3;">@u.AsociacionNombre</span>
                                    </td>
                                    <td>
                                        <span class="small text-muted d-block" style="font-size: 0.75rem; line-height: 1.25;">
                                            @(u.UltimoAccesoUtc.HasValue ? FormatearFechaLocal(u.UltimoAccesoUtc.Value) : "Sin registro")
                                        </span>
                                        @if (u.SesionRevocadaEnUtc.HasValue)
                                        {
                                            <small class="text-warning-emphasis d-block" style="font-size: 0.7rem;">
                                                Sesión revocada: @FormatearFechaLocal(u.SesionRevocadaEnUtc.Value)
                                            </small>
                                        }
                                        @if (u.RecuperacionPendiente)
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle mt-1" style="font-size: 0.68rem;">
                                                Recuperación vigente
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(u.Activo ? "bg-success" : "bg-secondary") rounded-pill px-3 py-1.5">
                                            @(u.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <div class="adm-actions-grid">
                                            <button type="button" class="adm-act-btn adm-act-edit"
                                                    title="Editar datos, rol y asociación"
                                                    @onclick="() => AbrirModalEditarUsuario(u)">
                                                <i class="bi bi-pencil"></i> Editar
                                            </button>
                                            <button type="button" class="adm-act-btn @(u.Activo ? "adm-act-warn" : "adm-act-enable")"
                                                    title="@(u.Activo ? "Desactivar acceso" : "Activar acceso")"
                                                    @onclick="() => AlternarEstadoUsuarioAsync(u)">
                                                <i class="bi @(u.Activo ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                @(u.Activo ? "Desactivar" : "Activar")
                                            </button>
                                            <button type="button" class="adm-act-btn adm-act-danger"
                                                    title="Cerrar todas las sesiones activas de este usuario"
                                                    @onclick="() => RevocarSesionesAsync(u)">
                                                <i class="bi bi-slash-circle"></i> Revocar sesión
                                            </button>
                                            <button type="button" class="adm-act-btn adm-act-info"
                                                    title="Habilitar recuperación segura de contraseña sin mostrar clave"
                                                    @onclick="() => IniciarRecuperacionAsync(u)">
                                                <i class="bi bi-key"></i> Recuperar acceso
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- MATRIZ DE ROLES Y PERMISOS (MÍNIMO PRIVILEGIO) -->
        <section class="adm-surface">
            <div class="adm-section-head">
                <div>
                    <h3 class="adm-section-title">
                        <i class="bi bi-grid-3x3-gap-fill text-success"></i> Matriz de Roles y Permisos (Mínimo Privilegio)
                    </h3>
                    <p class="adm-section-sub">
                        Control granular de acceso por rol y módulo. La bitácora de Auditoría permanece en solo lectura para todos los perfiles.
                    </p>
                </div>
                <select class="form-select form-select-sm" style="max-width: 260px;" aria-label="Filtrar matriz por rol" @bind="filtroRolMatriz">
                    <option value="">Todos los roles</option>
                    @foreach (var r in AdminSistemaService.RolesSistema)
                    {
                        <option value="@r">@NombreRolLegible(r)</option>
                    }
                </select>
            </div>

            <div class="table-responsive aso-table-wrap mb-0">
                <table class="table table-sm table-hover align-middle mb-0 adm-table" style="min-width: 680px;">
                    <thead class="aso-thead-unified">
                        <tr>
                            <th style="width: 22%;">Rol</th>
                            <th style="width: 30%;">Módulo</th>
                            <th class="text-center" style="width: 9%;">Ver</th>
                            <th class="text-center" style="width: 9%;">Crear</th>
                            <th class="text-center" style="width: 9%;">Editar</th>
                            <th class="text-center" style="width: 9%;">Eliminar</th>
                            <th class="text-end" style="width: 12%;">Guardar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var perm in MatrizPermisosFiltrada)
                        {
                            var esAuditoria = perm.Modulo.Equals("Auditoría y seguridad", StringComparison.OrdinalIgnoreCase);
                            <tr>
                                <td class="fw-semibold text-dark">@NombreRolLegible(perm.Rol)</td>
                                <td>
                                    <span class="text-dark">@perm.Modulo</span>
                                    @if (esAuditoria)
                                    {
                                        <span class="badge bg-light text-muted border ms-1" style="font-size: 0.66rem;">Solo lectura</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" @bind="perm.PuedeVer" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" @bind="perm.PuedeCrear" disabled="@esAuditoria" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" @bind="perm.PuedeEditar" disabled="@esAuditoria" />
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" class="form-check-input" @bind="perm.PuedeEliminar" disabled="@esAuditoria" />
                                </td>
                                <td class="text-end">
                                    <button type="button" class="adm-act-btn adm-act-enable px-3"
                                            @onclick="() => GuardarPermisoAsync(perm)">
                                        Aplicar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <!-- =================================================================== -->
    <!-- MÓDULO 3: AUDITORÍA Y SEGURIDAD                                     -->
    <!-- =================================================================== -->
    @if (seccionActiva == "auditoria")
    {
        var seriesAuditoria = ObtenerSeriesAuditoriaPorResultado(eventosAuditoria, periodoAuditoria);
        var modulosAuditoria = ObtenerDistribucionModulosAuditoria(eventosAuditoria);

        <!-- VISUALIZACIONES DE AUDITORÍA BASADAS EN EVENTOS REALES -->
        <section class="adm-viz-grid">
            <article class="adm-viz-card adm-viz-col-7">
                <div class="adm-viz-header">
                    <div>
                        <h3 class="adm-viz-title">Actividad de Seguridad por Periodo y Resultado</h3>
                        <p class="adm-viz-desc">Eventos reales filtrados agrupados por Autorizado, Denegado y Error.</p>
                    </div>
                    <div class="adm-period-group" role="group" aria-label="Periodo de auditoría">
                        <button type="button" class="adm-period-btn @(periodoAuditoria == "24h" ? "is-active" : "")" @onclick='() => { periodoAuditoria = "24h"; hoveredBucketAuditoria = null; }'>24 h</button>
                        <button type="button" class="adm-period-btn @(periodoAuditoria == "7d" ? "is-active" : "")" @onclick='() => { periodoAuditoria = "7d"; hoveredBucketAuditoria = null; }'>7 días</button>
                        <button type="button" class="adm-period-btn @(periodoAuditoria == "30d" ? "is-active" : "")" @onclick='() => { periodoAuditoria = "30d"; hoveredBucketAuditoria = null; }'>30 días</button>
                        <button type="button" class="adm-period-btn @(periodoAuditoria == "todo" ? "is-active" : "")" @onclick='() => { periodoAuditoria = "todo"; hoveredBucketAuditoria = null; }'>Todo</button>
                    </div>
                </div>

                @if (eventosAuditoria.Count == 0 || seriesAuditoria.All(b => b.Total == 0))
                {
                    <div class="adm-empty-state my-auto">
                        <i class="bi bi-shield-check"></i>
                        <strong class="d-block small text-dark">No hay eventos reales en el periodo o filtros seleccionados</strong>
                        <span class="small">Ajusta el rango de fechas o los filtros de resultado para visualizar la tendencia.</span>
                    </div>
                }
                else
                {
                    var maxAud = Math.Max(1, seriesAuditoria.Max(b => b.Total));
                    <div class="adm-chart-stage d-none d-md-flex">
                        <svg class="adm-bar-chart-svg" viewBox="0 0 600 170" preserveAspectRatio="none" aria-label="Eventos de auditoría por periodo">
                            <line x1="0" y1="160" x2="600" y2="160" stroke="#CBD5E1" stroke-width="1" />
                            <line x1="0" y1="85" x2="600" y2="85" stroke="#EEF3F0" stroke-dasharray="4 4" stroke-width="1" />
                            <line x1="0" y1="15" x2="600" y2="15" stroke="#EEF3F0" stroke-dasharray="4 4" stroke-width="1" />
                            @for (int idx = 0; idx < seriesAuditoria.Count; idx++)
                            {
                                var b = seriesAuditoria[idx];
                                var stepW = 600.0 / seriesAuditoria.Count;
                                var barW = Math.Max(12, Math.Min(42, stepW * 0.62));
                                var xPos = idx * stepW + (stepW - barW) / 2.0;
                                var totalH = b.Total == 0 ? 0 : Math.Max(6, (b.Total / (double)maxAud) * 140.0);
                                var errH = b.Errores == 0 ? 0 : Math.Max(3, (b.Errores / (double)b.Total) * totalH);
                                var denH = b.Denegados == 0 ? 0 : Math.Max(3, (b.Denegados / (double)b.Total) * totalH);
                                var autH = Math.Max(0, totalH - errH - denH);
                                var yAut = 160.0 - autH;
                                var yDen = yAut - denH;
                                var yErr = yDen - errH;
                                var activeOpacity = hoveredBucketAuditoria == null || hoveredBucketAuditoria == b ? "1" : "0.45";

                                <g style="cursor: pointer; opacity: @activeOpacity;"
                                   @onmouseenter="() => hoveredBucketAuditoria = b"
                                   @onmouseleave="() => hoveredBucketAuditoria = null">
                                    <rect x="@xPos.ToString("0.##", CultureInfo.InvariantCulture)" y="10" width="@barW.ToString("0.##", CultureInfo.InvariantCulture)" height="150" fill="transparent" />
                                    @if (autH > 0)
                                    {
                                        <rect x="@xPos.ToString("0.##", CultureInfo.InvariantCulture)" y="@yAut.ToString("0.##", CultureInfo.InvariantCulture)" width="@barW.ToString("0.##", CultureInfo.InvariantCulture)" height="@autH.ToString("0.##", CultureInfo.InvariantCulture)" rx="3" fill="#10B981" />
                                    }
                                    @if (denH > 0)
                                    {
                                        <rect x="@xPos.ToString("0.##", CultureInfo.InvariantCulture)" y="@yDen.ToString("0.##", CultureInfo.InvariantCulture)" width="@barW.ToString("0.##", CultureInfo.InvariantCulture)" height="@denH.ToString("0.##", CultureInfo.InvariantCulture)" rx="3" fill="#D97706" />
                                    }
                                    @if (errH > 0)
                                    {
                                        <rect x="@xPos.ToString("0.##", CultureInfo.InvariantCulture)" y="@yErr.ToString("0.##", CultureInfo.InvariantCulture)" width="@barW.ToString("0.##", CultureInfo.InvariantCulture)" height="@errH.ToString("0.##", CultureInfo.InvariantCulture)" rx="3" fill="#DC2626" />
                                    }
                                    <title>@b.Etiqueta: @b.Autorizados Autorizado, @b.Denegados Denegado, @b.Errores Error</title>
                                </g>
                            }
                        </svg>
                        <div class="adm-axis-labels" style="grid-template-columns: repeat(@seriesAuditoria.Count, minmax(0, 1fr));">
                            @foreach (var b in seriesAuditoria)
                            {
                                <span class="text-truncate" title="@b.Etiqueta">@b.EtiquetaCorta</span>
                            }
                        </div>
                    </div>

                    <div class="adm-hbar-list d-md-none">
                        @foreach (var b in seriesAuditoria.Where(x => x.Total > 0))
                        {
                            var wA = (b.Autorizados * 100.0 / maxAud).ToString("0.##", CultureInfo.InvariantCulture);
                            var wD = (b.Denegados * 100.0 / maxAud).ToString("0.##", CultureInfo.InvariantCulture);
                            var wE = (b.Errores * 100.0 / maxAud).ToString("0.##", CultureInfo.InvariantCulture);
                            <div class="adm-hbar-row">
                                <div class="adm-hbar-top">
                                    <strong class="text-dark">@b.Etiqueta</strong>
                                    <span class="text-muted">@b.Total evento(s)</span>
                                </div>
                                <div class="adm-hbar-track">
                                    <div class="adm-hbar-fill" style="width: @(wA)%; background: #10B981;"></div>
                                    <div class="adm-hbar-fill" style="width: @(wD)%; background: #D97706;"></div>
                                    <div class="adm-hbar-fill" style="width: @(wE)%; background: #DC2626;"></div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-center mt-2">
                        <button type="button" class="adm-period-btn border @(filtroAuditoria.Resultado == "Autorizado" ? "is-active" : "")"
                                @onclick='() => FiltrarPorResultadoDesdeLeyendaAsync("Autorizado")'>
                            <span class="adm-swatch d-inline-block me-1" style="background: #10B981;"></span> Autorizado (@eventosAuditoria.Count(e => e.Resultado == "Autorizado"))
                        </button>
                        <button type="button" class="adm-period-btn border @(filtroAuditoria.Resultado == "Denegado" ? "is-active" : "")"
                                @onclick='() => FiltrarPorResultadoDesdeLeyendaAsync("Denegado")'>
                            <span class="adm-swatch d-inline-block me-1" style="background: #D97706;"></span> Denegado (@eventosAuditoria.Count(e => e.Resultado == "Denegado"))
                        </button>
                        <button type="button" class="adm-period-btn border @(filtroAuditoria.Resultado == "Error" ? "is-active" : "")"
                                @onclick='() => FiltrarPorResultadoDesdeLeyendaAsync("Error")'>
                            <span class="adm-swatch d-inline-block me-1" style="background: #DC2626;"></span> Error (@eventosAuditoria.Count(e => e.Resultado == "Error"))
                        </button>
                    </div>

                    <div class="adm-tooltip-box @(hoveredBucketAuditoria == null ? "adm-tooltip-muted" : "")">
                        @if (hoveredBucketAuditoria != null)
                        {
                            <span><strong>@hoveredBucketAuditoria.Etiqueta:</strong> @hoveredBucketAuditoria.Total evento(s)</span>
                            <span>Autorizado: <strong>@hoveredBucketAuditoria.Autorizados</strong> · Denegado: <strong>@hoveredBucketAuditoria.Denegados</strong> · Error: <strong>@hoveredBucketAuditoria.Errores</strong></span>
                        }
                        else
                        {
                            <span>Pasa el cursor sobre las columnas o haz clic en un resultado para filtrar la bitácora.</span>
                        }
                    </div>
                }
            </article>

            <article class="adm-viz-card adm-viz-col-5">
                <div class="adm-viz-header">
                    <div>
                        <h3 class="adm-viz-title">Módulos con Mayor Actividad Auditada</h3>
                        <p class="adm-viz-desc">Distribución proporcional real según el filtro aplicado.</p>
                    </div>
                    <span class="adm-chip-meta">@eventosAuditoria.Count evento(s)</span>
                </div>

                @if (modulosAuditoria.Count == 0)
                {
                    <div class="adm-empty-state my-auto">
                        <i class="bi bi-layers"></i>
                        <strong class="d-block small text-dark">Sin distribución de módulos disponible</strong>
                    </div>
                }
                else
                {
                    var maxMod = Math.Max(1, modulosAuditoria.Max(m => m.Cantidad));
                    <div class="adm-hbar-list">
                        @foreach (var mod in modulosAuditoria.Take(6))
                        {
                            var pct = (int)Math.Round(mod.Cantidad * 100.0 / Math.Max(1, eventosAuditoria.Count));
                            var ancho = (mod.Cantidad * 100.0 / maxMod).ToString("0.##", CultureInfo.InvariantCulture);
                            <button type="button" class="adm-hbar-row border-0 bg-transparent text-start w-100"
                                    style="cursor: pointer;"
                                    @onclick="() => FiltrarPorModuloDesdeGraficoAsync(mod.Nombre)">
                                <div class="adm-hbar-top">
                                    <strong class="text-dark text-truncate">@mod.Nombre</strong>
                                    <span class="text-muted text-nowrap">@mod.Cantidad (@pct%)</span>
                                </div>
                                <div class="adm-hbar-track">
                                    <div class="adm-hbar-fill" style="width: @(ancho)%; background: #059669;"></div>
                                </div>
                            </button>
                        }
                    </div>
                    <small class="text-muted mt-auto pt-2" style="font-size: 0.72rem;">
                        <i class="bi bi-hand-index-thumb me-1"></i> Haz clic en cualquier módulo para filtrar la tabla.
                    </small>
                }
            </article>
        </section>

        <section class="adm-surface mb-4">
            <div class="adm-section-head">
                <div>
                    <h2 class="adm-section-title">
                        <i class="bi bi-shield-shaded text-success"></i> Auditoría de Seguridad y Eventos del Sistema
                    </h2>
                    <p class="adm-section-sub">
                        Registro protegido contra alteraciones (solo lectura). Fuente activa: <strong>@fuenteAuditoria</strong>.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 text-nowrap" @onclick="CargarAuditoriaAsync">
                        <i class="bi bi-arrow-clockwise me-1"></i> Actualizar
                    </button>
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-3 fw-bold text-nowrap"
                            style="background-color: #14532D; border-color: #14532D;"
                            disabled="@(eventosAuditoria.Count == 0)"
                            @onclick="ExportarAuditoriaCsvAsync">
                        <i class="bi bi-download me-1"></i> Exportar CSV
                    </button>
                </div>
            </div>

            <!-- FILTROS AVANZADOS DE AUDITORÍA -->
            <div class="p-3 rounded-4 border mb-3" style="background: #F7FAF8; border-color: #DCE7DF !important;">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Buscar usuario, registro o detalle</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Texto..." @bind="filtroAuditoria.TextoBusqueda" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-bold mb-1">Desde</label>
                        <input type="date" class="form-control form-control-sm" @bind="filtroAuditoria.FechaDesde" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-bold mb-1">Hasta</label>
                        <input type="date" class="form-control form-control-sm" @bind="filtroAuditoria.FechaHasta" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-bold mb-1">Rol</label>
                        <select class="form-select form-select-sm" @bind="filtroAuditoria.Rol">
                            <option value="">Todos</option>
                            @foreach (var r in AdminSistemaService.RolesSistema)
                            {
                                <option value="@r">@NombreRolLegible(r)</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-bold mb-1">Resultado</label>
                        <select class="form-select form-select-sm" @bind="filtroAuditoria.Resultado">
                            <option value="">Todos</option>
                            <option value="Autorizado">Autorizado</option>
                            <option value="Denegado">Denegado</option>
                            <option value="Error">Error</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex gap-1">
                        <button type="button" class="btn btn-success btn-sm w-100" @onclick="CargarAuditoriaAsync" title="Aplicar filtros">
                            <i class="bi bi-funnel-fill"></i>
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LimpiarFiltrosAuditoriaAsync" title="Limpiar">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">Módulo</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Ej: Autenticación, Usuarios, Catálogos..." @bind="filtroAuditoria.Modulo" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">Acción</label>
                        <input type="text" class="form-control form-control-sm" placeholder="Ej: Inicio de sesión, Acceso denegado..." @bind="filtroAuditoria.Accion" />
                    </div>
                    <div class="col-md-4 d-flex justify-content-md-end">
                        <span class="adm-result-pill">Total: @eventosAuditoria.Count evento(s) reales</span>
                    </div>
                </div>
            </div>

            <!-- TABLA DE EVENTOS REALES (O ESTADO VACÍO CLARO SIN DATOS FICTICIOS) -->
            @if (eventosAuditoria.Count == 0)
            {
                <div class="adm-empty-state">
                    <i class="bi bi-journal-check"></i>
                    <strong class="d-block text-dark mb-1">No hay eventos de auditoría registrados para los filtros actuales</strong>
                    <p class="small mb-0">
                        Aquí aparecerán únicamente eventos reales generados por inicios/cierres de sesión, accesos denegados, cambios de usuarios, permisos o parámetros.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive aso-table-wrap mb-0">
                    <table class="table table-hover align-middle mb-0 adm-table">
                        <thead class="aso-thead-unified">
                            <tr>
                                <th style="width: 155px;">Fecha / Hora</th>
                                <th style="min-width: 185px;">Usuario</th>
                                <th style="width: 135px;">Rol</th>
                                <th style="min-width: 185px;">Módulo / Acción</th>
                                <th style="min-width: 145px;">Registro afectado</th>
                                <th style="width: 120px;">Terminal / IP</th>
                                <th class="text-center" style="width: 105px;">Resultado</th>
                                <th class="text-end" style="width: 85px;">Detalle</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in eventosAuditoria)
                            {
                                var claseBadge = log.Resultado switch
                                {
                                    "Denegado" => "bg-warning text-dark",
                                    "Error" => "bg-danger",
                                    _ => "bg-success"
                                };
                                <tr>
                                    <td class="font-monospace text-muted text-nowrap">@FormatearFechaLocal(log.FechaUtc)</td>
                                    <td>
                                        <strong class="text-dark d-block">@log.UsuarioNombre</strong>
                                        @if (!string.IsNullOrWhiteSpace(log.UsuarioCorreo))
                                        {
                                            <small class="text-muted text-break">@log.UsuarioCorreo</small>
                                        }
                                    </td>
                                    <td><span class="adm-role-badge">@NombreRolLegible(log.Rol)</span></td>
                                    <td>
                                        <span class="fw-semibold text-dark d-block">@log.Modulo</span>
                                        <small class="text-muted">@log.Accion</small>
                                    </td>
                                    <td><small class="text-dark text-break">@log.RegistroAfectado</small></td>
                                    <td class="font-monospace text-muted text-nowrap">@log.IpTerminal</td>
                                    <td class="text-center">
                                        <span class="badge @claseBadge rounded-pill px-2.5 py-1">@log.Resultado</span>
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="adm-act-btn adm-act-edit px-2.5" @onclick="() => eventoDetalle = log">
                                            Ver
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    }

    <!-- =================================================================== -->
    <!-- MÓDULO 4: CATÁLOGOS Y PARÁMETROS                                    -->
    <!-- =================================================================== -->
    @if (seccionActiva == "catalogos")
    {
        var cultivosActivos = catalogos.Cultivos.Count(c => c.Activo);
        var cuotasActivas = catalogos.TiposCuota.Count(t => t.Activo);
        var cambiosCatalogos = eventosResumenSistema
            .Where(e => e.Modulo.Contains("Catálogos", StringComparison.OrdinalIgnoreCase))
            .Take(4)
            .ToList();

        <!-- RESUMEN PROPORCIONAL REAL DE CATÁLOGOS Y CAMBIOS -->
        <section class="adm-viz-grid">
            <article class="adm-viz-card adm-viz-col-6">
                <div class="adm-viz-header">
                    <div>
                        <h3 class="adm-viz-title">Estado de Catálogos Maestros Activos</h3>
                        <p class="adm-viz-desc">Conteo real y proporción de elementos habilitados frente a inactivos.</p>
                    </div>
                </div>
                <div class="adm-hbar-list my-auto">
                    <div class="adm-hbar-row">
                        <div class="adm-hbar-top">
                            <span class="fw-bold text-dark">Cultivos y líneas productivas</span>
                            <span class="text-muted">@cultivosActivos activos de @catalogos.Cultivos.Count</span>
                        </div>
                        <div class="adm-hbar-track">
                            <div class="adm-hbar-fill" style="width: @((catalogos.Cultivos.Count == 0 ? 0 : cultivosActivos * 100 / catalogos.Cultivos.Count))%; background: #10B981;"></div>
                        </div>
                    </div>
                    <div class="adm-hbar-row">
                        <div class="adm-hbar-top">
                            <span class="fw-bold text-dark">Tipos de cuota asociativa</span>
                            <span class="text-muted">@cuotasActivas activos de @catalogos.TiposCuota.Count</span>
                        </div>
                        <div class="adm-hbar-track">
                            <div class="adm-hbar-fill" style="width: @((catalogos.TiposCuota.Count == 0 ? 0 : cuotasActivas * 100 / catalogos.TiposCuota.Count))%; background: #059669;"></div>
                        </div>
                    </div>
                    <div class="adm-hbar-row">
                        <div class="adm-hbar-top">
                            <span class="fw-bold text-dark">Tipos de documento institucional</span>
                            <span class="text-muted">@catalogos.TiposDocumento.Count registrados · @parametrosSistema.Count parámetro(s)</span>
                        </div>
                        <div class="adm-hbar-track">
                            <div class="adm-hbar-fill" style="width: @(catalogos.TiposDocumento.Count > 0 ? 100 : 0)%; background: #14532D;"></div>
                        </div>
                    </div>
                </div>
            </article>

            <article class="adm-viz-card adm-viz-col-6">
                <div class="adm-viz-header">
                    <div>
                        <h3 class="adm-viz-title">Últimas Modificaciones en Catálogos y Parámetros</h3>
                        <p class="adm-viz-desc">Trazabilidad real registrada en la bitácora de auditoría.</p>
                    </div>
                </div>
                @if (cambiosCatalogos.Count == 0)
                {
                    <div class="adm-empty-state my-auto">
                        <i class="bi bi-sliders"></i>
                        <strong class="d-block small text-dark">Sin modificaciones recientes registradas</strong>
                        <span class="small">Cada alta o edición confirmada en catálogos o parámetros quedará auditada aquí.</span>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var cLog in cambiosCatalogos)
                        {
                            <div class="p-2.5 rounded-3 border bg-light d-flex justify-content-between align-items-center gap-2 small">
                                <div class="min-w-0">
                                    <strong class="text-dark d-block text-truncate">@cLog.Accion: @cLog.RegistroAfectado</strong>
                                    <span class="text-muted">Por @cLog.UsuarioNombre</span>
                                </div>
                                <span class="font-monospace text-muted text-nowrap">@FormatearFechaLocal(cLog.FechaUtc)</span>
                            </div>
                        }
                    </div>
                }
            </article>
        </section>

        <div class="row g-4">
            <!-- CULTIVOS (public.cultivos) -->
            <div class="col-lg-6">
                <section class="adm-surface h-100">
                    <div class="adm-section-head">
                        <div>
                            <h2 class="adm-section-title fs-6"><i class="bi bi-flower1 text-success"></i> Catálogo de Cultivos y Líneas (public.cultivos)</h2>
                            <p class="adm-section-sub">Utilizado en la vinculación productiva de asociados.</p>
                        </div>
                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 text-nowrap flex-shrink-0" @onclick="AbrirNuevoCultivo">
                            + Agregar cultivo
                        </button>
                    </div>
                    <div class="table-responsive aso-table-wrap mb-0">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.82rem;">
                            <thead class="aso-thead-unified">
                                <tr>
                                    <th style="width: 56%;">Nombre</th>
                                    <th class="text-center" style="width: 24%;">Estado</th>
                                    <th class="text-end" style="width: 20%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in catalogos.Cultivos)
                                {
                                    <tr>
                                        <td class="fw-semibold text-dark">@c.Nombre</td>
                                        <td class="text-center">
                                            <span class="badge @(c.Activo ? "bg-success" : "bg-secondary") rounded-pill px-2.5">@(c.Activo ? "Activo" : "Inactivo")</span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="adm-act-btn adm-act-edit px-2.5" @onclick="() => EditarCultivo(c)">Editar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <!-- TIPOS DE CUOTA (public.tipos_cuota) -->
            <div class="col-lg-6">
                <section class="adm-surface h-100">
                    <div class="adm-section-head">
                        <div>
                            <h2 class="adm-section-title fs-6"><i class="bi bi-receipt text-success"></i> Tipos de Cuota Asociativa (public.tipos_cuota)</h2>
                            <p class="adm-section-sub">Utilizado en el registro de cuotas de asociados.</p>
                        </div>
                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 text-nowrap flex-shrink-0" @onclick="AbrirNuevoTipoCuota">
                            + Agregar tipo
                        </button>
                    </div>
                    <div class="table-responsive aso-table-wrap mb-0">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.82rem;">
                            <thead class="aso-thead-unified">
                                <tr>
                                    <th style="width: 26%;">Código</th>
                                    <th style="width: 38%;">Nombre</th>
                                    <th class="text-center" style="width: 18%;">Estado</th>
                                    <th class="text-end" style="width: 18%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var t in catalogos.TiposCuota)
                                {
                                    <tr>
                                        <td class="font-monospace text-muted">@t.Codigo</td>
                                        <td class="fw-semibold text-dark">@t.Nombre</td>
                                        <td class="text-center">
                                            <span class="badge @(t.Activo ? "bg-success" : "bg-secondary") rounded-pill px-2.5">@(t.Activo ? "Activo" : "Inactivo")</span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="adm-act-btn adm-act-edit px-2.5" @onclick="() => EditarTipoCuota(t)">Editar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <!-- TIPOS DE DOCUMENTO (public.tipos_documento) -->
            <div class="col-lg-6">
                <section class="adm-surface h-100">
                    <div class="adm-section-head">
                        <div>
                            <h2 class="adm-section-title fs-6"><i class="bi bi-file-earmark-text text-success"></i> Tipos de Documento (public.tipos_documento)</h2>
                            <p class="adm-section-sub">Catálogo utilizado en expedientes y vencimientos.</p>
                        </div>
                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-3 text-nowrap flex-shrink-0" @onclick="AbrirNuevoTipoDocumento">
                            + Agregar tipo
                        </button>
                    </div>
                    <div class="table-responsive aso-table-wrap mb-0">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.82rem;">
                            <thead class="aso-thead-unified">
                                <tr>
                                    <th style="width: 32%;">Código</th>
                                    <th style="width: 48%;">Nombre</th>
                                    <th class="text-end" style="width: 20%;">Acción</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var td in catalogos.TiposDocumento)
                                {
                                    <tr>
                                        <td class="font-monospace text-muted">@td.Codigo</td>
                                        <td class="fw-semibold text-dark">@td.Nombre</td>
                                        <td class="text-end">
                                            <button type="button" class="adm-act-btn adm-act-edit px-2.5" @onclick="() => EditarTipoDocumento(td)">Editar</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>

            <!-- PARÁMETROS GENERALES DE LA PLATAFORMA -->
            <div class="col-lg-6">
                <section class="adm-surface h-100">
                    <div class="adm-section-head">
                        <div>
                            <h2 class="adm-section-title fs-6"><i class="bi bi-gear-fill text-success"></i> Parámetros Técnicos del Sistema</h2>
                            <p class="adm-section-sub">Todo ajuste requiere confirmación explícita y queda auditado.</p>
                        </div>
                    </div>
                    <div class="table-responsive aso-table-wrap mb-0">
                        <table class="table table-sm align-middle mb-0" style="font-size: 0.8rem;">
                            <thead class="aso-thead-unified">
                                <tr>
                                    <th style="width: 48%;">Parámetro</th>
                                    <th style="width: 30%;">Valor actual</th>
                                    <th class="text-end" style="width: 22%;">Control</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var param in parametrosSistema)
                                {
                                    <tr>
                                        <td>
                                            <strong class="text-dark d-block">@param.Nombre</strong>
                                            <small class="text-muted d-block">@param.Descripcion</small>
                                            @if (param.UltimoCambioUtc.HasValue)
                                            {
                                                <small class="text-success d-block">
                                                    Último cambio por @param.UltimoCambioPor el @FormatearFechaLocal(param.UltimoCambioUtc.Value)
                                                </small>
                                            }
                                        </td>
                                        <td><code class="text-dark text-break">@param.Valor</code></td>
                                        <td class="text-end">
                                            @if (param.Editable)
                                            {
                                                <button type="button" class="adm-act-btn adm-act-enable px-2.5" @onclick="() => AbrirEditarParametro(param)">
                                                    Modificar
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border">Solo código</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </section>
            </div>
        </div>
    }

    <!-- =================================================================== -->
    <!-- MÓDULO 5: ESTADO DE DATOS E INTEGRACIONES                           -->
    <!-- =================================================================== -->
    @if (seccionActiva == "integraciones")
    {
        @if (estadoSistema is not null)
        {
            var tablasDisponibles = estadoSistema.TablasSupabase.Where(t => t.Registros.HasValue).ToList();
            var maxRegistrosTabla = Math.Max(1, tablasDisponibles.Select(t => t.Registros ?? 0).DefaultIfEmpty(0).Max());

            <!-- PANEL VISUAL DE CONEXIÓN, LATENCIA Y TELEMETRÍA REAL -->
            <section class="adm-viz-grid">
                <article class="adm-viz-card adm-viz-col-6">
                    <div class="adm-viz-header">
                        <div>
                            <h3 class="adm-viz-title">Estado de Sincronización y Latencia</h3>
                            <p class="adm-viz-desc">Medición real en vivo de servicios conectados y pendientes.</p>
                        </div>
                        <span class="adm-chip-meta">
                            @(estadoSistema.SupabaseLatenciaMs.HasValue ? $"Latencia BD: {estadoSistema.SupabaseLatenciaMs} ms" : "Modo almacenamiento local")
                        </span>
                    </div>

                    <div class="adm-mini-stats">
                        <div class="adm-mini-stat">
                            <span class="adm-mini-stat-label">Supabase</span>
                            <span class="adm-mini-stat-val">@(!estadoSistema.SupabaseConfigurado ? "No config." : (estadoSistema.SupabaseConectado ? "En línea" : "Con error"))</span>
                            <span class="adm-mini-stat-hint">@(estadoSistema.SupabaseLatenciaMs.HasValue ? $"{estadoSistema.SupabaseLatenciaMs} ms de respuesta" : "Sin conexión activa")</span>
                        </div>
                        <div class="adm-mini-stat">
                            <span class="adm-mini-stat-label">Google OAuth</span>
                            <span class="adm-mini-stat-val">@(estadoSistema.GoogleOAuthConfigurado ? "Activo" : "Pendiente")</span>
                            <span class="adm-mini-stat-hint">@(estadoSistema.GoogleOAuthConfigurado ? "Credenciales completas" : "Falta ClientSecret")</span>
                        </div>
                        <div class="adm-mini-stat">
                            <span class="adm-mini-stat-label">Errores de Host</span>
                            <span class="adm-mini-stat-val @(estadoSistema.ErroresRecientes.Count > 0 ? "text-danger" : "")">@estadoSistema.ErroresRecientes.Count</span>
                            <span class="adm-mini-stat-hint">Desde último arranque</span>
                        </div>
                    </div>

                    <div class="adm-hbar-list">
                        @foreach (var integ in estadoSistema.Integraciones)
                        {
                            <div class="adm-hbar-row">
                                <div class="adm-hbar-top">
                                    <strong class="text-dark">@integ.Nombre</strong>
                                    <span class="badge @(integ.Operativo ? "bg-success" : "bg-warning text-dark") rounded-pill">@integ.Estado</span>
                                </div>
                                <div class="adm-hbar-track">
                                    <div class="adm-hbar-fill" style="width: @(integ.Operativo ? "100" : "35")%; background: @(integ.Operativo ? "#10B981" : "#D97706");"></div>
                                </div>
                            </div>
                        }
                    </div>
                </article>

                <article class="adm-viz-card adm-viz-col-6">
                    <div class="adm-viz-header">
                        <div>
                            <h3 class="adm-viz-title">Volumen Real de Registros en Supabase</h3>
                            <p class="adm-viz-desc">Conteo directo por tabla en PostgreSQL (sin estimaciones).</p>
                        </div>
                    </div>

                    @if (!estadoSistema.SupabaseConfigurado || !estadoSistema.SupabaseConectado || tablasDisponibles.Count == 0)
                    {
                        <div class="adm-empty-state my-auto">
                            <i class="bi bi-database-dash"></i>
                            <strong class="d-block small text-dark">Volumen de tablas no disponible</strong>
                            <span class="small">@estadoSistema.SupabaseMensaje</span>
                        </div>
                    }
                    else
                    {
                        <div class="adm-hbar-list my-auto">
                            @foreach (var tb in tablasDisponibles.OrderByDescending(x => x.Registros ?? 0))
                            {
                                var reg = tb.Registros ?? 0;
                                var ancho = (reg == 0 ? 4 : Math.Max(6, reg * 100.0 / maxRegistrosTabla)).ToString("0.##", CultureInfo.InvariantCulture);
                                <div class="adm-hbar-row" style="cursor: pointer;"
                                     @onmouseenter="() => hoveredTablaSupabase = tb"
                                     @onmouseleave="() => hoveredTablaSupabase = null">
                                    <div class="adm-hbar-top">
                                        <span class="font-monospace fw-semibold text-dark">@tb.Tabla</span>
                                        <strong class="text-dark">@reg.ToString("N0") registro(s)</strong>
                                    </div>
                                    <div class="adm-hbar-track">
                                        <div class="adm-hbar-fill" style="width: @(ancho)%; background: #14532D;"></div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="adm-tooltip-box mt-3 @(hoveredTablaSupabase == null ? "adm-tooltip-muted" : "")">
                            @if (hoveredTablaSupabase != null)
                            {
                                <span><strong>@hoveredTablaSupabase.Tabla:</strong> @(hoveredTablaSupabase.Registros?.ToString("N0") ?? "0") fila(s) reales</span>
                                <span>Estado: @hoveredTablaSupabase.Estado</span>
                            }
                            else
                            {
                                <span>Pasa el cursor sobre cualquier tabla para inspeccionar el conteo real.</span>
                            }
                        </div>
                    }
                </article>
            </section>

            <section class="adm-surface mb-4">
                <div class="adm-section-head">
                    <div>
                        <h2 class="adm-section-title">
                            <i class="bi bi-hdd-network-fill text-success"></i> Estado Real de Supabase e Integraciones
                        </h2>
                        <p class="adm-section-sub">
                            Diagnóstico en vivo sin exposición de credenciales, contraseñas ni cadenas de conexión.
                        </p>
                    </div>
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-3 py-2 fw-bold text-nowrap"
                            style="background-color: #14532D; border-color: #14532D;"
                            disabled="@cargandoEstado"
                            @onclick="() => EjecutarDiagnosticoAsync(true)">
                        <i class="bi bi-lightning-charge-fill me-1"></i> @(cargandoEstado ? "Probando..." : "Probar conexiones ahora")
                    </button>
                </div>

                <div class="table-responsive aso-table-wrap mb-4">
                    <table class="table table-hover align-middle mb-0 adm-table">
                        <thead class="aso-thead-unified">
                            <tr>
                                <th style="width: 24%;">Integración / Servicio</th>
                                <th style="width: 16%;">Tipo</th>
                                <th class="text-center" style="width: 15%;">Estado real</th>
                                <th style="width: 16%;">Último intento</th>
                                <th style="width: 29%;">Detalle comprensible</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var integ in estadoSistema.Integraciones)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@integ.Nombre</td>
                                    <td class="text-muted">@integ.Tipo</td>
                                    <td class="text-center">
                                        <span class="badge rounded-pill px-2.5 py-1 @(integ.Operativo ? "bg-success" : "bg-warning text-dark")">
                                            @integ.Estado
                                        </span>
                                    </td>
                                    <td class="font-monospace text-muted text-nowrap">
                                        @(integ.UltimaVerificacionUtc.HasValue ? FormatearFechaLocal(integ.UltimaVerificacionUtc.Value) : "Sin verificación")
                                    </td>
                                    <td>
                                        <span class="small text-dark d-block">@integ.Detalle</span>
                                        @if (!string.IsNullOrWhiteSpace(integ.UltimoError))
                                        {
                                            <small class="text-danger d-block mt-1">@integ.UltimoError</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <h3 class="adm-section-title fs-6 mb-2">
                    <i class="bi bi-table text-success"></i> Detalle de Tablas en Supabase (PostgreSQL)
                </h3>
                @if (!estadoSistema.SupabaseConfigurado || !estadoSistema.SupabaseConectado)
                {
                    <div class="adm-empty-state">
                        <i class="bi bi-info-circle"></i>
                        <strong class="d-block small text-dark">Conexión a PostgreSQL no disponible</strong>
                        <span class="small">@estadoSistema.SupabaseMensaje</span>
                    </div>
                }
                else
                {
                    <div class="table-responsive aso-table-wrap mb-0">
                        <table class="table table-sm table-bordered align-middle mb-0" style="font-size: 0.81rem;">
                            <thead class="aso-thead-unified">
                                <tr>
                                    <th style="width: 45%;">Tabla</th>
                                    <th class="text-center" style="width: 25%;">Registros reales</th>
                                    <th style="width: 30%;">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tb in estadoSistema.TablasSupabase)
                                {
                                    <tr>
                                        <td class="font-monospace text-dark">@tb.Tabla</td>
                                        <td class="text-center fw-bold">@(tb.Registros?.ToString("N0") ?? "—")</td>
                                        <td>
                                            <span class="badge @(tb.Estado == "Disponible" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning-emphasis")">
                                                @tb.Estado
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    }

</div>

<!-- MODAL: CREAR / EDITAR USUARIO -->
@if (mostrarModalUsuario)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(11, 46, 28, 0.55); z-index: 3500;" role="dialog" aria-modal="true" @onclick="() => mostrarModalUsuario = false">
        <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation="true">
            <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                <div class="modal-header bg-success text-white p-3" style="background-color: #14532D !important;">
                    <h5 class="modal-title fw-bold fs-6 mb-0">
                        <i class="bi bi-person-gear me-2"></i>@(solicitudUsuario.Id.HasValue ? "Editar cuenta institucional" : "Nueva cuenta de usuario")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => mostrarModalUsuario = false" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrWhiteSpace(errorModalUsuario))
                    {
                        <div class="alert alert-danger small rounded-3 py-2">@errorModalUsuario</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">Nombre completo <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" @bind="solicitudUsuario.NombreCompleto" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">Documento de identidad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" @bind="solicitudUsuario.DocumentoId" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">Correo institucional <span class="text-danger">*</span></label>
                            <input type="email" class="form-control form-control-sm" @bind="solicitudUsuario.Correo" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">Teléfono</label>
                            <input type="text" class="form-control form-control-sm" @bind="solicitudUsuario.Telefono" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">Rol asignado (Mínimo privilegio) <span class="text-danger">*</span></label>
                            <select class="form-select form-select-sm" @bind="solicitudUsuario.Rol">
                                @foreach (var r in AdminSistemaService.RolesSistema)
                                {
                                    <option value="@r">@NombreRolLegible(r)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">Asociación asignada</label>
                            <select class="form-select form-select-sm" @bind="solicitudUsuario.AsociacionId">
                                <option value="">Federación FAAUA (Todas / Global)</option>
                                @foreach (var asoc in asociacionesDisponibles)
                                {
                                    <option value="@asoc.Id">@asoc.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold mb-1">
                                @(solicitudUsuario.Id.HasValue ? "Asignar nueva contraseña (opcional)" : "Contraseña inicial (opcional si usa Google/Recuperación)")
                            </label>
                            <input type="password" class="form-control form-control-sm" autocomplete="new-password" placeholder="Mínimo 8 caracteres" @bind="solicitudUsuario.ContrasenaNueva" />
                            <small class="text-muted" style="font-size: 0.7rem;">Se almacena únicamente mediante hash seguro; nunca en texto visible.</small>
                        </div>
                        <div class="col-md-6 d-flex align-items-center pt-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="chkUserActivo" @bind="solicitudUsuario.Activo" />
                                <label class="form-check-label small fw-semibold" for="chkUserActivo">Cuenta activa (permitir inicio de sesión)</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => mostrarModalUsuario = false">Cancelar</button>
                    <button type="button" class="btn btn-success btn-sm rounded-pill px-4 fw-bold" style="background-color: #14532D; border-color: #14532D;" @onclick="GuardarUsuarioAsync">
                        Guardar cuenta
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL: DETALLE DE EVENTO DE AUDITORÍA -->
@if (eventoDetalle is not null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(11, 46, 28, 0.55); z-index: 3500;" role="dialog" aria-modal="true" @onclick="() => eventoDetalle = null">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                <div class="modal-header bg-success text-white p-3" style="background-color: #14532D !important;">
                    <h5 class="modal-title fw-bold fs-6 mb-0">
                        <i class="bi bi-shield-check me-2"></i>Detalle de Evento de Auditoría #@eventoDetalle.Id
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => eventoDetalle = null" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4 small">
                    <div class="mb-2"><strong>Fecha y hora:</strong> @FormatearFechaLocal(eventoDetalle.FechaUtc)</div>
                    <div class="mb-2"><strong>Usuario:</strong> @eventoDetalle.UsuarioNombre @(string.IsNullOrWhiteSpace(eventoDetalle.UsuarioCorreo) ? "" : $"({eventoDetalle.UsuarioCorreo})")</div>
                    <div class="mb-2"><strong>Rol:</strong> @NombreRolLegible(eventoDetalle.Rol)</div>
                    <div class="mb-2"><strong>Módulo:</strong> @eventoDetalle.Modulo</div>
                    <div class="mb-2"><strong>Acción:</strong> @eventoDetalle.Accion</div>
                    <div class="mb-2"><strong>Registro afectado:</strong> @eventoDetalle.RegistroAfectado</div>
                    <div class="mb-2"><strong>Resultado:</strong> <span class="badge bg-light text-dark border">@eventoDetalle.Resultado</span></div>
                    <div class="mb-2"><strong>Terminal / IP:</strong> <span class="font-monospace">@eventoDetalle.IpTerminal</span></div>
                    <div class="mb-2"><strong>Fuente:</strong> @eventoDetalle.FuenteDatos</div>
                    <div class="p-3 rounded-3 bg-light border mt-3">
                        <strong class="d-block mb-1">Detalle técnico registrado:</strong>
                        <span class="text-dark">@(string.IsNullOrWhiteSpace(eventoDetalle.Detalle) ? "Sin detalles adicionales." : eventoDetalle.Detalle)</span>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-4" @onclick="() => eventoDetalle = null">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL: EDICIÓN Y CONFIRMACIÓN DE CATÁLOGO / PARÁMETRO -->
@if (modalCatalogoTipo != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(11, 46, 28, 0.55); z-index: 3500;" role="dialog" aria-modal="true" @onclick="CerrarModalCatalogo">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                <div class="modal-header bg-success text-white p-3" style="background-color: #14532D !important;">
                    <h5 class="modal-title fw-bold fs-6 mb-0">
                        <i class="bi bi-sliders me-2"></i>@tituloModalCatalogo
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalCatalogo" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    @if (!string.IsNullOrWhiteSpace(errorModalCatalogo))
                    {
                        <div class="alert alert-danger small rounded-3 py-2">@errorModalCatalogo</div>
                    }

                    @if (modalCatalogoTipo is "cuota" or "documento")
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-bold mb-1">Código <span class="text-danger">*</span></label>
                            <input type="text" class="form-control form-control-sm" @bind="catCodigo" disabled="@confirmandoCambioCatalogo" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-bold mb-1">
                            @(modalCatalogoTipo == "parametro" ? "Nuevo valor del parámetro" : "Nombre") <span class="text-danger">*</span>
                        </label>
                        <input type="text" class="form-control form-control-sm" @bind="catNombreOValor" disabled="@confirmandoCambioCatalogo" />
                    </div>

                    @if (modalCatalogoTipo == "cuota")
                    {
                        <div class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" id="chkPermPer" @bind="catPermitePeriodicidad" disabled="@confirmandoCambioCatalogo" />
                            <label class="form-check-label small" for="chkPermPer">Permite periodicidad</label>
                        </div>
                    }

                    @if (modalCatalogoTipo is "cultivo" or "cuota")
                    {
                        <div class="form-check mb-3">
                            <input type="checkbox" class="form-check-input" id="chkCatActivo" @bind="catActivo" disabled="@confirmandoCambioCatalogo" />
                            <label class="form-check-label small" for="chkCatActivo">Elemento activo en el catálogo</label>
                        </div>
                    }

                    @if (confirmandoCambioCatalogo)
                    {
                        <div class="alert alert-warning small rounded-3 mb-0">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i>
                            <strong>Confirmación requerida:</strong> Al aplicar este cambio quedará registrado en la auditoría del sistema a nombre de <strong>@nombreUsuario</strong>. ¿Deseas continuar?
                        </div>
                    }
                </div>
                <div class="modal-footer bg-light p-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="CerrarModalCatalogo">Cancelar</button>
                    @if (!confirmandoCambioCatalogo)
                    {
                        <button type="button" class="btn btn-success btn-sm rounded-pill px-4 fw-bold" style="background-color: #14532D; border-color: #14532D;" @onclick="SolicitarConfirmacionCatalogo">
                            Revisar y confirmar
                        </button>
                    }
                    else
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="() => confirmandoCambioCatalogo = false">Editar</button>
                        <button type="button" class="btn btn-success btn-sm rounded-pill px-4 fw-bold" style="background-color: #14532D; border-color: #14532D;" @onclick="ConfirmarGuardarCatalogoAsync">
                            Confirmar y aplicar
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

