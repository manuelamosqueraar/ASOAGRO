    // --- Visualizaciones basadas únicamente en datos reales ---
    private List<DonutSegmento> CalcularSegmentosDisponibilidad(List<EstadoIntegracionItem> integraciones)
    {
        var list = new List<DonutSegmento>();
        if (integraciones.Count == 0) return list;

        var op = integraciones.Count(i => i.Operativo);
        var pend = integraciones.Count - op;
        var items = new List<(string Clave, string Etiqueta, int Valor, string Color, string Detalle)>();
        if (op > 0) items.Add(("op", "Operativos", op, "#10B981", string.Join(", ", integraciones.Where(i => i.Operativo).Select(i => i.Nombre))));
        if (pend > 0) items.Add(("pend", "Pendientes / Con alerta", pend, "#D97706", string.Join(", ", integraciones.Where(i => !i.Operativo).Select(i => i.Nombre))));

        return ConstruirDonut(items, integraciones.Count);
    }

    private List<DonutSegmento> ObtenerDistribucionRoles()
    {
        if (usuarios.Count == 0) return new();

        var paleta = new[] { "#14532D", "#10B981", "#0284C7", "#D97706", "#7C3AED", "#64748B" };
        var grupos = usuarios
            .GroupBy(u => string.IsNullOrWhiteSpace(u.Rol) ? "Sin rol" : u.Rol.Trim().ToLowerInvariant())
            .OrderByDescending(g => g.Count())
            .Select((g, idx) =>
            {
                var muestra = g.First().Rol;
                var claveFiltro = string.IsNullOrWhiteSpace(muestra) ? "Sin rol" : muestra.Trim();
                return (
                    Clave: claveFiltro,
                    Etiqueta: NombreRolLegible(muestra),
                    Valor: g.Count(),
                    Color: paleta[idx % paleta.Length],
                    Detalle: string.Empty);
            })
            .ToList();

        return ConstruirDonut(grupos, usuarios.Count)
            .Select(s => new DonutSegmento
            {
                ClaveFiltro = s.ClaveFiltro,
                Etiqueta = s.Etiqueta,
                Cantidad = s.Cantidad,
                Porcentaje = s.Porcentaje,
                Color = s.Color,
                DashArray = s.DashArray,
                DashOffset = s.DashOffset,
                Detalle = s.Detalle
            })
            .ToList();
    }

    private static List<DonutSegmento> ConstruirDonut(
        List<(string Clave, string Etiqueta, int Valor, string Color, string Detalle)> items,
        int total)
    {
        const double r = 56.0;
        var circunferencia = 2.0 * Math.PI * r;
        var acumulado = 0.0;
        var salida = new List<DonutSegmento>();

        foreach (var item in items)
        {
            var longitud = total <= 0 ? 0.0 : (item.Valor / (double)total) * circunferencia;
            var pct = total <= 0 ? 0 : (int)Math.Round(item.Valor * 100.0 / total);
            salida.Add(new DonutSegmento
            {
                Clave = item.Clave,
                ClaveFiltro = item.Clave,
                Etiqueta = item.Etiqueta,
                Valor = item.Valor,
                Cantidad = item.Valor,
                Porcentaje = pct,
                Color = item.Color,
                Detalle = item.Detalle,
                DashArray = $"{longitud.ToString("0.##", CultureInfo.InvariantCulture)} {circunferencia.ToString("0.##", CultureInfo.InvariantCulture)}",
                DashOffset = (-acumulado).ToString("0.##", CultureInfo.InvariantCulture)
            });
            acumulado += longitud;
        }
        return salida;
    }

    private List<ActividadBucket> ObtenerBucketsActividad(
        List<AuditoriaEventoDto> eventos,
        List<ErrorTecnicoItem> erroresHost,
        string periodo)
    {
        var ahora = DateTime.Now;
        var salida = new List<ActividadBucket>();

        if (periodo == "24h")
        {
            // 8 bloques de 3 horas sobre las últimas 24 h
            var inicioVentana = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, 0, 0).AddHours(-21);
            for (int i = 0; i < 8; i++)
            {
                var desde = inicioVentana.AddHours(i * 3);
                var hasta = desde.AddHours(3);
                var evTramo = eventos.Where(e =>
                {
                    var local = DateTime.SpecifyKind(e.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                    return local >= desde && local < hasta;
                }).ToList();
                var errTramo = erroresHost.Count(err =>
                {
                    var local = DateTime.SpecifyKind(err.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                    return local >= desde && local < hasta;
                });
                var alertas = evTramo.Count(e => e.Resultado is "Denegado" or "Error") + errTramo;
                var normales = evTramo.Count(e => e.Resultado == "Autorizado");
                salida.Add(new ActividadBucket($"{desde:HH}:00-{hasta:HH}:00", $"{desde:HH}h", normales, alertas));
            }
            return salida;
        }

        int dias = periodo == "30d" ? 30 : 7;
        if (periodo == "30d")
        {
            // 10 tramos de 3 días para mantener etiquetas legibles
            var primerDia = DateTime.Today.AddDays(-29);
            for (int i = 0; i < 10; i++)
            {
                var d0 = primerDia.AddDays(i * 3);
                var d1 = d0.AddDays(3);
                var evTramo = eventos.Where(e =>
                {
                    var local = DateTime.SpecifyKind(e.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                    return local >= d0 && local < d1;
                }).ToList();
                var errTramo = erroresHost.Count(err =>
                {
                    var local = DateTime.SpecifyKind(err.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                    return local >= d0 && local < d1;
                });
                var alertas = evTramo.Count(e => e.Resultado is "Denegado" or "Error") + errTramo;
                var normales = evTramo.Count(e => e.Resultado == "Autorizado");
                salida.Add(new ActividadBucket($"{d0:dd/MM}-{d1.AddDays(-1):dd/MM}", $"{d0:dd/MM}", normales, alertas));
            }
            return salida;
        }

        for (int i = dias - 1; i >= 0; i--)
        {
            var dia = DateTime.Today.AddDays(-i);
            var sig = dia.AddDays(1);
            var evDia = eventos.Where(e =>
            {
                var local = DateTime.SpecifyKind(e.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                return local >= dia && local < sig;
            }).ToList();
            var errDia = erroresHost.Count(err =>
            {
                var local = DateTime.SpecifyKind(err.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                return local >= dia && local < sig;
            });
            var alertas = evDia.Count(e => e.Resultado is "Denegado" or "Error") + errDia;
            var normales = evDia.Count(e => e.Resultado == "Autorizado");
            salida.Add(new ActividadBucket(dia.ToString("dd/MM/yyyy"), dia.ToString("dd/MM"), normales, alertas));
        }

        return salida;
    }

    private List<AuditoriaBucket> ObtenerSeriesAuditoriaPorResultado(List<AuditoriaEventoDto> eventos, string periodo)
    {
        var salida = new List<AuditoriaBucket>();
        if (periodo == "todo" && eventos.Count > 0)
        {
            var grupos = eventos
                .GroupBy(e => DateTime.SpecifyKind(e.FechaUtc, DateTimeKind.Utc).ToLocalTime().Date)
                .OrderBy(g => g.Key)
                .TakeLast(12);
            foreach (var g in grupos)
            {
                salida.Add(new AuditoriaBucket(
                    g.Key.ToString("dd/MM/yyyy"),
                    g.Key.ToString("dd/MM"),
                    g.Count(x => x.Resultado == "Autorizado"),
                    g.Count(x => x.Resultado == "Denegado"),
                    g.Count(x => x.Resultado == "Error")));
            }
            return salida;
        }

        if (periodo == "24h")
        {
            var ahora = DateTime.Now;
            var inicio = new DateTime(ahora.Year, ahora.Month, ahora.Day, ahora.Hour, 0, 0).AddHours(-21);
            for (int i = 0; i < 8; i++)
            {
                var desde = inicio.AddHours(i * 3);
                var hasta = desde.AddHours(3);
                var ev = eventos.Where(e =>
                {
                    var local = DateTime.SpecifyKind(e.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                    return local >= desde && local < hasta;
                }).ToList();
                salida.Add(new AuditoriaBucket(
                    $"{desde:HH}:00-{hasta:HH}:00",
                    $"{desde:HH}h",
                    ev.Count(x => x.Resultado == "Autorizado"),
                    ev.Count(x => x.Resultado == "Denegado"),
                    ev.Count(x => x.Resultado == "Error")));
            }
            return salida;
        }

        if (periodo == "30d")
        {
            var dInicio = DateTime.Today.AddDays(-29);
            for (int i = 0; i < 10; i++)
            {
                var d0 = dInicio.AddDays(i * 3);
                var d1 = d0.AddDays(3);
                var ev = eventos.Where(e =>
                {
                    var local = DateTime.SpecifyKind(e.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                    return local >= d0 && local < d1;
                }).ToList();
                salida.Add(new AuditoriaBucket(
                    $"{d0:dd/MM}-{d1.AddDays(-1):dd/MM}",
                    $"{d0:dd/MM}",
                    ev.Count(x => x.Resultado == "Autorizado"),
                    ev.Count(x => x.Resultado == "Denegado"),
                    ev.Count(x => x.Resultado == "Error")));
            }
            return salida;
        }

        for (int i = 6; i >= 0; i--)
        {
            var dia = DateTime.Today.AddDays(-i);
            var sig = dia.AddDays(1);
            var ev = eventos.Where(e =>
            {
                var local = DateTime.SpecifyKind(e.FechaUtc, DateTimeKind.Utc).ToLocalTime();
                return local >= dia && local < sig;
            }).ToList();
            salida.Add(new AuditoriaBucket(
                dia.ToString("dd/MM/yyyy"),
                dia.ToString("dd/MM"),
                ev.Count(x => x.Resultado == "Autorizado"),
                ev.Count(x => x.Resultado == "Denegado"),
                ev.Count(x => x.Resultado == "Error")));
        }

        return salida;
    }

    private static List<(string Nombre, int Cantidad)> ObtenerDistribucionModulosAuditoria(List<AuditoriaEventoDto> eventos) =>
        eventos
            .GroupBy(e => string.IsNullOrWhiteSpace(e.Modulo) ? "Sistema" : e.Modulo.Trim())
            .Select(g => (Nombre: g.Key, Cantidad: g.Count()))
            .OrderByDescending(x => x.Cantidad)
            .ToList();

    private static string EtiquetaPeriodo(string periodo) => periodo switch
    {
        "24h" => "Últimas 24 horas",
        "7d" => "Últimos 7 días",
        "30d" => "Últimos 30 días",
        _ => "Historial completo"
    };

