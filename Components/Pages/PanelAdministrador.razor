@page "/panel-administrador"
@page "/panel-administrador/{Seccion}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Administrador,Admin")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Asoagro.Models
@using Asoagro.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IAsociadoService AsociadoService
@inject IDocumentoAsociacionService DocumentoService
@inject IFinanzasService FinanzasService
@inject IPuntoVentaService PuntoVentaService
@inject ISeguimientoAsociadoService SeguimientoService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Panel Administrador · Supervisión General ASOAGRO</PageTitle>

<div class="container-fluid px-0 pb-5" style="font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">
    <!-- ENCABEZADO HERO DE SUPERVISIÓN ADMINISTRATIVA -->
    <div class="card aso-hero-card mb-4" style="border-top: 4px solid #10B981 !important;">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="aso-hero-icon-box" style="background: #10B981 !important; border: 1.5px solid #34D399 !important; color: #FFFFFF !important;">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="aso-hero-kicker" style="background: #065F46 !important; border-color: #34D399 !important; color: #ECFDF5 !important;">
                                <i class="bi bi-shield-lock me-1"></i> Supervisión Central ASOAGRO
                            </span>
                            <span class="badge px-2.5 py-1 rounded-pill fw-bold bg-success bg-opacity-75" style="font-size: 0.7rem;">
                                <i class="bi bi-check-circle me-1"></i> Rol Administrador
                            </span>
                        </div>
                        <h1 class="aso-hero-title">Panel de Supervisión Administrativa</h1>
                        <p class="aso-hero-desc">
                            Monitoreo integral y supervisión del funcionamiento de ASOAGRO en sus áreas operativa (Secretaría), financiera (Tesorería) y de gobernanza (Presidencia).
                        </p>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-4 d-inline-block text-start w-100" style="min-width: 280px; max-width: 320px; background: rgba(255, 255, 255, 0.08); border: 1.5px solid rgba(255, 255, 255, 0.18); backdrop-filter: blur(10px);">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 42px; height: 42px; background: #059669; box-shadow: 0 4px 10px rgba(0,0,0,0.25);">
                                <i class="bi bi-person-gear fs-5"></i>
                            </div>
                            <div>
                                <span class="d-block text-white-50" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Administrador en Sesión</span>
                                <span class="fw-bold text-white small d-block text-truncate" style="max-width: 210px;">@nombreUsuario</span>
                                <span class="badge bg-white text-dark mt-1" style="font-size: 0.65rem; font-weight: 700;">@correoUsuario</span>
                            </div>
                        </div>
                        <div class="pt-2 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center" style="font-size: 0.72rem;">
                            <span class="text-white-50">Nivel de Supervisión:</span>
                            <span class="fw-bold text-white">Supervisión sin alteración de datos</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- NAVEGACIÓN PRINCIPAL DEL ADMINISTRADOR -->
    <div class="d-flex flex-wrap gap-2 mb-4 border-bottom pb-2">
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(seccionActiva == "supervision" ? "btn-success" : "btn-light text-muted border")"
                style="@(seccionActiva == "supervision" ? "background-color: #14532D; border: 1.5px solid #14532D; color: #FFFFFF;" : "background: #FFFFFF; border: 1.5px solid #D5E2D8; color: #4B6A5A;")"
                @onclick='@(() => seccionActiva = "supervision")'>
            <i class="bi bi-speedometer2 me-1"></i> 1. Supervisión y KPIs Generales
        </button>
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(seccionActiva == "usuarios" ? "btn-success" : "btn-light text-muted border")"
                style="@(seccionActiva == "usuarios" ? "background-color: #14532D; border: 1.5px solid #14532D; color: #FFFFFF;" : "background: #FFFFFF; border: 1.5px solid #D5E2D8; color: #4B6A5A;")"
                @onclick='@(() => seccionActiva = "usuarios")'>
            <i class="bi bi-people-fill me-1"></i> 2. Usuarios, Roles y Permisos
            <span class="badge bg-white text-dark ms-1">5</span>
        </button>
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(seccionActiva == "auditoria" ? "btn-success" : "btn-light text-muted border")"
                style="@(seccionActiva == "auditoria" ? "background-color: #14532D; border: 1.5px solid #14532D; color: #FFFFFF;" : "background: #FFFFFF; border: 1.5px solid #D5E2D8; color: #4B6A5A;")"
                @onclick='@(() => seccionActiva = "auditoria")'>
            <i class="bi bi-shield-shaded me-1"></i> 3. Auditoría de Accesos
        </button>
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(seccionActiva == "catalogos" ? "btn-success" : "btn-light text-muted border")"
                style="@(seccionActiva == "catalogos" ? "background-color: #14532D; border: 1.5px solid #14532D; color: #FFFFFF;" : "background: #FFFFFF; border: 1.5px solid #D5E2D8; color: #4B6A5A;")"
                @onclick='@(() => seccionActiva = "catalogos")'>
            <i class="bi bi-sliders me-1"></i> 4. Catálogos y Parámetros
        </button>
    </div>

    @if (seccionActiva == "supervision")
    {
        <!-- SELECTOR DE FILTRO POR ASOCIACIÓN -->
        <div class="adm-filter-bar">
            <div class="adm-filter-label">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3" />
                </svg>
                <span>Filtrar supervisión por asociación:</span>
            </div>
            <div class="adm-filter-control">
                <select class="adm-select" @bind="filtroAsociacion" @bind:after="ActualizarMetricas">
                    <option value="">Todas las asociaciones federadas</option>
                    @foreach (var asoc in listaAsociaciones)
                    {
                        <option value="@asoc">@asoc</option>
                    }
                </select>
            </div>
            @if (!string.IsNullOrEmpty(filtroAsociacion))
            {
                <button type="button" class="adm-btn-clear" @onclick="LimpiarFiltroAsociacion">
                    Restablecer todas
                </button>
            }
        </div>

    <!-- TARJETAS DE MÉTRICAS EJECUTIVAS -->
    <section class="adm-kpi-grid">
        <!-- 1. Productores y Asociados -->
        <article class="adm-kpi-card">
            <div class="adm-kpi-header">
                <span class="adm-kpi-icon adm-kpi-icon-green">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="9" cy="8" r="4" />
                        <path d="M2 21c0-4 3.1-7 7-7s7 3 7 7" />
                        <circle cx="19" cy="11" r="3" />
                        <path d="M16 21c0-2.5 2-4.5 4.5-4.5" />
                    </svg>
                </span>
                <span class="adm-kpi-tag">Secretaría</span>
            </div>
            <div class="adm-kpi-body">
                <span class="adm-kpi-value">@conteoProductores</span>
                <h3 class="adm-kpi-title">Productores y Asociados</h3>
                <p class="adm-kpi-desc">Padrón de familias agricultoras registradas</p>
            </div>
            <ul class="adm-kpi-details">
                <li>
                    <span>Vinculados con asociación</span>
                    <strong>@conteoAsociadosVinculados</strong>
                </li>
                <li>
                    <span>Pendientes de asignar</span>
                    <strong class="@(conteoAsociadosPendientes > 0 ? "text-warning-emphasis" : "")">@conteoAsociadosPendientes</strong>
                </li>
                <li>
                    <span>Con BPA vigente</span>
                    <strong>@conteoProductoresBpa</strong>
                </li>
            </ul>
            <a href="/consultar-asociados" class="adm-kpi-link">
                <span>Supervisar asociados</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </article>

        <!-- 2. Expedientes y Documentación -->
        <article class="adm-kpi-card">
            <div class="adm-kpi-header">
                <span class="adm-kpi-icon adm-kpi-icon-blue">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                </span>
                <span class="adm-kpi-tag">Secretaría</span>
            </div>
            <div class="adm-kpi-body">
                <span class="adm-kpi-value">@conteoDocumentos</span>
                <h3 class="adm-kpi-title">Documentos Institucionales</h3>
                <p class="adm-kpi-desc">Expedientes legales de las organizaciones</p>
            </div>
            <ul class="adm-kpi-details">
                <li>
                    <span>Vigentes</span>
                    <strong>@conteoDocumentosVigentes</strong>
                </li>
                <li>
                    <span>Por vencer (≤30 días)</span>
                    <strong class="@(conteoDocumentosPorVencer > 0 ? "text-warning-emphasis" : "")">@conteoDocumentosPorVencer</strong>
                </li>
                <li>
                    <span>Vencidos</span>
                    <strong class="@(conteoDocumentosVencidos > 0 ? "text-danger" : "")">@conteoDocumentosVencidos</strong>
                </li>
            </ul>
            <a href="/consultar-estado-documentos" class="adm-kpi-link">
                <span>Supervisar documentación</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </article>

        <!-- 3. Tesorería y Finanzas -->
        <article class="adm-kpi-card">
            <div class="adm-kpi-header">
                <span class="adm-kpi-icon adm-kpi-icon-emerald">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="5" width="20" height="14" rx="2" />
                        <line x1="2" y1="10" x2="22" y2="10" />
                    </svg>
                </span>
                <span class="adm-kpi-tag">Tesorería</span>
            </div>
            <div class="adm-kpi-body">
                <span class="adm-kpi-value">@totalSaldoDisponible.ToString("C0")</span>
                <h3 class="adm-kpi-title">Saldo Disponible Consolidado</h3>
                <p class="adm-kpi-desc">Balance neto entre ingresos y costos</p>
            </div>
            <ul class="adm-kpi-details">
                <li>
                    <span>Ingresos registrados</span>
                    <strong>@totalIngresos.ToString("C0")</strong>
                </li>
                <li>
                    <span>Costos y gastos</span>
                    <strong>@totalCostos.ToString("C0")</strong>
                </li>
                <li>
                    <span>Cuentas por cobrar</span>
                    <strong>@totalPorCobrar.ToString("C0")</strong>
                </li>
            </ul>
            <a href="/gestion-financiera/resumen" class="adm-kpi-link">
                <span>Supervisar finanzas</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </article>

        <!-- 4. Seguimiento Asociativo -->
        <article class="adm-kpi-card">
            <div class="adm-kpi-header">
                <span class="adm-kpi-icon adm-kpi-icon-amber">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22v-9" />
                        <path d="M12 13C12 7.5 7.5 4 2 4c0 5.5 3.5 10 10 10z" />
                        <path d="M12 13c0-5.5 4.5-9 10-9 0 5.5-3.5 10-10 10z" />
                    </svg>
                </span>
                <span class="adm-kpi-tag">Secretaría</span>
            </div>
            <div class="adm-kpi-body">
                <span class="adm-kpi-value">@conteoSeguimientos</span>
                <h3 class="adm-kpi-title">Encuentros y Gestiones</h3>
                <p class="adm-kpi-desc">Reuniones y acuerdos con productores</p>
            </div>
            <ul class="adm-kpi-details">
                <li>
                    <span>Próximas reuniones</span>
                    <strong>@conteoProximosEncuentros</strong>
                </li>
                <li>
                    <span>Asociados con seguimiento</span>
                    <strong>@conteoProductoresConSeguimiento</strong>
                </li>
                <li>
                    <span>Alertas de atención</span>
                    <strong>@conteoAlertasDocumento</strong>
                </li>
            </ul>
            <a href="/seguimiento-asociados" class="adm-kpi-link">
                <span>Supervisar encuentros</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </article>
    </section>

    <!-- CENTRAL DE MÓDULOS DE SUPERVISIÓN -->
    <section class="adm-hub-section">
        <div class="adm-section-header">
            <div>
                <h2>Módulos y Paneles Disponibles para Supervisión</h2>
                <p>Accede de forma directa a consultar cada módulo institucional con permisos de auditoría y revisión.</p>
            </div>
            <span class="adm-tag-supervision">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
                Supervisión de solo lectura
            </span>
        </div>

        <div class="adm-hub-grid">
            <!-- 1. Consultar asociados -->
            <a href="/consultar-asociados" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="3" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="3" width="7" height="7" rx="1.5" />
                        <rect x="14" y="14" width="7" height="7" rx="1.5" />
                        <rect x="3" y="14" width="7" height="7" rx="1.5" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Directorio de Asociados</h3>
                        <span class="adm-badge-source">Secretaría</span>
                    </div>
                    <p>Revisa el padrón completo, predios rurales, cultivos y relaciones asociativas.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <!-- 2. Seguimiento de asociados -->
            <a href="/seguimiento-asociados" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 22v-9" />
                        <path d="M12 13C12 7.5 7.5 4 2 4c0 5.5 3.5 10 10 10z" />
                        <path d="M12 13c0-5.5 4.5-9 10-9 0 5.5-3.5 10-10 10z" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Seguimiento y Encuentros</h3>
                        <span class="adm-badge-source">Secretaría</span>
                    </div>
                    <p>Audita las reuniones, notas de campo, asesorías técnicas y acuerdos registrados.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <!-- 3. Estado de documentación -->
            <a href="/consultar-estado-documentos" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Expedientes Documentales</h3>
                        <span class="adm-badge-source">Secretaría</span>
                    </div>
                    <p>Consulta RUT, Cámara de Comercio, estatutos y resoluciones de las asociaciones.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <!-- 4. Alertas de documentos -->
            <a href="/alertas-documentos" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Alertas de Vencimiento</h3>
                        <span class="adm-badge-source">Secretaría</span>
                    </div>
                    <p>Supervisa plazos legales y documentos próximos a vencer para evitar pérdida de vigencia.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <!-- 5. Resumen Financiero -->
            <a href="/gestion-financiera/resumen" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21.21 15.89A10 10 0 1 1 8 2.83" />
                        <path d="M22 12A10 10 0 0 0 12 2v10z" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Resumen Financiero</h3>
                        <span class="adm-badge-source">Tesorería</span>
                    </div>
                    <p>Audita los ingresos, egresos y comprobantes contables sin modificar las cuentas.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <!-- 6. Reportes y Balances -->
            <a href="/gestion-financiera/reportes-balances" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Reportes y Balances</h3>
                        <span class="adm-badge-source">Tesorería</span>
                    </div>
                    <p>Descarga estados consolidados y reportes oficiales en formato PDF o Excel.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <!-- 7. Repositorio de Actas -->
            <a href="/actas-estatutos/documentos" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Repositorio de Actas y Estatutos</h3>
                        <span class="adm-badge-source">Presidencia</span>
                    </div>
                    <p>Inspecciona las actas de asamblea, estatutos vigentes y decisiones de junta directiva.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <!-- 8. Historial de Actividad -->
            <a href="/actas-estatutos/historial" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 16 14" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Historial de Actividad</h3>
                        <span class="adm-badge-source">Presidencia</span>
                    </div>
                    <p>Auditoría cronológica de las acciones institucionales registradas en el sistema.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
                    <i class="bi bi-arrow-right"></i>
                </div>
            </a>

            <!-- 9. Directorio de Asociaciones Base -->
            <a href="/asociaciones" class="adm-hub-card">
                <div class="adm-hub-card-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 21h18M3 7v14M21 7v14M6 7V3h12v4M9 11h2M9 15h2M13 11h2M13 15h2" />
                    </svg>
                </div>
                <div class="adm-hub-card-body">
                    <div class="adm-hub-card-top">
                        <h3>Directorio de Asociaciones</h3>
                        <span class="adm-badge-source">Secretaría</span>
                    </div>
                    <p>Fichas institucionales de las entidades federadas: personerías, RUES, juntas directivas y sedes.</p>
                </div>
                <div class="adm-hub-card-footer">
                    <span>Abrir módulo</span>
