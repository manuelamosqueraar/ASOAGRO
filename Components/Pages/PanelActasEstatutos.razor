                        <h4 class="fw-bold text-success mb-0 fs-4">@totalAsociadosProductores</h4>
                        <small class="text-muted">En las asociaciones federadas</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="d-block small text-muted text-uppercase fw-bold">Modo de Consulta</span>
                        <h4 class="fw-bold text-purple mb-0 fs-4" style="color: #7c3aed;">Directivo</h4>
                        <small class="text-muted">Supervisión y control de acuerdos</small>
                    </div>
                </div>
            </div>

            <!-- LISTA DE ENCUENTROS Y ACUERDOS RECIENTES -->
            <h6 class="fw-bold text-dark mb-2" style="font-size: 0.85rem;">Encuentros y Acuerdos de Gestión Recientes:</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.8rem;">
                    <thead class="table-light">
