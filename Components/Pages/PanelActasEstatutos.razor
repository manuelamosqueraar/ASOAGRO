                                </td>
                                <td class="text-center">
                                    <span class="badge @(mov.Estado == EstadosMovimientoFinanciero.Validado ? "bg-success" : mov.Estado == EstadosMovimientoFinanciero.Pagado ? "bg-info" : "bg-warning text-dark")">
                                        @mov.Estado
                                    </span>
