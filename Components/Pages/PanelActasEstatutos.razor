    <!-- ======================================================== -->
    <!-- ESPACIO 5: SEGUIMIENTO DE GESTIÓN Y METAS                 -->
    <!-- ======================================================== -->
    @if (pestanaActiva == "gestion")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-bullseye text-success me-1"></i> Seguimiento de Gestión y Metas Asociativas
                    </h5>
                    <small class="text-muted">Consulta de actividades, atenciones en territorio y acuerdos tomados con productores</small>
                </div>
                <a href="/seguimiento-asociados" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-people me-1"></i> Abrir Bitácora de Seguimiento Completa
                </a>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
