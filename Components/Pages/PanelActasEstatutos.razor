                    </div>
                </div>
            </div>

            <!-- ÚLTIMOS MOVIMIENTOS CONTABLES EN MODO LECTURA -->
            <h6 class="fw-bold text-dark mb-2" style="font-size: 0.85rem;">Partidas Contables Recientes de las Asociaciones:</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.8rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Referencia</th>
                            <th>Asociación</th>
                            <th>Concepto</th>
                            <th>Monto</th>
                            <th class="text-center">Estado</th>
                            <th>Fecha</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var mov in movimientosFinancieros.Take(6))
