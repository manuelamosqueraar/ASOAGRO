                    <div class="p-3 bg-light rounded-3 border">
                        <span class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Cuentas por Cobrar</span>
                        <h4 class="fw-bold text-warning mb-0 fs-5">$ @resumenFinanciero.TotalCuentasPorCobrar.ToString("N0") COP</h4>
                        <small class="text-muted" style="font-size: 0.72rem;">Ventas por recaudar</small>
                    </div>
                </div>
                <div class="col-sm-6 col-xl">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Cuentas por Pagar</span>
                        <h4 class="fw-bold text-info mb-0 fs-5">$ @resumenFinanciero.TotalCuentasPorPagar.ToString("N0") COP</h4>
                        <small class="text-muted" style="font-size: 0.72rem;">Obligaciones pendientes</small>
                    </div>
                </div>
                <div class="col-sm-6 col-xl">
                    <div class="p-3 bg-light rounded-3 border" style="border-left: 3px solid #166534 !important;">
                        <span class="d-block small text-muted text-uppercase fw-bold" style="font-size: 0.68rem;">Saldo Líquido</span>
                        <h4 class="fw-bold @(resumenFinanciero.SaldoNetoCalculable >= 0 ? "text-success" : "text-danger") mb-0 fs-5">
                            $ @resumenFinanciero.SaldoNetoCalculable.ToString("N0") COP
