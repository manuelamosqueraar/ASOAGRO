                    <thead class="table-light">
                        <tr>
                            <th>Fecha y Hora</th>
                            <th>Documento</th>
                            <th>Usuario Responsable</th>
                            <th>Acción</th>
                            <th>Detalle</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var act in historialActividades.Take(10))
                        {
                            <tr>
                                <td class="fw-bold text-dark">@act.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>@act.CodigoDocumento - @act.TituloDocumento</td>
                                <td><span class="badge bg-light text-dark border">@act.Usuario</span></td>
                                <td>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        @act.Accion
                                    </span>
                                </td>
                                <td class="text-muted small">@act.Detalle</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    private string nombrePresidente = "Juan Diego Padilla Moreno";
    private string correoPresidente = "juan.padillamo@amigo.edu.co";
    private string rolUsuario = "Presidente";

    private string pestanaActiva = "resumen";
    private string filtroAsociacion = "";

    private List<string> listaAsociaciones = new();
    private List<DocumentoInstitucional> documentosInstitucionales = new();
    private List<AlertaDocumento> alertasPrioritarias = new();
    private List<CompromisoActa> todosCompromisos = new();
    private List<SeguimientoAsociado> ultimosSeguimientos = new();
    private List<MovimientoFinanciero> movimientosFinancieros = new();
    private List<ItemHistorialActividad> historialActividades = new();

    private ResumenFinanciero resumenFinanciero = new();

    private int totalAsociadosProductores = 0;
    private int totalAsociadosAlDia = 0;
    private int totalDocumentosAsociacion = 0;
    private int totalAlertasActivas = 0;
    private int totalAlertasCriticas = 0;
    private int totalCompromisosActas = 0;
    private int totalCompromisosPendientes = 0;
    private int totalEncuentros = 0;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        nombrePresidente = user.Identity?.Name 
            ?? user.FindFirst(ClaimTypes.Name)?.Value 
            ?? "Juan Diego Padilla Moreno";

        correoPresidente = user.FindFirst(ClaimTypes.Email)?.Value 
            ?? "juan.padillamo@amigo.edu.co";

        rolUsuario = user.IsInRole("Presidenta") ? "Presidenta" :
                     user.IsInRole("Presidente") ? "Presidente" : "Presidente";

        await CargarDatosCompletos();
    }

    private async Task CargarDatosCompletos()
    {
        // 1. Asociaciones disponibles
        listaAsociaciones = DocumentoAsociacionService.ObtenerAsociaciones().ToList();

        // 2. Documentos institucionales y actas
        documentosInstitucionales = DocumentoService.ObtenerTodos().ToList();
        todosCompromisos = documentosInstitucionales.SelectMany(d => d.Compromisos).ToList();
        totalCompromisosActas = todosCompromisos.Count;
        totalCompromisosPendientes = todosCompromisos.Count(c => c.Estado != "Cumplido");

        // 3. Asociados de base
        var asociados = AsociadoService.ObtenerTodos();
        totalAsociadosProductores = asociados.Count;
        totalAsociadosAlDia = asociados.Count(a => a.EstadoMembresia == "AlDia");

        // 4. Expedientes y alertas documentales
        var docsAsoc = DocumentoAsociacionService.ObtenerTodos();
        totalDocumentosAsociacion = docsAsoc.Count;

        var alertas = AlertaService.ObtenerAlertasPendientes(DateTime.Today).ToList();
        alertasPrioritarias = alertas;
        totalAlertasActivas = alertas.Count;
        totalAlertasCriticas = alertas.Count(a => a.DiasRestantes <= 7);

        // 5. Finanzas en modo consulta
        var asocParam = string.IsNullOrWhiteSpace(filtroAsociacion) ? null : filtroAsociacion;
        resumenFinanciero = FinanzasService.ObtenerResumen(asocParam);
        movimientosFinancieros = FinanzasService.ObtenerTodos(asocParam).ToList();

        // 6. Seguimiento de gestión
        ultimosSeguimientos = SeguimientoService.ObtenerTodos().ToList();
        totalEncuentros = ultimosSeguimientos.Count;

        // 7. Historial de actividad
        historialActividades = DocumentoService.ObtenerHistorialGlobal().ToList();

        await Task.CompletedTask;
    }

    private async Task ActualizarDatosFiltro()
    {
        var asocParam = string.IsNullOrWhiteSpace(filtroAsociacion) ? null : filtroAsociacion;
        resumenFinanciero = FinanzasService.ObtenerResumen(asocParam);
        movimientosFinancieros = FinanzasService.ObtenerTodos(asocParam).ToList();
        await Task.CompletedTask;
    }
}
