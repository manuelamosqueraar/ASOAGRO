@page "/actas-estatutos"
@page "/presidencia"
@page "/panel-presidencia"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Presidenta,Presidente")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Asoagro.Models
@using Asoagro.Services
@inject IDocumentoInstitucionalService DocumentoService
@inject IDocumentoAsociacionService DocumentoAsociacionService
@inject IAlertaDocumentoService AlertaService
@inject IFinanzasService FinanzasService
@inject IAsociadoService AsociadoService
@inject ISeguimientoAsociadoService SeguimientoService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>Panel de Presidencia · Supervisión y Consulta Directiva · FAAUA</PageTitle>

<div class="container-fluid px-0 pb-5" style="font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <!-- HERO BANNER DE PRESIDENCIA -->
    <div class="p-4 p-md-5 mb-4 position-relative overflow-hidden rounded-4 text-white" 
         style="background: linear-gradient(135deg, #092615 0%, #114224 50%, #1e4d2b 100%); box-shadow: 0 10px 25px -5px rgba(17, 66, 36, 0.4);">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="badge px-3 py-1.5 rounded-pill fw-bold" style="background: rgba(255, 255, 255, 0.95); color: #114224; font-size: 0.75rem;">
                        <i class="bi bi-shield-check me-1"></i> Federación FAAUA · Urabá Antioqueño
                    </span>
                    <span class="badge px-3 py-1.5 rounded-pill fw-bold" style="background: rgba(124, 58, 237, 0.3); color: #ede9fe; border: 1px solid rgba(167, 139, 250, 0.4); font-size: 0.75rem;">
                        <i class="bi bi-person-workspace me-1"></i> Supervisión y Consulta Directiva
                    </span>
                    <span class="badge px-3 py-1.5 rounded-pill fw-bold bg-success bg-opacity-75" style="font-size: 0.75rem;">
                        <i class="bi bi-check-circle me-1"></i> Gobernanza Activa
                    </span>
                </div>
                <h1 class="fw-bolder mb-2 text-white" style="font-size: 1.85rem; letter-spacing: -0.02em;">
                    Panel de Presidencia y Gobernanza Directiva
                </h1>
                <p class="text-white-50 mb-0 small" style="max-width: 720px; line-height: 1.6;">
                    Espacio central de supervisión estratégica, consulta de expedientes institucionales, seguimiento de acuerdos asamblearios, monitoreo contable de base y trazabilidad de compromisos para las asociaciones federadas de base.
                </p>
            </div>

            <div class="col-lg-4 mt-4 mt-lg-0 text-lg-end">
                <div class="p-3 rounded-4 d-inline-block text-start w-100" style="max-width: 310px; background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.15); backdrop-filter: blur(10px);">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 42px; height: 42px; background: #7c3aed; box-shadow: 0 4px 10px rgba(0,0,0,0.25);">
                            <i class="bi bi-person-fill-check fs-5"></i>
                        </div>
                        <div>
                            <span class="d-block text-white-50" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Dignatario en Sesión</span>
                            <span class="fw-bold text-white small d-block text-truncate" style="max-width: 210px;">@nombrePresidente</span>
                            <span class="badge bg-white text-dark mt-1" style="font-size: 0.65rem; font-weight: 700;">@rolUsuario (FAAUA)</span>
                        </div>
                    </div>
                    <div class="pt-2 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center" style="font-size: 0.72rem;">
                        <span class="text-white-50">Nivel de Acceso:</span>
                        <span class="fw-bold text-white">Supervisión y Lectura Integral</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- BANNER DE ALCANCE DIRECTIVO: SOLO LECTURA Y SEGUIMIENTO -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4" style="border-left: 5px solid #7c3aed !important;">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 rounded-3 bg-purple-subtle text-purple d-flex align-items-center justify-content-center" style="background-color: #f5f3ff; color: #7c3aed; width: 40px; height: 40px;">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-dark mb-0 fs-6">Marco de Autorización Directiva · Presidencia</h6>
                    <small class="text-muted">
                        Presidencia cuenta con acceso irrestricto de consulta, supervisión y auditoría en todas las asociaciones asignadas. Las operaciones financieras y de registro administrativo se gestionan en sus módulos fuente correspondientes sin duplicar controles.
                    </small>
                </div>
            </div>
            <div class="d-flex gap-2">
                <a href="/consultar-estado-documentos" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold">
                    <i class="bi bi-folder-check me-1"></i> Expedientes
                </a>
                <a href="/panel-tesorero" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-semibold">
                    <i class="bi bi-bank me-1"></i> Tesorería
                </a>
            </div>
        </div>
    </div>

    <!-- SELECTOR DE ASOCIACIÓN ASIGNADA -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <div class="row align-items-center g-3">
            <div class="col-md-5">
                <label class="form-label text-muted small fw-bold mb-1" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;">
                    <i class="bi bi-building text-success me-1"></i> Entidad o Asociación a Supervisar
                </label>
                <select class="form-select form-select-sm rounded-3 border-light-subtle shadow-none" @bind="filtroAsociacion" @bind:after="ActualizarDatosFiltro">
                    <option value="">-- Todas las Asociaciones Federadas (FAAUA Consolidado) --</option>
                    @foreach (var asoc in listaAsociaciones)
                    {
                        <option value="@asoc">@asoc</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold mb-1" style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.05em;">
                    <i class="bi bi-calendar-check text-success me-1"></i> Periodo de Corte Directivo
                </label>
                <input type="text" class="form-control form-control-sm bg-light" readonly value="@DateTime.Now.ToString("MMMM yyyy").ToUpperInvariant()" />
            </div>
            <div class="col-md-3 text-md-end mt-3 mt-md-0">
                <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 fw-semibold shadow-none" @onclick="CargarDatosCompletos">
                    <i class="bi bi-arrow-clockwise me-1"></i> Sincronizar
                </button>
            </div>
        </div>
    </div>

    <!-- PESTAÑAS PRINCIPALES DE LOS 6 ESPACIOS DIRECTIVOS -->
    <div class="d-flex flex-wrap gap-2 mb-4 border-bottom pb-2">
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(pestanaActiva == "resumen" ? "btn-success" : "btn-light text-muted border")"
                style="@(pestanaActiva == "resumen" ? "background-color: #114224; border-color: #114224;" : "")"
                @onclick="@(() => pestanaActiva = "resumen")">
            <i class="bi bi-grid-1x2-fill me-1"></i> 1. Resumen de Presidencia
        </button>
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(pestanaActiva == "centro" ? "btn-success" : "btn-light text-muted border")"
                style="@(pestanaActiva == "centro" ? "background-color: #114224; border-color: #114224;" : "")"
                @onclick="@(() => pestanaActiva = "centro")">
            <i class="bi bi-file-earmark-check-fill me-1"></i> 2. Centro Documental
            <span class="badge bg-white text-dark ms-1">@totalDocumentosAsociacion</span>
        </button>
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(pestanaActiva == "actas" ? "btn-success" : "btn-light text-muted border")"
                style="@(pestanaActiva == "actas" ? "background-color: #114224; border-color: #114224;" : "")"
                @onclick="@(() => pestanaActiva = "actas")">
            <i class="bi bi-journal-bookmark-fill me-1"></i> 3. Repositorio de Actas y Compromisos
            <span class="badge bg-white text-dark ms-1">@documentosInstitucionales.Count</span>
        </button>
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(pestanaActiva == "finanzas" ? "btn-success" : "btn-light text-muted border")"
                style="@(pestanaActiva == "finanzas" ? "background-color: #114224; border-color: #114224;" : "")"
                @onclick="@(() => pestanaActiva = "finanzas")">
            <i class="bi bi-currency-dollar me-1"></i> 4. Resumen Financiero
        </button>
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(pestanaActiva == "gestion" ? "btn-success" : "btn-light text-muted border")"
                style="@(pestanaActiva == "gestion" ? "background-color: #114224; border-color: #114224;" : "")"
                @onclick="@(() => pestanaActiva = "gestion")">
            <i class="bi bi-bullseye me-1"></i> 5. Seguimiento de Gestión
            <span class="badge bg-white text-dark ms-1">@totalEncuentros</span>
        </button>
        <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-bold transition-all @(pestanaActiva == "historial" ? "btn-success" : "btn-light text-muted border")"
                style="@(pestanaActiva == "historial" ? "background-color: #114224; border-color: #114224;" : "")"
                @onclick="@(() => pestanaActiva = "historial")">
            <i class="bi bi-clock-history me-1"></i> 6. Historial de Actividad
        </button>
    </div>

    <!-- ======================================================== -->
    <!-- ESPACIO 1: RESUMEN DE PRESIDENCIA (PANORAMA Y ASUNTOS)   -->
    <!-- ======================================================== -->
    @if (pestanaActiva == "resumen")
    {
        <!-- TARJETAS DE INDICADORES REALES -->
        <div class="row g-3 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.05em;">Asociaciones Federadas</span>
                        <span class="p-2 rounded-3 bg-primary-subtle text-primary">
                            <i class="bi bi-buildings fs-5"></i>
                        </span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="fw-bold text-dark mb-0 fs-3">@listaAsociaciones.Count</h2>
                        <span class="text-muted small">entidades base</span>
                    </div>
                    <span class="text-primary small mt-2 d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                        <i class="bi bi-diagram-3-fill"></i> Urabá Antioqueño
                    </span>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.05em;">Productores Asociados</span>
                        <span class="p-2 rounded-3 bg-success-subtle text-success">
                            <i class="bi bi-people-fill fs-5"></i>
                        </span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="fw-bold text-dark mb-0 fs-3">@totalAsociadosProductores</h2>
                        <span class="text-muted small">integrantes</span>
                    </div>
                    <span class="text-success small mt-2 d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                        <i class="bi bi-check-circle-fill"></i> @totalAsociadosAlDia al día con cuotas
                    </span>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.05em;">Alertas de Vencimiento</span>
                        <span class="p-2 rounded-3 @(totalAlertasCriticas > 0 ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning")">
                            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                        </span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="fw-bold text-dark mb-0 fs-3">@totalAlertasActivas</h2>
                        <span class="text-muted small">documentos en umbral</span>
                    </div>
                    <span class="@(totalAlertasCriticas > 0 ? "text-danger" : "text-muted") small mt-2 d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                        <i class="bi bi-bell-fill"></i> @totalAlertasCriticas críticas (≤ 7 días)
                    </span>
                </div>
            </div>

            <div class="col-sm-6 col-xl-3">
                <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.68rem; letter-spacing: 0.05em;">Compromisos de Actas</span>
                        <span class="p-2 rounded-3 bg-info-subtle text-info">
                            <i class="bi bi-list-task fs-5"></i>
                        </span>
                    </div>
                    <div class="d-flex align-items-baseline gap-2">
                        <h2 class="fw-bold text-dark mb-0 fs-3">@totalCompromisosActas</h2>
                        <span class="text-muted small">acuerdos vigentes</span>
                    </div>
                    <span class="text-info small mt-2 d-flex align-items-center gap-1" style="font-size: 0.75rem;">
                        <i class="bi bi-hourglass-split"></i> @totalCompromisosPendientes en seguimiento
                    </span>
                </div>
            </div>
        </div>

        <!-- ASUNTOS PENDIENTES Y ALERTAS PRIORITARIAS -->
        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0 fs-6">
                            <i class="bi bi-exclamation-triangle text-warning me-1"></i> Asuntos Pendientes y Alertas de Vencimiento
                        </h5>
                        <a href="/alertas-documentos" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold" style="font-size: 0.72rem;">
                            Ver todas las alertas &rarr;
                        </a>
                    </div>

                    @if (alertasPrioritarias.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var alerta in alertasPrioritarias.Take(5))
                            {
                                <div class="list-group-item px-0 py-2.5 border-light-subtle d-flex justify-content-between align-items-center">
                                    <div class="me-2">
                                        <div class="fw-bold text-dark small">@alerta.TipoDocumento</div>
                                        <small class="text-muted">@alerta.NombreAsociado</small>
                                        <div class="small text-muted" style="font-size: 0.72rem;">
                                            Vence: <strong>@alerta.FechaVencimiento.ToString("dd/MM/yyyy")</strong>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        @if (alerta.DiasRestantes < 0)
                                        {
                                            <span class="badge bg-danger rounded-pill px-2.5 py-1">Vencido</span>
                                        }
                                        else if (alerta.DiasRestantes <= 7)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5 py-1">
                                                Crítica · @alerta.DiasRestantes días
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2.5 py-1">
                                                Preventiva · @alerta.DiasRestantes días
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-shield-check text-success fs-2 d-block mb-1"></i>
                            <span class="small">No hay alertas críticas de vencimiento en las asociaciones asignadas.</span>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold text-dark mb-0 fs-6">
                            <i class="bi bi-calendar-event text-primary me-1"></i> Compromisos Derivados de Actas
                        </h5>
                        <button class="btn btn-link text-success p-0 fw-bold small text-decoration-none" @onclick="@(() => pestanaActiva = "actas")">
                            Ver detalle
                        </button>
                    </div>

                    @if (todosCompromisos.Any())
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var comp in todosCompromisos.Take(4))
                            {
                                <div class="list-group-item px-0 py-2 border-light-subtle">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge @(comp.Estado == "Cumplido" ? "bg-success" : comp.Estado == "Atrasado" ? "bg-danger" : "bg-warning text-dark")" style="font-size: 0.65rem;">
                                            @comp.Estado
                                        </span>
                                        <small class="text-muted" style="font-size: 0.7rem;">Límite: @comp.FechaLimite.ToString("dd/MM/yyyy")</small>
                                    </div>
                                    <div class="fw-semibold text-dark small" style="line-height: 1.3;">@comp.Descripcion</div>
                                    <small class="text-muted d-block mt-0.5">Responsable: @comp.Responsable</small>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-check2-all text-muted fs-3 d-block mb-1"></i>
                            <span class="small">No hay compromisos pendientes derivados de actas.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- PANORAMA DE LAS ASOCIACIONES FEDERADAS BASE -->
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
            <h5 class="fw-bold text-dark mb-3 fs-6">
                <i class="bi bi-diagram-3 text-success me-1"></i> Panorama de las Asociaciones Asignadas a FAAUA
            </h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                    <thead style="background-color: #114224; color: white;">
                        <tr>
                            <th class="py-2.5 ps-3 text-white fw-bold">Asociación Titular</th>
                            <th class="py-2.5 text-white fw-bold">NIT</th>
                            <th class="py-2.5 text-white fw-bold">Sede / Municipio</th>
                            <th class="py-2.5 text-white fw-bold text-center">Estado Documental</th>
                            <th class="py-2.5 text-white fw-bold text-center">Nivel de Alerta</th>
                            <th class="py-2.5 pe-3 text-white fw-bold text-end">Expediente</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var asoc in listaAsociaciones)
                        {
                            var alertasAsoc = alertasPrioritarias.Count(a => a.NombreAsociado.Contains(asoc, StringComparison.OrdinalIgnoreCase));
                            <tr>
                                <td class="ps-3 fw-bold text-dark">@asoc</td>
                                <td class="text-muted">@(asoc.Contains("ASOPLÁTANO") ? "901234567-1" : asoc.Contains("ASOCACAO") ? "901876543-2" : "900543210-8")</td>
                                <td>@(asoc.Contains("ASOPLÁTANO") ? "Apartadó" : asoc.Contains("ASOCACAO") ? "Turbo" : "Carepa / Urabá")</td>
                                <td class="text-center">
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
                                        Expediente al día
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (alertasAsoc > 0)
                                    {
                                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2.5 py-1">
                                            @alertasAsoc alerta(s)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border px-2.5 py-1">Óptimo</span>
                                    }
                                </td>
                                <td class="pe-3 text-end">
                                    <a href="/consultar-estado-documentos" class="btn btn-outline-success btn-sm rounded-pill py-0.5 px-3" style="font-size: 0.72rem;">
                                        Inspeccionar &rarr;
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ======================================================== -->
    <!-- ESPACIO 2: CENTRO DOCUMENTAL INSTITUCIONAL               -->
    <!-- ======================================================== -->
    @if (pestanaActiva == "centro")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-file-earmark-check-fill text-success me-1"></i> Centro Documental Institucional
                    </h5>
                    <small class="text-muted">Consulta consolidada de documentos soporte, personerías jurídicas, estatutos y resoluciones de base</small>
                </div>
                <div class="d-flex gap-2">
                    <a href="/consultar-estado-documentos" class="btn btn-success btn-sm rounded-pill px-3 fw-bold" style="background-color: #114224; border-color: #114224;">
                        <i class="bi bi-folder-check me-1"></i> Abrir Estado Completo de Documentación
                    </a>
                    <a href="/alertas-documentos" class="btn btn-outline-warning btn-sm rounded-pill px-3 fw-bold text-dark">
                        <i class="bi bi-bell me-1"></i> Ver Alertas de Vencimiento
                    </a>
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="d-block small text-muted text-uppercase fw-bold">Documentos Registrados</span>
                        <h3 class="fw-bold text-dark mb-0 fs-4">@totalDocumentosAsociacion</h3>
                        <small class="text-success">Soportes legales y tributarios</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="d-block small text-muted text-uppercase fw-bold">Documentos en Regla</span>
                        <h3 class="fw-bold text-success mb-0 fs-4">@(totalDocumentosAsociacion - totalAlertasActivas)</h3>
                        <small class="text-muted">Vigencia legal verificada</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 border">
                        <span class="d-block small text-muted text-uppercase fw-bold">Próximos a Vencer o Vencidos</span>
                        <h3 class="fw-bold text-danger mb-0 fs-4">@totalAlertasActivas</h3>
                        <small class="text-danger">Requieren renovación</small>
                    </div>
                </div>
            </div>

            <!-- TABLA DE ALERTAS Y VENCIMIENTOS DOCUMENTALES -->
            <h6 class="fw-bold text-dark mb-2" style="font-size: 0.85rem;">Documentos Institucionales y Estados de Vigencia:</h6>
            @if (alertasPrioritarias.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.8rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Asociación</th>
                                <th>Tipo de Documento</th>
                                <th>Fecha Vencimiento</th>
                                <th class="text-center">Días Restantes</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Consulta</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in alertasPrioritarias)
                            {
                                <tr>
                                    <td class="fw-semibold">@doc.NombreAsociado</td>
                                    <td>@doc.TipoDocumento</td>
                                    <td>@doc.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge @(doc.DiasRestantes < 0 ? "bg-danger" : doc.DiasRestantes <= 7 ? "bg-danger" : "bg-warning text-dark")">
                                            @(doc.DiasRestantes < 0 ? "Vencido" : $"{doc.DiasRestantes} días")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@doc.MensajeAlerta</span>
                                    </td>
                                    <td class="text-end">
                                        <a href="/alertas-documentos" class="btn btn-outline-secondary btn-sm py-0.5 px-2 rounded-pill" style="font-size: 0.72rem;">
                                            Ver alerta
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">Todos los documentos institucionales se encuentran al día.</p>
            }
        </div>
    }

    <!-- ======================================================== -->
    <!-- ESPACIO 3: REPOSITORIO DE ACTAS Y COMPROMISOS DERIVADOS  -->
    <!-- ======================================================== -->
    @if (pestanaActiva == "actas")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
                <div>
                    <h5 class="fw-bold text-dark mb-0 fs-6">
                        <i class="bi bi-journal-bookmark-fill text-success me-1"></i> Repositorio de Actas, Estatutos y Acuerdos
                    </h5>
                    <small class="text-muted">Consulta de actas de asamblea, resoluciones y seguimiento de compromisos derivados</small>
                </div>
                <a href="/actas-estatutos/documentos" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-search me-1"></i> Inspeccionar Repositorio Completo
                </a>
            </div>

            <!-- LISTA DE ACTAS INSTITUCIONALES -->
            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                    <thead style="background-color: #114224; color: white;">
                        <tr>
                            <th class="py-2.5 ps-3 text-white fw-bold">Código / Referencia</th>
                            <th class="py-2.5 text-white fw-bold">Título del Documento</th>
                            <th class="py-2.5 text-white fw-bold">Tipo</th>
                            <th class="py-2.5 text-white fw-bold">Fecha</th>
                            <th class="py-2.5 text-white fw-bold text-center">Estado</th>
                            <th class="py-2.5 text-white fw-bold text-center">Compromisos</th>
                            <th class="py-2.5 pe-3 text-white fw-bold text-end">Soporte</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in documentosInstitucionales)
                        {
                            <tr>
                                <td class="ps-3 fw-bold text-dark">@doc.Codigo</td>
                                <td>
                                    <div class="fw-semibold text-dark">@doc.Titulo</div>
                                    <small class="text-muted text-truncate d-block" style="max-width: 280px;">@doc.Descripcion</small>
                                </td>
                                <td><span class="badge bg-light text-dark border">@doc.Tipo</span></td>
                                <td>@doc.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge @(doc.Estado == EstadosDocumento.Vigente ? "bg-success-subtle text-success border border-success-subtle" : "bg-warning-subtle text-warning border border-warning-subtle")">
                                        @doc.Estado
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info border border-info-subtle">
                                        @doc.Compromisos.Count compromiso(s)
                                    </span>
                                </td>
                                <td class="pe-3 text-end">
                                    @if (doc.Archivo is not null)
                                    {
                                        <a href="/api/documentos-institucionales/@doc.Id/descargar" target="_blank" class="btn btn-outline-success btn-sm rounded-pill py-0.5 px-2" style="font-size: 0.72rem;">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> Descargar
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Sin archivo</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- SEGUIMIENTO DE COMPROMISOS DERIVADOS DE ACTAS -->
            <h6 class="fw-bold text-dark mb-3" style="font-size: 0.85rem;">
                <i class="bi bi-check2-square text-success me-1"></i> Trazabilidad de Compromisos Derivados de Actas:
            </h6>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.78rem;">
                    <thead class="table-light">
                        <tr>
                            <th>Compromiso o Acuerdo Asambleario</th>
                            <th>Responsable Designado</th>
                            <th>Fecha Límite</th>
                            <th>Estado de Cumplimiento</th>
                            <th>Observaciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comp in todosCompromisos)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">@comp.Descripcion</td>
                                <td>@comp.Responsable</td>
                                <td>@comp.FechaLimite.ToString("dd/MM/yyyy")</td>
                                <td>
