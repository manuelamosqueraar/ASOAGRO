        EstadosMovimientoFinanciero.PorCobrar => "bg-warning text-dark",
        EstadosMovimientoFinanciero.PorPagar => "bg-secondary text-white",
        EstadosMovimientoFinanciero.PendienteRevision => "bg-warning-subtle text-dark border border-warning",
        EstadosMovimientoFinanciero.Observado => "bg-danger-subtle text-danger border border-danger",
        EstadosMovimientoFinanciero.Anulado => "bg-dark text-white text-decoration-line-through",
