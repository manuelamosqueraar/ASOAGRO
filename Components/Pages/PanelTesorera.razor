    {
        TipoMovimientoFinanciero.Ingreso => new[]
        {
            SubtiposMovimientoFinanciero.VentaProduccion,
            SubtiposMovimientoFinanciero.VentaServicios,
            SubtiposMovimientoFinanciero.CuotaOrdinaria,
            SubtiposMovimientoFinanciero.CuotaExtraordinaria,
            SubtiposMovimientoFinanciero.AporteSocial,
            SubtiposMovimientoFinanciero.RecaudoCartera,
            SubtiposMovimientoFinanciero.SubsidioDonacion,
            SubtiposMovimientoFinanciero.OtroIngreso
        },
        TipoMovimientoFinanciero.CostoGasto => new[]
        {
            SubtiposMovimientoFinanciero.InsumosFertilizantes,
            SubtiposMovimientoFinanciero.ManoDeObra,
            SubtiposMovimientoFinanciero.TransporteFlete,
            SubtiposMovimientoFinanciero.AsistenciaTecnica,
            SubtiposMovimientoFinanciero.EmpaquesEmbalajes,
            SubtiposMovimientoFinanciero.GastosAdministrativos,
            SubtiposMovimientoFinanciero.ServiciosPublicos,
            SubtiposMovimientoFinanciero.MantenimientoEquipos,
            SubtiposMovimientoFinanciero.HonorariosProfesionales,
            SubtiposMovimientoFinanciero.OtroCostoGasto
        },
        TipoMovimientoFinanciero.PagoDespacho => new[]
        {
            SubtiposMovimientoFinanciero.PagoProveedor,
            SubtiposMovimientoFinanciero.LiquidacionAsociado,
            SubtiposMovimientoFinanciero.AbonoObligacion,
            SubtiposMovimientoFinanciero.AnticipoDespacho,
            SubtiposMovimientoFinanciero.DespachoCarga
