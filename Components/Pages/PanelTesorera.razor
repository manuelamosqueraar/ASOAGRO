    private async Task OnSeleccionarArchivoSoporte(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file != null)
            {
                nuevoNombreSoporte = file.Name;
                nuevoArchivoTipoMime = string.IsNullOrWhiteSpace(file.ContentType) ? "application/pdf" : file.ContentType;
                using var stream = file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                nuevoArchivoContenido = ms.ToArray();
                mensajeFeedback = $"Archivo soporte '{file.Name}' cargado correctamente para la operación.";
                esFeedbackExito = true;
            }
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al leer el archivo soporte: {ex.Message}";
            esFeedbackExito = false;
        }
    }

