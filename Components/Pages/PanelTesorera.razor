    private async Task ExportarExcelCsv()
    {
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Codigo;Fecha;Asociacion;Tipo;Categoria;Concepto;Tercero;DocumentoTercero;ValorCOP;Estado;MetodoPago;Soporte;FacturaNumero;QueSePago;ParaQueSePago;ActividadProyecto");

            foreach (var m in todosMovimientos)
            {
                sb.AppendLine($"{m.CodigoReferencia};{m.FechaMovimiento:dd/MM/yyyy};\"{m.NombreAsociacion}\";{m.Tipo};\"{m.Categoria}\";\"{m.Concepto}\";\"{m.BeneficiarioOProveedor}\";{m.DocumentoIdentidadTercero};{m.Monto};{m.Estado};\"{m.MetodoPago}\";\"{m.TipoSoporte}\";\"{m.NumeroFactura}\";\"{m.QueSePago}\";\"{m.ParaQueSePago}\";\"{m.ActividadOProyecto}\"");
            }

            var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(sb.ToString())).ToArray();
            var base64 = Convert.ToBase64String(bytes);
            var nombre = $"Movimientos_Tesoreria_{DateTime.Now:yyyyMMdd}.csv";

            await JS.InvokeVoidAsync("descargarArchivoBase64", nombre, "text/csv", base64);
            mensajeFeedback = "Archivo CSV exportado exitosamente con compatibilidad Excel.";
            esFeedbackExito = true;
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al exportar CSV: {ex.Message}";
            esFeedbackExito = false;
        }
    }

    private static string FormatearCop(decimal valor)
