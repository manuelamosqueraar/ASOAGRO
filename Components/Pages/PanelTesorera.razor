    /// <summary>
    /// Descarga el soporte principal de la operación (Factura de venta, factura electrónica de proveedor o documento soporte).
    /// </summary>
    private async Task DescargarSoportePrincipalAsync(Guid id)
    {
        try
        {
            var resultado = FinanzasService.ObtenerSoporteDescarga(id, esComprobantePago: false, $"{nombreUsuario} ({rolActivo})");
            if (!resultado.Disponible || resultado.Contenido == null || resultado.Contenido.Length == 0)
            {
                mensajeFeedback = string.IsNullOrWhiteSpace(resultado.Mensaje)
                    ? "El registro financiero no cuenta con un archivo de soporte adjunto o no se encuentra disponible."
                    : resultado.Mensaje;
                esFeedbackExito = false;
                return;
            }

            var base64 = Convert.ToBase64String(resultado.Contenido);
            await JS.InvokeVoidAsync("descargarArchivoBase64", resultado.NombreArchivo, resultado.TipoMime, base64);
            mensajeFeedback = $"Soporte '{resultado.NombreArchivo}' descargado exitosamente.";
            esFeedbackExito = true;
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al descargar soporte documental: {ex.Message}";
            esFeedbackExito = false;
        }
    }

