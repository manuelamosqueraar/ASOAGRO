                                     "#4b5563";

    private string IconoModo => EsTesorero ? "bi-shield-check" :
                                EsAdmin ? "bi-pencil-square" :
                                EsPresidenta ? "bi-eye" :
                                "bi-file-earmark-text";

    private string AlcancePermisoTexto => EsTesorero ? "Control total, correcciones, anulación y emisión de reportes" :
                                          EsAdmin ? "Ingreso de operaciones (sin aprobación ni edición)" :
                                          EsPresidenta ? "Consulta consolidada y seguimiento de gobernanza" :
                                          "Consulta de balances y soportes";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        nombreUsuario = user.Identity?.Name 
            ?? user.FindFirst(ClaimTypes.Name)?.Value 
            ?? "Usuario ASOAGRO";

        correoUsuario = user.FindFirst(ClaimTypes.Email)?.Value ?? "";

        // Determinar rol
        if (user.IsInRole("Tesorero") || user.IsInRole("Tesorera"))
        {
            rolActivo = "Tesorera";
        }
        else if (user.IsInRole("Directora") || user.IsInRole("Director") || user.IsInRole("Administrador"))
        {
            rolActivo = "Administrador";
        }
        else if (user.IsInRole("Presidenta") || user.IsInRole("Presidente"))
        {
            rolActivo = "Presidenta";
        }
        else if (user.IsInRole("Secretaria") || user.IsInRole("Secretaría"))
        {
            rolActivo = "Secretaría";
        }

        // Suscribirse a sincronización en tiempo real
        FinanzasService.DatosFinancierosActualizados += OnDatosActualizadosExternos;

        await CargarDatosAsync();
    }

    private void OnDatosActualizadosExternos()
    {
        _ = InvokeAsync(async () =>
        {
            await CargarDatosAsync();
            StateHasChanged();
        });
    }

    private Task CargarDatosAsync()
    {
        listaAsociaciones = FinanzasService.ObtenerAsociaciones().ToList();
        listaPeriodos = FinanzasService.ObtenerPeriodosDisponibles().ToList();

        if (string.IsNullOrWhiteSpace(nuevaAsociacion) && listaAsociaciones.Any())
        {
            nuevaAsociacion = listaAsociaciones.First();
        }

        AplicarFiltros();
        return Task.CompletedTask;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Seccion))
        {
            moduloActivo = Seccion.ToLowerInvariant() switch
            {
                "resumen" => "resumen",
                "costos" or "gastos" or "costos-gastos" => "costos",
                "ingresos" or "ventas" or "ingresos-ventas" => "ingresos",
                "cobrar" or "cuentas-por-cobrar" => "cobrar",
                "pagar" or "pagos" or "cuentas-por-pagar" => "pagar",
                "soportes" or "facturacion" or "facturacion-soportes" => "soportes",
                "reportes" or "balances" or "reportes-balances" => "reportes",
                _ => "resumen"
            };
        }
    }

    private void AplicarFiltros()
    {
        resumenActual = FinanzasService.ObtenerResumen(filtroAsociacion, filtroPeriodo);
        todosMovimientos = FinanzasService.ObtenerTodos(filtroAsociacion, filtroPeriodo).ToList();

        movimientosCostos = todosMovimientos.Where(m => m.Tipo == TipoMovimientoFinanciero.CostoGasto).ToList();
        movimientosIngresos = todosMovimientos.Where(m => m.Tipo == TipoMovimientoFinanciero.Ingreso).ToList();
        movimientosPagos = todosMovimientos.Where(m => m.Tipo == TipoMovimientoFinanciero.PagoDespacho).ToList();

        movimientosCobrar = todosMovimientos.Where(m => m.Tipo == TipoMovimientoFinanciero.Ingreso && (m.SaldoPendiente > 0 || m.Estado == EstadosMovimientoFinanciero.PendienteRevision || m.Estado == EstadosMovimientoFinanciero.PorCobrar || m.Estado == EstadosMovimientoFinanciero.AbonoParcial)).ToList();
        if (!movimientosCobrar.Any())
        {
            movimientosCobrar = movimientosIngresos.Take(10).ToList();
        }

        movimientosPagar = todosMovimientos.Where(m => (m.Tipo == TipoMovimientoFinanciero.CostoGasto || m.Tipo == TipoMovimientoFinanciero.PagoDespacho) && (m.SaldoPendiente > 0 || m.Estado == EstadosMovimientoFinanciero.PendienteRevision || m.Estado == EstadosMovimientoFinanciero.PorPagar || m.Estado == EstadosMovimientoFinanciero.AbonoParcial)).ToList();
        if (!movimientosPagar.Any())
        {
            movimientosPagar = movimientosCostos.Concat(movimientosPagos).Take(10).ToList();
        }

        movimientosSoportes = todosMovimientos.Where(m => !string.IsNullOrWhiteSpace(m.ArchivoNombre) || !string.IsNullOrWhiteSpace(m.NumeroFactura) || !string.IsNullOrWhiteSpace(m.ComprobantePagoNombre) || !string.IsNullOrWhiteSpace(m.TipoSoporte)).ToList();

        conteoCostos = movimientosCostos.Count;
        conteoIngresos = movimientosIngresos.Count;
        conteoPagos = movimientosPagos.Count;
        conteoCobrar = movimientosCobrar.Count;
        conteoPagar = movimientosPagar.Count;
        conteoSoportes = movimientosSoportes.Count;
    }

    private void CambiarModulo(string modulo)
    {
        moduloActivo = modulo;
        var slug = modulo switch
        {
            "resumen" => "resumen",
            "costos" => "costos-gastos",
            "ingresos" => "ingresos-ventas",
            "cobrar" => "cuentas-por-cobrar",
            "pagar" => "cuentas-por-pagar",
            "soportes" => "facturacion-soportes",
            "reportes" => "reportes-balances",
            _ => "resumen"
        };
        Navigation.NavigateTo($"gestion-financiera/{slug}", replace: false);
    }

    private void OnCambioTipoOperacion()
    {
        var subtipos = ObtenerSubtiposPorTipo(nuevoTipo);
        nuevoSubtipo = subtipos.FirstOrDefault() ?? "Operación general";
        if (nuevoTipo == TipoMovimientoFinanciero.Ingreso)
        {
            nuevoTipoSoporte = TiposSoporteFinanciero.FacturaVentaAsociacion;
            nuevoTipoTercero = "Cliente";
        }
        else if (nuevoTipo == TipoMovimientoFinanciero.CostoGasto)
        {
            nuevoTipoSoporte = TiposSoporteFinanciero.FacturaElectronicaProveedor;
            nuevoTipoTercero = "Proveedor";
        }
        else
        {
            nuevoTipoSoporte = TiposSoporteFinanciero.ExtractoConsignacion;
            nuevoTipoTercero = "Transportador";
        }
    }

