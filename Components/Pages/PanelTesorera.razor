@code {
    private string nombreUsuario = "Usuario";
    private string correoUsuario = "";
    private string rolActivo = "Tesorero";

    private bool EsTesorero => rolActivo.Equals("Tesorero", StringComparison.OrdinalIgnoreCase) || rolActivo.Equals("Tesorera", StringComparison.OrdinalIgnoreCase);
    private bool EsAdmin => rolActivo.Equals("Directora", StringComparison.OrdinalIgnoreCase) || rolActivo.Equals("Director", StringComparison.OrdinalIgnoreCase) || rolActivo.Equals("Administrador", StringComparison.OrdinalIgnoreCase);
    private bool EsPresidenta => rolActivo.Equals("Presidenta", StringComparison.OrdinalIgnoreCase) || rolActivo.Equals("Presidente", StringComparison.OrdinalIgnoreCase);
    private bool EsSecretaria => rolActivo.Equals("Secretaria", StringComparison.OrdinalIgnoreCase) || rolActivo.Equals("Secretaría", StringComparison.OrdinalIgnoreCase);

    private bool PuedeRegistrar => EsTesorero || EsAdmin;

    [Parameter] public string? Seccion { get; set; }

    private string moduloActivo = "resumen";
    private string filtroAsociacion = "";
    private string filtroPeriodo = "";

    private List<string> listaAsociaciones = new();
    private List<string> listaPeriodos = new();

    private List<MovimientoFinanciero> todosMovimientos = new();
    private List<MovimientoFinanciero> movimientosCostos = new();
    private List<MovimientoFinanciero> movimientosIngresos = new();
    private List<MovimientoFinanciero> movimientosPagos = new();
    private List<MovimientoFinanciero> movimientosCobrar = new();
    private List<MovimientoFinanciero> movimientosPagar = new();
    private List<MovimientoFinanciero> movimientosSoportes = new();

    private ResumenFinanciero resumenActual = new();

    private int conteoCostos = 0;
    private int conteoIngresos = 0;
    private int conteoPagos = 0;
    private int conteoCobrar = 0;
    private int conteoPagar = 0;
    private int conteoSoportes = 0;

    // Modales y formularios
    private bool mostrarModalNuevo = false;
    private bool mostrarModalPago = false;
    private bool mostrarModalObservacion = false;
    private bool mostrarModalAnular = false;
    private bool mostrarModalAuditoria = false;
    private bool mostrarModalSoporte = false;

    private bool esEdicion = false;
    private MovimientoFinanciero? movimientoSeleccionado = null;

    // Campos formulario
    private TipoMovimientoFinanciero nuevoTipo = TipoMovimientoFinanciero.Ingreso;
    private string nuevaAsociacion = "";
    private string nuevoSubtipo = SubtiposMovimientoFinanciero.VentaProduccion;
    private string nuevaActividadProyecto = "Línea Productiva de Plátano Exportación";
    private DateTime nuevaFecha = DateTime.Today;
    private decimal nuevoMonto = 0;
    private string nuevoMetodoPago = MetodosPagoFinanciero.TransferenciaBancaria;
    private string nuevoTercero = "";
    private string nuevoDocTercero = "";
    private string nuevoTipoTercero = "Proveedor";
    private string nuevoOrigenMotivo = "Operación regular asociativa";
    private string nuevaDescripcion = "";
    private string nuevoTipoSoporte = TiposSoporteFinanciero.ComprobanteInternoAsoagro;
    private string nuevoNumeroFactura = "";
    private string nuevoNombreSoporte = "Comprobante_Pago.pdf";
    private string nuevoComprobantePago = "";

    // Campos de archivo binario cargado
    private byte[]? nuevoArchivoContenido = null;
    private string? nuevoArchivoTipoMime = "application/pdf";
    private byte[]? nuevoComprobantePagoContenido = null;

    // Campos específicos para Costos y Gastos
    private string nuevoQueSePago = "";
    private string nuevoParaQueSePago = "";
    private string nuevoActividadNecesidad = "";

    // Textos modales
    private string textoObservacion = "";
    private string textoMotivoAnulacion = "";
    private decimal montoPagoRegistro = 0;
    private string comprobantePagoTexto = "";

    // Mensajes
    private string? mensajeFeedback = null;
    private bool esFeedbackExito = true;

    // Banners dinámicos según el rol
    private string TextoModoRol => EsTesorero ? "Gestión Integral y Control · Tesorera" :
                                   EsAdmin ? "Registro Operativo Inicial · Administración" :
                                   EsPresidenta ? "Supervisión y Gobernanza · Presidencia" :
                                   "Consulta Documental y Soportes · Secretaría";

    private string ColorBadgeModo => EsTesorero ? "#059669" :
                                     EsAdmin ? "#2563eb" :
