    private async Task GuardarMovimientoAsync()
    {
        if (nuevoMonto <= 0)
        {
            mensajeFeedback = "El valor de la operación debe ser mayor a $0 COP.";
            esFeedbackExito = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevaDescripcion))
        {
            mensajeFeedback = "Debe ingresar una descripción explicativa de la operación.";
            esFeedbackExito = false;
            return;
        }

        if (esEdicion && movimientoSeleccionado != null)
        {
            var res = FinanzasService.ActualizarMovimiento(movimientoSeleccionado.Id, m =>
            {
                m.Tipo = nuevoTipo;
                m.NombreAsociacion = nuevaAsociacion;
                m.Subtipo = nuevoSubtipo;
                m.Categoria = nuevoSubtipo;
                m.ActividadOProyecto = nuevaActividadProyecto;
                m.FechaMovimiento = nuevaFecha;
                m.Monto = nuevoMonto;
                m.MetodoPago = nuevoMetodoPago;
                m.BeneficiarioOProveedor = nuevoTercero;
                m.DocumentoIdentidadTercero = nuevoDocTercero;
                m.TipoTercero = nuevoTipoTercero;
                m.OrigenOMotivo = nuevoOrigenMotivo;
                m.Descripcion = nuevaDescripcion;
                m.TipoSoporte = nuevoTipoSoporte;
                m.NumeroFactura = nuevoNumeroFactura;
                m.ArchivoNombre = nuevoNombreSoporte;
                m.ComprobantePagoNombre = nuevoComprobantePago;
                if (nuevoArchivoContenido != null && nuevoArchivoContenido.Length > 0)
                {
                    m.ArchivoContenido = nuevoArchivoContenido;
                    m.ArchivoTipoMime = nuevoArchivoTipoMime;
                }
                if (nuevoComprobantePagoContenido != null && nuevoComprobantePagoContenido.Length > 0)
                {
                    m.ComprobantePagoContenido = nuevoComprobantePagoContenido;
                }
                m.QueSePago = nuevoQueSePago;
                m.ParaQueSePago = nuevoParaQueSePago;
                m.ActividadONecesidad = nuevoActividadNecesidad;
            }, nombreUsuario, rolActivo);

            mensajeFeedback = res.Mensaje;
            esFeedbackExito = res.Exitoso;
        }
        else
        {
            var mov = new MovimientoFinanciero
            {
                Tipo = nuevoTipo,
                NombreAsociacion = nuevaAsociacion,
                Subtipo = nuevoSubtipo,
                Categoria = nuevoSubtipo,
                ActividadOProyecto = nuevaActividadProyecto,
                FechaMovimiento = nuevaFecha,
                Monto = nuevoMonto,
                ValorPagado = EsTesorero ? nuevoMonto : 0,
                MetodoPago = nuevoMetodoPago,
                BeneficiarioOProveedor = nuevoTercero,
                DocumentoIdentidadTercero = nuevoDocTercero,
                TipoTercero = nuevoTipoTercero,
                OrigenOMotivo = nuevoOrigenMotivo,
                Descripcion = nuevaDescripcion,
                TipoSoporte = nuevoTipoSoporte,
                NumeroFactura = nuevoNumeroFactura,
                ArchivoNombre = nuevoNombreSoporte,
                ArchivoContenido = nuevoArchivoContenido,
                ArchivoTipoMime = nuevoArchivoTipoMime ?? "application/pdf",
                ComprobantePagoNombre = nuevoComprobantePago,
                ComprobantePagoContenido = nuevoComprobantePagoContenido,
                QueSePago = nuevoQueSePago,
                ParaQueSePago = nuevoParaQueSePago,
                ActividadONecesidad = nuevoActividadNecesidad,
                Estado = EsTesorero ? EstadosMovimientoFinanciero.Validado : EstadosMovimientoFinanciero.PendienteRevision
            };

            var res = FinanzasService.RegistrarMovimiento(mov, nombreUsuario, rolActivo);
            mensajeFeedback = res.Mensaje;
            esFeedbackExito = res.Exitoso;
        }

        CerrarModales();
        await CargarDatosAsync();
    }

    private async Task ConfirmarPagoAsync()
    {
        if (movimientoSeleccionado == null) return;

        var res = FinanzasService.MarcarPagado(movimientoSeleccionado.Id, nombreUsuario, rolActivo, comprobantePagoTexto, montoPagoRegistro);
        if (res.Exitoso && res.Movimiento != null && nuevoComprobantePagoContenido != null)
        {
            res.Movimiento.ComprobantePagoContenido = nuevoComprobantePagoContenido;
        }
        mensajeFeedback = res.Mensaje;
        esFeedbackExito = res.Exitoso;

        CerrarModales();
        await CargarDatosAsync();
    }

