</div>

@code {
    private string pestanaActiva = "caja";
    private string nombreUsuario = "Carlos Mostrador FAAUA";
    private string rolUsuario = "Administrador del punto de venta";
    private bool esModoConsulta = false;

    private List<ProductoPdv> productos = new();
    private List<VentaPdv> ventas = new();
    private List<RecepcionProductoPdv> recepciones = new();
    private List<CierreCajaPdv> cierresCaja = new();
    private ResumenPdv resumen = new();
    private List<string> listaAsociaciones = new();

    private string filtroCategoriaCatalogo = string.Empty;
    private string filtroAsocInventario = string.Empty;

    // Feedback
    private string? mensajeFeedback;
    private bool esFeedbackExito = true;

    // Carrito de mostrador
    private List<ItemVentaPdv> carrito = new();
    private string clienteNombre = string.Empty;
    private string clienteDocumento = string.Empty;
    private string metodoPago = "Efectivo";
    private decimal montoRecibido = 0;
    private bool guardandoVenta = false;
    private string errorVenta = string.Empty;
    private VentaPdv? ventaSeleccionada;
    private bool aplicaDescuento = false;
    private decimal descuentoVenta = 0;
    private string? motivoDescuento;
    private string? autorizadoPorDescuento;
    private string? nombreSoportePago;

    // Recepción
    private RecepcionProductoPdv nuevaRecepcion = new();
    private bool guardandoRecepcion = false;
    private string errorRecepcion = string.Empty;

    // Cierre
    private CierreCajaPdv nuevoCierre = new();
    private bool guardandoCierre = false;
    private string errorCierre = string.Empty;

    // Anulación
    private VentaPdv? ventaPorAnular;
    private string motivoAnulacion = string.Empty;
    private string errorAnulacion = string.Empty;

    // Ajuste inventario
    private ProductoPdv? productoPorAjustar;
    private decimal nuevoStockAjuste = 0;
    private string autorizadoPorAjuste = string.Empty;
    private string motivoAjuste = string.Empty;
    private string errorAjuste = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            nombreUsuario = user.FindFirst(ClaimTypes.Name)?.Value ?? user.Identity.Name ?? "Carlos Mostrador FAAUA";
            var rol = user.FindFirst(ClaimTypes.Role)?.Value ?? "AdministradorPdv";
            rolUsuario = rol switch
            {
                "AdministradorPdv" or "PuntoVenta" or "Vendedor" => "Administrador del punto de venta",
                "Presidenta" or "Presidente" => "Presidente FAAUA",
                "Tesorero" or "Tesorera" => "Tesorería FAAUA",
                "Administrador" or "Admin" => "Administrador de la plataforma",
                _ => rol
            };

            // Solo Administrador del punto de venta y Vendedor tienen rol operativo
            esModoConsulta = !(rol.Equals("AdministradorPdv", StringComparison.OrdinalIgnoreCase) ||
                               rol.Equals("PuntoVenta", StringComparison.OrdinalIgnoreCase) ||
                               rol.Equals("Vendedor", StringComparison.OrdinalIgnoreCase));
        }

        listaAsociaciones = DocumentoService.ObtenerAsociaciones().ToList();
        CargarDatos();
        InicializarRecepcion();
        InicializarCierre();
    }

    private void CargarDatos()
    {
        productos = PuntoVentaService.ObtenerProductos().ToList();
        ventas = PuntoVentaService.ObtenerVentas().ToList();
        recepciones = PuntoVentaService.ObtenerRecepciones().ToList();
        cierresCaja = PuntoVentaService.ObtenerCierresCaja().ToList();
        resumen = PuntoVentaService.ObtenerResumen();
    }

    private void InicializarRecepcion()
    {
        nuevaRecepcion = new RecepcionProductoPdv
        {
            FechaRecepcion = DateTime.Today,
            Cantidad = 0,
            CostoUnitario = 0
        };
        errorRecepcion = string.Empty;
    }

    private void InicializarCierre()
    {
        nuevoCierre = new CierreCajaPdv
        {
            FechaCierre = DateTime.Today,
            Turno = "Jornada Completa",
            EfectivoEsperado = resumen.TotalEfectivoHoy,
            EfectivoContado = resumen.TotalEfectivoHoy,
            Responsable = nombreUsuario
        };
        errorCierre = string.Empty;
    }

    private IEnumerable<ProductoPdv> ProductosCatalogoFiltrados =>
        productos.Where(p => string.IsNullOrWhiteSpace(filtroCategoriaCatalogo) ||
                             string.Equals(p.Categoria, filtroCategoriaCatalogo, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ProductoPdv> ProductosInventarioFiltrados =>
        productos.Where(p => string.IsNullOrWhiteSpace(filtroAsocInventario) ||
                             string.Equals(p.AsociacionOrigen, filtroAsocInventario, StringComparison.OrdinalIgnoreCase));

    private decimal SubtotalBrutoCarrito => carrito.Sum(i => i.Cantidad * i.PrecioUnitario);
    private decimal TotalCarrito => Math.Max(0, SubtotalBrutoCarrito - (aplicaDescuento ? descuentoVenta : 0));

    private void AgregarAlCarrito(ProductoPdv prod)
    {
        if (esModoConsulta) return;

        var existente = carrito.FirstOrDefault(i => i.ProductoId == prod.Id);
        if (existente != null)
        {
            if (existente.Cantidad + 1 <= prod.StockDisponible)
            {
                existente.Cantidad += 1;
            }
        }
        else
        {
            carrito.Add(new ItemVentaPdv
            {
                ProductoId = prod.Id,
                CodigoProducto = prod.Codigo,
                NombreProducto = prod.Nombre,
                Categoria = prod.Categoria,
                AsociacionOrigen = prod.AsociacionOrigen,
                UnidadMedida = prod.UnidadMedida,
                Cantidad = 1,
                PrecioUnitario = prod.PrecioUnitario
            });
        }

        if (montoRecibido < TotalCarrito)
        {
            montoRecibido = TotalCarrito;
        }
    }

    private void ModificarCantidad(ItemVentaPdv item, decimal delta)
    {
        if (esModoConsulta) return;

        var nuevaCant = item.Cantidad + delta;
        if (nuevaCant <= 0)
        {
            carrito.Remove(item);
        }
        else
        {
            var prod = productos.FirstOrDefault(p => p.Id == item.ProductoId);
            if (prod != null && nuevaCant <= prod.StockDisponible)
            {
                item.Cantidad = nuevaCant;
            }
        }

        if (montoRecibido < TotalCarrito)
        {
            montoRecibido = TotalCarrito;
        }
    }

    private void VaciarCarrito()
    {
        carrito.Clear();
        montoRecibido = 0;
        descuentoVenta = 0;
        aplicaDescuento = false;
        errorVenta = string.Empty;
    }

    private async Task CargarSoportePagoVenta(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                errorVenta = "El comprobante no debe superar los 10 MB.";
                return;
            }
            nombreSoportePago = file.Name;
        }
    }

    private void FinalizarVenta()
    {
        if (esModoConsulta || !carrito.Any()) return;

        if (string.IsNullOrWhiteSpace(clienteNombre))
        {
            errorVenta = "El nombre o razón social del cliente es obligatorio.";
            return;
        }

        if (string.IsNullOrWhiteSpace(clienteDocumento))
        {
            errorVenta = "El documento (Cédula o NIT) del cliente es obligatorio.";
            return;
        }

        if (metodoPago == "Efectivo" && montoRecibido < TotalCarrito)
        {
            errorVenta = "El monto recibido en efectivo no puede ser inferior al total a cobrar.";
            return;
        }

        errorVenta = string.Empty;
        guardandoVenta = true;

        try
        {
            var venta = new VentaPdv
            {
                ClienteNombre = clienteNombre.Trim(),
                ClienteDocumento = clienteDocumento.Trim(),
                MetodoPago = metodoPago,
                MontoRecibido = montoRecibido >= TotalCarrito ? montoRecibido : TotalCarrito,
                DescuentoAutorizado = aplicaDescuento ? descuentoVenta : 0,
                MotivoDescuento = aplicaDescuento ? motivoDescuento : null,
                AutorizadoPor = aplicaDescuento ? autorizadoPorDescuento : null,
                SoportePagoNombre = nombreSoportePago,
                Items = new List<ItemVentaPdv>(carrito)
            };

            var res = PuntoVentaService.RegistrarVenta(venta, nombreUsuario, rolUsuario);
            if (!res.Exitoso)
            {
                errorVenta = res.Mensaje;
                return;
            }

            ventaSeleccionada = res.Venta;
            mensajeFeedback = res.Mensaje;
            esFeedbackExito = true;
            VaciarCarrito();
            clienteNombre = string.Empty;
            clienteDocumento = string.Empty;
            nombreSoportePago = null;
            CargarDatos();
            InicializarCierre();
        }
        finally
        {
            guardandoVenta = false;
        }
    }

    private void ActualizarDatosProductoRecepcion()
    {
        var p = productos.FirstOrDefault(x => x.Id == nuevaRecepcion.ProductoId);
        if (p != null)
        {
            nuevaRecepcion.ProductoNombre = p.Nombre;
            nuevaRecepcion.CodigoProducto = p.Codigo;
            nuevaRecepcion.UnidadMedida = p.UnidadMedida;
            nuevaRecepcion.AsociacionOrigen = p.AsociacionOrigen;
            if (nuevaRecepcion.CostoUnitario <= 0)
            {
                nuevaRecepcion.CostoUnitario = p.CostoPromedio;
            }
        }
    }

    private async Task CargarSoporteRecepcion(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                errorRecepcion = "El archivo supera el límite permitido de 10 MB.";
                return;
            }
            nuevaRecepcion.SoporteNombre = file.Name;
        }
    }

    private void GuardarRecepcion()
    {
        if (esModoConsulta) return;

        if (nuevaRecepcion.ProductoId == Guid.Empty)
        {
            errorRecepcion = "Debe seleccionar un producto del catálogo.";
            return;
        }

        if (nuevaRecepcion.Cantidad <= 0)
        {
            errorRecepcion = "La cantidad debe ser mayor a cero.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevaRecepcion.ProveedorNombre))
        {
            errorRecepcion = "Debe indicar la finca o productor proveedor.";
            return;
        }

        errorRecepcion = string.Empty;
        guardandoRecepcion = true;

        try
        {
            var res = PuntoVentaService.RegistrarRecepcion(nuevaRecepcion, nombreUsuario, rolUsuario);
            if (!res.Exitoso)
            {
                errorRecepcion = res.Mensaje;
                return;
            }

            mensajeFeedback = res.Mensaje;
            esFeedbackExito = true;
            InicializarRecepcion();
            CargarDatos();
        }
        finally
        {
            guardandoRecepcion = false;
        }
    }

    private void GuardarCierreCaja()
    {
        if (esModoConsulta) return;

        errorCierre = string.Empty;
        guardandoCierre = true;

        try
        {
            nuevoCierre.TotalVentasEfectivo = resumen.TotalEfectivoHoy;
            nuevoCierre.TotalVentasTransferencia = resumen.TotalTransferenciasHoy;
            nuevoCierre.TotalVentasGeneral = resumen.TotalVentasHoy;
            nuevoCierre.CantidadVentas = resumen.CantidadTransaccionesHoy;
            nuevoCierre.EfectivoEsperado = resumen.TotalEfectivoHoy;

            var ok = PuntoVentaService.RegistrarCierreCaja(nuevoCierre, nombreUsuario, rolUsuario);
            if (ok)
            {
                mensajeFeedback = $"Cierre de turno '{nuevoCierre.Turno}' guardado exitosamente. Estado: {nuevoCierre.Estado}.";
                esFeedbackExito = true;
                InicializarCierre();
                CargarDatos();
            }
        }
        finally
        {
            guardandoCierre = false;
        }
    }

    private void AbrirModalAnulacion(VentaPdv v)
    {
        ventaPorAnular = v;
        motivoAnulacion = string.Empty;
        errorAnulacion = string.Empty;
    }

    private void ConfirmarAnulacion()
    {
        if (esModoConsulta || ventaPorAnular == null) return;

        if (string.IsNullOrWhiteSpace(motivoAnulacion))
        {
            errorAnulacion = "El motivo de la anulación es obligatorio por trazabilidad y auditoría.";
            return;
        }

        var ok = PuntoVentaService.AnularVenta(ventaPorAnular.Id, motivoAnulacion.Trim(), nombreUsuario, rolUsuario);
        if (ok)
        {
            mensajeFeedback = $"Venta {ventaPorAnular.NumeroTicket} anulada correctamente y mercancía reintegrada al inventario.";
            esFeedbackExito = true;
            ventaPorAnular = null;
            CargarDatos();
            InicializarCierre();
        }
        else
        {
            errorAnulacion = "No fue posible anular la venta.";
        }
    }

    private void AbrirModalAjusteInventario(ProductoPdv p)
    {
        productoPorAjustar = p;
        nuevoStockAjuste = p.StockDisponible;
        autorizadoPorAjuste = string.Empty;
        motivoAjuste = string.Empty;
        errorAjuste = string.Empty;
    }

    private void ConfirmarAjusteInventario()
    {
        if (esModoConsulta || productoPorAjustar == null) return;

        if (string.IsNullOrWhiteSpace(autorizadoPorAjuste))
        {
            errorAjuste = "Debe indicar quién autorizó el ajuste de inventario.";
            return;
        }

        if (string.IsNullOrWhiteSpace(motivoAjuste))
        {
            errorAjuste = "El motivo justificado del ajuste de inventario es obligatorio.";
            return;
        }

        var ok = PuntoVentaService.AjustarInventario(productoPorAjustar.Id, nuevoStockAjuste, motivoAjuste.Trim(), autorizadoPorAjuste.Trim(), nombreUsuario);
        if (ok)
        {
            mensajeFeedback = $"Ajuste de inventario aplicado a {productoPorAjustar.Nombre}: nuevo stock {nuevoStockAjuste} {productoPorAjustar.UnidadMedida}.";
            esFeedbackExito = true;
            productoPorAjustar = null;
            CargarDatos();
        }
    }

    private void MostrarRecibo(VentaPdv v) => ventaSeleccionada = v;
    private void CerrarRecibo() => ventaSeleccionada = null;
}
