    <!-- MODAL DE AJUSTE DE INVENTARIO -->
    @if (productoPorAjustar != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(3px);" role="dialog">
            <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content rounded-4 border-0 shadow-lg">
                    <div class="modal-header bg-dark text-white p-3">
                        <h6 class="modal-title fw-bold text-white mb-0">
                            <i class="bi bi-sliders me-1"></i> Ajuste Autorizado de Inventario: @productoPorAjustar.Nombre
                        </h6>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => productoPorAjustar = null"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold mb-1">Stock Actual:</label>
                            <div class="form-control form-control-sm bg-light">
                                @productoPorAjustar.StockDisponible.ToString("N0") @productoPorAjustar.UnidadMedida
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold mb-1">
                                Nuevo Stock Físico: <span class="text-danger">* (Obligatorio)</span>
                            </label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="nuevoStockAjuste" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold mb-1">
                                Autorizado por: <span class="text-danger">* (Obligatorio)</span>
                            </label>
                            <input type="text" class="form-control form-control-sm" placeholder="Ej: Junta Directiva FAAUA / Auditor" @bind="autorizadoPorAjuste" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold mb-1">
                                Motivo Justificado: <span class="text-danger">* (Obligatorio)</span>
                            </label>
                            <textarea class="form-control form-control-sm" rows="2" placeholder="Ej: Merma biológica natural por maduración o conteo físico de auditoría" @bind="motivoAjuste"></textarea>
                        </div>
                        @if (!string.IsNullOrEmpty(errorAjuste))
                        {
                            <div class="alert alert-danger py-2 small">@errorAjuste</div>
                        }
                    </div>
                    <div class="modal-footer p-3 bg-light">
                        <button type="button" class="btn btn-secondary btn-sm rounded-pill" @onclick="() => productoPorAjustar = null">Cancelar</button>
                        <button type="button" class="btn btn-success btn-sm rounded-pill fw-bold" @onclick="ConfirmarAjusteInventario">Guardar Ajuste</button>
                    </div>
                </div>
            </div>
