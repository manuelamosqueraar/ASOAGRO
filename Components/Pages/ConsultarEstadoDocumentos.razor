@page "/consultar-estado-documentos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Secretaria,Secretaría,Presidenta,Presidente")]
@rendermode InteractiveServer
@using System.Text.RegularExpressions
@using Asoagro.Models
@using Asoagro.Services
@inject IDocumentoAsociacionService DocumentoService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Estado de Documentación por Asociación · Asoagro & FAAUA</PageTitle>

<div class="asoagro-documentos-wrapper container-fluid px-0 pb-5">

    <!-- HERO PANEL INSTITUCIONAL -->
    <div class="card aso-hero-card mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="aso-hero-icon-box">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <path d="M9 15l2 2 4-4"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="aso-hero-kicker">FAAUA · Secretaría General</span>
                            <span class="text-white-50" style="font-size: 0.75rem; font-weight: 600;">Auditoría de Expedientes Institucionales</span>
                        </div>
                        <h1 class="aso-hero-title">Estado de documentación por asociación</h1>
                        <p class="aso-hero-desc">
                            Supervisa el expediente documental de cada entidad base: soportes custodiados, documentos faltantes para elegibilidad y fechas de vencimiento.
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a href="alertas-documentos" class="aso-btn-hero-secondary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2.2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                        <span>Alertas de vencimiento (@TotalAlertas)</span>
                    </a>
                    <a href="@($"/registrar-documentos{(string.IsNullOrWhiteSpace(asociacionFiltro) ? "" : $"?asociacion={Uri.EscapeDataString(asociacionFiltro)}")}")" class="aso-btn-hero-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Custodiar documento</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    @{
        var todosDocs = DocumentoService.ObtenerTodos();
    }

    <!-- FRANJA EJECUTIVA DE INDICADORES GLOBALES -->
    <div class="aso-kpi-grid">
        <div class="aso-kpi-card kpi-emerald" style="cursor: pointer;" @onclick='() => filtroEstado = "Todos"'>
            <div class="aso-kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
            </div>
            <div class="aso-kpi-meta">
                <span class="aso-kpi-label">Total Custodiados</span>
                <strong class="aso-kpi-value">@todosDocs.Count</strong>
                <span class="aso-kpi-sub">En @listaAsociaciones.Count asociaciones federadas</span>
            </div>
        </div>

        <div class="aso-kpi-card kpi-sky" style="cursor: pointer;" @onclick='() => filtroEstado = "Vigente"'>
            <div class="aso-kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <div class="aso-kpi-meta">
                <span class="aso-kpi-label">Al Día / Vigentes</span>
                <strong class="aso-kpi-value">@todosDocs.Count(d => d.EstadoCalculado == "Vigente")</strong>
                <span class="aso-kpi-sub">Cumplimiento normativo activo</span>
            </div>
        </div>

        <div class="aso-kpi-card kpi-amber" style="cursor: pointer;" @onclick='() => filtroEstado = "Por vencer"'>
            <div class="aso-kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="aso-kpi-meta">
                <span class="aso-kpi-label">Próximos a Vencer</span>
                <strong class="aso-kpi-value">@todosDocs.Count(d => d.EstadoCalculado == "Por vencer")</strong>
                <span class="aso-kpi-sub">Vencen en los próximos 30 días</span>
            </div>
        </div>

        <div class="aso-kpi-card kpi-rose" style="cursor: pointer;" @onclick='() => filtroEstado = "Vencido"'>
            <div class="aso-kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>
            <div class="aso-kpi-meta">
                <span class="aso-kpi-label">Soportes Vencidos</span>
                <strong class="aso-kpi-value">@todosDocs.Count(d => d.EstadoCalculado == "Vencido")</strong>
                <span class="aso-kpi-sub">Requieren renovación inmediata</span>
            </div>
        </div>
    </div>

    <!-- ESTACIÓN DE SELECCIÓN Y FILTROS -->
    <div class="aso-filter-workbench">
        <div class="aso-filter-top-row">
            <div class="aso-search-wrap">
                <span class="aso-search-icon">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </span>
                <input type="text"
                       class="aso-search-input"
                       placeholder="Buscar soporte por nombre de documento, asociación, RUT, Cámara de Comercio o ICA..."
                       @bind="textoBusqueda"
                       @bind:event="oninput" />
                @if (!string.IsNullOrWhiteSpace(textoBusqueda))
                {
                    <button class="aso-search-clear" type="button" @onclick="() => textoBusqueda = string.Empty" title="Limpiar búsqueda">
                        &times;
                    </button>
                }
            </div>

            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="aso-table-count-pill">
                    @DocumentosFiltrados.Count() soporte(s) filtrado(s)
                </span>
                <button type="button" class="btn-consultar-expediente" style="height: 38px; border-radius: 10px; padding: 0 16px;" @onclick="EjecutarConsultaExpediente">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                    <span>Consultar expediente</span>
                </button>
            </div>
        </div>

        <div class="aso-filter-grid-3">
            <!-- Selector de Asociación -->
            <div class="aso-field-group">
                <label class="aso-field-label">Asociación federada a consultar</label>
                <select class="aso-select-modern" value="@asociacionFiltro" @onchange="OnCambioAsociacion">
                    <option value="">Todas las asociaciones federadas</option>
                    @foreach (var asoc in listaAsociaciones)
                    {
                        <option value="@asoc">@asoc</option>
                    }
                </select>
            </div>

            <!-- Filtro por Estado -->
            <div class="aso-field-group">
                <label class="aso-field-label">Estado de vigencia</label>
                <select class="aso-select-modern" @bind="filtroEstado">
                    <option value="Todos">Todos los estados</option>
                    <option value="Vigente">Vigentes</option>
                    <option value="Por vencer">Por vencer (&le; 30 días)</option>
                    <option value="Vencido">Vencidos</option>
                </select>
            </div>

            <!-- Filtro por Tipo -->
            <div class="aso-field-group">
                <label class="aso-field-label">Tipo de soporte documental</label>
                <select class="aso-select-modern" @bind="filtroTipo">
                    <option value="">Todos los tipos documentales</option>
                    @foreach (var tipo in catalogoTipos)
                    {
                        <option value="@tipo">@tipo</option>
                    }
                </select>
            </div>
        </div>
    </div>

    <!-- RESUMEN DEL EXPEDIENTE (Si hay asociación seleccionada) -->
    @if (!string.IsNullOrWhiteSpace(asociacionFiltro))
    {
        var expediente = DocumentoService.ObtenerExpediente(asociacionFiltro);
        
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden border-top border-4 border-success">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 pb-3 border-bottom">
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="badge bg-success-subtle text-success px-2.5 py-1 rounded-pill fw-bold">Entidad Base</span>
                            <h4 class="fw-bold text-dark mb-0">@expediente.NombreAsociacion</h4>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(expediente.NitAsociacion))
                        {
                            <span class="text-muted small mt-1 d-block">NIT: @expediente.NitAsociacion</span>
                        }
                    </div>

                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn-consultar-expediente" @onclick="() => DescargarExpedientePdf(expediente.NombreAsociacion)">
                            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                            <span>Consultar expediente (PDF)</span>
                        </button>
                        <a href="@($"/registrar-documentos?asociacion={Uri.EscapeDataString(expediente.NombreAsociacion)}")" class="aso-btn-action aso-btn-action-primary py-2 px-3">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            <span>Adjuntar en Expediente</span>
                        </a>
                    </div>
                </div>

                <!-- Métricas de estado del expediente (4 tarjetas perfectamente alineadas) -->
                <div class="ced-metricas-grid">
                    <div class="ced-metrica-card ced-metrica-registrados">
                        <span class="ced-metrica-titulo">Documentos Registrados</span>
                        <strong class="ced-metrica-valor">@expediente.TotalRegistrados</strong>
                    </div>

                    <div class="ced-metrica-card ced-metrica-vigentes">
                        <span class="ced-metrica-titulo">Al Día / Vigentes</span>
                        <strong class="ced-metrica-valor">@expediente.Vigentes</strong>
                    </div>

                    <div class="ced-metrica-card ced-metrica-porvencer">
                        <span class="ced-metrica-titulo">Por Vencer (&le; 30d)</span>
                        <strong class="ced-metrica-valor">@expediente.PorVencer</strong>
                    </div>

                    <div class="ced-metrica-card ced-metrica-vencidos">
                        <span class="ced-metrica-titulo">Vencidos</span>
                        <strong class="ced-metrica-valor">@expediente.Vencidos</strong>
                    </div>
                </div>

                <!-- Documentos Faltantes -->
                @if (expediente.DocumentosFaltantes.Any())
                {
                    <div class="alert alert-warning border-0 rounded-3 p-3 mb-0">
                        <div class="d-flex align-items-start gap-2">
                            <i class="bi bi-exclamation-diamond-fill fs-5 text-warning-emphasis mt-0.5"></i>
                            <div class="w-100">
                                <strong class="text-warning-emphasis d-block mb-1">
                                    Documentos faltantes para completar el expediente legal (@expediente.DocumentosFaltantes.Count pendientes):
                                </strong>
                                <div class="d-flex flex-wrap gap-2 mt-2">
                                    @foreach (var faltante in expediente.DocumentosFaltantes)
                                    {
                                        <span class="badge bg-white text-dark border border-warning-subtle px-3 py-2 rounded-pill small fw-semibold d-inline-flex align-items-center gap-1.5 shadow-xs">
                                            <i class="bi bi-file-earmark-x text-danger"></i> @faltante
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-success border-0 rounded-3 p-2.5 mb-0 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                        <span class="small fw-semibold text-success-emphasis">
                            ¡Expediente institucional completo! La asociación cuenta con los documentos legales fundamentales registrados.
                        </span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- TABLA DE DOCUMENTOS ENCONTRADOS -->
    <div class="aso-table-card mb-4">
        <div class="aso-table-header-bar">
            <div class="aso-table-header-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#15803d" stroke-width="2.2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                <span>Documentos Institucionales Custodiados</span>
                <span class="aso-table-count-pill">@DocumentosFiltrados.Count() registros</span>
            </div>

            @if (DocumentosFiltrados.Any())
            {
                <span class="text-muted" style="font-size: 0.78rem; font-weight: 500;">Ordenados del más reciente al más antiguo</span>
            }
        </div>

        @if (!DocumentosFiltrados.Any())
        {
            <div class="p-5 text-center">
                <div class="mb-3 text-muted">
                    <i class="bi bi-folder2-open display-4 opacity-50"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No se encontraron documentos</h5>
                <p class="text-muted small mb-3">
                    @(string.IsNullOrWhiteSpace(asociacionFiltro) 
                        ? "Aún no se han registrado documentos institucionales con los filtros seleccionados." 
                        : $"No hay registros para {asociacionFiltro} con los criterios indicados.")
                </p>
                <a href="registrar-documentos" class="aso-btn-action aso-btn-action-primary px-3 py-2">
                    <span>Registrar Primer Documento</span>
                </a>
            </div>
        }
        else
        {
            <div class="aso-table-wrap">
                <table class="table aso-table-grid align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="text-start" style="width: 25%; min-width: 210px;">Asociación titular</th>
                            <th class="text-start" style="width: 27%; min-width: 220px;">Documento y detalle</th>
                            <th class="text-center" style="width: 12%; min-width: 105px;">Emisión</th>
                            <th class="text-center" style="width: 13%; min-width: 115px;">Vencimiento</th>
                            <th class="text-center" style="width: 11%; min-width: 105px;">Estado</th>
                            <th class="text-end" style="width: 12%; min-width: 135px;">Archivo soporte</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var doc in DocumentosFiltrados)
                        {
                            var estado = doc.EstadoCalculado;
                            var dias = doc.DiasRestantes;

                            <tr>
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-xs flex-shrink-0"
                                             style="width: 38px; height: 38px; min-width: 38px; border-radius: 10px; background: linear-gradient(135deg, #0b2e1c 0%, #1e7043 100%); font-size: 0.78rem; border: 1px solid rgba(185, 231, 122, 0.35);">
                                            @ObtenerInicialesAsociacion(doc.NombreAsociacion)
                                        </div>
                                        <div class="d-flex flex-column" style="min-width: 0;">
                                            <strong class="text-dark text-truncate" style="max-width: 210px; font-size: 0.85rem;" title="@doc.NombreAsociacion">@doc.NombreAsociacion</strong>
                                            @if (!string.IsNullOrWhiteSpace(doc.NitAsociacion))
                                            {
                                                <small class="text-muted font-monospace" style="font-size: 0.73rem;">NIT: @doc.NitAsociacion</small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="text-start">
                                    <div class="d-flex flex-column gap-0.5">
                                        <span class="badge bg-success-subtle text-success-emphasis rounded-pill align-self-start" style="font-size: 0.7rem;">
                                            @doc.TipoDocumento
                                        </span>
                                        <strong class="text-dark" style="font-size: 0.85rem;">@doc.Titulo</strong>
                                        @if (!string.IsNullOrWhiteSpace(doc.Observaciones))
                                        {
                                            <small class="text-secondary text-truncate" style="max-width: 260px; font-size: 0.74rem;" title="@doc.Observaciones">
                                                @doc.Observaciones
                                            </small>
                                        }
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="text-dark fw-semibold" style="font-size: 0.82rem;">@doc.FechaEmision.ToString("dd/MM/yyyy")</span>
                                </td>

                                <td class="text-center">
                                    @if (doc.FechaVencimiento.HasValue)
                                    {
                                        <div class="d-flex flex-column align-items-center">
                                            <span class="fw-semibold @(dias < 0 ? "text-danger fw-bold" : dias <= 30 ? "text-warning-emphasis fw-bold" : "text-dark")" style="font-size: 0.82rem;">
                                                @doc.FechaVencimiento.Value.ToString("dd/MM/yyyy")
                                            </span>
                                            @if (dias < 0)
                                            {
                                                <small class="text-danger fw-bold" style="font-size: 0.7rem;">Vencido hace @Math.Abs(dias.Value) d</small>
                                            }
                                            else if (dias <= 30)
                                            {
                                                <small class="text-warning-emphasis fw-bold" style="font-size: 0.7rem;">Vence en @dias d</small>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">No expira</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (estado == "Vigente")
                                    {
                                        <span class="aso-badge-activa">
                                            Vigente
                                        </span>
                                    }
                                    else if (estado == "Por vencer")
                                    {
                                        <span class="aso-badge-pendiente">
                                            Por vencer
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="aso-badge-vencida">
                                            Vencido
                                        </span>
                                    }
                                </td>

                                <td class="text-end">
                                    <div class="aso-actions-group">
                                        @if (!string.IsNullOrWhiteSpace(doc.ArchivoNombre))
                                        {
                                            <button type="button"
                                                    class="aso-btn-action aso-btn-action-primary"
                                                    title="Descargar soporte @doc.ArchivoNombre"
                                                    @onclick="() => DescargarArchivo(doc)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                                <span>Descargar</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="aso-badge-neutro">Sin soporte</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

@code {
    [SupplyParameterFromQuery(Name = "asoc")]
    public string? AsocParam { get; set; }

    [SupplyParameterFromQuery(Name = "asociacion")]
    public string? AsociacionParam { get; set; }

    private string asociacionFiltro = string.Empty;
    private string textoBusqueda = string.Empty;
    private string filtroEstado = "Todos";
    private string filtroTipo = string.Empty;

    private List<string> listaAsociaciones = new();
    private List<string> catalogoTipos = new();

    private int TotalAlertas => DocumentoService.ObtenerAlertas(DateTime.Today).Count;

    protected override void OnInitialized()
    {
        listaAsociaciones = DocumentoService.ObtenerAsociaciones().ToList();
        catalogoTipos = DocumentoService.ObtenerCatalogoTiposDocumentos().ToList();

        var param = !string.IsNullOrWhiteSpace(AsociacionParam) ? AsociacionParam : AsocParam;
        if (!string.IsNullOrWhiteSpace(param))
        {
            asociacionFiltro = param;
        }
    }

    protected override void OnParametersSet()
    {
        var param = !string.IsNullOrWhiteSpace(AsociacionParam) ? AsociacionParam : AsocParam;
        if (!string.IsNullOrWhiteSpace(param) && asociacionFiltro != param)
        {
            asociacionFiltro = param;
        }
    }

    private void OnCambioAsociacion(ChangeEventArgs e)
    {
        asociacionFiltro = e.Value?.ToString() ?? "";
    }

    private IEnumerable<DocumentoAsociacion> DocumentosFiltrados
    {
        get
        {
            var docs = DocumentoService.ObtenerTodos();

            if (!string.IsNullOrWhiteSpace(asociacionFiltro))
            {
                var filtroNorm = asociacionFiltro.Trim();
                docs = docs.Where(d => 
                    string.Equals(d.NombreAsociacion.Trim(), filtroNorm, StringComparison.OrdinalIgnoreCase) ||
                    d.NombreAsociacion.Contains(filtroNorm, StringComparison.OrdinalIgnoreCase) ||
                    filtroNorm.Contains(d.NombreAsociacion.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (!string.IsNullOrWhiteSpace(filtroTipo))
            {
                docs = docs.Where(d => string.Equals(d.TipoDocumento, filtroTipo, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (filtroEstado != "Todos")
            {
                docs = docs.Where(d => string.Equals(d.EstadoCalculado, filtroEstado, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (!string.IsNullOrWhiteSpace(textoBusqueda))
            {
                var term = textoBusqueda.Trim().ToLowerInvariant();
                docs = docs.Where(d =>
                    d.NombreAsociacion.ToLowerInvariant().Contains(term) ||
                    d.TipoDocumento.ToLowerInvariant().Contains(term) ||
                    d.Titulo.ToLowerInvariant().Contains(term) ||
                    d.Observaciones.ToLowerInvariant().Contains(term) ||
                    d.ArchivoNombre.ToLowerInvariant().Contains(term)).ToList();
            }

            return docs;
        }
    }

    private static string ObtenerInicialesAsociacion(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var partes = nombre.Trim().Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
        return $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant();
    }

    private async Task DescargarArchivo(DocumentoAsociacion doc)
    {
        if (doc.ArchivoContenido != null && doc.ArchivoContenido.Length > 0)
        {
            var base64 = Convert.ToBase64String(doc.ArchivoContenido);
            await JS.InvokeVoidAsync("descargarArchivoBase64", doc.ArchivoNombre, doc.ArchivoTipoMime, base64);
        }
        else
        {
            // Generar documento formal informativo de respaldo si fue registrado sin binario directo
            var textoInfo = $"DOCUMENTO INSTITUCIONAL FAAUA\nAsociación: {doc.NombreAsociacion}\nNIT: {doc.NitAsociacion}\nTipo: {doc.TipoDocumento}\nTítulo: {doc.Titulo}\nFecha Emisión: {doc.FechaEmision:dd/MM/yyyy}\nVencimiento: {(doc.FechaVencimiento.HasValue ? doc.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "N/A")}\nRegistrado por: {doc.RegistradoPor}\nFecha Registro: {doc.FechaRegistro:dd/MM/yyyy HH:mm}\nObservaciones: {doc.Observaciones}\nArchivo Original: {doc.ArchivoNombre}";
            var bytes = System.Text.Encoding.UTF8.GetBytes(textoInfo);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("descargarArchivoBase64", $"{doc.ArchivoNombre}.txt", "text/plain", base64);
        }
    }

    private void EjecutarConsultaExpediente()
    {
        if (string.IsNullOrWhiteSpace(asociacionFiltro) && !string.IsNullOrWhiteSpace(textoBusqueda))
        {
            var match = listaAsociaciones.FirstOrDefault(a => a.Contains(textoBusqueda.Trim(), StringComparison.OrdinalIgnoreCase));
            if (match != null)
            {
                asociacionFiltro = match;
            }
        }
        else if (string.IsNullOrWhiteSpace(asociacionFiltro) && listaAsociaciones.Any())
        {
            asociacionFiltro = listaAsociaciones.First();
        }
    }

    private async Task DescargarExpedientePdf(string nombreAsoc)
    {
        try
        {
            var expediente = DocumentoService.ObtenerExpediente(nombreAsoc);
            var asoc = new AsociacionInstitucional
            {
                NombreLegal = expediente.NombreAsociacion,
                Nit = expediente.NitAsociacion,
                Estado = expediente.TotalRegistrados > 0 ? "Activa" : "En actualización"
            };
            var docs = DocumentoService.ObtenerPorAsociacion(nombreAsoc).ToList();
            var pdfBytes = ExpedienteAsociacionPdfGenerator.GenerarResumenPdf(asoc, docs, "Secretaría FAAUA");
            var base64 = Convert.ToBase64String(pdfBytes);
            var nombreLimpio = Regex.Replace(nombreAsoc, @"[^a-zA-Z0-9]", "_");
            await JS.InvokeVoidAsync("descargarArchivoBase64", $"Expediente_{nombreLimpio}.pdf", "application/pdf", base64);
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"No fue posible generar el expediente PDF: {ex.Message}");
        }
    }
}
