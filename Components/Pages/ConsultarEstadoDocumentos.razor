@page "/consultar-estado-documentos"
@rendermode InteractiveServer

<PageTitle>Consultar Estado de Documentación</PageTitle>

<div class="container mt-4">
    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0 text-primary">
            <span class="bi bi-file-earmark-check-fill me-2"></span>Estado de Documentación por Asociado
        </h3>
    </div>

    <!-- Buscador Compacto -->
    <div class="card shadow-sm mb-4 border-0 rounded-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <div class="col-md-7">
                    <label class="form-label fw-bold small text-muted mb-1">Buscar Asociado</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0 ps-0" placeholder="Ingrese Cédula o Nombre completo..." @bind="criterioBusqueda" />
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end mt-3 mt-md-0">
                    <button class="btn btn-primary w-100 fw-semibold" @onclick="EjecutarBusqueda">
                        <i class="bi bi-search me-1"></i> Buscar
                    </button>
                </div>
                <div class="col-md-2 d-flex align-items-end mt-3 mt-md-0">
                    <button class="btn btn-outline-secondary btn-sm w-100 py-2" @onclick="LimpiarFiltro" title="Limpiar búsqueda">
                        <i class="bi bi-x-lg me-1"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Resultados -->
    @if (asociadoEncontrado != null)
    {
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-0">@asociadoEncontrado.NombreCompleto</h5>
                    <small class="text-muted">Cédula: @asociadoEncontrado.Cedula | Finca: @asociadoEncontrado.FincaVereda</small>
                </div>
                <span class="badge bg-info text-dark">@asociadoEncontrado.CultivoPrincipal</span>
            </div>
            <div class="card-body">
                <h6 class="fw-bold mb-3">Documentos Registrados:</h6>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tipo de Documento</th>
                                <th>Fecha de Emisión</th>
                                <th>Fecha de Vencimiento</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var doc in asociadoEncontrado.Documentos)
                            {
                                <tr>
                                    <td class="fw-semibold">@doc.TipoDocumento</td>
                                    <td>@doc.FechaEmision.ToString("dd/MM/yyyy")</td>
                                    <td>@(doc.FechaVencimiento.HasValue ? doc.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "N/A")</td>
                                    <td>
                                        <span class="badge @ObtenerClaseBadge(doc.Estado)">
                                            @doc.Estado
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else if (busquedaRealizada)
    {
        <div class="alert alert-warning text-center shadow-sm">
            <i class="bi bi-exclamation-triangle me-2"></i> No se encontró ningún asociado registrado con el criterio "<strong>@criterioBusqueda</strong>".
        </div>
    }
    else
    {
        <div class="alert alert-info text-center shadow-sm">
            <i class="bi bi-info-circle me-2"></i> Ingrese un nombre o cédula en el buscador y presione <strong>Buscar</strong> para consultar los documentos del asociado.
        </div>
    }
</div>

@code {
    private string criterioBusqueda = "";
    private bool busquedaRealizada = false;
    private AsociadoConDocumentos? asociadoEncontrado;

    private class DocumentoEstado
    {
        public string TipoDocumento { get; set; } = "";
        public DateTime FechaEmision { get; set; }
        public DateTime? FechaVencimiento { get; set; }
        public string Estado { get; set; } = "Vigente";
    }

    private class AsociadoConDocumentos
    {
        public string Cedula { get; set; } = "";
        public string NombreCompleto { get; set; } = "";
        public string FincaVereda { get; set; } = "";
        public string CultivoPrincipal { get; set; } = "";
        public List<DocumentoEstado> Documentos { get; set; } = new();
    }
 
    private List<AsociadoConDocumentos> listaAsociados = new()
    {
        new AsociadoConDocumentos
        {
            Cedula = "1012345678",
            NombreCompleto = "Juan Pérez",
            FincaVereda = "Finca La Esperanza - Vereda Central",
            CultivoPrincipal = "Cacao",
            Documentos = new List<DocumentoEstado>
            {
                new DocumentoEstado { TipoDocumento = "Cédula de Ciudadanía", FechaEmision = new DateTime(2015, 5, 10), FechaVencimiento = null, Estado = "Vigente" },
                new DocumentoEstado { TipoDocumento = "Certificación BPA", FechaEmision = new DateTime(2023, 1, 15), FechaVencimiento = new DateTime(2025, 1, 15), Estado = "Vencido" },
                new DocumentoEstado { TipoDocumento = "Uso de Suelo", FechaEmision = new DateTime(2024, 6, 1), FechaVencimiento = new DateTime(2026, 11, 1), Estado = "Próximo a Vencer" }
            }
        },
        new AsociadoConDocumentos
        {
            Cedula = "1098765432",
            NombreCompleto = "María Rodríguez",
            FincaVereda = "Finca El Porvenir - Vereda La Selva",
            CultivoPrincipal = "Plátano",
            Documentos = new List<DocumentoEstado>
            {
                new DocumentoEstado { TipoDocumento = "Cédula de Ciudadanía", FechaEmision = new DateTime(2018, 3, 20), FechaVencimiento = null, Estado = "Vigente" },
                new DocumentoEstado { TipoDocumento = "Registro RUT", FechaEmision = new DateTime(2022, 8, 10), FechaVencimiento = new DateTime(2027, 8, 10), Estado = "Vigente" }
            }
        }
    };

    private void EjecutarBusqueda()
    {
        if (string.IsNullOrWhiteSpace(criterioBusqueda)) return;

        busquedaRealizada = true;
        asociadoEncontrado = listaAsociados.FirstOrDefault(a =>
            a.Cedula.Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase) ||
            a.NombreCompleto.Contains(criterioBusqueda, StringComparison.OrdinalIgnoreCase));
    }

    private void LimpiarFiltro()
    {
        criterioBusqueda = "";
        busquedaRealizada = false;
        asociadoEncontrado = null;
    }

    private string ObtenerClaseBadge(string estado) => estado switch
    {
        "Vigente" => "bg-success",
        "Próximo a Vencer" => "bg-warning text-dark",
        "Vencido" => "bg-danger",
        _ => "bg-secondary"
    };
}