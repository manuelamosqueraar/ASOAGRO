@page "/registrar-documentos"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations

<div class="page-header">
    <div>
        <p class="eyebrow text-success">Documentos</p>
        <h1>Registrar documento</h1>
        <p>Asocia soportes a un productor para alimentar el futuro control de vencimientos.</p>
    </div>
    <span class="status-chip">Módulo inicial</span>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

<div class="content-card">
    <div class="form-intro">
        <div>
            <h2>Información del soporte</h2>
            <p>Carga y asocia los documentos requeridos para cada asociado.</p>
        </div>
    </div>

    <EditForm Model="@documentoModel" OnValidSubmit="GuardarDocumento">
        <DataAnnotationsValidator />
 
        <div class="row g-3">
            <div class="col-md-6">
                <label for="documentoAsociado" class="form-label fw-bold">Número de Documento del Asociado <span class="text-danger">*</span></label>
                <InputText id="documentoAsociado" class="form-control" placeholder="Ej: 1045123890" @bind-Value="documentoModel.DocumentoAsociado" />
                <ValidationMessage For="@(() => documentoModel.DocumentoAsociado)" class="text-danger small mt-1 d-block" />
            </div>

            <div class="col-md-6">
                <label for="tipoDocumento" class="form-label fw-bold">Tipo de Documento <span class="text-danger">*</span></label>
                <InputSelect id="tipoDocumento" class="form-select" @bind-Value="documentoModel.TipoDocumento">
                    <option value="">Seleccione el tipo...</option>
                    <option value="CertificadoFinca">Certificado de Tradición y Libertad</option>
                    <option value="CedulaCiudadania">Cédula de Ciudadanía</option>
                    <option value="RegistroBPA">Buenas Prácticas Agrícolas (BPA)</option>
                </InputSelect>
                <ValidationMessage For="@(() => documentoModel.TipoDocumento)" class="text-danger small mt-1 d-block" />
            </div>
        </div>

        <div class="upload-zone my-4 p-3 border border-2 border-dashed rounded text-center bg-light">
            <label for="archivo" class="form-label fw-bold d-block">Seleccionar Archivo (PDF / Imagen) <span class="text-danger">*</span></label>
            <InputFile id="archivo" class="form-control w-75 mx-auto mb-2" OnChange="CargarArchivo" accept=".pdf,.png,.jpg,.jpeg" />
            <ValidationMessage For="@(() => documentoModel.ArchivoNombre)" class="text-danger small mt-1 d-block" />
            
            @if (!string.IsNullOrEmpty(documentoModel.ArchivoNombre))
            {
                <span class="badge bg-success px-3 py-2 mt-2 d-inline-block">
                    <i class="bi bi-check-circle me-1"></i>@documentoModel.ArchivoNombre
                </span>
            }
            else
            {
                <small class="text-muted d-block">Formatos sugeridos: PDF, JPG o PNG.</small>
            }
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Subir y Registrar Documento</button>
    </EditForm>
</div>

@code {
    private DocumentoModel documentoModel = new();
    private string mensajeExito = string.Empty;
 
    private void CargarArchivo(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo != null)
        {
            documentoModel.ArchivoNombre = archivo.Name;
        }
    }

    private void GuardarDocumento()
    {
        mensajeExito = $"¡Documento '{documentoModel.TipoDocumento}' registrado con éxito para el asociado con cédula {documentoModel.DocumentoAsociado}!";
        documentoModel = new();
    }

    public class DocumentoModel
    {
        [Required(ErrorMessage = "El documento del asociado es obligatorio.")]
        public string DocumentoAsociado { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe seleccionar el tipo de documento.")]
        public string TipoDocumento { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe adjuntar un archivo digitalizado.")]
        public string ArchivoNombre { get; set; } = string.Empty;
    }
} 