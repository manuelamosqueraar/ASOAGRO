    };

    private static string FormatearBytes(long bytes)
    {
        if (bytes <= 0) return "0 KB";
        if (bytes < 1024) return $"{bytes} B";
        var kb = bytes / 1024.0;
        if (kb < 1024) return $"{kb:0.#} KB";
        var mb = kb / 1024.0;
        return $"{mb:0.##} MB";
    }

