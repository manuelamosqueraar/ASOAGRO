@page "/registrar-documentos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Secretaria,Secretaría,Directora,Director,Presidenta,Presidente")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Asoagro.Models
@using Asoagro.Services
@inject IDocumentoAsociacionService DocumentoService
@inject MunicipiosColombiaService MunicipiosService
@inject NotificacionService Notificaciones
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Registro de Documentación Institucional · Asoagro & FAAUA</PageTitle>

<div class="ra">
    <div class="ra-shell">

        <!-- HERO BANNER INSTITUCIONAL -->
        <section class="ra-hero">
            <div class="ra-hero-texto">
                <div class="ra-etiquetas">
                    <span class="ra-etiqueta">
                        <svg class="ra-ico"><use href="#ico-brote" /></svg>
                        FAAUA · Urabá Antioqueño
                    </span>
                    <span class="ra-etiqueta ra-etiqueta-trigo">
                        <svg class="ra-ico"><use href="#ico-escudo" /></svg>
                        Secretaría General · Gestión Documental
                    </span>
                </div>
                <h1 class="ra-titulo">Registro de Documentación Institucional de Asociaciones</h1>
                <p class="ra-descripcion">
                    Custodia y radicación de los expedientes legales, estatutarios y tributarios de las asociaciones agrícolas federadas.
                    Flujo por pasos para centralizar la información institucional de la entidad, sin solicitar datos personales de sus asociados.
                </p>
            </div>

            <div class="ra-hero-progreso">
                <div class="ra-hero-progreso-top">
                    <span class="ra-hero-etiqueta">Avance del expediente</span>
                    <strong class="ra-hero-valor">@CalcularPorcentajeAvance()%</strong>
                </div>
                <div class="ra-barra">
                    <div class="ra-barra-relleno" style="width: @(CalcularPorcentajeAvance())%;"></div>
                </div>
                <span class="ra-hero-pie">Paso @pasoActual de 7 · @ObtenerNombrePaso(pasoActual)</span>
            </div>
        </section>

        <!-- NAVEGACIÓN DE PASOS (STEPPER DE 7 SECCIONES) -->
        <nav class="ra-pasos" aria-label="Pasos del expediente institucional">
            @for (int p = 1; p <= 7; p++)
            {
                var nPaso = p;
                var activo = pasoActual == nPaso;
                var completo = EsPasoCompleto(nPaso);
                <button type="button"
                        class="ra-paso @(activo ? "activo" : "") @(completo ? "completo" : "")"
                        @onclick="() => IrAlPaso(nPaso)"
                        title="@ObtenerNombrePaso(nPaso)">
                    <span class="ra-paso-num">
                        @if (completo && !activo)
                        {
                            <svg class="ra-ico"><use href="#ico-check" /></svg>
                        }
                        else
                        {
                            <span>@nPaso</span>
                        }
                    </span>
                    <span class="ra-paso-info">
                        <span class="ra-paso-titulo">@ObtenerNombrePasoCorto(nPaso)</span>
                        <span class="ra-paso-sub">Paso @nPaso</span>
                    </span>
                </button>
            }
        </nav>

        <!-- ALERTA DE MENSAJE O VALIDACIÓN -->
        @if (!string.IsNullOrWhiteSpace(mensajeAlerta))
        {
            <div class="ra-alerta @(esErrorAlerta ? "ra-alerta-error" : "ra-alerta-exito")" role="alert">
                <i class="bi @(esErrorAlerta ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
                <div class="flex-grow-1">
                    <strong>@(esErrorAlerta ? "Atención requerida" : "Información")</strong>
                    <div>@mensajeAlerta</div>
                </div>
                <button type="button" class="ra-alerta-cerrar" @onclick='() => mensajeAlerta = ""' aria-label="Cerrar">&times;</button>
            </div>
        }

        <!-- PANEL PRINCIPAL DEL FORMULARIO -->
        <section class="ra-panel">

            <!-- =========================================================================================
                 PASO 1: IDENTIFICACIÓN DE LA ASOCIACIÓN
                 ========================================================================================= -->
            @if (pasoActual == 1)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-escudo" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Sección 1 de 7</span>
                            <h2>Identificación de la Asociación</h2>
                            <p>Razón social, NIT institucional, personería, grado y estado legal de la entidad.</p>
                        </div>
                        <span class="ra-estado @(EsPasoCompleto(1) ? "ra-estado-ok" : "")">
                            @(EsPasoCompleto(1) ? "Completo" : "Pendiente")
                        </span>
                    </header>

                    <div class="ra-body">
                        <div class="ra-grid">
                            <div class="ra-campo ra-grid-full">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-nombre-legal">
                                        Nombre legal completo
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Razón social formal registrada en estatutos y personería jurídica.</span>
                                </div>
                                <input id="txt-nombre-legal"
                                       type="text"
                                       class="ra-input @(TieneError("NombreLegal") ? "ra-input-error" : "")"
                                       placeholder="Ej.: Asociación Agropecuaria de Urabá"
                                       @bind="modelo.NombreLegal"
                                       @bind:after='() => ValidarCampo("NombreLegal")' />
                                @if (TieneError("NombreLegal"))
                                {
                                    <span class="ra-error-campo">@ObtenerError("NombreLegal")</span>
                                }
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-sigla">
                                        Sigla o acrónimo
                                        <span class="ra-badge-opc">Opcional</span>
                                    </label>
                                    <span class="ra-hint">Abreviatura reconocida para comunicaciones.</span>
                                </div>
                                <input id="txt-sigla"
                                       type="text"
                                       maxlength="20"
                                       class="ra-input @(TieneError("Sigla") ? "ra-input-error" : "")"
                                       placeholder="Ej.: ASOAGRO"
                                       @bind="modelo.Sigla"
                                       @bind:after='() => ValidarCampo("Sigla")' />
                                @if (TieneError("Sigla"))
                                {
                                    <span class="ra-error-campo">@ObtenerError("Sigla")</span>
                                }
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="sel-tipo-org">
                                        Tipo de organización
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Naturaleza jurídica según Ley 2219 de 2022.</span>
                                </div>
                                <select id="sel-tipo-org" class="ra-select" @bind="modelo.TipoOrganizacion">
                                    <option value="Asociación campesina">Asociación campesina</option>
                                    <option value="Asociación agropecuaria">Asociación agropecuaria</option>
                                    <option value="Asociación de mujeres rurales">Asociación de mujeres rurales</option>
                                    <option value="Cooperativa agropecuaria">Cooperativa agropecuaria</option>
                                    <option value="Organización comunitaria de productores">Organización comunitaria de productores</option>
                                    <option value="Otra categoría asociativa">Otra categoría asociativa</option>
                                </select>
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="sel-ambito">
                                        Ámbito territorial
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Jurisdicción de cobertura estatutaria.</span>
                                </div>
                                <select id="sel-ambito" class="ra-select" @bind="modelo.Ambito" @bind:after="OnAmbitoCambiado">
                                    <option value="Municipal">Municipal</option>
                                    <option value="Distrital">Distrital</option>
                                    <option value="Departamental">Departamental</option>
                                    <option value="Regional">Regional</option>
                                    <option value="Nacional">Nacional</option>
                                </select>
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="sel-grado">
                                        Grado de la organización
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Nivel de articulación federada.</span>
                                </div>
                                <select id="sel-grado" class="ra-select" @bind="modelo.GradoOrganizacion">
                                    <option value="Primer grado (Asociación de base)">Primer grado (Asociación de base)</option>
                                    <option value="Segundo grado (Federación o unión)">Segundo grado (Federación o unión de asociaciones)</option>
                                    <option value="Tercer grado (Confederación nacional)">Tercer grado (Confederación nacional)</option>
                                </select>
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-nit">
                                        NIT institucional
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    @if (!string.IsNullOrWhiteSpace(modelo.Nit))
                                    {
                                        <span class="badge bg-light text-dark border">DV DIAN: @CalcularDigitoVerificacionDian(modelo.Nit)</span>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <input id="txt-nit"
                                           type="text"
                                           maxlength="10"
                                           class="ra-input @(TieneError("Nit") ? "ra-input-error" : "")"
                                           placeholder="Ej.: 900543210 (solo dígitos, no cédula)"
                                           @bind="modelo.Nit"
                                           @bind:after="OnNitCambiado" />
                                    <input type="text"
                                           style="width: 50px; text-align: center;"
                                           class="ra-input bg-light"
                                           placeholder="DV"
                                           readonly
                                           value="@modelo.DigitoVerificacion"
                                           title="Dígito de verificación DIAN (Módulo 11)" />
                                </div>
                                <span class="ra-hint">Número de Identificación Tributaria asignado a la persona jurídica.</span>
                                @if (TieneError("Nit"))
                                {
                                    <span class="ra-error-campo">@ObtenerError("Nit")</span>
                                }
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-fecha-const">
                                        Fecha de constitución
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Fecha de asamblea fundacional (no futura).</span>
                                </div>
                                <input id="txt-fecha-const"
                                       type="date"
                                       max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       class="ra-input @(TieneError("FechaConstitucion") ? "ra-input-error" : "")"
                                       @bind="modelo.FechaConstitucion"
                                       @bind:after='() => ValidarCampo("FechaConstitucion")' />
                                @if (TieneError("FechaConstitucion"))
                                {
                                    <span class="ra-error-campo">@ObtenerError("FechaConstitucion")</span>
                                }
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="sel-estado-asoc">
                                        Estado institucional
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Condición operativa de la personería.</span>
                                </div>
                                <select id="sel-estado-asoc" class="ra-select" @bind="modelo.Estado">
                                    <option value="Activa">Activa</option>
                                    <option value="En actualización">En actualización</option>
                                    <option value="Suspendida">Suspendida</option>
                                    <option value="Disuelta">Disuelta</option>
                                    <option value="En liquidación">En liquidación</option>
                                </select>
                            </div>

                            <div class="ra-campo ra-grid-full">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-excepciones">
                                        Excepciones o justificación de identificación
                                        <span class="ra-badge-opc">Opcional</span>
                                    </label>
                                    <span class="ra-hint">Explica cualquier régimen normativo excepcional o exención aplicable.</span>
                                </div>
                                <textarea id="txt-excepciones"
                                          class="ra-textarea"
                                          placeholder="Ej.: Organización de reciente constitución en trámite de inscripción ante autoridad especial..."
                                          @bind="modelo.ExcepcionesIdentificacion"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- =========================================================================================
                 PASO 2: DOMICILIO Y CONTACTO INSTITUCIONAL
                 ========================================================================================= -->
            @if (pasoActual == 2)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-mapa" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Sección 2 de 7</span>
                            <h2>Domicilio y Contacto Institucional</h2>
                            <p>Sede principal de la asociación, canales oficiales de notificación y contacto formal.</p>
                        </div>
                        <span class="ra-estado @(EsPasoCompleto(2) ? "ra-estado-ok" : "")">
                            @(EsPasoCompleto(2) ? "Completo" : "Pendiente")
                        </span>
                    </header>

                    <div class="ra-body">
                        <div class="ra-grid">
                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-departamento">
                                        Departamento
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Departamento de domicilio legal.</span>
                                </div>
                                <input id="txt-departamento"
                                       type="text"
                                       class="ra-input"
                                       placeholder="Ej.: Antioquia"
                                       @bind="modelo.Departamento" />
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="sel-municipio">
                                        Municipio
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Municipio sede principal.</span>
                                </div>
                                <select id="sel-municipio" class="ra-select" @bind="modelo.Municipio">
                                    <optgroup label="Subregión de Urabá Antioqueño">
                                        <option value="Apartadó">Apartadó</option>
                                        <option value="Turbo">Turbo</option>
                                        <option value="Carepa">Carepa</option>
                                        <option value="Chigorodó">Chigorodó</option>
                                        <option value="Necoclí">Necoclí</option>
                                        <option value="San Pedro de Urabá">San Pedro de Urabá</option>
                                        <option value="San Juan de Urabá">San Juan de Urabá</option>
                                        <option value="Arboletes">Arboletes</option>
                                        <option value="Mutatá">Mutatá</option>
                                        <option value="Murindó">Murindó</option>
                                        <option value="Vigía del Fuerte">Vigía del Fuerte</option>
                                    </optgroup>
                                    <optgroup label="Otras Regiones">
                                        <option value="Medellín">Medellín</option>
                                        <option value="Dabeiba">Dabeiba</option>
                                        <option value="Acandí">Acandí (Chocó)</option>
                                        <option value="Unguía">Unguía (Chocó)</option>
                                        <option value="Otro municipio">Otro municipio</option>
                                    </optgroup>
                                </select>
                            </div>

                            <div class="ra-campo ra-grid-full">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-dir-principal">
                                        Dirección principal
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Ubicación física de la sede u oficina de atención de la asociación.</span>
                                </div>
                                <input id="txt-dir-principal"
                                       type="text"
                                       class="ra-input @(TieneError("DireccionPrincipal") ? "ra-input-error" : "")"
                                       placeholder="Ej.: Carrera 100 # 98-45, Barrio Ortíz / Casa Campesina"
                                       @bind="modelo.DireccionPrincipal"
                                       @bind:after='() => ValidarCampo("DireccionPrincipal")' />
                                @if (TieneError("DireccionPrincipal"))
                                {
                                    <span class="ra-error-campo">@ObtenerError("DireccionPrincipal")</span>
                                }
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-correo-inst">
                                        Correo institucional
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Canal oficial para notificaciones y convocatorias.</span>
                                </div>
                                <input id="txt-correo-inst"
                                       type="email"
                                       class="ra-input @(TieneError("CorreoInstitucional") ? "ra-input-error" : "")"
                                       placeholder="Ej.: secretaria@asoagro-uraba.org"
                                       @bind="modelo.CorreoInstitucional"
                                       @bind:after='() => ValidarCampo("CorreoInstitucional")' />
                                @if (TieneError("CorreoInstitucional"))
                                {
                                    <span class="ra-error-campo">@ObtenerError("CorreoInstitucional")</span>
                                }
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-tel-inst">
                                        Teléfono institucional
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                    <span class="ra-hint">Celular (10 dígitos) o teléfono fijo con indicativo.</span>
                                </div>
                                <input id="txt-tel-inst"
                                       type="tel"
                                       class="ra-input @(TieneError("TelefonoContacto") ? "ra-input-error" : "")"
                                       placeholder="Ej.: 3104509876 o (604) 8281234"
                                       @bind="modelo.TelefonoContacto"
                                       @bind:after='() => ValidarCampo("TelefonoContacto")' />
                                @if (TieneError("TelefonoContacto"))
                                {
                                    <span class="ra-error-campo">@ObtenerError("TelefonoContacto")</span>
                                }
                            </div>

                            <div class="ra-campo ra-grid-full">
                                <div class="form-check form-switch mb-2">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           id="chk-notif-misma"
                                           checked="@modelo.DireccionNotificacionesEsMisma"
                                           @onchange="OnToggleNotificacionesEsMisma" />
                                    <label class="form-check-label fw-bold" for="chk-notif-misma">
                                        La dirección de notificaciones es la misma dirección principal
                                    </label>
                                </div>
                                @if (!modelo.DireccionNotificacionesEsMisma)
                                {
                                    <div class="ra-campo mt-2">
                                        <label class="ra-label" for="txt-dir-notif">
                                            Dirección para notificaciones
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                        <input id="txt-dir-notif"
                                               type="text"
                                               class="ra-input"
                                               placeholder="Ej.: Apartado Aéreo 102 / Calle 96 # 102-15"
                                               @bind="modelo.DireccionNotificaciones" />
                                    </div>
                                }
                            </div>

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="txt-sitio-web">
                                        Sitio web o portal oficial
                                        <span class="ra-badge-opc">Opcional</span>
                                    </label>
                                    <span class="ra-hint">Dirección web institucional.</span>
                                </div>
                                <input id="txt-sitio-web"
                                       type="url"
                                       class="ra-input"
                                       placeholder="Ej.: https://asoagro-uraba.org"
                                       @bind="modelo.SitioWeb" />
                            </div>

                            <div class="ra-subtarjeta ra-grid-full">
                                <h4 class="ra-subtarjeta-titulo">
                                    <i class="bi bi-person-lines-fill"></i> Persona de Contacto Institucional (Opcional)
                                </h4>
                                <p class="small text-muted mb-2">
                                    Datos exclusivamente de contacto para trámites oficiales de la asociación. No constituyen expediente personal de asociado ni requieren cédula.
                                </p>
                                <div class="ra-grid">
                                    <div class="ra-campo">
                                        <label class="ra-label" for="txt-contacto-nombre">
                                            Nombre completo del enlace
                                            <span class="ra-badge-opc">Opcional</span>
                                        </label>
                                        <input id="txt-contacto-nombre"
                                               type="text"
                                               class="ra-input"
                                               placeholder="Ej.: Karen Argumedo"
                                               @bind="modelo.ContactoNombre" />
                                    </div>
                                    <div class="ra-campo">
                                        <label class="ra-label" for="txt-contacto-cargo">
                                            Cargo en la organización
                                            <span class="ra-badge-opc">Opcional</span>
                                        </label>
                                        <input id="txt-contacto-cargo"
                                               type="text"
                                               class="ra-input"
                                               placeholder="Ej.: Secretaria General / Coordinadora Administrativa"
                                               @bind="modelo.ContactoCargo" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- =========================================================================================
                 PASO 3: REGISTRO LEGAL Y CONSTITUCIÓN (LEY 2219 DE 2022)
                 ========================================================================================= -->
            @if (pasoActual == 3)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-doc" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Sección 3 de 7</span>
                            <h2>Registro Legal y Constitución (Ley 2219 de 2022)</h2>
                            <p>Inscripción formal, matrícula, soporte RUES y elementos estatutarios pertinentes.</p>
                        </div>
                        <span class="ra-estado @(EsPasoCompleto(3) ? "ra-estado-ok" : "")">
                            @(EsPasoCompleto(3) ? "Completo" : "Pendiente")
                        </span>
                    </header>

                    <div class="ra-body">
                        <!-- Datos de Registro Oficial -->
                        <div class="ra-subtarjeta">
                            <h4 class="ra-subtarjeta-titulo">
                                <i class="bi bi-bank"></i> Datos de Inscripción Oficial
                            </h4>
                            <div class="ra-grid">
                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Entidad donde está inscrita
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                        <span class="ra-hint">Cámara de Comercio o entidad competente.</span>
                                    </div>
                                    <input type="text"
                                           class="ra-input @(TieneError("EntidadInscripcion") ? "ra-input-error" : "")"
                                           placeholder="Ej.: Cámara de Comercio de Urabá"
                                           @bind="modelo.EntidadInscripcion"
                                           @bind:after='() => ValidarCampo("EntidadInscripcion")' />
                                    @if (TieneError("EntidadInscripcion"))
                                    {
                                        <span class="ra-error-campo">@ObtenerError("EntidadInscripcion")</span>
                                    }
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Número de matrícula o radicado
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                        <span class="ra-hint">Identificador oficial en el registro público.</span>
                                    </div>
                                    <input type="text"
                                           class="ra-input @(TieneError("NumeroRegistro") ? "ra-input-error" : "")"
                                           placeholder="Ej.: 00028471-03"
                                           @bind="modelo.NumeroRegistro"
                                           @bind:after='() => ValidarCampo("NumeroRegistro")' />
                                    @if (TieneError("NumeroRegistro"))
                                    {
                                        <span class="ra-error-campo">@ObtenerError("NumeroRegistro")</span>
                                    }
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Fecha de inscripción en registro
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                        <span class="ra-hint">Fecha oficial de expedición de matrícula.</span>
                                    </div>
                                    <input type="date"
                                           max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                           class="ra-input"
                                           @bind="modelo.FechaInscripcion" />
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Cámara de Comercio y número RUES
                                            <span class="ra-badge-opc">Opcional</span>
                                        </label>
                                        <span class="ra-hint">Código único de registro empresarial.</span>
                                    </div>
                                    <input type="text"
                                           class="ra-input"
                                           placeholder="Ej.: RUES CCU-984712"
                                           @bind="modelo.NumeroRues" />
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Autoridad de inspección, vigilancia y control
                                            <span class="ra-badge-opc">Opcional</span>
                                        </label>
                                        <span class="ra-hint">Entidad estatal competente (ej. Gobernación, MinAgricultura).</span>
                                    </div>
                                    <input type="text"
                                           class="ra-input"
                                           placeholder="Ej.: Gobernación de Antioquia / MinAgricultura"
                                           @bind="modelo.AutoridadVigilancia" />
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Fecha de renovación de matrícula
                                            <span class="ra-badge-opc">Opcional</span>
                                        </label>
                                        <span class="ra-hint">Generará alerta anual de renovación mercantil.</span>
                                    </div>
                                    <input type="date" class="ra-input" @bind="modelo.FechaRenovacionMatricula" />
                                </div>
                            </div>
                        </div>

                        <!-- Elementos pertinentes Ley 2219 de 2022 -->
                        <div class="ra-subtarjeta">
                            <h4 class="ra-subtarjeta-titulo">
                                <i class="bi bi-file-earmark-check"></i> Elementos Constitutivos (Ley 2219 de 2022)
                            </h4>
                            <div class="ra-grid">
                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Fecha de asamblea fundacional
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                    </div>
                                    <input type="date" class="ra-input" @bind="modelo.FechaAsambleaConstitucion" />
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Aprobación de estatutos
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                    </div>
                                    <div class="d-flex gap-3 align-items-center mt-2">
                                        <label class="small"><input type="radio" name="aprob-est" checked="@modelo.AprobacionEstatutos" @onchange="() => modelo.AprobacionEstatutos = true" /> Sí, aprobados en asamblea</label>
                                        <label class="small"><input type="radio" name="aprob-est" checked="@(!modelo.AprobacionEstatutos)" @onchange="() => modelo.AprobacionEstatutos = false" /> Pendiente de protocolización</label>
                                    </div>
                                </div>

                                <div class="ra-campo ra-grid-full">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Cuotas iniciales de sostenimiento
                                            <span class="ra-badge-opc">Opcional</span>
                                        </label>
                                        <span class="ra-hint">Acuerdos económicos fijados por fundadores en asamblea.</span>
                                    </div>
                                    <div class="d-flex gap-3 align-items-center mb-2">
                                        <label class="small"><input type="radio" name="cuotas-acord" checked="@modelo.CuotasInicialesAcordadas" @onchange="() => modelo.CuotasInicialesAcordadas = true" /> Sí acordadas</label>
                                        <label class="small"><input type="radio" name="cuotas-acord" checked="@(!modelo.CuotasInicialesAcordadas)" @onchange="() => modelo.CuotasInicialesAcordadas = false" /> No acordadas inicialmente</label>
                                    </div>
                                    @if (modelo.CuotasInicialesAcordadas)
                                    {
                                        <input type="text"
                                               class="ra-input"
                                               placeholder="Ej.: Cuota de ingreso $50.000 y sostenimiento mensual $20.000"
                                               @bind="modelo.DetalleCuotasIniciales" />
                                    }
                                </div>

                                <div class="ra-campo ra-grid-full">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Reglas de autogobierno y autocontrol en estatutos
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                        <span class="ra-hint">Mecanismos de toma de decisiones, mayorías y comités de control social.</span>
                                    </div>
                                    <textarea class="ra-textarea"
                                              placeholder="Ej.: Asamblea general ordinaria anual con quórum del 50%+1; comité de control social de 3 miembros..."
                                              @bind="modelo.ReglasAutogobierno"></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Carga documental independiente del Paso 3 -->
                        <h4 class="mt-2 mb-2 fw-bold text-dark fs-6">Soportes Documentales de Constitución</h4>
                        <div class="d-flex flex-column gap-3">
                            @RenderCardDocumento("DOC_ACTA_CONST", "Acta de Constitución Firmada", "Acta original firmada por los asociados fundadores con la declaración de constitución.")
                            @RenderCardDocumento("DOC_ESTATUTOS", "Estatutos Vigentes Aprobados", "Texto estatutario completo y formalmente vigente de la asociación.")
                            @RenderCardDocumento("DOC_CERT_CONST", "Constancia o Certificado de Inscripción de la Constitución", "Certificado de personería jurídica emitido por la autoridad competente.")
                            @RenderCardDocumento("DOC_CERT_REPRESENTACION", "Certificado de Existencia y Representación Legal Vigente", "Certificado de Cámara de Comercio con expedición reciente para trámites y convenios.")
                            @RenderCardDocumento("DOC_REFORMAS_EST", "Reformas Estatutarias y Actas de Aprobación", "Actas y textos de modificaciones posteriores a los estatutos fundacionales.")
                        </div>
                    </div>
                </div>
            }

            <!-- =========================================================================================
                 PASO 4: REPRESENTACIÓN Y GOBIERNO INSTITUCIONAL
                 ========================================================================================= -->
            @if (pasoActual == 4)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-usuario" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Sección 4 de 7</span>
                            <h2>Representación y Gobierno Institucional</h2>
                            <p>Cargos directivos vigentes, periodos estatutarios y soportes de nombramiento.</p>
                        </div>
                        <span class="ra-estado @(EsPasoCompleto(4) ? "ra-estado-ok" : "")">
                            @(EsPasoCompleto(4) ? "Completo" : "Pendiente")
                        </span>
                    </header>

                    <div class="ra-body">
                        <!-- Representante Legal -->
                        <div class="ra-subtarjeta">
                            <h4 class="ra-subtarjeta-titulo">
                                <i class="bi bi-person-badge"></i> Representación Legal Vigente
                            </h4>
                            <div class="ra-grid">
                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Nombre del Representante Legal
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                        <span class="ra-hint">Nombre de quien ostenta la representación jurídica.</span>
                                    </div>
                                    <input type="text"
                                           class="ra-input @(TieneError("RepLegalNombre") ? "ra-input-error" : "")"
                                           placeholder="Ej.: Manuela Andrea Mosquera"
                                           @bind="modelo.RepLegalNombre"
                                           @bind:after='() => ValidarCampo("RepLegalNombre")' />
                                    @if (TieneError("RepLegalNombre"))
                                    {
                                        <span class="ra-error-campo">@ObtenerError("RepLegalNombre")</span>
                                    }
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Cargo formal
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                    </div>
                                    <input type="text" class="ra-input" placeholder="Ej.: Representante Legal / Directora" @bind="modelo.RepLegalCargo" />
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Documento de contacto
                                            <span class="ra-badge-opc">Opcional</span>
                                        </label>
                                    </div>
                                    <input type="text" class="ra-input" placeholder="Ej.: 1045123890" @bind="modelo.RepLegalDocumento" />
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Fecha de nombramiento / elección
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                    </div>
                                    <input type="date" class="ra-input" @bind="modelo.RepLegalFechaNombramiento" />
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Inicio del periodo
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                    </div>
                                    <input type="date" class="ra-input" @bind="modelo.RepLegalPeriodoInicio" />
                                </div>

                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Fin del periodo (Vencimiento)
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                        <span class="ra-hint">Alimentará las alertas de renovación institucional.</span>
                                    </div>
                                    <input type="date"
                                           class="ra-input @(TieneError("RepLegalPeriodoFin") ? "ra-input-error" : "")"
                                           @bind="modelo.RepLegalPeriodoFin"
                                           @bind:after='() => ValidarCampo("RepLegalPeriodoFin")' />
                                    @if (TieneError("RepLegalPeriodoFin"))
                                    {
                                        <span class="ra-error-campo">@ObtenerError("RepLegalPeriodoFin")</span>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Junta Directiva -->
                        <div class="ra-subtarjeta">
                            <h4 class="ra-subtarjeta-titulo">
                                <i class="bi bi-people"></i> Integrantes de la Junta Directiva
                            </h4>
                            <div class="ra-grid">
                                <div class="ra-campo">
                                    <label class="ra-label">Presidente(a) de Junta</label>
                                    <input type="text" class="ra-input" placeholder="Ej.: Carlos Julio Ramírez" @bind="modelo.JuntaPresidente" />
                                </div>
                                <div class="ra-campo">
                                    <label class="ra-label">Vicepresidente(a)</label>
                                    <input type="text" class="ra-input" placeholder="Ej.: María Elena Mendoza" @bind="modelo.JuntaVicepresidente" />
                                </div>
                                <div class="ra-campo">
                                    <label class="ra-label">Secretario(a)</label>
                                    <input type="text" class="ra-input" placeholder="Ej.: Karen Argumedo" @bind="modelo.JuntaSecretario" />
                                </div>
                                <div class="ra-campo">
                                    <label class="ra-label">Tesorero(a)</label>
                                    <input type="text" class="ra-input" placeholder="Ej.: Gabriel Restrepo" @bind="modelo.JuntaTesorero" />
                                </div>
                                <div class="ra-campo ra-grid-full">
                                    <label class="ra-label">Periodo estatutario de la Junta Directiva</label>
                                    <input type="text" class="ra-input" placeholder="Ej.: Periodo ordinario 2024 - 2026 (2 años)" @bind="modelo.JuntaPeriodo" />
                                </div>
                            </div>
                        </div>

                        <!-- Fiscal o Revisor Fiscal -->
                        <div class="ra-subtarjeta">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h4 class="ra-subtarjeta-titulo mb-0 border-0 p-0">
                                    <i class="bi bi-shield-check"></i> Fiscal o Revisor Fiscal
                                </h4>
                                <div class="form-check form-switch mb-0">
                                    <input class="form-check-input" type="checkbox" id="chk-fiscal-aplica" checked="@modelo.FiscalAplica" @onchange="OnToggleFiscalAplica" />
                                    <label class="form-check-label small fw-bold" for="chk-fiscal-aplica">
                                        @(modelo.FiscalAplica ? "Aplica a la asociación" : "Marcar como No aplica")
                                    </label>
                                </div>
                            </div>

                            @if (modelo.FiscalAplica)
                            {
                                <div class="ra-grid">
                                    <div class="ra-campo">
                                        <label class="ra-label">Tipo de órgano de control</label>
                                        <select class="ra-select" @bind="modelo.FiscalTipo">
                                            <option value="Fiscal principal (Asociado)">Fiscal principal (Elegido en asamblea)</option>
                                            <option value="Revisor fiscal con matrícula">Revisor fiscal con matrícula profesional</option>
                                            <option value="Comité de Control Social">Comité de Control Social</option>
                                        </select>
                                    </div>
                                    <div class="ra-campo">
                                        <label class="ra-label">Nombre del fiscal / firma contable</label>
                                        <input type="text" class="ra-input" placeholder="Ej.: Claudia Patricia Henao" @bind="modelo.FiscalNombre" />
                                    </div>
                                    <div class="ra-campo">
                                        <label class="ra-label">Periodo de vigencia</label>
                                        <input type="text" class="ra-input" placeholder="Ej.: 2024 - 2026" @bind="modelo.FiscalPeriodo" />
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="ra-campo">
                                    <label class="ra-label">Motivo o justificación de por qué no aplica <span class="ra-badge-req">Obligatorio</span></label>
                                    <input type="text"
                                           class="ra-input"
                                           placeholder="Ej.: Por tipología asociativa y estatutos, el control lo ejerce directamente la asamblea."
                                           @bind="modelo.FiscalMotivoNoAplica" />
                                </div>
                            }
                        </div>

                        <!-- Soportes Documentales del Paso 4 -->
                        <h4 class="mt-2 mb-2 fw-bold text-dark fs-6">Soportes Documentales de Nombramiento</h4>
                        <div class="d-flex flex-column gap-3">
                            @RenderCardDocumento("DOC_ACTA_ELECCION", "Acta o Documento de Nombramiento", "Acta de asamblea donde se eligió el Representante Legal y los dignatarios vigentes.")
                            @RenderCardDocumento("DOC_ACEPTACION_CARGOS", "Constancias de Aceptación del Cargo", "Cartas suscritas de aceptación de funciones por los dignatarios electos.")
                            @RenderCardDocumento("DOC_SOPORTE_INSCRIPCION_NOMB", "Soporte de Inscripción del Nombramiento", "Constancia de radicación e inscripción ante la Cámara de Comercio.")
                        </div>
                    </div>
                </div>
            }

            <!-- =========================================================================================
                 PASO 5: IDENTIFICACIÓN TRIBUTARIA
                 ========================================================================================= -->
            @if (pasoActual == 5)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-alerta" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Sección 5 de 7</span>
                            <h2>Identificación Tributaria y Régimen Fiscal</h2>
                            <p>RUT institucional, responsabilidades tributarias confirmadas y trámite de Régimen Tributario Especial.</p>
                        </div>
                        <span class="ra-estado @(EsPasoCompleto(5) ? "ra-estado-ok" : "")">
                            @(EsPasoCompleto(5) ? "Completo" : "Pendiente")
                        </span>
                    </header>

                    <div class="ra-body">
                        <div class="ra-grid">
                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label">
                                        Estado de inscripción en el RUT
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                </div>
                                <select class="ra-select" @bind="modelo.RutEstado">
                                    <option value="Inscrita y activa">Inscrita y activa ante DIAN</option>
                                    <option value="Pendiente / En trámite">Pendiente / En trámite de asignación</option>
                                    <option value="No aplica">No aplica</option>
                                </select>
                            </div>

                            @if (modelo.RutEstado == "No aplica")
                            {
                                <div class="ra-campo ra-grid-full">
                                    <label class="ra-label">Justificación de no aplicación del RUT <span class="ra-badge-req">Obligatorio</span></label>
                                    <input type="text" class="ra-input" placeholder="Explique la razón legal o tributaria" @bind="modelo.RutEstadoMotivo" />
                                </div>
                            }
                            else
                            {
                                <div class="ra-campo">
                                    <div class="ra-label-fila">
                                        <label class="ra-label">
                                            Fecha de expedición o actualización del RUT
                                            <span class="ra-badge-req">Obligatorio</span>
                                        </label>
                                    </div>
                                    <input type="date" class="ra-input" @bind="modelo.RutFechaActualizacion" />
                                </div>
                            }

                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label">
                                        Régimen tributario en el RUT
                                        <span class="ra-badge-req">Obligatorio</span>
                                    </label>
                                </div>
                                <select class="ra-select" @bind="modelo.RegimenTributario" @bind:after="OnRegimenTributarioCambiado">
                                    <option value="Régimen Ordinario">Régimen Ordinario de Renta</option>
                                    <option value="Régimen Tributario Especial (RTE)">Régimen Tributario Especial (RTE - DIAN)</option>
                                    <option value="No contribuyente de renta">No contribuyente de renta</option>
                                    <option value="Otro régimen">Otro régimen</option>
                                </select>
                            </div>
                        </div>

                        <!-- Responsabilidades Tributarias Confirmadas (Casilla 53) -->
                        <div class="ra-subtarjeta">
                            <h4 class="ra-subtarjeta-titulo">
                                <i class="bi bi-card-checklist"></i> Responsabilidades Tributarias Confirmadas en el RUT (Casilla 53)
                            </h4>
                            <p class="small text-muted mb-2">Seleccione únicamente los códigos que figuran expresamente en el RUT vigente de la asociación:</p>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var resp in catalogoResponsabilidades)
                                {
                                    var checkedVal = modelo.ResponsabilidadesTributarias.Contains(resp);
                                    <label class="btn btn-sm @(checkedVal ? "btn-success" : "btn-outline-secondary") d-flex align-items-center gap-1.5" style="border-radius: 6px;">
                                        <input type="checkbox"
                                               class="d-none"
                                               checked="@checkedVal"
                                               @onchange="(e) => ToggleResponsabilidad(resp, (bool?)e.Value ?? false)" />
                                        <i class="bi @(checkedVal ? "bi-check-square-fill" : "bi-square")"></i>
                                        <span>@resp</span>
                                    </label>
                                }
                            </div>
                        </div>

                        <!-- Bloque de Régimen Tributario Especial (RTE) -->
                        @if (modelo.RegimenTributario == "Régimen Tributario Especial (RTE)")
                        {
                            <div class="ra-subtarjeta border-success bg-white">
                                <h4 class="ra-subtarjeta-titulo text-success">
                                    <i class="bi bi-award"></i> Actualización Anual Régimen Tributario Especial (DIAN)
                                </h4>
                                <div class="ra-grid">
                                    <div class="ra-campo">
                                        <label class="ra-label">Estado de la actualización ante DIAN</label>
                                        <select class="ra-select" @bind="modelo.RteEstadoDian">
                                            <option value="Permanencia anual confirmada">Permanencia anual confirmada</option>
                                            <option value="Solicitud de actualización radicada">Solicitud de actualización radicada</option>
                                            <option value="Calificación inicial en trámite">Calificación inicial en trámite</option>
                                        </select>
                                    </div>
                                    <div class="ra-campo">
                                        <label class="ra-label">Fecha de última radicación DIAN</label>
                                        <input type="date" class="ra-input" @bind="modelo.RteUltimaActualizacion" />
                                    </div>
                                    <div class="ra-campo">
                                        <label class="ra-label">Fecha límite próxima renovación anual RTE</label>
                                        <input type="date" class="ra-input" @bind="modelo.RteFechaLimiteRenovacion" />
                                        <span class="ra-hint">Plazo legal DIAN: Generalmente 30 de junio de cada año.</span>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Carga Documental Fiscal -->
                        <h4 class="mt-2 mb-2 fw-bold text-dark fs-6">Soportes Documentales Fiscales</h4>
                        <div class="d-flex flex-column gap-3">
                            @RenderCardDocumento("DOC_RUT", "Archivo del RUT Actualizado", "Copia digitalizada en PDF expedida por la DIAN con fecha reciente.")
                            @RenderCardDocumento("DOC_DECLARACION_RENTA", "Declaración de Renta e Ingresos", "Formulario 110 con acuse de recibo de la DIAN del último año gravable.")
                            @RenderCardDocumento("DOC_ESTADOS_FINANCIEROS", "Estados Financieros Certificados con Dictamen", "Balance y Estado de Resultados dictaminados por contador o revisor fiscal.")
                            @if (modelo.RegimenTributario == "Régimen Tributario Especial (RTE)")
                            {
                                @RenderCardDocumento("DOC_SOPORTES_RTE", "Memoria Económica y Soportes DIAN - RTE", "Acta de asamblea con destinación de excedentes y soportes web DIAN.")
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- =========================================================================================
                 PASO 6: ACTAS Y DOCUMENTACIÓN INSTITUCIONAL RECURRENTE
                 ========================================================================================= -->
            @if (pasoActual == 6)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-lista" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Sección 6 de 7</span>
                            <h2>Actas y Documentación Institucional Recurrente</h2>
                            <p>Asambleas generales ordinarias, extraordinarias, juntas directivas y aprobación de informes periódicos.</p>
                        </div>
                        <span class="ra-estado @(EsPasoCompleto(6) ? "ra-estado-ok" : "")">
                            @(EsPasoCompleto(6) ? "Completo" : "Pendiente")
                        </span>
                    </header>

                    <div class="ra-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h4 class="fw-bold text-dark mb-0 fs-6">Registro de Actas y Decisiones Colectivas</h4>
                                <span class="small text-muted">Registre cada acta según la periodicidad aprobada por los estatutos de la asociación.</span>
                            </div>
                            <button type="button" class="ra-btn ra-btn-secundario py-1" @onclick="AgregarNuevaActaRecurrente">
                                <i class="bi bi-plus-lg"></i> Agregar otra acta
                            </button>
                        </div>

                        <div class="d-flex flex-column gap-3 mt-2">
                            @for (int i = 0; i < listaActasRecurrentes.Count; i++)
                            {
                                var indexActa = i;
                                var acta = listaActasRecurrentes[indexActa];
                                <div class="ra-subtarjeta bg-white">
                                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                                        <strong class="text-success"><i class="bi bi-journal-text me-1"></i> Acta #@(indexActa + 1)</strong>
                                        @if (listaActasRecurrentes.Count > 1)
                                        {
                                            <button type="button" class="btn btn-outline-danger btn-sm py-0" @onclick="() => EliminarActaRecurrente(indexActa)">
                                                <i class="bi bi-trash"></i> Quitar acta
                                            </button>
                                        }
                                    </div>
                                    <div class="ra-grid">
                                        <div class="ra-campo">
                                            <label class="ra-label">
                                                Tipo de sesión o acta
                                                <span class="ra-badge-req">Obligatorio</span>
                                            </label>
                                            <select class="ra-select" @bind="acta.TipoDocumento">
                                                <option value="Acta de Asamblea General Ordinaria">Acta de Asamblea General Ordinaria</option>
                                                <option value="Acta de Asamblea General Extraordinaria">Acta de Asamblea General Extraordinaria</option>
                                                <option value="Acta de Reunión de Junta Directiva">Acta de Reunión de Junta Directiva</option>
                                                <option value="Acta de Aprobación de Estados Financieros y Presupuesto">Acta de Aprobación de Estados Financieros y Presupuesto</option>
                                                <option value="Acta de Fijación de Cuotas de Sostenimiento">Acta de Fijación de Cuotas de Sostenimiento</option>
                                                <option value="Informe Anual de Gestión Institucional">Informe Anual de Gestión Institucional</option>
                                                <option value="Acta de Reforma Estatutaria">Acta de Reforma Estatutaria</option>
                                                <option value="Acta de Elección de Dignatarios">Acta de Elección de Dignatarios</option>
                                            </select>
                                        </div>
                                        <div class="ra-campo">
                                            <label class="ra-label">
                                                Número de acta / radicado
                                                <span class="ra-badge-req">Obligatorio</span>
                                            </label>
                                            <input type="text" class="ra-input" placeholder="Ej.: Acta No. 018" @bind="acta.NumeroReferencia" />
                                        </div>
                                        <div class="ra-campo">
                                            <label class="ra-label">
                                                Fecha de asamblea / aprobación
                                                <span class="ra-badge-req">Obligatorio</span>
                                            </label>
                                            <input type="date" class="ra-input" @bind="acta.FechaEmision" />
                                        </div>
                                        <div class="ra-campo">
                                            <label class="ra-label">
                                                Periodo al que corresponde
                                                <span class="ra-badge-req">Obligatorio</span>
                                            </label>
                                            <input type="text" class="ra-input" placeholder="Ej.: Ejercicio 2025" @bind="acta.Periodo" />
                                        </div>
                                        <div class="ra-campo">
                                            <label class="ra-label">
                                                Frecuencia establecida en estatutos
                                                <span class="ra-badge-req">Obligatorio</span>
                                            </label>
                                            <select class="ra-select" @bind="acta.EntidadEmisora">
                                                <option value="Anual ordinaria">Anual ordinaria</option>
                                                <option value="Semestral">Semestral</option>
                                                <option value="Trimestral">Trimestral</option>
                                                <option value="Mensual">Mensual</option>
                                                <option value="Extraordinaria">Extraordinaria</option>
                                            </select>
                                        </div>
                                        <div class="ra-campo ra-grid-full">
                                            <label class="ra-label">Resumen de decisiones aprobadas</label>
                                            <input type="text" class="ra-input" placeholder="Ej.: Aprobación unánime de presupuesto y balance anual..." @bind="acta.Observaciones" />
                                        </div>

                                        <!-- Subir archivo de esta acta -->
                                        <div class="ra-campo ra-grid-full">
                                            <label class="ra-label">Archivo digitalizado del acta (PDF, JPG, PNG)</label>
                                            @if (!string.IsNullOrWhiteSpace(acta.ArchivoNombre))
                                            {
                                                <div class="ra-archivo-box">
                                                    <div class="ra-archivo-info">
                                                        <span class="ra-archivo-ico"><i class="bi bi-file-earmark-pdf"></i></span>
                                                        <div class="ra-archivo-nombres">
                                                            <strong>@acta.ArchivoNombre</strong>
                                                            <small>@FormatearBytes(acta.TamanoBytes)</small>
                                                        </div>
                                                    </div>
                                                    <button type="button" class="ra-archivo-btn-quitar" @onclick="() => QuitarArchivoActa(indexActa)">
                                                        <i class="bi bi-x-circle"></i> Quitar
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <InputFile class="ra-input py-1" OnChange="(e) => OnSubirArchivoActa(e, indexActa)" accept=".pdf,.png,.jpg,.jpeg" />
                                                <span class="ra-hint">Límite: hasta 10 MB por archivo.</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- =========================================================================================
                 PASO 7: OTROS DOCUMENTOS Y REVISIÓN FINAL (RESUMEN + DESCARGA PDF)
                 ========================================================================================= -->
            @if (pasoActual == 7)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-check" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Sección 7 de 7</span>
                            <h2>Otros Documentos Sectoriales y Revisión Final</h2>
                            <p>Soportes de convocatorias, permisos sectoriales, descarga de resumen en PDF y radicación oficial.</p>
                        </div>
                        <span class="ra-estado ra-estado-ok">Revisión Final</span>
                    </header>

                    <div class="ra-body">
                        <!-- Bloque de Documentos Sectoriales -->
                        <h4 class="fw-bold text-dark mb-2 fs-6">Soportes Sectoriales y Convocatorias</h4>
                        <div class="d-flex flex-column gap-3 mb-4">
                            @RenderCardDocumento("DOC_REGISTRO_ICA", "Certificado Fitosanitario / Registro ICA", "Certificación de sanidad vegetal, predio exportador o registro sanitario ante el ICA.")
                            @RenderCardDocumento("DOC_AVAL_MINAGRO", "Aval Institucional ante MinAgricultura o ADR", "Constancia de registro en el Sistema Nacional de Asociaciones Agropecuarias o ADR.")
                            @RenderCardDocumento("DOC_PERMISO_CORPOURABA", "Permiso Ambiental / Concesión Corpouraba", "Permisos de aprovechamiento o registros ambientales regionales si aplican.")
                            @RenderCardDocumento("DOC_AVAL_BPA_GREMIAL", "Certificación Colectiva de Buenas Prácticas Agrícolas (BPA)", "Aval grupal o acompañamiento técnico en BPA para convocatorias de exportación.")
                            @RenderCardDocumento("DOC_CONVENIOS_PROYECTOS", "Documentos para Convocatorias y Convenios", "Propuestas, cartas de intención o convenios suscritos por la entidad.")

                            <!-- Documento libre / personalizado -->
                            <div class="ra-subtarjeta bg-white">
                                <h4 class="ra-subtarjeta-titulo">
                                    <i class="bi bi-file-earmark-plus"></i> Otro Documento Legal o Institucional Personalizado
                                </h4>
                                <div class="ra-grid">
                                    <div class="ra-campo">
                                        <label class="ra-label">Nombre del documento <span class="ra-badge-opc">Opcional</span></label>
                                        <input type="text" class="ra-input" placeholder="Ej.: Contrato de comodato de sede institucional" @bind="docPersonalizado.Titulo" />
                                    </div>
                                    <div class="ra-campo">
                                        <label class="ra-label">Entidad que lo expide</label>
                                        <input type="text" class="ra-input" placeholder="Ej.: Alcaldía Municipal de Apartadó" @bind="docPersonalizado.EntidadEmisora" />
                                    </div>
                                    <div class="ra-campo">
                                        <label class="ra-label">Fecha de emisión</label>
                                        <input type="date" class="ra-input" @bind="docPersonalizado.FechaEmision" />
                                    </div>
                                    <div class="ra-campo">
                                        <label class="ra-label">Fecha de vencimiento (si tiene)</label>
                                        <input type="date" class="ra-input" @bind="docPersonalizado.FechaVencimiento" />
                                    </div>
                                    <div class="ra-campo ra-grid-full">
                                        <label class="ra-label">Archivo digitalizado</label>
                                        @if (!string.IsNullOrWhiteSpace(docPersonalizado.ArchivoNombre))
                                        {
                                            <div class="ra-archivo-box">
                                                <div class="ra-archivo-info">
                                                    <span class="ra-archivo-ico"><i class="bi bi-file-earmark-check"></i></span>
                                                    <div class="ra-archivo-nombres">
                                                        <strong>@docPersonalizado.ArchivoNombre</strong>
                                                        <small>@FormatearBytes(docPersonalizado.TamanoBytes)</small>
                                                    </div>
                                                </div>
                                                <button type="button" class="ra-archivo-btn-quitar" @onclick="() => { docPersonalizado.ArchivoNombre = null; docPersonalizado.ArchivoContenido = null; }">
                                                    <i class="bi bi-x-circle"></i> Quitar
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <InputFile class="ra-input py-1" OnChange="OnSubirArchivoPersonalizado" accept=".pdf,.png,.jpg,.jpeg" />
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ========================================================
                             RESUMEN EDITABLE COMPLETO ANTES DE CONFIRMAR
                             ======================================================== -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h4 class="fw-bold text-dark mb-0 fs-5"><i class="bi bi-card-checklist me-1 text-success"></i> Resumen del Expediente Institucional</h4>
                            <button type="button" class="ra-btn ra-btn-pdf shadow-sm" @onclick="DescargarResumenPdf">
                                <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                                <span>Descargar resumen en PDF</span>
                            </button>
                        </div>

                        <!-- Tarjeta 1: Identificación y Domicilio -->
                        <div class="ra-resumen-card mb-3">
                            <div class="ra-resumen-card-header">
                                <h3><i class="bi bi-building"></i> Asociación y Personería Jurídica</h3>
                                <button type="button" class="ra-resumen-btn-editar" @onclick="() => IrAlPaso(1)">Editar Paso 1</button>
                            </div>
                            <div class="ra-resumen-grid">
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Razón Social</span>
                                    <span class="ra-resumen-valor">@(string.IsNullOrWhiteSpace(modelo.NombreLegal) ? "No indicada" : modelo.NombreLegal) @(string.IsNullOrWhiteSpace(modelo.Sigla) ? "" : $"({modelo.Sigla})")</span>
                                </div>
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">NIT Institucional</span>
                                    <span class="ra-resumen-valor">@(string.IsNullOrWhiteSpace(modelo.Nit) ? "En trámite" : $"{modelo.Nit}-{modelo.DigitoVerificacion}") · Matrícula: @(string.IsNullOrWhiteSpace(modelo.NumeroRegistro) ? "Pendiente" : modelo.NumeroRegistro)</span>
                                </div>
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Tipo y Grado</span>
                                    <span class="ra-resumen-valor">@modelo.TipoOrganizacion · @modelo.GradoOrganizacion</span>
                                </div>
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Ámbito y Estado</span>
                                    <span class="ra-resumen-valor text-success fw-bold">@modelo.Ambito · @modelo.Estado</span>
                                </div>
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Sede y Municipio</span>
                                    <span class="ra-resumen-valor">@modelo.DireccionPrincipal, @modelo.Municipio (@modelo.Departamento)</span>
                                </div>
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Canales Oficiales</span>
                                    <span class="ra-resumen-valor">@modelo.CorreoInstitucional · Tel. @modelo.TelefonoContacto</span>
                                </div>
                            </div>
                        </div>

                        <!-- Tarjeta 2: Órganos Directivos y Régimen Fiscal -->
                        <div class="ra-resumen-card mb-3">
                            <div class="ra-resumen-card-header">
                                <h3><i class="bi bi-diagram-3"></i> Representación Legal y Régimen Fiscal</h3>
                                <button type="button" class="ra-resumen-btn-editar" @onclick="() => IrAlPaso(4)">Editar Órganos</button>
                            </div>
                            <div class="ra-resumen-grid">
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Representante Legal</span>
                                    <span class="ra-resumen-valor">@(string.IsNullOrWhiteSpace(modelo.RepLegalNombre) ? "No indicado" : modelo.RepLegalNombre) · Vence: @(modelo.RepLegalPeriodoFin?.ToString("dd/MM/yyyy") ?? "No indicada")</span>
                                </div>
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Presidente de Junta</span>
                                    <span class="ra-resumen-valor">@(string.IsNullOrWhiteSpace(modelo.JuntaPresidente) ? "No especificado" : modelo.JuntaPresidente)</span>
                                </div>
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Órgano de Control</span>
                                    <span class="ra-resumen-valor">@(modelo.FiscalAplica ? $"{modelo.FiscalTipo}: {modelo.FiscalNombre}" : $"No aplica: {modelo.FiscalMotivoNoAplica}")</span>
                                </div>
                                <div class="ra-resumen-item">
                                    <span class="ra-resumen-etiqueta">Régimen y RUT</span>
                                    <span class="ra-resumen-valor">@modelo.RegimenTributario · Estado RUT: @modelo.RutEstado</span>
                                </div>
                            </div>
                        </div>

                        <!-- Tarjeta 3: Inventario de Documentos -->
                        <div class="ra-resumen-card mb-3">
                            <div class="ra-resumen-card-header">
                                <h3><i class="bi bi-folder-check"></i> Inventario de Documentos del Expediente</h3>
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                    @ContarDocumentosAdjuntos() archivos digitalizados
                                </span>
                            </div>
                            <div class="table-responsive">
                                <table class="ra-resumen-tabla">
                                    <thead>
                                        <tr>
                                            <th>Documento Institucional</th>
                                            <th>Condición / Estado</th>
                                            <th>Archivo Cargado</th>
                                            <th>Vigencia / Observación</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var doc in catalogoDocumentosConfigurados.Values)
                                        {
                                            <tr>
                                                <td class="fw-bold">@doc.TipoDocumento</td>
                                                <td>
                                                    @if (doc.EstadoRequisito == "No aplica")
                                                    {
                                                        <span class="badge bg-light text-muted border">No aplica</span>
                                                    }
                                                    else if (!string.IsNullOrWhiteSpace(doc.ArchivoNombre))
                                                    {
                                                        <span class="badge bg-success">Digitalizado</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning text-dark">Pendiente de archivo</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (!string.IsNullOrWhiteSpace(doc.ArchivoNombre))
                                                    {
                                                        <span class="text-truncate d-inline-block" style="max-width: 200px;">@doc.ArchivoNombre</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Sin archivo</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (doc.EstadoRequisito == "No aplica")
                                                    {
                                                        <span class="text-muted small">Motivo: @doc.MotivoNoAplica</span>
                                                    }
                                                    else
                                                    {
                                                        @(doc.FechaVencimiento.HasValue ? doc.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "Sin vencimiento / Vigente")
                                                    }
                                                </td>
                                            </tr>
                                        }

                                        <!-- Actas registradas -->
                                        @foreach (var acta in listaActasRecurrentes)
                                        {
                                            <tr>
                                                <td class="fw-bold">@acta.TipoDocumento (@acta.NumeroReferencia)</td>
                                                <td><span class="badge bg-info text-dark">Acta periódica</span></td>
                                                <td>@(string.IsNullOrWhiteSpace(acta.ArchivoNombre) ? "Sin archivo" : acta.ArchivoNombre)</td>
                                                <td>Celebrada el @(acta.FechaEmision?.ToString("dd/MM/yyyy") ?? "-") · @acta.Periodo</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Nota de Descargo y Auditoría -->
                        <div class="alert alert-light border small text-muted d-flex align-items-center gap-2 mb-0">
                            <i class="bi bi-info-circle text-primary fs-5"></i>
                            <div>
                                Este reporte y expediente es generado por el Sistema de Información ASOAGRO (FAAUA).
                                No reemplaza certificados oficiales de autoridades competentes ni constituye asesoría legal.
                                Responsable: <strong>@usuarioActualNombre</strong> · Fecha de radicación: <strong>@DateTime.Now.ToString("dd/MM/yyyy HH:mm")</strong>.
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- =========================================================================================
                 BOTONES DE ACCIÓN: ANTERIOR / CONTINUAR / GUARDAR
                 ========================================================================================= -->
            <footer class="ra-acciones">
                <div class="ra-acciones-izq">
                    @if (pasoActual > 1)
                    {
                        <button type="button" class="ra-btn ra-btn-secundario" @onclick="PasoAnterior">
                            <i class="bi bi-arrow-left"></i> Anterior
                        </button>
                    }
                    <button type="button" class="ra-btn ra-btn-secundario" @onclick="GuardarBorrador">
                        <i class="bi bi-save"></i> Guardar borrador
                    </button>
                </div>

                <div class="ra-acciones-der">
                    @if (pasoActual < 7)
                    {
                        <button type="button" class="ra-btn ra-btn-primario" @onclick="PasoSiguiente">
                            Continuar al Paso @(pasoActual + 1) <i class="bi bi-arrow-right"></i>
                        </button>
                    }
                    else
                    {
                        <button type="button" class="ra-btn ra-btn-guardar" @onclick="FinalizarYArchivarExpediente" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Archivando expediente...</span>
                            }
                            else
                            {
                                <i class="bi bi-check-all fs-5 me-1"></i>
                                <span>Archivar Expediente Institucional</span>
                            }
                        </button>
                    }
                </div>
            </footer>
        </section>
    </div>
</div>

<!-- =========================================================================================
     MODAL DE CONFIRMACIÓN CORREGIDO (CENTRADO, SIN CORTES, RESPONSIVE)
     ========================================================================================= -->
@if (registroExitoso && expedienteGuardado is not null)
{
    <div class="ra-modal-velo" role="dialog" aria-modal="true" @onclick="CerrarModalExito">
        <article class="ra-exito-modal" @onclick:stopPropagation="true">
            <button type="button" class="ra-exito-cerrar" title="Cerrar ventana" @onclick="CerrarModalExito">&times;</button>

            <div class="ra-exito-icono">
                <i class="bi bi-check-lg"></i>
            </div>

            <h2 class="ra-exito-titulo">¡Expediente Institucional Radicado con Éxito!</h2>
            <p class="ra-exito-subtitulo">
                La documentación de <strong>@expedienteGuardado.NombreLegal</strong> ha quedado formalmente archivada bajo custodia de la Secretaría de FAAUA.
            </p>

            <div class="ra-exito-resumen-compacto">
                <div class="ra-exito-fila-dato">
                    <span class="ra-exito-fila-etiqueta">NIT Institucional</span>
                    <strong class="ra-exito-fila-valor">@(string.IsNullOrWhiteSpace(expedienteGuardado.Nit) ? "En trámite" : $"{expedienteGuardado.Nit}-{expedienteGuardado.DigitoVerificacion}")</strong>
                </div>
                <div class="ra-exito-fila-dato">
                    <span class="ra-exito-fila-etiqueta">Tipo y Ubicación</span>
                    <strong class="ra-exito-fila-valor">@expedienteGuardado.TipoOrganizacion · @expedienteGuardado.Municipio</strong>
                </div>
                <div class="ra-exito-fila-dato">
                    <span class="ra-exito-fila-etiqueta">Representante Legal</span>
                    <strong class="ra-exito-fila-valor">@expedienteGuardado.RepLegalNombre</strong>
                </div>
                <div class="ra-exito-fila-dato">
                    <span class="ra-exito-fila-etiqueta">Soportes Vinculados</span>
                    <strong class="ra-exito-fila-valor">@totalDocumentosArchivados archivos custodiados</strong>
                </div>
                <div class="ra-exito-fila-dato">
                    <span class="ra-exito-fila-etiqueta">Estado del Expediente</span>
                    <strong class="ra-exito-fila-valor text-success">@expedienteGuardado.Estado · Sincronizado</strong>
                </div>
            </div>

            <div class="ra-exito-acciones">
                <button type="button" class="ra-exito-btn-ficha" @onclick="IrAEstadoExpediente">
                    <i class="bi bi-folder2-open me-2"></i>
                    <span>Consultar expediente</span>
                </button>
                <button type="button" class="ra-exito-btn-pdf" @onclick="DescargarResumenPdf">
                    <i class="bi bi-file-earmark-pdf-fill me-1"></i> Descargar Resumen en PDF
                </button>
                <button type="button" class="ra-exito-btn-nuevo" @onclick="RegistrarOtraAsociacion">
                    <i class="bi bi-plus-circle me-1"></i> Registrar otra asociación
                </button>
            </div>
        </article>
    </div>
}

@code {
    private int pasoActual = 1;
    private bool guardando = false;
    private bool registroExitoso = false;
    private string mensajeAlerta = string.Empty;
    private bool esErrorAlerta = false;

    private string usuarioActualNombre = "Secretaría FAAUA";

    // Al iniciar, los campos inician completamente vacíos (sin datos precargados ficticios)
    private AsociacionInstitucional modelo = new()
    {
        NombreLegal = "",
        Sigla = "",
        Nit = "",
        DigitoVerificacion = "",
        TipoOrganizacion = "Asociación campesina",
        Ambito = "Municipal",
        GradoOrganizacion = "Primer grado (Asociación de base)",
        Estado = "Activa",
        Departamento = "Antioquia",
        Municipio = "Apartadó",
        DireccionPrincipal = "",
        CorreoInstitucional = "",
        TelefonoContacto = "",
        DireccionNotificacionesEsMisma = true,
        DireccionNotificaciones = "",
        SitioWeb = "",
        ContactoNombre = "",
        ContactoCargo = "",
        EntidadInscripcion = "",
