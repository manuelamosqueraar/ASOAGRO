    public static string CalcularDigitoVerificacionDian(string nit)
    {
        if (string.IsNullOrWhiteSpace(nit)) return "";
        var nitLimpio = Regex.Replace(nit, "[^0-9]", "");
        if (nitLimpio.Length == 0) return "";

        int[] pesos = { 71, 67, 59, 53, 47, 43, 41, 37, 29, 23, 19, 17, 13, 7, 3 };
        int suma = 0;
        int len = nitLimpio.Length;

        for (int i = 0; i < len; i++)
        {
            var digito = nitLimpio[len - 1 - i] - '0';
            suma += digito * pesos[15 - 1 - i];
        }

        int residuo = suma % 11;
        if (residuo == 0) return "0";
        if (residuo == 1) return "1";
        return (11 - residuo).ToString();
    }

