@page "/registrar-documentos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Tesorero, Director")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations

<PageTitle>Registrar Documentos - Asoagro & FAAUA</PageTitle>

<div class="asoagro-documentos-wrapper container-fluid px-0 pb-5">
    
    <!-- BANNER HERO EJECUTIVO -->
    <div class="asoagro-hero-banner p-4 p-md-5 mb-4 position-relative overflow-hidden rounded-4">
        <div class="hero-bg-shapes"></div>
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="badge-agri-pill">
                        <i class="bi bi-folder-fill me-1"></i> FAAUA · Gestión Documental
                    </span>
                    <span class="badge-agri-pill-sub">
                        <i class="bi bi-shield-fill-check me-1"></i> Control y Cumplimiento
                    </span>
                </div>
                <h1 class="fw-extrabold text-white mb-2 tracking-tight" style="font-size: 1.85rem; font-weight: 800;">
                    Registro y Archivo de Soportes Prediales
                </h1>
                <p class="text-white-50 mb-0 small" style="max-width: 600px; line-height: 1.6;">
                    Centralice los documentos legales, certificados de tradición y libertades, y avales BPA para anticipar vencimientos y cumplir con convocatorias.
                </p>
            </div>
            
            <div class="col-lg-4 mt-4 mt-lg-0 text-lg-end">
                <div class="hero-stats-glass p-3 rounded-4 d-inline-block text-start w-100" style="max-width: 260px;">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="hero-stat-icon">
                            <i class="bi bi-cloud-arrow-up-fill"></i>
                        </div>
                        <div>
                            <span class="d-block extra-small text-white-50">Estado del Módulo</span>
                            <span class="fw-bold text-success small d-flex align-items-center gap-1.5">
                                <span class="pulse-dot"></span> Sincronizado
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between gap-3 pt-2 border-top border-white border-opacity-10">
                        <span class="extra-small text-white-50">Seguridad</span>
                        <span class="fw-bold text-white small">Cifrado PDF/Img</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ALERTA DE ÉXITO DINÁMICA -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="toast-banner toast-success p-3 mb-4 d-flex align-items-center justify-content-between animate-fade-in">
            <div class="d-flex align-items-center gap-3">
                <div class="toast-icon-box bg-success text-white"><i class="bi bi-check2-all fs-4"></i></div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">¡Soporte Digitalizado con Éxito!</h6>
                    <span class="small text-secondary">@mensajeExito</span>
                </div>
            </div>
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }

    <EditForm Model="@documentoModel" OnValidSubmit="GuardarDocumento">
        <DataAnnotationsValidator />

        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: FORMULARIO MODULAR -->
            <div class="col-lg-8">
                <div class="unified-form-panel p-4 p-md-5">
                    
                    <div class="mb-4">
                        <div class="section-header-title mb-3">
                            <div class="section-icon-badge icon-purple"><i class="bi bi-file-earmark-text-fill"></i></div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">Información del Soporte Digital</h6>
                                <span class="extra-small text-muted">Seleccione al productor y el tipo de documento legal o predial</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="documentoAsociado" class="form-label-modern">Cédula o Código del Asociado <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-credit-card-2-front-fill input-icon"></i>
                                    <InputText id="documentoAsociado" class="form-control form-control-modern" placeholder="Ej: 1045123890" @bind-Value="documentoModel.DocumentoAsociado" />
                                </div>
                                <ValidationMessage For="@(() => documentoModel.DocumentoAsociado)" class="validation-msg" />
                            </div>

                            <div class="col-md-6">
                                <label for="tipoDocumento" class="form-label-modern">Tipo de Documento <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-file-earmark-richtext-fill input-icon"></i>
                                    <InputSelect id="tipoDocumento" class="form-select form-control-modern" @bind-Value="documentoModel.TipoDocumento">
                                        <option value="">Seleccione el tipo...</option>
                                        <option value="CertificadoFinca">Certificado de Tradición y Libertad</option>
                                        <option value="CedulaCiudadania">Cédula de Ciudadanía Digital</option>
                                        <option value="RegistroBPA">Certificación Buenas Prácticas Agrícolas (BPA)</option>
                                        <option value="AvalTecnico">Aval de Asistencia Técnica</option>
                                    </InputSelect>
                                </div>
                                <ValidationMessage For="@(() => documentoModel.TipoDocumento)" class="validation-msg" />
                            </div>
                        </div>
                    </div>

                    <div class="section-divider my-4"></div>

                    <!-- ZONA DE CARGA DE ARCHIVO -->
                    <div class="upload-zone-modern p-4 text-center rounded-4 mb-4">
                        <div class="upload-icon-box mx-auto mb-3">
                            <i class="bi bi-cloud-arrow-up-fill fs-3 text-success"></i>
                        </div>
                        <label for="archivo" class="form-label fw-bold text-dark mb-1">Adjuntar Archivo Digitalizado (PDF / Imagen)</label>
                        <p class="text-muted extra-small mb-3">Formatos admitidos: PDF, PNG, JPG (Máx. 10MB)</p>
                        
                        <div class="d-inline-block">
                            <InputFile id="archivo" class="form-control form-control-sm" OnChange="CargarArchivo" accept=".pdf,.png,.jpg,.jpeg" />
                        </div>
                        <ValidationMessage For="@(() => documentoModel.ArchivoNombre)" class="validation-msg mt-2" />

                        @if (!string.IsNullOrEmpty(documentoModel.ArchivoNombre))
                        {
                            <div class="mt-3">
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill small fw-bold">
                                    <i class="bi bi-file-earmark-check-fill me-1"></i> @documentoModel.ArchivoNombre (Cargado OK)
                                </span>
                            </div>
                        }
                    </div>

                    <!-- BOTÓN DE ENVÍO -->
                    <div class="d-flex justify-content-end pt-3 border-top">
                        <button type="submit" class="btn btn-asoagro-submit d-flex align-items-center gap-2">
                            <i class="bi bi-cloud-upload-fill fs-5"></i>
                            <span>Subir y Registrar Soporte</span>
                        </button>
                    </div>

                </div>
            </div>

            <!-- COLUMNA DERECHA: TARJETA INFORMATIVA DE CUMPLIMIENTO -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 20px;">
                    <div class="info-sidebar-card p-4 rounded-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="sidebar-icon-box">
                                <i class="bi bi-shield-exclamation text-warning"></i>
                            </div>
                            <h6 class="fw-bold text-dark mb-0 small">Importancia del Repositorio</h6>
                        </div>
                        <p class="text-muted small" style="line-height: 1.5;">
                            De acuerdo con los lineamientos de FAAUA, tener los soportes prediales y certificados BPA digitalizados evita que las asociaciones de base queden fuera de convocatorias por documentos vencidos.
                        </p>
                        <div class="alert-box-mini p-3 rounded-3 mt-3">
                            <span class="d-block extra-small fw-bold text-success mb-1">
                                <i class="bi bi-bell-fill me-1"></i> Alertas Automáticas
                            </span>
                            <span class="extra-small text-muted">El sistema notificará con antelación las fechas de vencimiento de los documentos registrados.</span>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </EditForm>
</div>

@code {
    private DocumentoModel documentoModel = new();
    private string mensajeExito = string.Empty;

    private void CargarArchivo(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo != null)
        {
            documentoModel.ArchivoNombre = archivo.Name;
        }
    }

    private void GuardarDocumento()
    {
        mensajeExito = $"¡Soporte '{documentoModel.TipoDocumento}' registrado con éxito para la cédula {documentoModel.DocumentoAsociado}!";
        documentoModel = new();
    }

    public class DocumentoModel
    {
        [Required(ErrorMessage = "El documento o cédula del asociado es obligatorio.")]
        public string DocumentoAsociado { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe seleccionar el tipo de documento.")]
        public string TipoDocumento { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe adjuntar un archivo digitalizado.")]
        public string ArchivoNombre { get; set; } = string.Empty;
    }
}