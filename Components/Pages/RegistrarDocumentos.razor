    private async Task OnSubirArchivoActa(InputFileChangeEventArgs e, int indexActa)
    {
        if (indexActa < 0 || indexActa >= listaActasRecurrentes.Count) return;
        var archivo = e.File;
        if (archivo == null || archivo.Size == 0)
        {
            mensajeAlerta = "El archivo seleccionado está vacío o no es válido.";
            esErrorAlerta = true;
            return;
        }

        var ext = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (ext is not (".pdf" or ".jpg" or ".jpeg" or ".png"))
        {
            mensajeAlerta = "Solo se permiten archivos en formato PDF, JPG o PNG.";
            esErrorAlerta = true;
            return;
        }

        if (archivo.Size > 10 * 1024 * 1024)
        {
            mensajeAlerta = $"El archivo '{archivo.Name}' excede el límite de 10 MB.";
            esErrorAlerta = true;
            return;
        }

        try
        {
            using var ms = new MemoryStream();
            await archivo.OpenReadStream(10 * 1024 * 1024).CopyToAsync(ms);
            var acta = listaActasRecurrentes[indexActa];
            acta.ArchivoNombre = archivo.Name;
            acta.ArchivoContenido = ms.ToArray();
            acta.TamanoBytes = archivo.Size;
            acta.ArchivoTipoMime = archivo.ContentType;
            mensajeAlerta = $"Archivo '{archivo.Name}' cargado correctamente para el acta.";
            esErrorAlerta = false;
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al leer el archivo: {ex.Message}";
            esErrorAlerta = true;
        }
    }

    private void QuitarArchivoActa(int indexActa)
    {
        if (indexActa >= 0 && indexActa < listaActasRecurrentes.Count)
        {
            var acta = listaActasRecurrentes[indexActa];
            acta.ArchivoNombre = null;
            acta.ArchivoContenido = null;
            acta.TamanoBytes = 0;
        }
    }

