    private void ValidarCampo(string campo)
    {
        erroresValidacion.Remove(campo);

        switch (campo)
        {
            case "NombreLegal":
                if (string.IsNullOrWhiteSpace(modelo.NombreLegal))
                {
                    erroresValidacion["NombreLegal"] = "El nombre legal completo de la asociación es obligatorio.";
                }
                else
                {
                    var limpio = modelo.NombreLegal.Trim();
                    if (limpio.Length < 4)
                        erroresValidacion["NombreLegal"] = "Debe tener al menos 4 caracteres.";
                    else if (Regex.IsMatch(limpio, @"^\d+$"))
                        erroresValidacion["NombreLegal"] = "No puede consistir únicamente en números.";
                    else if (limpio.ToLowerInvariant().Contains("ejemplo") || limpio.ToLowerInvariant().Contains("test"))
                        erroresValidacion["NombreLegal"] = "No se permiten textos de ejemplo ficticios como nombre real.";
                }
                break;

            case "Sigla":
                if (!string.IsNullOrWhiteSpace(modelo.Sigla) && modelo.Sigla.Trim().Length > 20)
                {
                    erroresValidacion["Sigla"] = "La sigla no debe exceder 20 caracteres.";
                }
                break;

            case "Nit":
                if (!string.IsNullOrWhiteSpace(modelo.Nit))
                {
                    var soloNums = Regex.Replace(modelo.Nit, "[^0-9]", "");
                    if (soloNums.Length < 9 || soloNums.Length > 10)
                        erroresValidacion["Nit"] = "El NIT debe tener entre 9 y 10 dígitos numéricos.";
                    else if (new string(soloNums[0], soloNums.Length) == soloNums)
                        erroresValidacion["Nit"] = "El NIT no puede ser una secuencia repetida del mismo dígito.";
                }
                else
                {
                    erroresValidacion["Nit"] = "El NIT institucional es obligatorio.";
                }
                break;

            case "FechaConstitucion":
                if (modelo.FechaConstitucion == null)
                    erroresValidacion["FechaConstitucion"] = "La fecha de constitución es obligatoria.";
                else if (modelo.FechaConstitucion.Value.Date > DateTime.Today)
                    erroresValidacion["FechaConstitucion"] = "La fecha de constitución no puede ser una fecha futura.";
                break;

            case "DireccionPrincipal":
                if (string.IsNullOrWhiteSpace(modelo.DireccionPrincipal) || modelo.DireccionPrincipal.Trim().Length < 5)
                    erroresValidacion["DireccionPrincipal"] = "La dirección de la sede principal es obligatoria (mínimo 5 caracteres).";
                break;

            case "CorreoInstitucional":
                if (string.IsNullOrWhiteSpace(modelo.CorreoInstitucional))
                {
                    erroresValidacion["CorreoInstitucional"] = "El correo institucional es obligatorio.";
                }
                else
                {
                    var correo = modelo.CorreoInstitucional.Trim();
                    if (correo.Contains(" ") || !Regex.IsMatch(correo, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
                    {
                        erroresValidacion["CorreoInstitucional"] = "Indique un correo electrónico válido (ej.: secretaria@asoagro-uraba.org).";
                    }
                }
                break;

            case "TelefonoContacto":
                if (string.IsNullOrWhiteSpace(modelo.TelefonoContacto))
                {
                    erroresValidacion["TelefonoContacto"] = "El teléfono institucional es obligatorio.";
                }
                else
                {
                    var soloDigitos = Regex.Replace(modelo.TelefonoContacto, "[^0-9]", "");
                    if (soloDigitos.Length < 7 || soloDigitos.Length > 10)
                    {
                        erroresValidacion["TelefonoContacto"] = "Indique un número celular de 10 dígitos o fijo de 7 dígitos.";
                    }
                }
                break;

            case "EntidadInscripcion":
                if (string.IsNullOrWhiteSpace(modelo.EntidadInscripcion))
                    erroresValidacion["EntidadInscripcion"] = "Debe indicar la entidad de inscripción (ej.: Cámara de Comercio de Urabá).";
                break;

            case "NumeroRegistro":
                if (string.IsNullOrWhiteSpace(modelo.NumeroRegistro))
                    erroresValidacion["NumeroRegistro"] = "El número de matrícula o radicado es obligatorio.";
                break;

            case "RepLegalNombre":
                if (string.IsNullOrWhiteSpace(modelo.RepLegalNombre) || modelo.RepLegalNombre.Trim().Length < 4)
                    erroresValidacion["RepLegalNombre"] = "El nombre del Representante Legal es obligatorio.";
                break;

            case "RepLegalPeriodoFin":
                if (modelo.RepLegalPeriodoInicio.HasValue && modelo.RepLegalPeriodoFin.HasValue)
                {
                    if (modelo.RepLegalPeriodoFin.Value < modelo.RepLegalPeriodoInicio.Value)
                    {
                        erroresValidacion["RepLegalPeriodoFin"] = "El fin del periodo no puede ser anterior al inicio.";
                    }
                }
                break;
        }
    }

    private bool TieneError(string campo) => erroresValidacion.ContainsKey(campo);
    private string ObtenerError(string campo) => erroresValidacion.TryGetValue(campo, out var err) ? err : string.Empty;

    private bool ValidarPasoActual(int paso)
    {
        erroresValidacion.Clear();

        switch (paso)
        {
            case 1:
                ValidarCampo("NombreLegal");
                ValidarCampo("Nit");
                ValidarCampo("FechaConstitucion");
                break;

            case 2:
                ValidarCampo("DireccionPrincipal");
                ValidarCampo("CorreoInstitucional");
                ValidarCampo("TelefonoContacto");
                break;

            case 3:
                ValidarCampo("EntidadInscripcion");
                ValidarCampo("NumeroRegistro");
                foreach (var doc in catalogoDocumentosConfigurados.Values.Where(d => d.CategoriaSeccion == "Constitución"))
                {
                    if (doc.EstadoRequisito == "No aplica" && string.IsNullOrWhiteSpace(doc.MotivoNoAplica))
                    {
                        mensajeAlerta = $"Debe indicar el motivo por el cual '{doc.TipoDocumento}' no aplica.";
                        esErrorAlerta = true;
                        return false;
                    }
                }
                break;

            case 4:
                ValidarCampo("RepLegalNombre");
                ValidarCampo("RepLegalPeriodoFin");
                if (!modelo.FiscalAplica && string.IsNullOrWhiteSpace(modelo.FiscalMotivoNoAplica))
                {
                    mensajeAlerta = "Debe justificar el motivo por el cual no aplica el cargo de Fiscal / Revisor Fiscal.";
                    esErrorAlerta = true;
                    return false;
                }
                break;

            case 5:
                if (modelo.RutEstado == "No aplica" && string.IsNullOrWhiteSpace(modelo.RutEstadoMotivo))
                {
                    mensajeAlerta = "Debe indicar la justificación de no aplicación del RUT.";
                    esErrorAlerta = true;
                    return false;
                }
                break;

            case 6:
                if (!listaActasRecurrentes.Any())
                {
                    mensajeAlerta = "Debe registrar al menos un acta institucional o asamblea.";
                    esErrorAlerta = true;
                    return false;
                }
                break;
        }

        if (erroresValidacion.Any())
        {
            mensajeAlerta = "Por favor corrija los campos requeridos marcados en rojo antes de continuar.";
            esErrorAlerta = true;
            return false;
        }

        mensajeAlerta = string.Empty;
        esErrorAlerta = false;
        return true;
    }

    private void IrAlPaso(int pasoDestino)
    {
        if (pasoDestino < pasoActual || ValidarPasoActual(pasoActual))
        {
            pasoActual = pasoDestino;
        }
    }

    private void PasoSiguiente()
    {
        if (ValidarPasoActual(pasoActual) && pasoActual < 7)
        {
            pasoActual++;
        }
    }

    private void PasoAnterior()
    {
        if (pasoActual > 1)
        {
            pasoActual--;
        }
    }

    private void GuardarBorrador()
    {
        modelo.ActualizadoPor = usuarioActualNombre;
        DocumentoService.GuardarAsociacionInstitucional(modelo, ObtenerTodosLosDocumentosParaGuardar());
        mensajeAlerta = "Borrador institucional guardado en el sistema. Puede continuar completándolo en cualquier momento.";
        esErrorAlerta = false;
    }

    private async Task FinalizarYArchivarExpediente()
    {
        if (!ValidarPasoActual(1) || !ValidarPasoActual(2) || !ValidarPasoActual(3) || !ValidarPasoActual(4))
        {
            return;
        }

        guardando = true;
        mensajeAlerta = string.Empty;

        try
        {
            modelo.ActualizadoPor = usuarioActualNombre;
            var documentosParaGuardar = ObtenerTodosLosDocumentosParaGuardar();

            DocumentoService.GuardarAsociacionInstitucional(modelo, documentosParaGuardar);

            totalDocumentosArchivados = documentosParaGuardar.Count(d => d.Aplica && !string.IsNullOrWhiteSpace(d.ArchivoNombre));

            // Notificación institucional para directivos
            Notificaciones.Publicar(new Notificacion
            {
                Titulo = $"Expediente institucional radicado: {modelo.NombreLegal}",
                Descripcion = $"Secretaría ({usuarioActualNombre}) radicó el expediente legal y estatutario de {modelo.NombreLegal} con {totalDocumentosArchivados} soportes archivados.",
                Etiqueta = "Secretaría",
                Enlace = $"/consultar-estado-documentos?asoc={Uri.EscapeDataString(modelo.NombreLegal)}",
                Icono = "check",
                Categoria = CategoriaNotificacion.Documentos,
                Nivel = NivelNotificacion.Informativa,
                RolesDestino = new[] { "Directora", "Presidenta", "Secretaria", "Tesorero" },
                RolesEnlace = new[] { "Secretaria", "Tesorero", "Directora", "Presidenta" }
            });

            expedienteGuardado = modelo;
            registroExitoso = true;
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al archivar el expediente institucional: {ex.Message}";
            esErrorAlerta = true;
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task DescargarResumenPdf()
    {
        try
        {
            var pdfBytes = ExpedienteAsociacionPdfGenerator.GenerarResumenPdf(
                modelo,
                ObtenerTodosLosDocumentosParaGuardar(),
                usuarioActualNombre,
                DateTime.Now);

            var base64 = Convert.ToBase64String(pdfBytes);
            var nombrePdf = $"Expediente_Institucional_{Regex.Replace(modelo.NombreLegal, @"[^a-zA-Z0-9]", "_")}.pdf";
            await JS.InvokeVoidAsync("descargarArchivoBase64", nombrePdf, "application/pdf", base64);
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al generar el PDF del expediente: {ex.Message}";
            esErrorAlerta = true;
        }
    }

    private List<DocumentoItemInstitucional> ObtenerTodosLosDocumentosParaGuardar()
    {
        var lista = catalogoDocumentosConfigurados.Values.ToList();
        lista.AddRange(listaActasRecurrentes);

        if (!string.IsNullOrWhiteSpace(docPersonalizado.Titulo) && (!string.IsNullOrWhiteSpace(docPersonalizado.ArchivoNombre) || docPersonalizado.FechaEmision.HasValue))
        {
            lista.Add(docPersonalizado);
        }

        return lista;
    }

    private int ContarDocumentosAdjuntos()
    {
        return ObtenerTodosLosDocumentosParaGuardar().Count(d => d.Aplica && !string.IsNullOrWhiteSpace(d.ArchivoNombre));
    }

    private bool EsPasoCompleto(int paso)
    {
        return paso switch
        {
            1 => !string.IsNullOrWhiteSpace(modelo.NombreLegal) && !string.IsNullOrWhiteSpace(modelo.Nit) && modelo.FechaConstitucion.HasValue,
            2 => !string.IsNullOrWhiteSpace(modelo.DireccionPrincipal) && !string.IsNullOrWhiteSpace(modelo.CorreoInstitucional) && !string.IsNullOrWhiteSpace(modelo.TelefonoContacto),
            3 => !string.IsNullOrWhiteSpace(modelo.EntidadInscripcion) && !string.IsNullOrWhiteSpace(modelo.NumeroRegistro),
            4 => !string.IsNullOrWhiteSpace(modelo.RepLegalNombre) && modelo.RepLegalPeriodoFin.HasValue,
            5 => !string.IsNullOrWhiteSpace(modelo.RutEstado),
            6 => listaActasRecurrentes.Any(a => !string.IsNullOrWhiteSpace(a.NumeroReferencia)),
            7 => registroExitoso,
            _ => false
        };
    }

    private int CalcularPorcentajeAvance()
    {
        if (registroExitoso) return 100;
        int puntos = 0;
        if (!string.IsNullOrWhiteSpace(modelo.NombreLegal)) puntos += 20;
        if (!string.IsNullOrWhiteSpace(modelo.Nit)) puntos += 15;
        if (!string.IsNullOrWhiteSpace(modelo.DireccionPrincipal)) puntos += 15;
        if (!string.IsNullOrWhiteSpace(modelo.EntidadInscripcion)) puntos += 15;
        if (!string.IsNullOrWhiteSpace(modelo.RepLegalNombre)) puntos += 15;
        if (!string.IsNullOrWhiteSpace(modelo.RutEstado)) puntos += 10;
        if (catalogoDocumentosConfigurados.Values.Any(d => !string.IsNullOrWhiteSpace(d.ArchivoNombre))) puntos += 10;
        return Math.Min(100, Math.Max(10, puntos));
    }

