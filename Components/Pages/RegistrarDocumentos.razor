    private void OnNitCambiado()
    {
        if (!string.IsNullOrWhiteSpace(modelo.Nit))
        {
            modelo.Nit = Regex.Replace(modelo.Nit, "[^0-9]", "");
            modelo.DigitoVerificacion = CalcularDigitoVerificacionDian(modelo.Nit);
        }
        else
