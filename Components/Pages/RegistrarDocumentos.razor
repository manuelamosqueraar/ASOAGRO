    private RenderFragment RenderCardDocumento(string clave, string titulo, string descripcion) => __builder =>
    {
        if (!catalogoDocumentosConfigurados.TryGetValue(clave, out var docItem)) return;

        <div class="ra-doc-card @(docItem.EstadoRequisito == "No aplica" ? "no-aplica" : "")">
            <div class="ra-doc-cab">
                <div class="ra-doc-cab-izq">
                    <span class="badge @(docItem.EstadoRequisito == "Obligatorio" ? "bg-danger-subtle text-danger border border-danger-subtle" : docItem.EstadoRequisito == "No aplica" ? "bg-secondary-subtle text-secondary" : "bg-success-subtle text-success")">
                        @docItem.EstadoRequisito
                    </span>
                    <h5 class="ra-doc-titulo">@titulo</h5>
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="small text-muted mb-0 fw-bold">Estado del requisito:</label>
                    <select class="ra-doc-estado-select" value="@docItem.EstadoRequisito" @onchange='(e) => OnCambiarEstadoRequisito(clave, e.Value?.ToString() ?? "Aplica")'>
                        <option value="Obligatorio">Obligatorio</option>
                        <option value="Aplica">Aplica</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="No aplica">No aplica</option>
                    </select>
                </div>
            </div>

            <p class="small text-muted mb-0">@descripcion</p>

            @if (docItem.EstadoRequisito != "No aplica")
            {
                <div class="ra-grid mt-1">
                    <div class="ra-campo">
                        <label class="ra-label">Fecha de expedición / emisión</label>
                        <input type="date" class="ra-input py-1" @bind="docItem.FechaEmision" />
                    </div>

                    <div class="ra-campo">
                        <label class="ra-label">Fecha de vencimiento / renovación <span class="ra-hint">(dejar vacío si no caduca)</span></label>
                        <input type="date" class="ra-input py-1" @bind="docItem.FechaVencimiento" />
                    </div>

                    <div class="ra-campo">
                        <label class="ra-label">Número de referencia / radicado</label>
                        <input type="text" class="ra-input py-1" placeholder="Ej.: Radicado No. 048-2025" @bind="docItem.NumeroReferencia" />
                    </div>

                    <div class="ra-campo ra-grid-full">
