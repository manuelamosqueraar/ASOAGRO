@page "/registrar-documentos"
@page "/expediente-documental"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Secretaria,Secretaría,Presidenta,Presidente,Administrador,Admin")]
@rendermode InteractiveServer
@using System.Security.Claims
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using Asoagro.Models
@using Asoagro.Services
@inject IDocumentoAsociacionService DocumentoService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Expediente Documental Institucional · Asoagro & FAAUA</PageTitle>

<div class="container-fluid px-0 pb-5" style="font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <!-- =========================================================================
         1. ENCABEZADO EJECUTIVO INSTITUCIONAL
         ========================================================================= -->
    <div class="card aso-hero-card">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3" style="flex: 1 1 360px; min-width: 0;">
                    <div class="aso-hero-icon-box">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z" />
                        </svg>
                    </div>
                    <div style="min-width: 0;">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="aso-hero-kicker">Gestión Documental · FAAUA</span>
                            <span class="text-white-50" style="font-size: 0.74rem; font-weight: 600;">Secretaría General</span>
                        </div>
                        <h1 class="aso-hero-title">Expediente Documental Institucional</h1>
                        <p class="aso-hero-desc">
                            Custodia, consulta y actualización de los soportes legales, estatutarios, tributarios y de gobierno de las asociaciones federadas.
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2 flex-shrink-0">
                    <a href="/asociaciones" class="aso-btn-hero-secondary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="19" y1="12" x2="5" y2="12" />
                            <polyline points="12 19 5 12 12 5" />
                        </svg>
                        <span>Volver al Directorio</span>
                    </a>
                    @if (puedeEditar && asociacionSeleccionada != null)
                    {
                        <button type="button" class="aso-btn-hero-primary" @onclick="AbrirModalNuevoDocumento">
                            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                <polyline points="14 2 14 8 20 8" />
                                <line x1="12" y1="18" x2="12" y2="12" />
                                <line x1="9" y1="15" x2="15" y2="15" />
                            </svg>
                            <span>Agregar soporte</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ALERTA DE MENSAJE TEMPORAL -->
    @if (!string.IsNullOrWhiteSpace(mensajeAlerta))
    {
        <div class="alert @(esErrorAlerta ? "alert-danger" : "alert-success") alert-dismissible fade show rounded-4 shadow-xs d-flex align-items-center gap-2 mb-3"
             style="border: 1px solid #dce4d8;" role="alert">
            <i class="bi @(esErrorAlerta ? "bi-exclamation-triangle-fill" : "bi-check-circle-fill") fs-5"></i>
            <div class="flex-grow-1 small fw-semibold">@mensajeAlerta</div>
            <button type="button" class="btn-close" @onclick='() => mensajeAlerta = ""' aria-label="Cerrar"></button>
        </div>
    }

    <!-- =========================================================================
         2. SELECTOR DE ASOCIACIÓN Y FICHA INSTITUCIONAL UNIFICADA
         ========================================================================= -->
    @if (!todasAsociaciones.Any())
    {
        <div class="aso-card-panel p-5 text-center">
            <h5 class="fw-bold text-dark">Primero registra la asociación en el Directorio</h5>
            <p class="text-muted small mx-auto mb-3" style="max-width: 500px;">
                Aún no existen entidades base registradas en la federación. El perfil institucional debe ser creado primero en el Directorio de asociaciones para habilitar su expediente documental.
            </p>
            <div>
                <a href="/asociaciones" class="aso-btn-action-primary px-4 py-2">
                    <span>Ir al Directorio de Asociaciones</span>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="aso-filter-workbench">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-8">
                    <div class="aso-field-group">
                        <label class="aso-field-label">Asociación federada a consultar en el expediente</label>
                        <select class="form-select aso-select-modern" style="height: 44px !important; font-size: 0.9rem !important;"
                                value="@(asociacionSeleccionada?.Id.ToString() ?? "")"
                                @onchange="OnCambioAsociacionSelect">
                            @foreach (var asoc in todasAsociaciones)
                            {
                                <option value="@asoc.Id.ToString()">
                                    @(!string.IsNullOrWhiteSpace(asoc.Sigla) ? $"[{asoc.Sigla}] " : "")@asoc.NombreLegal · NIT: @(!string.IsNullOrWhiteSpace(asoc.Nit) ? asoc.Nit : "En trámite")
                                </option>
                            }
                        </select>
                    </div>
                </div>

                <div class="col-12 col-lg-4 d-flex flex-wrap align-items-center justify-content-lg-end gap-2">
                    @if (asociacionSeleccionada != null)
                    {
                        <a href="@($"/consultar-asociados?asociacion={Uri.EscapeDataString(NombreCompletoAsoc)}")" class="aso-btn-action">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                            <span>Padrón productores</span>
                        </a>
                        <a href="/alertas-documentos" class="aso-btn-action">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                            <span>Alertas vencimiento</span>
                        </a>
                    }
                </div>
            </div>

            @if (asociacionSeleccionada != null)
            {
                <div class="mt-3 pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-3" style="border-color: rgba(16, 185, 129, 0.2) !important;">
                    <div class="d-flex align-items-center gap-3" style="min-width: 0; flex: 1 1 320px;">
                        <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-xs flex-shrink-0"
                             style="width: 48px; height: 48px; border-radius: 13px; background: linear-gradient(135deg, #047857 0%, #10b981 100%); font-size: 0.94rem; border: 1.5px solid #a7f3d0; box-shadow: 0 6px 14px rgba(16, 185, 129, 0.25);">
                            @ObtenerIniciales(string.IsNullOrWhiteSpace(asociacionSeleccionada.Sigla) ? asociacionSeleccionada.NombreLegal : asociacionSeleccionada.Sigla)
                        </div>
                        <div style="min-width: 0;">
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <strong class="text-dark" style="font-family: 'Sora', sans-serif; font-size: 1.05rem;">@asociacionSeleccionada.NombreLegal</strong>
                                @if (!string.IsNullOrWhiteSpace(asociacionSeleccionada.Sigla))
                                {
                                    <span class="aso-badge-activa">@asociacionSeleccionada.Sigla</span>
                                }
                                <span class="badge rounded-pill px-2.5 py-1 fw-bold" style="@ObtenerEstiloBadgeEstado(asociacionSeleccionada.Estado); font-size: 0.72rem;">
                                    @asociacionSeleccionada.Estado
                                </span>
                                <span class="@(asociacionSeleccionada.EstadoExpediente == "Completo" ? "aso-badge-activa" : "aso-badge-pendiente")">
                                    Expediente @asociacionSeleccionada.EstadoExpediente
                                </span>
                            </div>
                            <div class="d-flex flex-wrap align-items-center gap-3 text-muted mt-1" style="font-size: 0.81rem;">
                                <span><strong>NIT:</strong> @(string.IsNullOrWhiteSpace(asociacionSeleccionada.Nit) ? "En trámite" : $"{asociacionSeleccionada.Nit}-{asociacionSeleccionada.DigitoVerificacion}")</span>
                                <span>·</span>
                                <span><strong>Tipo:</strong> @asociacionSeleccionada.TipoOrganizacion (@asociacionSeleccionada.Ambito)</span>
                                <span>·</span>
                                <span><strong>Sede:</strong> @asociacionSeleccionada.Municipio, @asociacionSeleccionada.Departamento</span>
                                <span>·</span>
                                <span><strong>Representante:</strong> @(string.IsNullOrWhiteSpace(asociacionSeleccionada.RepLegalNombre) ? "Por designar" : asociacionSeleccionada.RepLegalNombre)</span>
                            </div>
                        </div>
                    </div>

                    <div class="flex-shrink-0">
                        <a href="@($"/asociaciones?editar={asociacionSeleccionada.Id}")" class="aso-btn-action-primary"
                           title="Modificar nombre, NIT, sede o representante en el Directorio">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                            <span>Editar perfil institucional</span>
                        </a>
                    </div>
                </div>
            }
        </div>

        @if (asociacionSeleccionada != null)
        {
            <!-- =========================================================================
                 3. TARJETAS KPI DEL EXPEDIENTE DE LA ASOCIACIÓN SELECCIONADA
                 ========================================================================= -->
            <div class="aso-kpi-grid">
                <div class="aso-kpi-card kpi-emerald" @onclick='() => categoriaActiva = "Todas"'>
                    <div class="aso-kpi-icon green">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    </div>
                    <div class="aso-kpi-meta">
                        <span class="aso-kpi-label">Soportes Custodiados</span>
                        <strong class="aso-kpi-value">@documentosAsoc.Count</strong>
                        <span class="aso-kpi-sub">Total en el expediente</span>
                    </div>
                </div>

                <div class="aso-kpi-card kpi-sky">
                    <div class="aso-kpi-icon">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    </div>
                    <div class="aso-kpi-meta">
                        <span class="aso-kpi-label">Soportes Vigentes</span>
                        <strong class="aso-kpi-value">@documentosAsoc.Count(d => d.Aplica && d.EstadoCalculado == "Vigente")</strong>
                        <span class="aso-kpi-sub">Al día y habilitados</span>
                    </div>
                </div>

                <div class="aso-kpi-card kpi-amber">
                    <div class="aso-kpi-icon amber">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                    </div>
                    <div class="aso-kpi-meta">
                        <span class="aso-kpi-label">Próximos a Vencer</span>
                        <strong class="aso-kpi-value">@documentosAsoc.Count(d => d.Aplica && d.EstadoCalculado == "Por vencer")</strong>
                        <span class="aso-kpi-sub">Dentro de umbral preventivo</span>
                    </div>
                </div>

                <div class="aso-kpi-card kpi-rose">
                    <div class="aso-kpi-icon red">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    </div>
                    <div class="aso-kpi-meta">
                        <span class="aso-kpi-label">Vencidos / Revisión</span>
                        <strong class="aso-kpi-value">@(documentosAsoc.Count(d => d.Aplica && d.EstadoCalculado == "Vencido") + documentosAsoc.Count(d => d.EstadoRevision == "Pendiente de revisión"))</strong>
                        <span class="aso-kpi-sub">@documentosAsoc.Count(d => d.Aplica && d.EstadoCalculado == "Vencido") vencido(s) · @documentosAsoc.Count(d => d.EstadoRevision == "Pendiente de revisión") en revisión</span>
                    </div>
                </div>
            </div>

            <!-- =========================================================================
                 4. TABLA EJECUTIVA DE SOPORTES POR CATEGORÍA
                 ========================================================================= -->
            <div class="aso-table-card">
                <div class="aso-table-header-bar">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <button type="button" class="@(categoriaActiva == "Todas" ? "aso-btn-action-primary" : "aso-btn-action")"
                                @onclick='() => categoriaActiva = "Todas"'>
                            <span>Todas (@documentosAsoc.Count)</span>
                        </button>
                        @foreach (var cat in CategoriasDisponibles)
                        {
                            var conteoCat = documentosAsoc.Count(d => string.Equals(d.Categoria, cat, StringComparison.OrdinalIgnoreCase));
                            var activa = categoriaActiva == cat;
                            <button type="button" class="@(activa ? "aso-btn-action-primary" : "aso-btn-action")"
                                    @onclick="() => categoriaActiva = cat">
                                <span>@cat (@conteoCat)</span>
                            </button>
                        }
                    </div>
                </div>

                @if (!DocumentosFiltrados.Any())
                {
                    <div class="p-5 text-center">
                        <h6 class="fw-bold text-dark mt-2">No hay soportes en esta categoría</h6>
                        <p class="text-muted small mb-3">Esta asociación aún no tiene documentos custodiados en la categoría «@categoriaActiva».</p>
                        @if (puedeEditar)
                        {
                            <button type="button" class="aso-btn-action-primary mx-auto" @onclick="AbrirModalNuevoDocumento">
                                <span>Adjuntar primer soporte</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <div class="aso-table-wrap">
                        <table class="table aso-table-grid align-middle mb-0" style="min-width: 940px;">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 28%; min-width: 220px;">Documento y Archivo</th>
                                    <th class="text-start" style="width: 16%; min-width: 140px;">Categoría / Requerimiento</th>
                                    <th class="text-start" style="width: 16%; min-width: 140px;">Referencia y Emisor</th>
                                    <th class="text-center" style="width: 14%; min-width: 130px;">Vigencia</th>
                                    <th class="text-center" style="width: 10%; min-width: 100px;">Revisión / Versión</th>
                                    <th class="text-end" style="width: 16%; min-width: 190px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in DocumentosFiltrados)
                                {
                                    <tr>
                                        <td class="text-start">
                                            <div class="d-flex align-items-start gap-2.5">
                                                <div class="rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                                                     style="width: 38px; height: 38px; background: #eaf5e7; border: 1px solid #cce5c8; color: #14532d;">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                                </div>
                                                <div style="min-width: 0;">
                                                    <strong class="text-dark d-block" style="font-size: 0.87rem; line-height: 1.25;">@doc.TipoDocumento</strong>
                                                    @if (!string.IsNullOrWhiteSpace(doc.Titulo) && doc.Titulo != doc.TipoDocumento)
                                                    {
                                                        <small class="text-secondary d-block">@doc.Titulo</small>
                                                    }
                                                    @if (!string.IsNullOrWhiteSpace(doc.ArchivoNombre))
                                                    {
                                                        <small class="text-success fw-semibold d-block mt-0.5" style="font-size: 0.74rem;">
                                                            @doc.ArchivoNombre (@FormatearTamano(doc.TamanoBytes))
                                                        </small>
                                                    }
                                                    else
                                                    {
                                                        <small class="text-danger fw-semibold d-block mt-0.5" style="font-size: 0.74rem;">
                                                            Sin archivo digital adjunto
                                                        </small>
                                                    }
                                                </div>
                                            </div>
                                        </td>

                                        <td class="text-start">
                                            <span class="aso-badge-neutro mb-1">@doc.Categoria</span>
                                            <small class="d-block text-muted" style="font-size: 0.73rem;">@doc.NivelRequerimiento</small>
                                        </td>

                                        <td class="text-start">
                                            <div class="d-flex flex-column" style="font-size: 0.79rem; line-height: 1.3;">
                                                <strong class="text-dark">@(string.IsNullOrWhiteSpace(doc.NumeroReferencia) ? "Sin radicado" : doc.NumeroReferencia)</strong>
                                                <span class="text-muted">@(string.IsNullOrWhiteSpace(doc.EntidadEmisora) ? "Emisor interno" : doc.EntidadEmisora)</span>
                                                <small class="text-secondary" style="font-size: 0.71rem;">Carga: @doc.FechaRegistro.ToString("dd/MM/yyyy")</small>
                                            </div>
                                        </td>

                                        <td class="text-center" style="white-space: nowrap;">
                                            @if (!doc.TieneVencimiento || !doc.FechaVencimiento.HasValue)
                                            {
                                                <span class="aso-badge-neutro" title="Vigencia permanente">Permanente</span>
                                            }
                                            else if (doc.EstadoCalculado == "Vigente")
                                            {
                                                <span class="aso-badge-activa">Vigente · @doc.FechaVencimiento.Value.ToString("dd/MM/yy")</span>
                                            }
                                            else if (doc.EstadoCalculado == "Por vencer")
                                            {
                                                <span class="aso-badge-pendiente">Por vencer (@doc.DiasRestantes d)</span>
                                            }
                                            else
                                            {
                                                <span class="aso-badge-vencida">Vencido · @doc.FechaVencimiento.Value.ToString("dd/MM/yy")</span>
                                            }
                                        </td>

                                        <td class="text-center" style="white-space: nowrap;">
                                            <div class="d-flex flex-column align-items-center gap-1">
                                                <span class="badge @ObtenerClaseRevisionBadge(doc.EstadoRevision)" style="font-size: 0.70rem;">
                                                    @doc.EstadoRevision
                                                </span>
                                                <small class="fw-bold text-secondary" style="font-size: 0.71rem;">Versión v@(doc.VersionActual)</small>
                                            </div>
                                        </td>

                                        <td class="text-end" style="white-space: nowrap;">
                                            <div class="aso-actions-group">
                                                <button type="button" class="aso-btn-action"
                                                        @onclick="() => DescargarArchivo(doc)"
                                                        title="Descargar documento registrado">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                                    <span>Descargar</span>
                                                </button>

                                                @if (doc.HistorialVersiones.Any())
                                                {
                                                    <button type="button" class="aso-btn-action"
                                                            @onclick="() => AbrirModalHistorial(doc)"
                                                            title="Ver historial de versiones">
                                                        <span>Historial (@doc.HistorialVersiones.Count)</span>
                                                    </button>
                                                }

                                                @if (puedeEditar)
                                                {
                                                    <button type="button" class="aso-btn-action-primary"
                                                            @onclick="() => AbrirModalVersion(doc)"
                                                            title="Subir nueva versión del documento">
                                                        <span>Actualizar</span>
                                                    </button>

                                                    <button type="button" class="aso-btn-action"
                                                            @onclick="() => AbrirModalRevisar(doc)"
                                                            title="Revisar y validar soporte">
                                                        <span>Validar</span>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    }

    <!-- =========================================================================
         6. MODAL: ADJUNTAR NUEVA VERSIÓN DE DOCUMENTO EXISTENTE
         ========================================================================= -->
    @if (mostrandoModalVersion && documentoSeleccionado != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 1060;" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                    <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #092615 0%, #17603a 100%);">
                        <div>
                            <span class="badge bg-warning text-dark fw-bold mb-1" style="font-size: 0.72rem;">
                                Versionamiento Documental
                            </span>
                            <h5 class="modal-title fw-bold text-white mb-0" style="font-size: 1.05rem;">
                                Adjuntar Nueva Versión: v@(documentoSeleccionado.VersionActual + 1)
                            </h5>
                            <small class="text-white-50">@documentoSeleccionado.TipoDocumento</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalVersion" aria-label="Cerrar"></button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorModal))
                    {
                        <div class="alert alert-danger mb-0 rounded-0 small d-flex align-items-center gap-2 px-4 py-2" role="alert">
                            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                            <div>@errorModal</div>
                        </div>
                    }

                    <div class="modal-body p-4" style="font-size: 0.88rem;">
                        <div class="alert alert-light border small mb-3">
                            <strong><i class="bi bi-info-circle-fill me-1 text-success"></i> Trazabilidad garantizada:</strong>
                            La versión actual (v@(documentoSeleccionado.VersionActual)) se conservará en el historial como <strong>Reemplazada</strong> con su fecha y usuario original, asegurando la auditoría institucional.
                        </div>

                        <!-- Opción para Ver el Archivo Actual -->
                        <div class="card border rounded-3 p-3 mb-3 bg-light">
                            <div class="d-flex align-items-center justify-content-between gap-2 flex-wrap">
                                <div class="d-flex align-items-center gap-2.5">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center bg-white border text-success flex-shrink-0" style="width: 38px; height: 38px;">
                                        <i class="bi bi-file-earmark-check-fill fs-5"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark" style="font-size: 0.88rem; line-height: 1.25;">
                                            @(string.IsNullOrWhiteSpace(documentoSeleccionado.ArchivoNombre) ? "Documento registrado en sistema" : documentoSeleccionado.ArchivoNombre)
                                        </div>
                                        <div class="text-muted small" style="font-size: 0.74rem;">
                                            Versión actual: <span class="badge bg-secondary-subtle text-secondary border">v@(documentoSeleccionado.VersionActual)</span> · @(documentoSeleccionado.TamanoBytes > 0 ? FormatearTamano(documentoSeleccionado.TamanoBytes) : "Documento oficial")
                                        </div>
                                    </div>
                                </div>
                                <div>
                                    <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3 py-1 fw-semibold"
                                            @onclick="() => DescargarArchivo(documentoSeleccionado)"
                                            title="Ver o descargar el archivo actualmente registrado">
                                        <i class="bi bi-eye-fill me-1"></i> Ver archivo actual
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Opción para Adjuntar o Reemplazar por Nueva Versión -->
                        <div class="mb-3">
                            <label class="form-label fw-bold mb-1">Adjuntar o reemplazar por nueva versión <span class="text-danger">*</span></label>
                            <div class="p-3 rounded-3 border bg-light text-center">
                                <label class="btn btn-outline-success rounded-pill px-4 py-1.5 fw-bold mb-1 cursor-pointer">
                                    <i class="bi bi-cloud-upload-fill me-1"></i> Seleccionar archivo
                                    <InputFile OnChange="OnCargaArchivoModal" accept=".pdf,.jpg,.jpeg,.png" style="display: none;" />
                                </label>
                                <div class="text-muted small" style="font-size: 0.74rem;">Formatos admitidos: PDF, JPG, PNG · Límite máximo: 10 MB</div>

                                @if (!string.IsNullOrWhiteSpace(archivoModalNombre))
                                {
                                    <div class="mt-2 text-success fw-bold small">
                                        <i class="bi bi-check-circle-fill"></i> @archivoModalNombre (@FormatearTamano(archivoModalBytes.Length))
                                    </div>
                                }
                            </div>
                        </div>

                        @if (documentoSeleccionado.TieneVencimiento)
                        {
                            <div class="mb-3">
                                <label class="form-label fw-bold mb-1">Nueva fecha de vencimiento</label>
                                <input type="date" class="form-control"
                                       value="@(fechaVencimientoModal?.ToString("yyyy-MM-dd"))"
                                       @onchange="e => fechaVencimientoModal = ParsearFecha(e.Value?.ToString())" />
                                <small class="text-muted" style="font-size: 0.72rem;">Actualiza la fecha de vencimiento aplicable a esta versión.</small>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label fw-bold mb-1">Observaciones o motivo del reemplazo</label>
                            <textarea class="form-control" rows="2" placeholder="Ej: Renovación anual de certificado / Actualización estatutaria..." @bind="observacionesModal"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary rounded-pill px-3 py-1.5" @onclick="CerrarModalVersion">Cancelar</button>
                        <button type="button" class="btn btn-success rounded-pill px-4 py-1.5 fw-bold" style="background-color: #17603a; border-color: #17603a;" @onclick="GuardarNuevaVersion">
                            <i class="bi bi-check-circle-fill me-1"></i> Guardar Nueva Versión
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- =========================================================================
         7. MODAL: AGREGAR NUEVO DOCUMENTO AL EXPEDIENTE
         ========================================================================= -->
    @if (mostrandoModalNuevoDoc)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 1060;" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                    <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #092615 0%, #17603a 100%);">
                        <div>
                            <span class="badge bg-warning text-dark fw-bold mb-1" style="font-size: 0.72rem;">
                                Expediente Institucional
                            </span>
                            <h5 class="modal-title fw-bold text-white mb-0" style="font-size: 1.05rem;">
                                Custodiar Nuevo Soporte Documental
                            </h5>
                            <small class="text-white-50">Para: @asociacionSeleccionada?.NombreLegal</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalNuevoDoc" aria-label="Cerrar"></button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(errorModal))
                    {
                        <div class="alert alert-danger mb-0 rounded-0 small d-flex align-items-center gap-2 px-4 py-2" role="alert">
                            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
                            <div>@errorModal</div>
                        </div>
                    }

                    <div class="modal-body p-4" style="font-size: 0.88rem;">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold mb-1">Categoría del documento <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="nuevoDocCategoria">
                                    @foreach (var c in CategoriasDisponibles)
                                    {
                                        <option value="@c">@c</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-bold mb-1">Tipo de documento <span class="text-danger">*</span></label>
                                <select class="form-select" @bind="nuevoDocTipo">
                                    <option value="">-- Seleccione tipo de soporte --</option>
                                    @foreach (var t in TiposDisponibles)
                                    {
                                        <option value="@t">@t</option>
                                    }
                                </select>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold mb-1">Título o descripción del soporte <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" placeholder="Ej: Certificado Fitosanitario Lote Las Palmeras 2026" @bind="nuevoDocTitulo" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold mb-1">Número de radicado / referencia</label>
                                <input type="text" class="form-control" placeholder="Ej: ICA-ANT-2026-089" @bind="nuevoDocReferencia" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold mb-1">Entidad emisora</label>
                                <input type="text" class="form-control" placeholder="Ej: ICA / Cámara de Comercio / DIAN" @bind="nuevoDocEntidad" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label fw-bold mb-1">Fecha de expedición</label>
                                <input type="date" class="form-control"
                                       value="@(nuevoDocFechaEmision.ToString("yyyy-MM-dd"))"
                                       @onchange="e => nuevoDocFechaEmision = ParsearFecha(e.Value?.ToString()) ?? DateTime.Today" />
                            </div>

                            <!-- Toggle de vencimiento -->
                            <div class="col-12">
                                <div class="form-check form-switch mb-1">
                                    <input class="form-check-input" type="checkbox" id="checkTieneVenc" @bind="nuevoDocTieneVencimiento" />
                                    <label class="form-check-label fw-semibold" for="checkTieneVenc">
                                        ¿Este documento tiene fecha de vencimiento periódico aplicable?
                                    </label>
                                </div>
                                <small class="text-muted" style="font-size: 0.74rem;">
                                    Los documentos permanentes como Estatutos, Actas de Constitución o RUT no expiran y no generan alertas automáticas.
                                </small>
                            </div>

                            @if (nuevoDocTieneVencimiento)
                            {
                                <div class="col-md-6">
                                    <label class="form-label fw-bold mb-1 text-danger">Fecha de vencimiento <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control"
                                           value="@(nuevoDocFechaVencimiento?.ToString("yyyy-MM-dd"))"
                                           @onchange="e => nuevoDocFechaVencimiento = ParsearFecha(e.Value?.ToString())" />
                                </div>
                            }

                            <!-- Archivo -->
                            <div class="col-12">
                                <label class="form-label fw-bold mb-1">Archivo digital custodiado <span class="text-danger">*</span></label>
                                <div class="p-3 rounded-3 border bg-light text-center">
                                    <label class="btn btn-outline-success rounded-pill px-4 py-1.5 fw-bold mb-1 cursor-pointer">
                                        <i class="bi bi-cloud-upload-fill me-1"></i> Seleccionar soporte
                                        <InputFile OnChange="OnCargaArchivoModal" accept=".pdf,.jpg,.jpeg,.png" style="display: none;" />
                                    </label>
                                    <div class="text-muted small" style="font-size: 0.74rem;">Formatos admitidos: PDF, JPG, PNG · Máximo 10 MB</div>

                                    @if (!string.IsNullOrWhiteSpace(archivoModalNombre))
                                    {
                                        <div class="mt-2 text-success fw-bold small">
                                            <i class="bi bi-check-circle-fill"></i> @archivoModalNombre (@FormatearTamano(archivoModalBytes.Length))
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="col-12">
                                <label class="form-label fw-bold mb-1">Observaciones</label>
                                <textarea class="form-control" rows="2" placeholder="Notas de custodia o alcance del documento..." @bind="nuevoDocObservaciones"></textarea>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary rounded-pill px-3 py-1.5" @onclick="CerrarModalNuevoDoc">Cancelar</button>
                        <button type="button" class="btn btn-success rounded-pill px-4 py-1.5 fw-bold" style="background-color: #17603a; border-color: #17603a;" @onclick="GuardarNuevoDocumento">
                            <i class="bi bi-check-circle-fill me-1"></i> Custodiar en Expediente
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- =========================================================================
         8. MODAL: HISTORIAL DE VERSIONES DE UN DOCUMENTO
         ========================================================================= -->
    @if (mostrandoModalHistorial && documentoSeleccionado != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 1060;" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                    <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #092615 0%, #17603a 100%);">
                        <div>
                            <span class="badge bg-warning text-dark fw-bold mb-1" style="font-size: 0.72rem;">
                                Auditoría Documental
                            </span>
                            <h5 class="modal-title fw-bold text-white mb-0" style="font-size: 1.05rem;">
                                Historial de Versiones: @documentoSeleccionado.TipoDocumento
                            </h5>
                            <small class="text-white-50">Versión actual: v@(documentoSeleccionado.VersionActual)</small>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalHistorial" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body p-4" style="font-size: 0.88rem;">
                        <!-- Versión actual -->
                        <div class="p-3 rounded-3 border border-success bg-light mb-3">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <span class="badge bg-success text-white fw-bold">Versión Actual (v@(documentoSeleccionado.VersionActual))</span>
                                <span class="text-muted small">@documentoSeleccionado.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <strong class="text-dark d-block">@documentoSeleccionado.ArchivoNombre</strong>
                            <small class="text-muted">Custodiado por: @documentoSeleccionado.RegistradoPor · @FormatearTamano(documentoSeleccionado.TamanoBytes)</small>
                            @if (!string.IsNullOrWhiteSpace(documentoSeleccionado.Observaciones))
                            {
                                <div class="mt-1 small text-secondary"><em>«@documentoSeleccionado.Observaciones»</em></div>
                            }
                        </div>

                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-3">Versiones Anteriores Custodiadas (@documentoSeleccionado.HistorialVersiones.Count)</h6>

                        <div class="d-flex flex-column gap-2">
                            @foreach (var v in documentoSeleccionado.HistorialVersiones.OrderByDescending(h => h.NumeroVersion))
                            {
                                <div class="p-2.5 rounded-3 border bg-white d-flex flex-wrap align-items-center justify-content-between gap-2">
                                    <div>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="badge bg-secondary text-white fw-bold">v@(v.NumeroVersion)</span>
                                            <strong class="text-dark small">@v.ArchivoNombre</strong>
                                            <span class="badge bg-light text-muted border small">@v.EstadoVersion</span>
                                        </div>
                                        <small class="text-muted d-block" style="font-size: 0.74rem;">
                                            Cargado el @v.FechaCarga.ToString("dd/MM/yyyy") por @v.SubidoPor · @FormatearTamano(v.TamanoBytes)
                                            @if (!string.IsNullOrWhiteSpace(v.Observaciones))
                                            {
                                                <span>· Motivo: «@v.Observaciones»</span>
                                            }
                                        </small>
                                    </div>
                                    @if (v.ArchivoContenido != null)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2.5 py-0.5" style="font-size: 0.75rem;" @onclick="() => DescargarArchivoVersion(v)">
                                            <i class="bi bi-download me-1"></i> Descargar v@(v.NumeroVersion)
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="modal-footer bg-light px-4 py-2.5 text-end">
                        <button type="button" class="btn btn-secondary rounded-pill px-4 py-1.5" @onclick="CerrarModalHistorial">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- =========================================================================
         9. MODAL: REVISIÓN / OBSERVACIÓN DE DOCUMENTO
         ========================================================================= -->
    @if (mostrandoModalRevisar && documentoSeleccionado != null)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6); backdrop-filter: blur(4px); z-index: 1060;" role="dialog" aria-modal="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content rounded-4 border-0 shadow-lg overflow-hidden">
                    <div class="modal-header text-white px-4 py-3" style="background: linear-gradient(135deg, #092615 0%, #17603a 100%);">
                        <div>
                            <span class="badge bg-warning text-dark fw-bold mb-1" style="font-size: 0.72rem;">Revisión de Custodia</span>
                            <h5 class="modal-title fw-bold text-white mb-0" style="font-size: 1.05rem;">
                                @documentoSeleccionado.TipoDocumento
                            </h5>
                        </div>
                        <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalRevisar" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body p-4" style="font-size: 0.88rem;">
                        <div class="mb-3">
                            <label class="form-label fw-bold mb-1">Estado de la revisión <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="nuevoEstadoRevision">
                                <option value="Aprobado">Aprobado (Soporte conforme a requisitos)</option>
                                <option value="Pendiente de revisión">Pendiente de revisión</option>
                                <option value="Observado">Observado (Requiere aclaración o reemplazo)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold mb-1">Nota de revisión u observaciones</label>
                            <textarea class="form-control" rows="3" placeholder="Indique las conclusiones de la revisión..." @bind="notaRevision"></textarea>
                        </div>
                    </div>

                    <div class="modal-footer bg-light px-4 py-3 d-flex justify-content-between">
                        <button type="button" class="btn btn-secondary rounded-pill px-3 py-1.5" @onclick="CerrarModalRevisar">Cancelar</button>
                        <button type="button" class="btn btn-success rounded-pill px-4 py-1.5 fw-bold" style="background-color: #17603a;" @onclick="GuardarRevision">
                            <i class="bi bi-check2-circle me-1"></i> Guardar Revisión
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

</div>

@code {
    [SupplyParameterFromQuery(Name = "asociacion")]
    public string? ParamAsociacion { get; set; }

    [SupplyParameterFromQuery(Name = "asoc")]
    public string? ParamAsoc { get; set; }

    [SupplyParameterFromQuery(Name = "id")]
    public string? ParamId { get; set; }

    private List<AsociacionInstitucional> todasAsociaciones = new();
    private AsociacionInstitucional? asociacionSeleccionada;
    private List<DocumentoAsociacion> documentosAsoc = new();

    private string categoriaActiva = "Todas";
    private string mensajeAlerta = string.Empty;
    private bool esErrorAlerta = false;

    private bool puedeEditar = true;
    private bool esPresidenta = false;
    private string usuarioActual = "Secretaría FAAUA";

    // Modales
    private bool mostrandoModalVersion = false;
    private bool mostrandoModalNuevoDoc = false;
    private bool mostrandoModalHistorial = false;
    private bool mostrandoModalRevisar = false;

    private DocumentoAsociacion? documentoSeleccionado;
    private string errorModal = string.Empty;

    // Estado modal versión
    private string archivoModalNombre = string.Empty;
    private byte[] archivoModalBytes = Array.Empty<byte>();
    private string archivoModalTipoMime = "application/pdf";
    private DateTime? fechaVencimientoModal;
    private string observacionesModal = string.Empty;

    // Estado modal nuevo documento
    private string nuevoDocCategoria = "Constitución y estatutos";
    private string nuevoDocTipo = "";
    private string nuevoDocTitulo = "";
    private string nuevoDocReferencia = "";
    private string nuevoDocEntidad = "";
    private DateTime nuevoDocFechaEmision = DateTime.Today;
    private bool nuevoDocTieneVencimiento = false;
    private DateTime? nuevoDocFechaVencimiento;
    private string nuevoDocObservaciones = "";

    // Estado modal revisión
    private string nuevoEstadoRevision = "Aprobado";
    private string notaRevision = string.Empty;

    private IEnumerable<string> CategoriasDisponibles => DocumentoService.ObtenerCategoriasDocumentales();
    private IEnumerable<string> TiposDisponibles => DocumentoService.ObtenerCatalogoTiposDocumentos();

    private string NombreCompletoAsoc => asociacionSeleccionada == null
        ? string.Empty
        : (string.IsNullOrWhiteSpace(asociacionSeleccionada.Sigla)
            ? asociacionSeleccionada.NombreLegal
            : $"{asociacionSeleccionada.Sigla} - {asociacionSeleccionada.NombreLegal}");

    private List<DocumentoAsociacion> DocumentosFiltrados => categoriaActiva == "Todas"
        ? documentosAsoc
        : documentosAsoc.Where(d => string.Equals(d.Categoria, categoriaActiva, StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            usuarioActual = user.Identity.Name
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? "Secretaría FAAUA";

            esPresidenta = user.IsInRole("Presidenta") || user.IsInRole("Presidente");
            puedeEditar = user.IsInRole("Secretaria") || user.IsInRole("Secretaría") || esPresidenta;
        }

        CargarAsociaciones();
    }

    protected override void OnParametersSet()
    {
        var query = ParamAsociacion ?? ParamAsoc ?? ParamId;
        if (!string.IsNullOrWhiteSpace(query))
        {
            var encontrada = DocumentoService.ObtenerAsociacionInstitucional(query);
            if (encontrada != null)
            {
                SeleccionarAsociacion(encontrada);
            }
        }
        else if (asociacionSeleccionada == null && todasAsociaciones.Any())
        {
            SeleccionarAsociacion(todasAsociaciones.First());
        }
    }

    private void CargarAsociaciones()
    {
        todasAsociaciones = DocumentoService.ObtenerAsociacionesInstitucionales().ToList();
    }

    private void OnCambioAsociacionSelect(ChangeEventArgs e)
    {
        var idStr = e.Value?.ToString();
        if (Guid.TryParse(idStr, out var id))
        {
            var asoc = todasAsociaciones.FirstOrDefault(a => a.Id == id);
            if (asoc != null)
            {
                SeleccionarAsociacion(asoc);
            }
        }
    }

    private void SeleccionarAsociacion(AsociacionInstitucional asoc)
    {
        asociacionSeleccionada = asoc;
        categoriaActiva = "Todas";
        CargarDocumentosAsociacion();
    }

    private void CargarDocumentosAsociacion()
    {
        if (asociacionSeleccionada == null)
        {
            documentosAsoc.Clear();
            return;
        }

        var nombre = NombreCompletoAsoc;
        documentosAsoc = DocumentoService.ObtenerPorAsociacion(nombre).ToList();
    }

    private void AbrirModalNuevoDocumento()
    {
        errorModal = "";
        archivoModalNombre = "";
        archivoModalBytes = Array.Empty<byte>();
        nuevoDocCategoria = categoriaActiva != "Todas" ? categoriaActiva : "Constitución y estatutos";
        nuevoDocTipo = "";
        nuevoDocTitulo = "";
        nuevoDocReferencia = "";
        nuevoDocEntidad = "";
        nuevoDocFechaEmision = DateTime.Today;
        nuevoDocTieneVencimiento = false;
        nuevoDocFechaVencimiento = null;
        nuevoDocObservaciones = "";
        mostrandoModalNuevoDoc = true;
    }

    private void CerrarModalNuevoDoc() => mostrandoModalNuevoDoc = false;

    private void AbrirModalVersion(DocumentoAsociacion doc)
    {
        documentoSeleccionado = doc;
        errorModal = "";
        archivoModalNombre = "";
        archivoModalBytes = Array.Empty<byte>();
        fechaVencimientoModal = doc.FechaVencimiento;
        observacionesModal = "";
        mostrandoModalVersion = true;
    }

    private void CerrarModalVersion()
    {
        mostrandoModalVersion = false;
        documentoSeleccionado = null;
    }

    private void AbrirModalHistorial(DocumentoAsociacion doc)
    {
        documentoSeleccionado = doc;
        mostrandoModalHistorial = true;
    }

    private void CerrarModalHistorial()
    {
        mostrandoModalHistorial = false;
        documentoSeleccionado = null;
    }

    private void AbrirModalRevisar(DocumentoAsociacion doc)
    {
        documentoSeleccionado = doc;
        nuevoEstadoRevision = doc.EstadoRevision;
        notaRevision = "";
        mostrandoModalRevisar = true;
    }

    private void CerrarModalRevisar()
    {
        mostrandoModalRevisar = false;
        documentoSeleccionado = null;
    }

    private async Task OnCargaArchivoModal(InputFileChangeEventArgs e)
    {
        errorModal = "";
        var file = e.File;
        if (file == null) return;

        if (file.Size == 0)
        {
            errorModal = "El archivo seleccionado está vacío (0 bytes).";
            return;
        }

        const long maxBytes = 10 * 1024 * 1024;
        if (file.Size > maxBytes)
        {
            errorModal = $"El archivo supera el límite de 10 MB ({file.Size / (1024 * 1024.0):F1} MB).";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var permitidas = new[] { ".pdf", ".jpg", ".jpeg", ".png" };
        if (!permitidas.Contains(ext))
        {
            errorModal = $"Formato '{ext}' no admitido. Formatos permitidos: PDF, JPG, PNG.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            archivoModalNombre = file.Name;
            archivoModalBytes = ms.ToArray();
            archivoModalTipoMime = file.ContentType ?? (ext == ".pdf" ? "application/pdf" : "image/jpeg");
        }
        catch (Exception ex)
        {
            errorModal = $"Error al leer el archivo: {ex.Message}";
        }
    }

    private void GuardarNuevaVersion()
    {
        if (documentoSeleccionado == null) return;
        errorModal = "";

        if (archivoModalBytes.Length == 0)
        {
            errorModal = "Debes seleccionar un archivo válido para adjuntar la nueva versión.";
            return;
        }

        var exito = DocumentoService.AgregarNuevaVersion(
            documentoSeleccionado.Id,
            archivoModalNombre,
            archivoModalBytes,
            archivoModalTipoMime,
            archivoModalBytes.Length,
            observacionesModal,
            usuarioActual,
            DateTime.Today,
            fechaVencimientoModal
        );

        if (!exito)
        {
            errorModal = "No fue posible registrar la nueva versión del documento.";
            return;
        }

        mensajeAlerta = $"Se guardó exitosamente la versión {documentoSeleccionado.VersionActual} del soporte '{documentoSeleccionado.TipoDocumento}'.";
        esErrorAlerta = false;

        CargarDocumentosAsociacion();
        CerrarModalVersion();
    }

    private void GuardarNuevoDocumento()
    {
        if (asociacionSeleccionada == null) return;
        errorModal = "";

        if (string.IsNullOrWhiteSpace(nuevoDocTipo))
        {
            errorModal = "Debe seleccionar un tipo de documento.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevoDocTitulo))
        {
            nuevoDocTitulo = nuevoDocTipo;
        }

        if (nuevoDocTieneVencimiento && !nuevoDocFechaVencimiento.HasValue)
        {
            errorModal = "Debe indicar la fecha de vencimiento aplicable para este documento.";
            return;
        }

        if (archivoModalBytes.Length == 0)
        {
            errorModal = "Debes seleccionar un archivo para custodiar el soporte en el expediente.";
            return;
        }

        var nuevoDoc = new DocumentoAsociacion
        {
            AsociacionId = asociacionSeleccionada.Id,
            NombreAsociacion = NombreCompletoAsoc,
            NitAsociacion = string.IsNullOrWhiteSpace(asociacionSeleccionada.DigitoVerificacion)
                ? asociacionSeleccionada.Nit
                : $"{asociacionSeleccionada.Nit}-{asociacionSeleccionada.DigitoVerificacion}",
            Categoria = nuevoDocCategoria,
            TipoDocumento = nuevoDocTipo,
            Titulo = nuevoDocTitulo,
            NumeroReferencia = nuevoDocReferencia,
            EntidadEmisora = nuevoDocEntidad,
            FechaEmision = nuevoDocFechaEmision,
            TieneVencimiento = nuevoDocTieneVencimiento,
            FechaVencimiento = nuevoDocTieneVencimiento ? nuevoDocFechaVencimiento : null,
            ArchivoNombre = archivoModalNombre,
            ArchivoContenido = archivoModalBytes,
            ArchivoTipoMime = archivoModalTipoMime,
            TamanoBytes = archivoModalBytes.Length,
            Observaciones = nuevoDocObservaciones,
            RegistradoPor = usuarioActual,
            FechaRegistro = DateTime.Now,
            EstadoRevision = "Aprobado",
            NivelRequerimiento = "Requerido para esta asociación"
        };

        DocumentoService.RegistrarDocumentoEnExpediente(nuevoDoc, usuarioActual);

        mensajeAlerta = $"El soporte '{nuevoDoc.TipoDocumento}' fue custodiado exitosamente en el expediente de {asociacionSeleccionada.NombreLegal}.";
        esErrorAlerta = false;

        CargarDocumentosAsociacion();
        CerrarModalNuevoDoc();
    }

    private void GuardarRevision()
    {
        if (documentoSeleccionado == null) return;

        DocumentoService.ActualizarRevisionDocumento(
            documentoSeleccionado.Id,
            nuevoEstadoRevision,
            notaRevision,
            usuarioActual
        );

        mensajeAlerta = $"La revisión del documento '{documentoSeleccionado.TipoDocumento}' fue actualizada a '{nuevoEstadoRevision}'.";
        esErrorAlerta = false;

        CargarDocumentosAsociacion();
        CerrarModalRevisar();
    }

    private async Task DescargarArchivo(DocumentoAsociacion doc)
    {
        try
        {
            if (doc.ArchivoContenido != null && doc.ArchivoContenido.Length > 0)
            {
                var nombreDescarga = !string.IsNullOrWhiteSpace(doc.ArchivoNombre) ? doc.ArchivoNombre : $"{Regex.Replace(doc.TipoDocumento, @"[^a-zA-Z0-9]", "_")}.pdf";
                var mime = !string.IsNullOrWhiteSpace(doc.ArchivoTipoMime) ? doc.ArchivoTipoMime : "application/pdf";
                var base64 = Convert.ToBase64String(doc.ArchivoContenido);
                await JS.InvokeVoidAsync("descargarArchivoBase64", nombreDescarga, mime, base64);
            }
            else
            {
                var asoc = asociacionSeleccionada ?? new AsociacionInstitucional
                {
                    NombreLegal = doc.NombreAsociacion,
                    Nit = doc.NitAsociacion,
                    Estado = "Activa"
                };
                var pdfBytes = ExpedienteAsociacionPdfGenerator.GenerarResumenPdf(asoc, new[] { doc }, usuarioActual);
                var base64 = Convert.ToBase64String(pdfBytes);
                var nombreLimpio = Regex.Replace(doc.TipoDocumento, @"[^a-zA-Z0-9]", "_");
                await JS.InvokeVoidAsync("descargarArchivoBase64", $"Soporte_{nombreLimpio}.pdf", "application/pdf", base64);
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"No fue posible descargar el documento: {ex.Message}");
        }
    }

    private async Task DescargarArchivoVersion(DocumentoVersionHistorial v)
    {
        if (v.ArchivoContenido == null || v.ArchivoContenido.Length == 0) return;
        var base64 = Convert.ToBase64String(v.ArchivoContenido);
        await JS.InvokeVoidAsync("descargarArchivoBase64", v.ArchivoNombre, v.ArchivoTipoMime, base64);
    }

    private static string FormatearTamano(long bytes)
    {
        if (bytes <= 0) return "0 KB";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F0} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    private static string ObtenerIconoPorFormato(string? nombre)
    {
        var ext = Path.GetExtension(nombre ?? "").ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "bi-filetype-pdf text-danger",
            ".jpg" or ".jpeg" => "bi-filetype-jpg text-primary",
            ".png" => "bi-filetype-png text-info",
            _ => "bi-file-earmark-text text-success"
        };
    }

    private static string ObtenerClaseRevisionBadge(string estado) => estado?.Trim().ToLowerInvariant() switch
    {
        "aprobado" => "bg-success-subtle text-success border border-success",
        "observado" => "bg-danger-subtle text-danger border border-danger",
        _ => "bg-warning-subtle text-warning-emphasis border border-warning"
    };

    private static string ObtenerEstiloBadgeEstado(string estado) => estado?.Trim().ToLowerInvariant() switch
    {
        "activa" => "background-color: #dcfce7 !important; color: #14532d !important; border: 1px solid #86efac !important;",
        "en actualización" or "suspendida" or "pendiente" => "background-color: #fef9c3 !important; color: #713f12 !important; border: 1px solid #fde047 !important;",
        "disuelta" or "en liquidación" or "inactiva" or "vencida" => "background-color: #fee2e2 !important; color: #7f1d1d !important; border: 1px solid #fca5a5 !important;",
        _ => "background-color: #f1f5f9 !important; color: #334155 !important; border: 1px solid #cbd5e1 !important;"
    };

    private static string ObtenerIniciales(string? texto)
    {
        if (string.IsNullOrWhiteSpace(texto)) return "AS";
        var palabras = texto.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (palabras.Length == 1) return palabras[0][..Math.Min(2, palabras[0].Length)].ToUpperInvariant();
        return $"{palabras[0][0]}{palabras[1][0]}".ToUpperInvariant();
    }

    private static DateTime? ParsearFecha(string? texto)
    {
        if (DateTime.TryParse(texto, out var f)) return f.Date;
        return null;
    }
}

<script>
    window.descargarArchivoBase64 = function (nombre, tipoMime, base64) {
        try {
            const enlace = document.createElement('a');
            enlace.download = nombre || 'documento.pdf';
            enlace.href = 'data:' + (tipoMime || 'application/pdf') + ';base64,' + base64;
            document.body.appendChild(enlace);
            enlace.click();
            document.body.removeChild(enlace);
        } catch (e) {
            console.error('Error al descargar archivo:', e);
        }
    };
</script>