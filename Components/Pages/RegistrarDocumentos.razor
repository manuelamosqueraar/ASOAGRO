@page "/registrar-documentos"
@rendermode InteractiveServer

<div class="page-header">
    <div>
        <p class="eyebrow text-success">Documentos</p>
        <h1>Registrar documento</h1>
        <p>Asocia soportes a un productor para alimentar el futuro control de vencimientos.</p>
    </div>
    <span class="status-chip">Módulo inicial</span>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

<div class="content-card">
    <div class="form-intro">
        <div>
            <h2>Información del soporte</h2>
            <p>La carga de archivos aún es simulada; esta pantalla prepara el flujo visual del módulo documental.</p>
        </div>
    </div>

    <EditForm Model="@documentoModel" OnValidSubmit="GuardarDocumento">
        <DataAnnotationsValidator />
        

        <div class="row g-3">
            <div class="col-md-6">
                <label for="documentoAsociado" class="form-label">Número de Documento del Asociado</label>
                <InputText id="documentoAsociado" class="form-control" @bind-Value="documentoModel.DocumentoAsociado" />
                <ValidationMessage For="@(() => documentoModel.DocumentoAsociado)" />
            </div>

            <div class="col-md-6">
                <label for="tipoDocumento" class="form-label">Tipo de Documento</label>
                <InputSelect id="tipoDocumento" class="form-select" @bind-Value="documentoModel.TipoDocumento">
                    <option value="">Seleccione el tipo...</option>
                    <option value="CertificadoFinca">Certificado de Tradición y Libertad</option>
                    <option value="CedulaCiudadania">Cédula de Ciudadanía</option>
                    <option value="RegistroBPA">Buenas Prácticas Agrícolas (BPA)</option>
                </InputSelect>
                <ValidationMessage For="@(() => documentoModel.TipoDocumento)" />
            </div>
        </div>

        <div class="upload-zone my-4">
            <label for="archivo" class="form-label">Seleccionar Archivo (PDF / Imagen)</label>
            <input type="file" id="archivo" class="form-control" @onchange="CargarArchivo" />
            <small>Formatos sugeridos: PDF, JPG o PNG. La validación real se agregará con el almacenamiento de archivos.</small>
        </div>

        <button type="submit" class="btn btn-primary btn-lg">Subir y Registrar Documento</button>
    </EditForm>
</div>

@code {
    private DocumentoModel documentoModel = new();
    private string mensajeExito = string.Empty;
    private string nombreArchivo = string.Empty;

    private void CargarArchivo(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        // Captura el nombre del archivo seleccionado de forma simulada
        if (e.Value is not null)
        {
            nombreArchivo = e.Value.ToString() ?? "archivo_cargado.pdf";
        }
    }

    private void GuardarDocumento()
    {
        mensajeExito = $"¡Documento '{documentoModel.TipoDocumento}' registrado con éxito para el asociado con cédula {documentoModel.DocumentoAsociado}!";
        documentoModel = new();
    }

    public class DocumentoModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El documento del asociado es obligatorio.")]
        public string DocumentoAsociado { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Debe seleccionar el tipo de documento.")]
        public string TipoDocumento { get; set; } = string.Empty;
    }
}
