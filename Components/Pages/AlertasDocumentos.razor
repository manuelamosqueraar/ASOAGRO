@page "/alertas-documentos"
@rendermode InteractiveServer

<h3>Panel de Alertas y Vencimientos de Documentos</h3>

<div class="alert alert-info" role="alert">
    Mostrando alertas basadas en los umbrales configurados (30, 15 y 7 días para el vencimiento de certificados y documentos de fincas).
</div>

@if (alertasPendientes.Any())
{
    <table class="table table-striped table-bordered mt-3">
        <thead class="table-dark">
            <tr>
                <th>Asociado</th>
                <th>Documento</th>
                <th>Fecha de Vencimiento</th>
                <th>Días Restantes</th>
                <th>Estado de Alerta</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alerta in alertasPendientes)
            {
                <tr>
                    <td>@alerta.NombreAsociado</td>
                    <td>@alerta.TipoDocumento</td>
                    <td>@alerta.FechaVencimiento.ToShortDateString()</td>
                    <td>
                        <span class="badge @ObtenerColorBadge(alerta.DiasRestantes)">
                            @alerta.DiasRestantes días
                        </span>
                    </td>
                    <td>
                        <strong>@alerta.MensajeAlerta</strong>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-success mt-3" role="alert">
        No hay alertas pendientes por vencimiento en este momento.
    </div>
}

@code {
    private List<AlertaDto> alertasPendientes = new()
    {
        new() { NombreAsociado = "Carlos Pérez", TipoDocumento = "Certificado de Tradición", FechaVencimiento = DateTime.Now.AddDays(5), DiasRestantes = 5, MensajeAlerta = "¡Alerta Crítica! Vence en menos de 7 días" },
        new() { NombreAsociado = "Ana Gómez", TipoDocumento = "Buenas Prácticas Agrícolas (BPA)", FechaVencimiento = DateTime.Now.AddDays(12), DiasRestantes = 12, MensajeAlerta = "Advertencia: Vence en menos de 15 días" },
        new() { NombreAsociado = "Luis Martínez", TipoDocumento = "Registro ICA", FechaVencimiento = DateTime.Now.AddDays(25), DiasRestantes = 25, MensajeAlerta = "Aviso preventivo: Vence en menos de 30 días" }
    };

    private string ObtenerColorBadge(int dias)
    {
        if (dias <= 7) return "bg-danger";
        if (dias <= 15) return "bg-warning text-dark";
        return "bg-info text-dark";
    }

    public class AlertaDto
    {
        public string NombreAsociado { get; set; } = string.Empty;
        public string TipoDocumento { get; set; } = string.Empty;
        public DateTime FechaVencimiento { get; set; }
        public int DiasRestantes { get; set; }
        public string MensajeAlerta { get; set; } = string.Empty;
    }
}