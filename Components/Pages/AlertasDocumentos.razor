@page "/alertas-documentos"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Secretaria,Secretaría,Presidenta,Presidente,Administrador,Admin")]
@rendermode InteractiveServer
@using Asoagro.Models
@using Asoagro.Services
@inject IDocumentoAsociacionService DocumentoService
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Alertas de Vencimiento de Documentos · Asoagro & FAAUA</PageTitle>

<div class="asoagro-documentos-wrapper container-fluid px-0 pb-5">

    <!-- HERO PANEL INSTITUCIONAL -->
    <div class="card aso-hero-card mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="aso-hero-icon-box">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                            <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="aso-hero-kicker">FAAUA · Secretaría General</span>
                            <span class="text-white-50" style="font-size: 0.75rem; font-weight: 600;">Umbrales 30 / 15 / 7 días · @alertas.Count alerta(s) activa(s)</span>
                        </div>
                        <h1 class="aso-hero-title">Alertas y vencimientos documentales</h1>
                        <p class="aso-hero-desc">
                            Monitoreo en tiempo real de soportes legales, tributarios y certificaciones de las asociaciones de base para mantener la elegibilidad de la federación.
                        </p>
                    </div>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    <a href="consultar-estado-documentos" class="aso-btn-hero-secondary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path></svg>
                        <span>Estado de documentación</span>
                    </a>
                    <a href="registrar-documentos" class="aso-btn-hero-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Registrar documento</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- MENSAJES DE ESTADO -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>¡Actualización exitosa!</strong> @mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = string.Empty"></button>
        </div>
    }

    <!-- FRANJA EJECUTIVA DE SEVERIDAD DE ALERTAS -->
    <div class="aso-kpi-grid">
        <div class="aso-kpi-card kpi-emerald" style="cursor: pointer;" @onclick='() => filtroNivel = "Todos"'>
            <div class="aso-kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
            </div>
            <div class="aso-kpi-meta">
                <span class="aso-kpi-label">Total Alertas Activas</span>
                <strong class="aso-kpi-value">@alertas.Count</strong>
                <span class="aso-kpi-sub">Umbral preventivo de 30 días</span>
            </div>
        </div>

        <div class="aso-kpi-card kpi-rose" style="cursor: pointer;" @onclick='() => filtroNivel = "Vencido"'>
            <div class="aso-kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
            </div>
            <div class="aso-kpi-meta">
                <span class="aso-kpi-label">Soportes Vencidos</span>
                <strong class="aso-kpi-value">@alertas.Count(a => a.DiasRestantes < 0)</strong>
                <span class="aso-kpi-sub">Renovación urgente requerida</span>
            </div>
        </div>

        <div class="aso-kpi-card kpi-amber" style="cursor: pointer;" @onclick='() => filtroNivel = "Crítica"'>
            <div class="aso-kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
            </div>
            <div class="aso-kpi-meta">
                <span class="aso-kpi-label">Alerta Crítica (&le; 7d)</span>
                <strong class="aso-kpi-value">@alertas.Count(a => a.DiasRestantes >= 0 && a.DiasRestantes <= 7)</strong>
                <span class="aso-kpi-sub">Vencimiento en la semana actual</span>
            </div>
        </div>

        <div class="aso-kpi-card kpi-sky" style="cursor: pointer;" @onclick='() => filtroNivel = "Preventivo"'>
            <div class="aso-kpi-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div class="aso-kpi-meta">
                <span class="aso-kpi-label">Aviso Preventivo (8–30d)</span>
                <strong class="aso-kpi-value">@alertas.Count(a => a.DiasRestantes > 7)</strong>
                <span class="aso-kpi-sub">En ventana de gestión anticipada</span>
            </div>
        </div>
    </div>

    <!-- ESTACIÓN DE FILTROS Y RESUMEN -->
    <div class="aso-filter-workbench">
        <div class="aso-filter-grid-3">
            <!-- Filtro por asociación -->
            <div class="aso-field-group">
                <label class="aso-field-label">Filtrar por asociación federada</label>
                <select class="aso-select-modern" @bind="filtroAsociacion">
                    <option value="">Todas las asociaciones federadas</option>
                    @foreach (var asoc in listaAsociaciones)
                    {
                        <option value="@asoc">@asoc</option>
                    }
                </select>
            </div>

            <!-- Filtro por severidad / nivel de alerta -->
            <div class="aso-field-group">
                <label class="aso-field-label">Nivel de severidad / alerta</label>
                <select class="aso-select-modern" @bind="filtroNivel">
                    <option value="Todos">Todos los niveles de alerta</option>
                    <option value="Vencido">Documentos vencidos</option>
                    <option value="Crítica">Alerta crítica (&le; 7 días)</option>
                    <option value="Advertencia">Advertencia (&le; 15 días)</option>
                    <option value="Preventivo">Aviso preventivo (&le; 30 días)</option>
                </select>
            </div>

            <div class="aso-field-group">
                <label class="aso-field-label">Resumen de monitoreo</label>
                <div class="d-flex align-items-center justify-content-between gap-2 px-3 rounded-3" style="height: 40px; background: #fff1f2; border: 1px solid #fecdd3;">
                    <span class="fw-bold text-danger" style="font-size: 0.82rem;">
                        @AlertasFiltradas.Count() alerta(s) filtrada(s)
                    </span>
                    @if (!string.IsNullOrWhiteSpace(filtroAsociacion) || filtroNivel != "Todos")
                    {
                        <button type="button" class="btn btn-sm btn-link text-danger p-0 fw-bold text-decoration-none" style="font-size: 0.76rem;" @onclick='() => { filtroAsociacion = ""; filtroNivel = "Todos"; }'>
                            Restablecer
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- TABLA DE ALERTAS REALES DE ASOCIACIONES -->
    <div class="aso-table-card">
        <div class="aso-table-header-bar">
            <div class="aso-table-header-title">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2.2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                <span>Tablero de Soportes Próximos a Vencer o Vencidos</span>
                <span class="aso-table-count-pill" style="background: #ffe4e6; color: #be123c; border-color: #fecdd3;">@AlertasFiltradas.Count() alertas</span>
            </div>
            <span class="text-muted" style="font-size: 0.78rem; font-weight: 500;">Corte del sistema: @DateTime.Today.ToString("dd/MM/yyyy")</span>
        </div>

        @if (!AlertasFiltradas.Any())
        {
            <div class="p-5 text-center">
                <div class="mb-3 text-success">
                    <i class="bi bi-shield-check display-3"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">No hay alertas de vencimiento pendientes</h5>
                <p class="text-muted small mb-3">
                    @(string.IsNullOrWhiteSpace(filtroAsociacion)
                        ? "Todos los documentos registrados de las asociaciones cuentan con vigencia óptima o no tienen vencimientos próximos (umbrales de 30, 15 y 7 días)."
                        : $"La asociación '{filtroAsociacion}' no presenta documentos con vencimiento próximo en el sistema.")
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="consultar-estado-documentos" class="aso-btn-action px-3 py-2">
                        <span>Consultar Expedientes</span>
                    </a>
                    <a href="registrar-documentos" class="aso-btn-action aso-btn-action-primary px-3 py-2">
                        <span>Registrar Documento</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="aso-table-wrap">
                <table class="table aso-table-grid align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="text-start" style="width: 24%; min-width: 200px;">Asociación</th>
                            <th class="text-start" style="width: 22%; min-width: 190px;">Documento</th>
                            <th class="text-center" style="width: 12%; min-width: 110px;">Vencimiento</th>
                            <th class="text-center" style="width: 12%; min-width: 110px;">Días restantes</th>
                            <th class="text-start" style="width: 14%; min-width: 145px;">Nivel de alerta</th>
                            <th class="text-end" style="width: 16%; min-width: 175px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alerta in AlertasFiltradas)
                        {
                            var esVencido = alerta.DiasRestantes < 0;
                            var esCritica = alerta.DiasRestantes >= 0 && alerta.DiasRestantes <= 7;
                            var esAdvertencia = alerta.DiasRestantes > 7 && alerta.DiasRestantes <= 15;

                            <tr>
                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-2.5">
                                        <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-xs flex-shrink-0"
                                             style="width: 38px; height: 38px; min-width: 38px; border-radius: 10px; background: @(esVencido || esCritica ? "#b91c1c" : "#b45309"); font-size: 0.76rem;">
                                            @ObtenerInicialesAsociacion(alerta.NombreAsociacion)
                                        </div>
                                        <div class="d-flex flex-column" style="min-width: 0;">
                                            <strong class="text-dark text-truncate" style="max-width: 200px; font-size: 0.85rem;" title="@alerta.NombreAsociacion">@alerta.NombreAsociacion</strong>
                                            @if (!string.IsNullOrWhiteSpace(alerta.NitAsociacion))
                                            {
                                                <small class="text-muted font-monospace" style="font-size: 0.72rem;">NIT: @alerta.NitAsociacion</small>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td class="text-start">
                                    <strong class="d-block text-dark" style="font-size: 0.85rem;">@alerta.TipoDocumento</strong>
                                    @if (!string.IsNullOrWhiteSpace(alerta.Titulo) && alerta.Titulo != alerta.TipoDocumento)
                                    {
                                        <small class="text-muted d-block text-truncate" style="max-width: 220px; font-size: 0.74rem;">@alerta.Titulo</small>
                                    }
                                </td>

                                <td class="text-center">
                                    <strong class="@(esVencido || esCritica ? "text-danger fw-bold" : "text-dark")" style="font-size: 0.84rem;">
                                        @alerta.FechaVencimiento.ToString("dd/MM/yyyy")
                                    </strong>
                                </td>

                                <td class="text-center">
                                    @if (esVencido)
                                    {
                                        <span class="aso-badge-vencida">
                                            Vencido (@Math.Abs(alerta.DiasRestantes)d)
                                        </span>
                                    }
                                    else if (esCritica)
                                    {
                                        <span class="aso-badge-vencida">
                                            @alerta.DiasRestantes días
                                        </span>
                                    }
                                    else if (esAdvertencia)
                                    {
                                        <span class="aso-badge-pendiente">
                                            @alerta.DiasRestantes días
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="aso-badge-neutro">
                                            @alerta.DiasRestantes días
                                        </span>
                                    }
                                </td>

                                <td class="text-start">
                                    <div class="d-flex align-items-center gap-1.5" style="font-size: 0.8rem;">
                                        @if (esVencido)
                                        {
                                            <strong class="text-danger">Documento vencido</strong>
                                        }
                                        else if (esCritica)
                                        {
                                            <strong class="text-danger">Crítica (&le; 7 días)</strong>
                                        }
                                        else if (esAdvertencia)
                                        {
                                            <strong class="text-warning-emphasis">Advertencia (&le; 15 días)</strong>
                                        }
                                        else
                                        {
                                            <strong class="text-primary">Preventivo (&le; 30 días)</strong>
                                        }
                                    </div>
                                </td>

                                <td class="text-end align-middle">
                                    <div class="aso-actions-group">
                                        @if (!string.IsNullOrWhiteSpace(alerta.ArchivoNombre))
                                        {
                                            <button type="button"
                                                    class="aso-btn-action"
                                                    title="Descargar o consultar archivo archivado"
                                                    @onclick="() => DescargarArchivoPorId(alerta.DocumentoId)">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                                <span>Ver</span>
                                            </button>
                                        }

                                        <button type="button"
                                                class="aso-btn-action aso-btn-action-primary"
                                                title="Actualizar fecha de vencimiento o subir renovación"
                                                @onclick="() => AbrirModalActualizar(alerta)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="23 4 23 10 17 10"></polyline><polyline points="1 20 1 14 7 14"></polyline><path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path></svg>
                                            <span>Renovar</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

</div>

<!-- MODAL PARA ACTUALIZAR O RENOVAR DOCUMENTO -->
@if (alertaSeleccionada != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(11, 46, 28, 0.65); backdrop-filter: blur(5px); z-index: 2500; pointer-events: auto;" @onclick="CerrarModalActualizar">
        <div class="modal-dialog modal-dialog-centered" style="pointer-events: auto;" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden" style="pointer-events: auto;">
                <div class="modal-header border-0 py-3 px-4 text-white" style="background: linear-gradient(135deg, #0b2e1c 0%, #17603a 100%);">
                    <div>
                        <span class="badge rounded-pill fw-bold mb-1" style="background-color: #b9e77a; color: #0b2e1c; font-size: 0.7rem;">Renovación de Documento</span>
                        <h5 class="modal-title fw-bold text-white mb-0" style="font-family: 'Sora', sans-serif; font-size: 1.05rem;">Actualizar Expediente Institucional</h5>
                    </div>
                    <button type="button" class="btn-close btn-close-white" @onclick="CerrarModalActualizar"></button>
                </div>

                <div class="modal-body p-4" style="max-height: 75vh; overflow-y: auto; overscroll-behavior: contain;">
                    <div class="p-3 bg-light rounded-3 mb-3 border" style="border-color: #dce4d8 !important;">
                        <strong class="d-block text-dark small">@alertaSeleccionada.NombreAsociacion</strong>
                        <span class="text-secondary small d-block">Documento: <strong>@alertaSeleccionada.TipoDocumento</strong></span>
                        <span class="extra-small text-muted">Vencimiento anterior: @alertaSeleccionada.FechaVencimiento.ToString("dd/MM/yyyy")</span>
                    </div>

                    @if (!string.IsNullOrEmpty(errorModal))
                    {
                        <div class="alert alert-danger py-2 px-3 small mb-3">
                            <i class="bi bi-exclamation-triangle-fill me-1"></i> @errorModal
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Nueva Fecha de Vencimiento <span class="text-danger">*</span></label>
                        <input type="date" class="form-control" @bind="nuevaFechaVencimiento" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <small class="text-muted extra-small">Indica la nueva vigencia acordada o expedida por la entidad.</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold small text-dark">Reemplazar Archivo Soporte (Opcional)</label>
                        <InputFile class="form-control form-control-sm" OnChange="CargarNuevoArchivo" accept=".pdf,.png,.jpg,.jpeg" />
                        @if (!string.IsNullOrEmpty(nuevoArchivoNombre))
                        {
                            <span class="badge bg-success-subtle text-success mt-1 small">
                                <i class="bi bi-file-earmark-check me-1"></i> @nuevoArchivoNombre
                            </span>
                        }
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-bold small text-dark">Observaciones de la Renovación</label>
                        <textarea class="form-control" rows="2" placeholder="Ej. Renovación tramitada ante Cámara de Comercio / Nuevo aval expedido..." @bind="nuevasObservaciones"></textarea>
                    </div>
                </div>

                <div class="modal-footer bg-light border-top py-2.5 px-4">
                    <button type="button" class="aso-btn-action px-3 py-1.5" @onclick="CerrarModalActualizar">Cancelar</button>
                    <button type="button" class="aso-btn-action-primary px-4 py-1.5" @onclick="GuardarActualizacionDocumento">
                        <i class="bi bi-check2-circle"></i> Guardar Renovación
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<AlertaDocumentoAsociacion> alertas = new();
    private List<string> listaAsociaciones = new();

    private string filtroAsociacion = string.Empty;
    private string filtroNivel = "Todos";
    private string mensajeExito = string.Empty;

    // Estado del modal de actualización
    private AlertaDocumentoAsociacion? alertaSeleccionada;
    private DateTime nuevaFechaVencimiento = DateTime.Today.AddMonths(6);
    private string? nuevoArchivoNombre;
    private byte[]? nuevoArchivoContenido;
    private string nuevasObservaciones = string.Empty;
    private string errorModal = string.Empty;

    protected override void OnInitialized()
    {
        CargarAlertas();
        listaAsociaciones = DocumentoService.ObtenerAsociaciones().ToList();
    }

    private void CargarAlertas()
    {
        alertas = DocumentoService.ObtenerAlertas(DateTime.Today).ToList();
    }

    private IEnumerable<AlertaDocumentoAsociacion> AlertasFiltradas
    {
        get
        {
            var res = alertas.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(filtroAsociacion))
            {
                res = res.Where(a => string.Equals(a.NombreAsociacion.Trim(), filtroAsociacion.Trim(), StringComparison.OrdinalIgnoreCase));
            }

            if (filtroNivel != "Todos")
            {
                if (filtroNivel == "Vencido")
                    res = res.Where(a => a.DiasRestantes < 0);
                else if (filtroNivel == "Crítica")
                    res = res.Where(a => a.DiasRestantes >= 0 && a.DiasRestantes <= 7);
                else if (filtroNivel == "Advertencia")
                    res = res.Where(a => a.DiasRestantes > 7 && a.DiasRestantes <= 15);
                else if (filtroNivel == "Preventivo")
                    res = res.Where(a => a.DiasRestantes > 15 && a.DiasRestantes <= 30);
            }

            return res;
        }
    }

    private static string ObtenerInicialesAsociacion(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var partes = nombre.Trim().Split(new[] { ' ', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
        return $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant();
    }

    private async Task DescargarArchivoPorId(Guid docId)
    {
        var doc = DocumentoService.ObtenerPorId(docId);
        if (doc == null) return;

        if (doc.ArchivoContenido != null && doc.ArchivoContenido.Length > 0)
        {
            var base64 = Convert.ToBase64String(doc.ArchivoContenido);
            await JS.InvokeVoidAsync("descargarArchivoBase64", doc.ArchivoNombre, doc.ArchivoTipoMime, base64);
        }
        else
        {
            var textoInfo = $"DOCUMENTO INSTITUCIONAL FAAUA\nAsociación: {doc.NombreAsociacion}\nTipo: {doc.TipoDocumento}\nTítulo: {doc.Titulo}\nFecha Emisión: {doc.FechaEmision:dd/MM/yyyy}\nVencimiento: {(doc.FechaVencimiento.HasValue ? doc.FechaVencimiento.Value.ToString("dd/MM/yyyy") : "N/A")}\nArchivo: {doc.ArchivoNombre}";
            var bytes = System.Text.Encoding.UTF8.GetBytes(textoInfo);
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("descargarArchivoBase64", $"{doc.ArchivoNombre}.txt", "text/plain", base64);
        }
    }

    private void AbrirModalActualizar(AlertaDocumentoAsociacion alerta)
    {
        alertaSeleccionada = alerta;
        nuevaFechaVencimiento = DateTime.Today.AddMonths(6);
        nuevoArchivoNombre = null;
        nuevoArchivoContenido = null;
        nuevasObservaciones = string.Empty;
        errorModal = string.Empty;
    }

    private void CerrarModalActualizar()
    {
        alertaSeleccionada = null;
    }

    private async Task CargarNuevoArchivo(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        errorModal = string.Empty;

        if (archivo != null)
        {
            if (archivo.Size > 10 * 1024 * 1024)
            {
                errorModal = "El archivo supera el tamaño máximo permitido de 10 MB.";
                return;
            }

            nuevoArchivoNombre = archivo.Name;
            using var stream = archivo.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            nuevoArchivoContenido = ms.ToArray();
        }
    }

    private void GuardarActualizacionDocumento()
    {
        if (alertaSeleccionada == null) return;

        if (nuevaFechaVencimiento < DateTime.Today)
        {
            errorModal = "La nueva fecha de vencimiento debe ser posterior o igual a la fecha de hoy.";
            return;
        }

        var exitoso = DocumentoService.ActualizarVencimientoYArchivo(
            alertaSeleccionada.DocumentoId,
            nuevaFechaVencimiento,
            nuevoArchivoNombre,
            nuevoArchivoContenido,
            nuevasObservaciones,
            "Secretaría");

        if (exitoso)
        {
            mensajeExito = $"Se renovó la vigencia de '{alertaSeleccionada.TipoDocumento}' para {alertaSeleccionada.NombreAsociacion} hasta el {nuevaFechaVencimiento:dd/MM/yyyy}.";
            alertaSeleccionada = null;
            CargarAlertas();
        }
        else
        {
            errorModal = "No fue posible actualizar el documento en el sistema.";
        }
    }
}
