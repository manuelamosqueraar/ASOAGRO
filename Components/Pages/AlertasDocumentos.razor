@page "/alertas-documentos"
@rendermode InteractiveServer
@inject HttpClient Http

<div class="page-header">
    <div>
        <p class="eyebrow text-success">Alertas</p>
        <h1>Vencimientos de documentos</h1>
        <p>Prioriza certificados y soportes próximos a vencer según umbrales operativos.</p>
    </div>
    <span class="status-chip">30 / 15 / 7 días</span>
</div>

<div class="notice-card" role="note">
    Mostrando alertas basadas en umbrales de 30, 15 y 7 días para documentos de productores y fincas.
</div>

@if (cargando)
{
    <div class="loading-state">Cargando alertas...</div>
}
else if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger mt-3" role="alert">
        @mensajeError
    </div>
}
else if (alertasPendientes.Any())
{
    <div class="content-card table-responsive">
        <table class="table table-striped align-middle mb-0">
            <thead>
                <tr>
                    <th>Asociado</th>
                    <th>Documento</th>
                    <th>Fecha de Vencimiento</th>
                    <th>Días Restantes</th>
                    <th>Estado de Alerta</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alerta in alertasPendientes)
                {
                    <tr>
                        <td>@alerta.NombreAsociado</td>
                        <td>@alerta.TipoDocumento</td>
                        <td>@alerta.FechaVencimiento.ToLocalTime().ToString("dd/MM/yyyy")</td>
                        <td>
                            <span class="badge @ObtenerColorBadge(alerta.DiasRestantes)">
                                @alerta.DiasRestantes días
                            </span>
                        </td>
                        <td>
                            <strong>@alerta.MensajeAlerta</strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state mt-3" role="status">
        <strong>No hay alertas pendientes</strong>
        <p class="mb-0">Los documentos registrados no tienen vencimientos próximos.</p>
    </div>
}

@code {
    private List<AlertaDocumento> alertasPendientes = new();
    private string mensajeError = string.Empty;
    private bool cargando = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            alertasPendientes = await Http.GetFromJsonAsync<List<AlertaDocumento>>("api/alertas-documentos") ?? new();
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible cargar las alertas de documentos.";
        }
        finally
        {
            cargando = false;
        }
    }

    private string ObtenerColorBadge(int dias)
    {
        if (dias <= 7) return "bg-danger";
        if (dias <= 15) return "bg-warning text-dark";
        return "bg-info text-dark";
    }

}
