@implements IDisposable
@using System.Globalization
@using System.Text
@using Microsoft.AspNetCore.Components.Web

<div class="asist">

    <svg class="asist-sprite" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="asist-brote" viewBox="0 0 24 24"><path d="M12 22v-9" /><path d="M12 13C12 7.5 7.5 4 2 4c0 5.5 3.5 10 10 10z" /><path d="M12 13c0-5.5 4.5-9 10-9 0 5.5-3.5 10-10 10z" /></symbol>
            <symbol id="asist-x" viewBox="0 0 24 24"><path d="M18 6L6 18M6 6l12 12" /></symbol>
            <symbol id="asist-abajo" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></symbol>
            <symbol id="asist-izq" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6" /></symbol>
            <symbol id="asist-flecha" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
            <symbol id="asist-enviar" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4z" /></symbol>
            <symbol id="asist-casa" viewBox="0 0 24 24"><path d="M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" /></symbol>
            <symbol id="asist-chat" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" /></symbol>
        </defs>
    </svg>

    @if (burbujaVisible && !abierto)
    {
        <div class="asist-burbuja" role="status">
            <button type="button" class="asist-burbuja-texto" @onclick="AlternarPanel">
                <span class="asist-avatar-sm"><svg class="asist-ico"><use href="#asist-brote" /></svg></span>
                <span>¡Bienvenido a ASOAGRO! ¿Cómo podemos ayudarte?</span>
            </button>
            <button type="button" class="asist-burbuja-cerrar" @onclick="CerrarBurbuja" aria-label="Cerrar mensaje">
                <svg class="asist-ico"><use href="#asist-x" /></svg>
            </button>
        </div>
    }

    @if (abierto)
    {
        <section class="asist-panel" aria-label="Asistente de ASOAGRO" @onkeydown="TeclaEnPanel">

            @if (vista == "inicio")
            {
                <header class="asist-cab asist-cab-inicio">
                    <div class="asist-grupo">
                        <span class="asist-avatar"><svg class="asist-ico"><use href="#asist-brote" /></svg></span>
                        <span class="asist-avatar"><svg class="asist-ico"><use href="#asist-brote" /></svg></span>
                        <span class="asist-avatar"><svg class="asist-ico"><use href="#asist-brote" /></svg></span>
                    </div>
                    <button type="button" class="asist-icono" @onclick="CerrarPanel" aria-label="Cerrar asistente">
                        <svg class="asist-ico"><use href="#asist-x" /></svg>
                    </button>
                </header>

                <div class="asist-cuerpo">
                    <h2 class="asist-hola">Hola 👋</h2>
                    <p class="asist-saludo">¿Cómo podemos ayudarte?</p>

                    <button type="button" class="asist-pregunta" @onclick="IrAMensajes">
                        <span>Hacer una pregunta</span>
                        <svg class="asist-ico"><use href="#asist-flecha" /></svg>
                    </button>

                    <p class="asist-etiqueta">Temas frecuentes</p>
                    <div class="asist-chips">
                        <button type="button" class="asist-chip" @onclick='() => PreguntarRapidoAsync("¿Cómo registro un asociado?")'>Registrar un asociado</button>
                        <button type="button" class="asist-chip" @onclick='() => PreguntarRapidoAsync("¿Cómo consulto los registros?")'>Consultar registros</button>
                        <button type="button" class="asist-chip" @onclick='() => PreguntarRapidoAsync("¿Cómo veo las alertas de documentos?")'>Alertas de documentos</button>
                        <button type="button" class="asist-chip" @onclick='() => PreguntarRapidoAsync("¿Qué es la trazabilidad?")'>Trazabilidad</button>
                    </div>
                </div>
            }
            else
            {
                <header class="asist-cab">
                    <button type="button" class="asist-icono" @onclick="VolverInicio" aria-label="Volver al inicio">
                        <svg class="asist-ico"><use href="#asist-izq" /></svg>
                    </button>
                    <div class="asist-titulo">
                        <strong>ASOAGRO</strong>
                        <small><span class="asist-punto"></span>En línea</small>
                    </div>
                    <button type="button" class="asist-icono" @onclick="CerrarPanel" aria-label="Cerrar asistente">
                        <svg class="asist-ico"><use href="#asist-x" /></svg>
                    </button>
                </header>

                <div class="asist-mensajes" aria-live="polite">
                    @if (escribiendo)
                    {
                        <div class="asist-msg asist-bot asist-escribiendo" aria-label="Escribiendo"><span></span><span></span><span></span></div>
                    }
                    @foreach (var m in mensajes.AsEnumerable().Reverse())
                    {
                        <div class="asist-msg @(m.EsUsuario ? "asist-usuario" : "asist-bot")">@m.Texto</div>
                    }
                </div>

                <form class="asist-entrada" @onsubmit="EnviarAsync" @onsubmit:preventDefault>
                    <input type="text" @bind="textoPregunta" @bind:event="oninput" maxlength="300" autocomplete="off" placeholder="Escribe tu pregunta…" aria-label="Escribe tu pregunta" />
                    <button type="submit" class="asist-enviar" disabled="@(escribiendo || string.IsNullOrWhiteSpace(textoPregunta))" aria-label="Enviar">
                        <svg class="asist-ico"><use href="#asist-enviar" /></svg>
                    </button>
                </form>
            }

            <nav class="asist-tabs" aria-label="Secciones del asistente">
                <button type="button" class="@(vista == "inicio" ? "activo" : "")" @onclick="VolverInicio">
                    <svg class="asist-ico"><use href="#asist-casa" /></svg>
                    Inicio
                </button>
                <button type="button" class="@(vista == "mensajes" ? "activo" : "")" @onclick="IrAMensajes">
                    <svg class="asist-ico"><use href="#asist-chat" /></svg>
                    Mensajes
                </button>
            </nav>
        </section>
    }

    <button type="button" class="asist-boton @(abierto ? "abierto" : "")" @onclick="AlternarPanel" aria-label="@(abierto ? "Cerrar asistente" : "Abrir asistente")">
        <span class="asist-pulso" aria-hidden="true"></span>
        @if (abierto)
        {
            <svg class="asist-ico"><use href="#asist-abajo" /></svg>
        }
        else
        {
            <svg class="asist-ico"><use href="#asist-brote" /></svg>
        }
    </button>
</div>

<style>
   .asist {
    --bosque: #0b2e1c; --pino: #17603a; --hoja: #2e9a5b; --brote: #b9e77a; --trigo: #e8c56b;
    --papel: #f2f7ec; --tinta: #10261a; --gris: #5c7063; --borde: #cfddc9;
    position: fixed !important;
    right: clamp(16px, 2.5vw, 28px);
    bottom: clamp(16px, 2.5vw, 28px);
    z-index: 1300;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    color: var(--tinta);
}
    .asist *, .asist *::before, .asist *::after { box-sizing: border-box; }
    .asist :is(button, input):focus-visible { outline: 3px solid var(--hoja); outline-offset: 2px; }
    .asist-sprite { position: absolute; width: 0; height: 0; overflow: hidden; }
    .asist-ico { width: 20px; height: 20px; flex-shrink: 0; overflow: visible; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

    /* Botón flotante */
    .asist-boton { position: relative; width: 62px; height: 62px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: var(--bosque); color: var(--brote); cursor: pointer; box-shadow: 0 16px 30px -10px rgba(11, 46, 28, .7), inset 0 1px 0 rgba(185, 231, 122, .25); transition: transform .25s ease, background-color .25s ease; }
    .asist-boton:hover { transform: translateY(-2px); background: var(--pino); }
    .asist-boton.abierto { background: var(--pino); }
    .asist-boton .asist-ico { width: 26px; height: 26px; }
    .asist-pulso { position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--brote); opacity: 0; animation: asist-pulso 2.6s ease-out infinite; pointer-events: none; }
    .asist-boton.abierto .asist-pulso { display: none; }

    /* Burbuja de bienvenida */
    .asist-burbuja { position: absolute; right: 0; bottom: calc(100% + 16px); width: min(292px, calc(100vw - 110px)); background: #fff; color: var(--tinta); border: 1px solid rgba(23, 96, 58, .1); border-radius: 18px; box-shadow: 0 18px 40px -16px rgba(11, 46, 28, .5); animation: asist-subir .45s cubic-bezier(.2, .7, .2, 1) both; }
    .asist-burbuja::after { content: ""; position: absolute; right: 24px; bottom: -7px; width: 14px; height: 14px; background: #fff; border-right: 1px solid rgba(23, 96, 58, .1); border-bottom: 1px solid rgba(23, 96, 58, .1); transform: rotate(45deg); }
    .asist-burbuja-texto { width: 100%; display: flex; align-items: center; gap: 12px; padding: 14px 40px 14px 14px; border: 0; background: transparent; color: var(--tinta); font-family: 'Asap Sharp', system-ui, sans-serif; font-size: .95rem; line-height: 1.4; text-align: left; cursor: pointer; }
    .asist-burbuja-cerrar { position: absolute; top: 8px; right: 8px; width: 26px; height: 26px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: transparent; color: var(--gris); cursor: pointer; }
    .asist-burbuja-cerrar:hover { background: var(--papel); }
    .asist-burbuja-cerrar .asist-ico { width: 14px; height: 14px; }
    .asist-avatar-sm { flex: 0 0 38px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 50%; background: var(--bosque); color: var(--brote); }
    .asist-avatar-sm .asist-ico { width: 20px; height: 20px; }

    /* Panel */
    .asist-panel { position: absolute; right: 0; bottom: calc(100% + 16px); width: min(352px, calc(100vw - 32px)); height: min(520px, calc(100vh - 190px)); display: flex; flex-direction: column; overflow: hidden; background: #fff; border: 1px solid rgba(23, 96, 58, .1); border-radius: 22px; box-shadow: 0 26px 50px -20px rgba(11, 46, 28, .55); animation: asist-subir .35s cubic-bezier(.2, .7, .2, 1) both; }
    .asist-cab { display: flex; align-items: center; gap: 10px; padding: 14px 14px 14px 16px; background: var(--bosque); color: var(--papel); }
    .asist-cab-inicio { justify-content: space-between; padding: 20px 16px 22px; background: linear-gradient(160deg, #0b2e1c 0%, #17603a 100%); }
    .asist-grupo { display: flex; align-items: center; }
    .asist-avatar { width: 44px; height: 44px; display: grid; place-items: center; margin-left: -10px; border: 3px solid #fff; border-radius: 50%; background: var(--brote); color: var(--bosque); }
    .asist-avatar:first-child { margin-left: 0; }
    .asist-avatar:nth-child(2) { background: var(--trigo); }
    .asist-avatar:nth-child(3) { background: var(--hoja); color: #fff; }
    .asist-avatar .asist-ico { width: 20px; height: 20px; }
    .asist-icono { width: 36px; height: 36px; flex-shrink: 0; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: rgba(185, 231, 122, .12); color: var(--papel); cursor: pointer; transition: background-color .2s ease; }
    .asist-icono:hover { background: rgba(185, 231, 122, .25); }
    .asist-icono .asist-ico { width: 18px; height: 18px; }
    .asist-titulo { flex: 1; min-width: 0; }
    .asist-titulo strong { display: block; font-family: 'Maname', Georgia, serif; font-size: 1.1rem; font-weight: 700; letter-spacing: .04em; }
    .asist-titulo small { display: flex; align-items: center; gap: 6px; font-size: .74rem; color: rgba(242, 247, 236, .75); }
    .asist-punto { width: 7px; height: 7px; border-radius: 50%; background: var(--brote); box-shadow: 0 0 0 3px rgba(185, 231, 122, .25); }

    /* Vista de inicio */
    .asist-cuerpo { flex: 1; min-height: 0; overflow-y: auto; padding: 22px 18px 18px; background: linear-gradient(180deg, #fff 0%, var(--papel) 100%); }
    .asist-hola { margin: 0; font-family: 'Maname', Georgia, serif; font-size: 1.9rem; font-weight: 700; line-height: 1.1; color: var(--bosque); }
    .asist-saludo { margin: 6px 0 20px; font-family: 'Maname', Georgia, serif; font-size: 1.45rem; line-height: 1.25; color: var(--pino); }
    .asist-pregunta { width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; border: 1px solid rgba(23, 96, 58, .14); border-radius: 16px; background: #fff; color: var(--tinta); font-size: .95rem; font-weight: 600; cursor: pointer; box-shadow: 0 10px 22px -16px rgba(11, 46, 28, .6); transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
    .asist-pregunta:hover { transform: translateY(-2px); border-color: var(--hoja); box-shadow: 0 16px 28px -16px rgba(11, 46, 28, .7); }
    .asist-pregunta .asist-ico { color: var(--pino); }
    .asist-etiqueta { margin: 24px 0 10px; font-family: 'Asap Sharp', system-ui, sans-serif; font-size: .9rem; font-weight: 600; color: var(--gris); }
    .asist-chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .asist-chip { padding: 9px 13px; border: 1px solid rgba(23, 96, 58, .18); border-radius: 12px; background: #fff; color: var(--pino); font-size: .84rem; font-weight: 600; cursor: pointer; transition: background-color .2s ease, color .2s ease, border-color .2s ease; }
    .asist-chip:hover { background: var(--pino); border-color: var(--pino); color: #fff; }

    /* Vista de mensajes */
    .asist-mensajes { flex: 1; min-height: 0; display: flex; flex-direction: column-reverse; gap: 10px; padding: 16px; overflow-y: auto; background: var(--papel); }
    .asist-msg { max-width: 82%; padding: 10px 14px; border-radius: 16px; font-family: 'Asap Sharp', system-ui, sans-serif; font-size: .93rem; line-height: 1.45; }
    .asist-bot { align-self: flex-start; background: #fff; color: var(--tinta); border: 1px solid rgba(23, 96, 58, .1); border-bottom-left-radius: 6px; box-shadow: 0 6px 14px -10px rgba(11, 46, 28, .45); }
    .asist-usuario { align-self: flex-end; background: var(--pino); color: var(--papel); border-bottom-right-radius: 6px; }
    .asist-escribiendo { display: inline-flex; align-items: center; gap: 5px; padding: 13px 15px; }
    .asist-escribiendo span { width: 7px; height: 7px; border-radius: 50%; background: var(--hoja); animation: asist-punto 1.2s ease-in-out infinite; }
    .asist-escribiendo span:nth-child(2) { animation-delay: .15s; }
    .asist-escribiendo span:nth-child(3) { animation-delay: .3s; }
    .asist-entrada { display: flex; align-items: center; gap: 8px; padding: 12px 14px; background: #fff; border-top: 1px solid rgba(23, 96, 58, .1); }
    .asist-entrada input { flex: 1; min-width: 0; height: 44px; padding: 0 14px; border: 1.5px solid var(--borde); border-radius: 12px; background: #fff; color: var(--tinta); font-family: 'Asap Sharp', system-ui, sans-serif; font-size: .95rem; transition: border-color .2s ease, box-shadow .2s ease; }
    .asist-entrada input::placeholder { color: #9aaa9f; }
    .asist-entrada input:focus { outline: none; border-color: var(--hoja); box-shadow: 0 0 0 4px rgba(46, 154, 91, .16); }
    .asist-enviar { width: 44px; height: 44px; flex: 0 0 44px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 12px; background: var(--pino); color: #fff; cursor: pointer; transition: background-color .2s ease, opacity .2s ease; }
    .asist-enviar:hover:not(:disabled) { background: var(--bosque); }
    .asist-enviar:disabled { opacity: .45; cursor: default; }
    .asist-enviar .asist-ico { width: 18px; height: 18px; }

    /* Pestañas inferiores */
    .asist-tabs { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid rgba(23, 96, 58, .1); background: #fff; }
    .asist-tabs button { display: flex; flex-direction: column; align-items: center; gap: 4px; padding: 11px 8px 13px; border: 0; background: transparent; color: var(--gris); font-size: .78rem; font-weight: 600; cursor: pointer; transition: color .2s ease; }
    .asist-tabs button .asist-ico { width: 20px; height: 20px; }
    .asist-tabs button.activo { color: var(--pino); }

    /* Animaciones */
    @@keyframes asist-subir { from { opacity: 0; transform: translate3d(0, 14px, 0); } to { opacity: 1; transform: none; } }
    @@keyframes asist-pulso { 0% { transform: scale(1); opacity: .6; } 100% { transform: scale(1.7); opacity: 0; } }
    @@keyframes asist-punto { 0%, 80%, 100% { opacity: .3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-3px); } }

    /* Teléfono */
    @@media (max-width: 575.98px) {
        .asist-panel { position: fixed; left: 12px; right: 12px; bottom: 92px; width: auto; height: min(560px, calc(100vh - 120px)); }
        .asist-burbuja { width: min(260px, calc(100vw - 110px)); }
    }

    @@media (prefers-reduced-motion: reduce) {
        .asist *, .asist *::before, .asist *::after { animation: none !important; transition: none !important; }
    }
</style>

@code {
    // Datos de contacto: cámbialos por los reales
    private const string Correo = "contacto@asoagro-uraba.org";
    private const string Telefono = "+57 300 123 4567";

    private record Mensaje(bool EsUsuario, string Texto);

    private readonly List<Mensaje> mensajes = new()
    {
        new(false, "¡Hola! Pregúntame sobre registros, alertas, trazabilidad o cómo contactar a la federación.")
    };

    private readonly CancellationTokenSource _cts = new();
    private bool abierto;
    private bool burbujaVisible;
    private bool escribiendo;
    private string vista = "inicio";
    private string textoPregunta = "";

    // Los temas específicos van primero y el saludo al final
    private static readonly (string[] Palabras, string Respuesta)[] Conocimiento =
    {
        (new[] { "consult", "busc" },
         "En Plataforma → Consultar registros puedes buscar y revisar asociados, predios y juntas directivas."),
        (new[] { "registr", "dar de alta", "nuevo asociado", "agregar", "inscrib" },
         "Para registrar un asociado, entra a Plataforma → Registrar asociado. Allí puedes dar de alta productores y fincas en la red."),
        (new[] { "alerta", "vence", "estatuto", "certificad", "documento" },
         "En Plataforma → Alertas y documentos verás los vencimientos de estatutos y certificados. También puedes verlas desde la campana del encabezado."),
        (new[] { "elegib", "financ", "convocatoria", "recurso", "credito" },
         "Para saber si tu asociación está lista para convocatorias, revisa Recursos → Guía de elegibilidad."),
        (new[] { "trazab", "inocuidad", "lote", "cacao", "platano", "banano", "ganad" },
         "La trazabilidad permite seguir cada predio y cada lote, desde la siembra hasta la venta, con inocuidad alimentaria. Puedes verla en Nosotros → Impacto y trazabilidad."),
        (new[] { "asoagro", "federacion", "faaua", "origen", "mision", "quienes son" },
         "ASOAGRO es la plataforma de la Federación de Asociaciones Agropecuarias (FAAUA) para gestionar y gobernar las asociaciones de base del Urabá. Su historia está en Nosotros → Orígenes y misión."),
        (new[] { "contact", "correo", "telefono", "llamar", "escribir", "email", "whatsapp" },
         $"Puedes escribirnos a {Correo} o llamar al {Telefono}."),
        (new[] { "sesion", "contrasena", "ingresar", "entrar", "login", "clave" },
         "Para entrar a tu cuenta usa el botón Iniciar sesión. Si olvidaste tu contraseña, pulsa ¿Olvidaste tu contraseña? en el formulario."),
        (new[] { "hola", "buenas", "buenos", "saludos" },
         "¡Hola! Cuéntame qué necesitas y te indico la sección correcta."),
    };

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            _ = MostrarBurbujaAsync();
    }

    private async Task MostrarBurbujaAsync()
    {
        try
        {
            await Task.Delay(2500, _cts.Token);
            burbujaVisible = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { }
    }

    private void AlternarPanel()
    {
        abierto = !abierto;
        burbujaVisible = false;
    }

    private void CerrarBurbuja() => burbujaVisible = false;

    private void CerrarPanel() => abierto = false;

    private void IrAMensajes() => vista = "mensajes";

    private void VolverInicio() => vista = "inicio";

    private void TeclaEnPanel(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") abierto = false;
    }

    private async Task EnviarAsync()
    {
        var texto = textoPregunta.Trim();
        if (texto.Length == 0 || escribiendo) return;

        textoPregunta = "";
        mensajes.Add(new(true, texto));
        await ResponderAsync(texto);
    }

    private async Task PreguntarRapidoAsync(string pregunta)
    {
        if (escribiendo) return;

        vista = "mensajes";
        mensajes.Add(new(true, pregunta));
        await ResponderAsync(pregunta);
    }

    private async Task ResponderAsync(string pregunta)
    {
        escribiendo = true;
        StateHasChanged();
        await Task.Delay(700);
        mensajes.Add(new(false, Responder(pregunta)));
        escribiendo = false;
    }

    private static string Responder(string pregunta)
    {
        var texto = Normalizar(pregunta);
        foreach (var (palabras, respuesta) in Conocimiento)
        {
            if (palabras.Any(p => texto.Contains(p)))
                return respuesta;
        }
        return $"No encontré una respuesta exacta para eso. Escríbenos a {Correo} o llama al {Telefono}, y te ayudaremos.";
    }

    // Quita acentos y pasa a minúsculas para comparar sin errores de tilde
    private static string Normalizar(string texto)
    {
        var sb = new StringBuilder();
        foreach (var c in texto.Normalize(NormalizationForm.FormD))
        {
            if (CharUnicodeInfo.GetUnicodeCategory(c) != UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        }
        return sb.ToString().ToLowerInvariant();
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}