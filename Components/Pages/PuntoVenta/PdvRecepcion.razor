@page "/punto-de-venta/recepcion"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "AdministradorPdv,PuntoVenta,Vendedor,Presidenta,Presidente,Tesorera,Tesorero,Administrador,Admin")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Asoagro.Models
@using Asoagro.Services
@inject IPuntoVentaService PuntoVentaService
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Recepción de Cosechas · Punto de Venta FAAUA</PageTitle>

<div class="container-fluid px-0 pb-5" style="font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">

    <!-- HERO BANNER DEL MÓDULO -->
    <div class="card aso-hero-card mb-4" style="border-top: 4px solid #059669 !important;">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="aso-hero-icon-box" style="background: #059669 !important; border: 1.5px solid #34D399 !important; color: #FFFFFF !important;">
                        <i class="bi bi-box-arrow-in-down fs-4"></i>
                    </div>
                    <div>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                            <span class="aso-hero-kicker" style="background: #065F46 !important; border-color: #34D399 !important; color: #ECFDF5 !important;">
                                <i class="bi bi-truck-flatbed me-1"></i> Punto de Venta Solidario · FAAUA
                            </span>
                            <span class="badge px-2.5 py-1 rounded-pill fw-bold bg-success bg-opacity-75" style="font-size: 0.7rem;">
                                <i class="bi bi-check-circle-fill me-1"></i> Módulo 2: Recepción de Cosechas
                            </span>
                            @if (esModoConsulta)
                            {
                                <span class="badge px-2.5 py-1 rounded-pill fw-bold bg-info bg-opacity-75" style="font-size: 0.7rem;">
                                    <i class="bi bi-eye-fill me-1"></i> Modo Consulta / Supervisión
                                </span>
                            }
                        </div>
                        <h1 class="aso-hero-title">Recepción y Acopio de Cosechas de Productores</h1>
                        <p class="aso-hero-desc">
                            Ingreso de lotes de cosechas provistos por fincas y asociaciones federadas, con verificación de pesaje, costo de adquisición, remisión, actualización de stock y emisión de comprobantes internos de recepción en PDF.
                        </p>
                    </div>
                </div>

                <div class="d-flex align-items-center">
                    <div class="p-3 rounded-4 d-inline-block text-start w-100" style="min-width: 280px; max-width: 320px; background: rgba(255, 255, 255, 0.08); border: 1.5px solid rgba(255, 255, 255, 0.18); backdrop-filter: blur(10px);">
                        <div class="d-flex align-items-center gap-3 mb-2">
                            <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 42px; height: 42px; background: #059669; box-shadow: 0 4px 10px rgba(0,0,0,0.25);">
                                <i class="bi bi-person-badge-fill fs-5"></i>
                            </div>
                            <div>
                                <span class="d-block text-white-50" style="font-size: 0.68rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Responsable Acopio</span>
                                <span class="fw-bold text-white small d-block text-truncate" style="max-width: 210px;">@nombreUsuario</span>
                                <span class="badge bg-white text-dark mt-1" style="font-size: 0.65rem; font-weight: 700;">@rolUsuario</span>
                            </div>
                        </div>
                        <div class="pt-2 border-top border-white border-opacity-10 d-flex justify-content-between align-items-center" style="font-size: 0.72rem;">
                            <span class="text-white-50">Acción Operativa:</span>
                            <span class="fw-bold @(esModoConsulta ? "text-warning" : "text-light")">
                                @(esModoConsulta ? "Consulta de Bitácora" : "Recepción e Ingreso de Lotes")
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FEEDBACK ALERT -->
    @if (!string.IsNullOrEmpty(mensajeFeedback))
    {
        <div class="alert @(esFeedbackExito ? "alert-success border-success" : "alert-danger border-danger") alert-dismissible fade show rounded-4 shadow-sm mb-4 d-flex align-items-center justify-content-between" role="alert">
            <div class="d-flex align-items-center gap-2">
                <i class="bi @(esFeedbackExito ? "bi-check-circle-fill text-success" : "bi-exclamation-triangle-fill text-danger") fs-5"></i>
                <span class="small fw-semibold">@mensajeFeedback</span>
            </div>
            <button type="button" class="btn-close small" @onclick="() => mensajeFeedback = null" aria-label="Cerrar"></button>
        </div>
    }

    <!-- AVISO DE MODO SUPERVISIÓN -->
    @if (esModoConsulta)
    {
        <div class="alert alert-light border border-info-subtle rounded-4 p-3 mb-4 shadow-sm">
            <div class="d-flex align-items-center gap-3">
                <div class="p-2 bg-info-subtle text-info rounded-3 flex-shrink-0">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                </div>
                <div class="small text-muted flex-grow-1">
                    <strong class="text-dark d-block">Supervisión Institucional (Modo Consulta)</strong>
                    Usted ha ingresado con el rol de <strong>@rolUsuario</strong>. Puede consultar la bitácora de recepciones de cosecha y descargar los comprobantes internos en PDF. Las acciones de radicación física e incremento de inventario corresponden al <em>Administrador del punto de venta</em>.
                </div>
            </div>
        </div>
    }

    <!-- CONTENIDO PRINCIPAL: FORMULARIO Y BITÁCORA -->
    <div class="row g-4 mb-4">
        <!-- FORMULARIO DE RECEPCIÓN -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <span class="p-2 rounded-3 bg-success-subtle text-success">
                        <i class="bi bi-truck-flatbed fs-5"></i>
                    </span>
                    <div>
                        <h2 class="fw-bold text-dark mb-0 fs-6">Radicar Recepción de Cosecha</h2>
                        <small class="text-muted">Ingreso de lotes de fincas con pesaje y soporte</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold mb-1">
                        Producto Agropecuario: <span class="text-danger">* (Obligatorio)</span>
                    </label>
                    <select class="form-select form-select-sm" @bind="nuevaRecepcion.ProductoId" @bind:after="ActualizarDatosProductoRecepcion" disabled="@esModoConsulta">
                        <option value="@Guid.Empty">-- Seleccionar producto del catálogo --</option>
                        @foreach (var p in productos)
                        {
                            <option value="@p.Id">@p.Nombre (@p.AsociacionOrigen)</option>
                        }
                    </select>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold mb-1">
                            Cantidad Recibida: <span class="text-danger">*</span>
                        </label>
                        <input type="number" step="0.01" class="form-control form-control-sm" placeholder="Ej: 500" @bind="nuevaRecepcion.Cantidad" disabled="@esModoConsulta" />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold mb-1">
                            Unidad de Medida:
                        </label>
                        <input type="text" class="form-control form-control-sm bg-light" @bind="nuevaRecepcion.UnidadMedida" readonly />
                    </div>
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold mb-1">
                            Costo Unitario COP: <span class="text-danger">*</span>
                        </label>
                        <input type="number" class="form-control form-control-sm" placeholder="Ej: 1800" @bind="nuevaRecepcion.CostoUnitario" disabled="@esModoConsulta" />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold mb-1">
                            Costo Total Lote:
                        </label>
                        <div class="form-control form-control-sm bg-light fw-bold text-success">
                            $@((nuevaRecepcion.Cantidad * nuevaRecepcion.CostoUnitario).ToString("N0")) COP
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold mb-1">
                        Finca o Productor Proveedor: <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control form-control-sm" placeholder="Ej: Finca El Porvenir - Carlos Ramírez" @bind="nuevaRecepcion.ProveedorNombre" disabled="@esModoConsulta" />
                </div>

                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold mb-1">
                            Fecha de Recepción: <span class="text-danger">*</span>
                        </label>
                        <input type="date" class="form-control form-control-sm" @bind="nuevaRecepcion.FechaRecepcion" disabled="@esModoConsulta" />
                    </div>
                    <div class="col-6">
                        <label class="form-label text-muted small fw-bold mb-1">
                            No. Remisión / Guía: <span class="text-muted fw-normal">(Opcional)</span>
                        </label>
                        <input type="text" class="form-control form-control-sm" placeholder="Ej: REM-0982" @bind="nuevaRecepcion.NumeroComprobante" disabled="@esModoConsulta" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold mb-1">
                        Soporte Digital Adjunto: <span class="text-muted fw-normal">(Opcional)</span>
                    </label>
                    <InputFile OnChange="CargarSoporteRecepcion" class="form-control form-control-sm" accept=".pdf,.png,.jpg,.jpeg" disabled="@esModoConsulta" />
                    <small class="text-muted" style="font-size: 0.68rem;">Formatos: PDF, JPG, PNG (máx. 10 MB)</small>
                    @if (!string.IsNullOrEmpty(nuevaRecepcion.SoporteNombre))
                    {
                        <div class="small text-success mt-1">
                            <i class="bi bi-file-earmark-check"></i> @nuevaRecepcion.SoporteNombre
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted small fw-bold mb-1">
                        Observaciones de Calidad y Pesaje: <span class="text-muted fw-normal">(Opcional)</span>
                    </label>
                    <textarea class="form-control form-control-sm" rows="2" placeholder="Ej: Cosecha recibida en óptimo estado de maduración, peso certificado en báscula" @bind="nuevaRecepcion.Observaciones" disabled="@esModoConsulta"></textarea>
                </div>

                @if (!string.IsNullOrEmpty(errorRecepcion))
                {
                    <div class="alert alert-danger py-2 small mb-3">@errorRecepcion</div>
                }

                <button type="button" class="btn btn-success w-100 rounded-pill py-2.5 fw-bold shadow-sm"
                        disabled="@(esModoConsulta || guardandoRecepcion)"
                        @onclick="GuardarRecepcion">
                    @if (guardandoRecepcion)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                        <span>Incrementando inventario...</span>
                    }
                    else
                    {
                        <i class="bi bi-check-circle-fill me-1"></i>
                        <span>Ingresar Cosecha al Inventario</span>
                    }
                </button>
            </div>
        </div>

        <!-- TABLA DE RECEPCIONES RECIENTES -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                    <div>
                        <h2 class="fw-bold text-dark mb-0 fs-6">
                            <i class="bi bi-clock-history text-success me-1"></i> Bitácora de Cosechas Recibidas
                        </h2>
                        <small class="text-muted">Descargue el comprobante interno de recepción en cualquier momento</small>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border">@recepciones.Count lote(s) registrados</span>
                    </div>
                </div>

                <div class="table-responsive aso-table-wrap">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.82rem;">
                        <thead class="aso-thead-unified">
                            <tr>
                                <th class="ps-3 py-2.5">No. Reg.</th>
                                <th class="py-2.5">Fecha</th>
                                <th class="py-2.5">Producto y Origen</th>
                                <th class="py-2.5">Proveedor / Finca</th>
                                <th class="py-2.5 text-center">Cantidad</th>
                                <th class="py-2.5 text-end">Costo Total</th>
                                <th class="pe-3 py-2.5 text-center">Comprobante PDF</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in recepciones)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-success">
                                        @(string.IsNullOrWhiteSpace(r.ConsecutivoRecepcion) ? "REC-S/N" : r.ConsecutivoRecepcion)
                                    </td>
                                    <td class="text-muted">@r.FechaRecepcion.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <strong class="text-dark d-block">@r.ProductoNombre</strong>
                                        <small class="text-muted text-truncate d-block" style="max-width: 170px;" title="@r.AsociacionOrigen">@r.AsociacionOrigen</small>
                                    </td>
                                    <td>
                                        <span class="d-block text-dark fw-semibold">@r.ProveedorNombre</span>
                                        <small class="text-muted">Doc: @(string.IsNullOrWhiteSpace(r.NumeroComprobante) ? "Sin remisión" : r.NumeroComprobante)</small>
                                    </td>
                                    <td class="text-center">
                                        <strong class="text-success">@r.Cantidad.ToString("N0")</strong>
                                        <small class="text-muted d-block">@r.UnidadMedida</small>
                                    </td>
                                    <td class="text-end">
                                        <strong class="text-dark">$@r.CostoTotal.ToString("N0")</strong>
                                        <small class="text-muted d-block">COP</small>
                                    </td>
                                    <td class="pe-3 text-center">
                                        <button type="button" class="btn btn-outline-success btn-sm rounded-pill px-2.5 py-1 fw-semibold"
                                                @onclick="() => DescargarComprobanteRecepcionPdf(r)"
                                                title="Descargar comprobante o acta interna de recepción en PDF">
                                            <i class="bi bi-file-earmark-pdf-fill me-1"></i> Comprobante
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (!recepciones.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4 text-muted">
                                        No hay registros de recepción de cosechas en la bitácora.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ProductoPdv> productos = new();
    private List<RecepcionProductoPdv> recepciones = new();

    private RecepcionProductoPdv nuevaRecepcion = new() { FechaRecepcion = DateTime.Today };
    private string? errorRecepcion;
    private bool guardandoRecepcion;

    private string nombreUsuario = "Administrador PDV";
    private string rolUsuario = "AdministradorPdv";
    private bool esModoConsulta = false;

    private string? mensajeFeedback;
    private bool esFeedbackExito;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var user = auth.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            nombreUsuario = user.Identity.Name ?? "Usuario PDV";
            rolUsuario = user.FindFirst(ClaimTypes.Role)?.Value ?? "AdministradorPdv";
            esModoConsulta = !user.IsInRole("AdministradorPdv") && !user.IsInRole("PuntoVenta") && !user.IsInRole("Vendedor");
        }

        CargarDatos();
    }

    private void CargarDatos()
    {
        productos = PuntoVentaService.ObtenerProductos().ToList();
        recepciones = PuntoVentaService.ObtenerRecepciones().ToList();
    }

    private void ActualizarDatosProductoRecepcion()
    {
        var prod = productos.FirstOrDefault(p => p.Id == nuevaRecepcion.ProductoId);
        if (prod != null)
        {
            nuevaRecepcion.ProductoNombre = prod.Nombre;
            nuevaRecepcion.CodigoProducto = prod.Codigo;
            nuevaRecepcion.UnidadMedida = prod.UnidadMedida;
            nuevaRecepcion.AsociacionOrigen = prod.AsociacionOrigen;
            nuevaRecepcion.CostoUnitario = prod.CostoPromedio;
        }
    }

    private async Task CargarSoporteRecepcion(InputFileChangeEventArgs e)
    {
        if (e.File == null) return;
        try
        {
            const long maxBytes = 10 * 1024 * 1024;
            await using var stream = e.File.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            nuevaRecepcion.SoporteNombre = e.File.Name;
            nuevaRecepcion.SoporteContenido = ms.ToArray();
        }
        catch (Exception ex)
        {
            errorRecepcion = $"Error al leer el archivo: {ex.Message}";
        }
    }

    private async Task GuardarRecepcion()
    {
        if (esModoConsulta) return;
        errorRecepcion = null;

        if (nuevaRecepcion.ProductoId == Guid.Empty)
        {
            errorRecepcion = "Seleccione un producto del catálogo.";
            return;
        }
        if (nuevaRecepcion.Cantidad <= 0)
        {
            errorRecepcion = "La cantidad debe ser mayor a cero.";
            return;
        }
        if (nuevaRecepcion.CostoUnitario <= 0)
        {
            errorRecepcion = "El costo unitario debe ser mayor a cero COP.";
            return;
        }
        if (string.IsNullOrWhiteSpace(nuevaRecepcion.ProveedorNombre))
        {
            errorRecepcion = "Ingrese el nombre de la finca o productor proveedor.";
            return;
        }

        guardandoRecepcion = true;
        try
        {
            var res = PuntoVentaService.RegistrarRecepcion(nuevaRecepcion, nombreUsuario, rolUsuario);
            if (res.Exitoso)
            {
                var recepcionGuardada = recepciones.FirstOrDefault(r => r.Id == nuevaRecepcion.Id) ?? nuevaRecepcion;

                // Generar y descargar automáticamente el comprobante de recepción
                await DescargarComprobanteRecepcionPdf(recepcionGuardada);

                mensajeFeedback = $"Lote de {nuevaRecepcion.Cantidad:N0} {nuevaRecepcion.UnidadMedida} de {nuevaRecepcion.ProductoNombre} ingresado con éxito al inventario. Se descargó el Comprobante interno de recepción.";
                esFeedbackExito = true;

                nuevaRecepcion = new RecepcionProductoPdv { FechaRecepcion = DateTime.Today };
                CargarDatos();
            }
            else
            {
                errorRecepcion = res.Mensaje;
            }
        }
        finally
        {
            guardandoRecepcion = false;
        }
    }

    private async Task DescargarComprobanteRecepcionPdf(RecepcionProductoPdv r)
    {
        try
        {
            var pdfBytes = PuntoVentaPdfGenerator.GenerarComprobanteRecepcionPdf(r, nombreUsuario);
            var base64 = Convert.ToBase64String(pdfBytes);
            var consecutivo = string.IsNullOrWhiteSpace(r.ConsecutivoRecepcion) ? "REC" : r.ConsecutivoRecepcion;
            var nombreArchivo = $"Comprobante_Recepcion_{consecutivo}_{DateTime.Now:yyyyMMdd}.pdf";
            await JS.InvokeVoidAsync("descargarArchivoBase64", nombreArchivo, "application/pdf", base64);
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al generar el comprobante de recepción en PDF: {ex.Message}";
            esFeedbackExito = false;
        }
    }
}

