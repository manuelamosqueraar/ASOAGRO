    private string ObtenerTituloReporteActivo() => tipoReporteActivo switch
    {
        "ventas_periodo" => "1. Reporte de Ventas por Período y Producto",
        "top_ventas" => "2. Reporte de Productos Más Vendidos y Rotación",
        "existencias" => "3. Reporte de Existencias, Valuación y Alertas de Stock",
        "recepciones" => "4. Reporte de Recepciones y Acopio por Asociación",
        "devoluciones" => "5. Reporte de Devoluciones, Anulaciones y Reintegros",
        "kardex" => "6. Kardex General y Auditoría de Movimientos",
        "medios_pago" => "7. Reporte de Ventas y Recaudos por Medio de Pago",
        "cierres_caja" => "8. Reporte Consolidado de Cierres de Turno y Arqueos",
        _ => "Reporte Operativo del Punto de Venta"
    };

    private string ObtenerTextoPeriodo() => periodoFiltro switch
    {
        "hoy" => $"Hoy ({fechaDesde:dd/MM/yyyy})",
        "semana" => $"Semana ({fechaDesde:dd/MM/yyyy} al {fechaHasta:dd/MM/yyyy})",
        "mes" => $"Mes de {fechaDesde:MMMM yyyy} ({fechaDesde:dd/MM/yyyy} al {fechaHasta:dd/MM/yyyy})",
        "ano" => $"Año {fechaDesde.Year} ({fechaDesde:dd/MM/yyyy} al {fechaHasta:dd/MM/yyyy})",
        _ => $"Rango ({fechaDesde:dd/MM/yyyy} al {fechaHasta:dd/MM/yyyy})"
    };

    private async Task DescargarReportePdf()
    {
        try
        {
            estaExportando = true;
            mensajeFeedback = "Generando reporte formal en PDF...";
            esFeedbackExito = true;
            StateHasChanged();

            var titulo = ObtenerTituloReporteActivo();
            var periodo = ObtenerTextoPeriodo();
            var resumen = $"Auditoría interna FAAUA. Total registros: {filasGeneradas.Count}. Filtros: Categoría='{categoriaFiltro}', Asociación='{asociacionFiltro}'.";

            var pdfBytes = PuntoVentaPdfGenerator.GenerarReportePdvPdf(
                titulo,
                periodo,
                columnasGeneradas,
                filasGeneradas,
                resumen,
                nombreUsuario,
                kpisReporteActivo
            );

            var base64 = Convert.ToBase64String(pdfBytes);
            var nombreArchivo = $"Reporte_{tipoReporteActivo}_{DateTime.Now:yyyyMMdd_HHmm}.pdf";

            await JS.InvokeVoidAsync("descargarArchivoBase64", nombreArchivo, "application/pdf", base64);
            mensajeFeedback = $"Reporte descargado exitosamente: '{nombreArchivo}'.";
            esFeedbackExito = true;
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al compilar el reporte PDF: {ex.Message}";
            esFeedbackExito = false;
        }
        finally
        {
            estaExportando = false;
            StateHasChanged();
        }
    }

    private async Task DescargarReporteCsv()
    {
        try
        {
            estaExportando = true;
            mensajeFeedback = "Generando archivo CSV para Excel...";
            esFeedbackExito = true;
            StateHasChanged();

            var sb = new System.Text.StringBuilder();

            // Encabezado institucional
            sb.AppendLine($"# REPORTE OPERATIVO - PUNTO DE VENTA SOLIDARIO FAAUA - ASOAGRO");
            sb.AppendLine($"# Reporte:;{ObtenerTituloReporteActivo()}");
            sb.AppendLine($"# Período auditado:;{ObtenerTextoPeriodo()}");
            sb.AppendLine($"# Generado por:;{nombreUsuario} ({rolUsuario}) el {DateTime.Now:dd/MM/yyyy HH:mm}");
            sb.AppendLine($"# Nota:;Documento interno de control operacional. No constituye factura electrónica DIAN.");
            sb.AppendLine();

            // KPIs
            if (kpisReporteActivo.Count > 0)
            {
                sb.AppendLine("# RESUMEN EJECUTIVO (KPIS)");
                foreach (var k in kpisReporteActivo)
                {
                    sb.AppendLine($"# {k.Etiqueta}:;{k.Valor}");
                }
                sb.AppendLine();
            }

            // Cabeceras de columnas
            var headers = columnasGeneradas.Select(c => EscaparCsv(c.Titulo));
            sb.AppendLine(string.Join(";", headers));

            // Filas
            foreach (var fila in filasGeneradas)
            {
                var rowItems = fila.Select(EscaparCsv);
                sb.AppendLine(string.Join(";", rowItems));
            }

            // UTF-8 con BOM para que Excel abra acentos y pesos colombianos correctamente
            var utf8BOM = new System.Text.UTF8Encoding(true);
            var csvBytes = utf8BOM.GetBytes(sb.ToString());
            var base64 = Convert.ToBase64String(csvBytes);
            var nombreArchivo = $"Reporte_{tipoReporteActivo}_{DateTime.Now:yyyyMMdd_HHmm}.csv";

            await JS.InvokeVoidAsync("descargarArchivoBase64", nombreArchivo, "text/csv;charset=utf-8", base64);
            mensajeFeedback = $"Reporte CSV exportado exitosamente: '{nombreArchivo}'.";
            esFeedbackExito = true;
        }
        catch (Exception ex)
        {
            mensajeFeedback = $"Error al generar el archivo CSV: {ex.Message}";
            esFeedbackExito = false;
        }
        finally
        {
            estaExportando = false;
            StateHasChanged();
        }
    }

    private static string EscaparCsv(string valor)
    {
        if (string.IsNullOrEmpty(valor)) return "\"\"";
        var limpio = valor.Replace("\"", "\"\"");
        return $"\"{limpio}\"";
    }
