    private void GenerarReporteMediosPago(DateTime inicio, DateTime fin)
    {
        columnasGeneradas = new List<PuntoVentaPdfGenerator.ColumnaReportePdv>
        {
            new() { Titulo = "Medio de Recaudo", Ancho = 130.0, Negrita = true },
            new() { Titulo = "Operaciones", Ancho = 65.0, AlinearDerecha = true },
            new() { Titulo = "% Transacciones", Ancho = 75.0, AlinearDerecha = true },
            new() { Titulo = "Total Recaudado COP", Ancho = 130.0, AlinearDerecha = true, Negrita = true },
            new() { Titulo = "% Participación COP", Ancho = 80.0, AlinearDerecha = true },
            new() { Titulo = "Ticket Promedio", Ancho = 36.0, AlinearDerecha = true }
        };

        var ventas = PuntoVentaService.ObtenerVentas(null, inicio, fin)
            .Where(v => v.Estado == "Completada")
            .ToList();

        var totalGlobal = ventas.Sum(v => v.Total);
        var totalOps = ventas.Count;

        var agrupados = ventas
            .GroupBy(v => string.IsNullOrWhiteSpace(v.MetodoPago) ? "Efectivo" : v.MetodoPago)
            .Select(g => new
            {
                Medio = g.Key,
                Ops = g.Count(),
                Total = g.Sum(x => x.Total)
            })
            .OrderByDescending(x => x.Total)
            .ToList();

        foreach (var g in agrupados)
        {
            var pctOps = totalOps > 0 ? ((decimal)g.Ops / totalOps * 100) : 0;
            var pctCop = totalGlobal > 0 ? (g.Total / totalGlobal * 100) : 0;
            var prom = g.Ops > 0 ? (g.Total / g.Ops) : 0;

            filasGeneradas.Add(new[]
            {
                g.Medio,
                g.Ops.ToString(),
                $"{pctOps:N1}%",
                $"${g.Total.ToString("N0", culturaCop)}",
                $"{pctCop:N1}%",
                $"${prom.ToString("N0", culturaCop)}"
            });
        }

        kpisReporteActivo.Add(("Total Recaudado", $"${totalGlobal.ToString("N0", culturaCop)} COP"));
        kpisReporteActivo.Add(("Total Transacciones", $"{totalOps}"));
        kpisReporteActivo.Add(("Medio Principal", agrupados.FirstOrDefault()?.Medio ?? "Sin datos"));
        var enEfectivo = agrupados.FirstOrDefault(x => x.Medio.Contains("Efectivo", StringComparison.OrdinalIgnoreCase))?.Total ?? 0;
        kpisReporteActivo.Add(("Efectivo en Caja", $"${enEfectivo.ToString("N0", culturaCop)} COP"));
    }

