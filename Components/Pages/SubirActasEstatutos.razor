        }
    }

    private void IniciarAnulacion()
    {
        SolicitaMotivoAnulacion = true;
        MotivoAnulacion = string.Empty;
        MensajeError = null;
    }

    private void CancelarAnulacion()
    {
        SolicitaMotivoAnulacion = false;
        MotivoAnulacion = string.Empty;
    }

    private void ConfirmarAnulacion()
    {
        if (DocumentoSeleccionado is null)
        {
            MensajeError = "Selecciona un documento válido.";
            return;
        }

        if (string.IsNullOrWhiteSpace(MotivoAnulacion))
        {
            MensajeError = "Escribe el motivo de la anulación para dejar constancia en el historial.";
            return;
        }

        if (!DocumentoService.Anular(DocumentoSeleccionado.Id, MotivoAnulacion, ObtenerUsuarioActual()))
        {
            MensajeError = "No fue posible anular el registro. Puede que ya estuviera anulado.";
            return;
        }

        PublicarNotificacionDocumento("Documento anulado", DocumentoSeleccionado);
        MensajeExito = "Registro anulado. Se conservó su archivo y su historial.";
        SolicitaMotivoAnulacion = false;
        ActualizarDetalleSeleccionado();
    }

    private void Restaurar(Guid id)
    {
        if (!DocumentoService.Restaurar(id, ObtenerUsuarioActual()))
        {
            MensajeError = "No fue posible restaurar el registro. Actualiza la lista e inténtalo de nuevo.";
            return;
        }

        var restaurado = DocumentoService.ObtenerPorId(id);
        if (restaurado is not null)
        {
            PublicarNotificacionDocumento("Documento restaurado", restaurado);
        }
        MensajeExito = "Registro restaurado y devuelto al estado Vigente.";
        ActualizarDetalleSeleccionado();
    }

    private async Task DescargarAsync(Guid id)
    {
        var documento = DocumentoService.ObtenerPorId(id);
        if (documento?.Archivo is null)
        {
            MensajeError = "Este registro no tiene un archivo disponible para descargar.";
            return;
        }

        if (!documento.Archivo.Verificar())
        {
            MensajeError = "La huella del archivo no coincide. Se canceló la descarga para proteger la integridad del documento.";
            return;
        }

        ModuloJavaScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/actas-archivos.js");
        using var contenido = new MemoryStream(documento.Archivo.Contenido, writable: false);
        using var referencia = new DotNetStreamReference(contenido);
        await ModuloJavaScript.InvokeVoidAsync("descargar", documento.Archivo.Nombre, referencia, documento.Archivo.TipoMime);
        DocumentoService.RegistrarDescarga(id, ObtenerUsuarioActual());
        ActualizarDetalleSeleccionado();
        MensajeExito = $"Descarga iniciada: {documento.Archivo.Nombre}.";
    }

    private async Task ExportarCsvAsync()
    {
        var documentos = DocumentosFiltrados;
        if (documentos.Count == 0)
        {
            return;
        }

        var lineas = new List<string>
        {
            CrearFilaCsv("Código", "Título", "Tipo", "Estado", "Fecha", "Vencimiento",
                "Referencia", "Asociado", "Cédula", "Versión", "Archivo", "Descripción")
        };

        lineas.AddRange(documentos.Select(documento => CrearFilaCsv(
            documento.Codigo,
            documento.Titulo,
            documento.Tipo,
            documento.Estado,
            documento.Fecha.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            documento.FechaVencimiento?.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture),
            documento.NumeroReferencia,
            string.IsNullOrWhiteSpace(documento.NombreAsociado) ? "Documento institucional" : documento.NombreAsociado,
            documento.CedulaAsociado,
            documento.Version.ToString(System.Globalization.CultureInfo.InvariantCulture),
            documento.Archivo?.Nombre,
            documento.Descripcion)));

        var nombre = $"repositorio-documentos-{DateTime.Now:yyyyMMdd-HHmm}.csv";
        var contenido = string.Join("\r\n", lineas);
        ModuloJavaScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/actas-archivos.js");
        await ModuloJavaScript.InvokeVoidAsync("descargarCsv", nombre, contenido);
        MensajeExito = $"Se exportaron {documentos.Count} documentos.";
    }

    private static string CrearFilaCsv(params string?[] valores) =>
        string.Join(';', valores.Select(valor =>
        {
            var seguro = valor ?? string.Empty;
            if (seguro.Length > 0 && seguro[0] is '=' or '+' or '-' or '@' or '\t' or '\r')
            {
                seguro = "'" + seguro;
            }

            return $"\"{seguro.Replace("\"", "\"\"")}\"";
        }));

