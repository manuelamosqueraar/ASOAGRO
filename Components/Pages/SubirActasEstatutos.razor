@page "/subir-actas-estatutos"
@rendermode InteractiveServer

<PageTitle>Actas e Histórico Documental</PageTitle>

<div class="container py-4">
    <!-- Encabezado Principal -->
    <div class="card border-0 bg-primary text-white shadow-sm mb-4 rounded-3">
        <div class="card-body p-4 d-flex justify-content-between align-items-center">
            <div>
                <h3 class="fw-bold mb-1">
                    <i class="bi bi-journal-bookmark-fill me-2"></i>Gestión de Actas e Histórico Documental
                </h3>
                <p class="mb-0 text-white-50">Consulta, filtra y almacena los documentos legales y actas de la asociación.</p>
            </div>
            <div class="d-none d-md-block fs-1 opacity-50">
                <i class="bi bi-folder-symlink"></i>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 border-start border-4 border-success mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@mensajeExito
            <button type="button" class="btn-close" @onclick="() => mensajeExito = null"></button>
        </div>
    }

    <!-- Selector de Pestañas Interactivo -->
    <div class="d-flex gap-2 mb-4 bg-light p-2 rounded-3 shadow-sm border">
        <button type="button" class="btn fw-semibold @(pestanaActiva == "historico" ? "btn-primary text-white" : "btn-light text-dark")" @onclick='() => CambiarPestana("historico")'>
            <i class="bi bi-clock-history me-2"></i>Histórico de Actas
        </button>
        <button type="button" class="btn fw-semibold @(pestanaActiva == "subir" ? "btn-primary text-white" : "btn-light text-dark")" @onclick='() => CambiarPestana("subir")'>
            <i class="bi bi-cloud-arrow-up-fill me-2"></i>Registrar Nueva Acta
        </button>
    </div>

    @if (pestanaActiva == "historico")
    {
        <!-- Buscador y Filtros -->
        <div class="card border-0 shadow-sm mb-4 rounded-3">
            <div class="card-body p-3">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted border-end-0"><i class="bi bi-search"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar por título, N° de acta o tema..." @bind="busqueda" @bind:event="oninput" />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <select class="form-select" @bind="filtroTipo">
                            <option value="">Todos los tipos de documento</option>
                            <option value="Acta de Asamblea">Acta de Asamblea</option>
                            <option value="Estatuto Actualizado">Estatuto Actualizado</option>
                            <option value="Reglamento Interno">Reglamento Interno</option>
                            <option value="Resolución Legal">Resolución Legal</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-secondary w-100 fw-semibold" @onclick="LimpiarFiltros">
                            <i class="bi bi-arrow-counterclockwise me-1"></i>Limpiar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla del Histórico -->
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-files text-primary me-2"></i>Documentos Encontrados (@documentosFiltrados.Count())
                </h6>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light text-uppercase small text-muted">
                        <tr>
                            <th class="ps-4">Documento / Título</th>
                            <th>Tipo</th>
                            <th>Fecha</th>
                            <th>Descripción</th>
                            <th>Archivo</th>
                            <th class="text-end pe-4">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (documentosFiltrados.Any())
                        {
                            @foreach (var doc in documentosFiltrados)
                            {
                                <tr>
                                    <td class="ps-4">
                                        <div class="fw-bold text-dark">@doc.Titulo</div>
                                    </td>
                                    <td>
                                        <span class="badge @ObtenerBadgeColor(doc.Tipo) px-2 py-1 fw-semibold">
                                            @doc.Tipo
                                        </span>
                                    </td>
                                    <td class="text-secondary fw-semibold">@doc.Fecha.ToString("dd MMM yyyy")</td>
                                    <td><small class="text-muted d-block text-truncate" style="max-width: 250px;">@doc.Descripcion</small></td>
                                    <td>
                                        <span class="badge bg-light text-danger border border-danger-subtle px-2 py-1">
                                            <i class="bi bi-file-earmark-pdf me-1"></i>@doc.ArchivoNombre
                                        </span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <button type="button" class="btn btn-sm btn-outline-primary fw-semibold rounded-pill px-3" title="Descargar Documento">
                                            <i class="bi bi-download me-1"></i>Descargar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-folder2-open display-4 d-block mb-2 text-secondary"></i>
                                        <p class="fw-bold mb-1">No se encontraron actas ni documentos</p>
                                        <small>Intenta cambiar el término de búsqueda o el filtro seleccionado.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Formulario de Carga y Registro de Documentos -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white border-bottom py-3">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-file-earmark-plus text-primary me-2"></i>Formulario de Registro de Nueva Acta
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <EditForm Model="nuevoDocumento" OnValidSubmit="GuardarDocumento">
                            <DataAnnotationsValidator />

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary">Tipo de Documento</label>
                                    <InputSelect class="form-select shadow-none" @bind-Value="nuevoDocumento.Tipo">
                                        <option value="Acta de Asamblea">Acta de Asamblea</option>
                                        <option value="Estatuto Actualizado">Estatuto Actualizado</option>
                                        <option value="Reglamento Interno">Reglamento Interno</option>
                                        <option value="Resolución Legal">Resolución Legal</option>
                                    </InputSelect>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold text-secondary">Fecha del Documento</label>
                                    <InputDate class="form-control shadow-none" @bind-Value="nuevoDocumento.Fecha" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold text-secondary">Título / N° de Acta</label>
                                    <InputText class="form-control shadow-none" placeholder="Ej: Acta N° 015 - Asamblea Ordinaria 2024" @bind-Value="nuevoDocumento.Titulo" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold text-secondary">Descripción o Resumen</label>
                                    <InputTextArea class="form-control shadow-none" rows="3" placeholder="Puntos principales o acuerdos aprobados..." @bind-Value="nuevoDocumento.Descripcion" />
                                </div>

                                <div class="col-12">
                                    <label class="form-label fw-bold text-secondary">Adjuntar Archivo Escaneado (PDF / Imagen)</label>
                                    <div class="p-3 border border-2 border-dashed text-center rounded-3 bg-light">
                                        <i class="bi bi-cloud-upload display-5 text-primary d-block mb-2"></i>
                                        <InputFile class="form-control w-75 mx-auto mb-2" OnChange="CargarArchivo" accept=".pdf,.png,.jpg,.jpeg" />
                                        @if (!string.IsNullOrEmpty(nombreArchivoCargado))
                                        {
                                            <span class="badge bg-success px-3 py-2 mt-2 d-inline-block">
                                                <i class="bi bi-check-circle me-1"></i>@nombreArchivoCargado
                                            </span>
                                        }
                                        else
                                        {
                                            <small class="text-muted d-block">Soporta formatos PDF, PNG, JPG (Máx. 10MB)</small>
                                        }
                                    </div>
                                </div>

                                <div class="col-12 text-end mt-4">
                                    <button type="submit" class="btn btn-primary fw-bold px-4 py-2 rounded-pill shadow-sm" disabled="@string.IsNullOrEmpty(nombreArchivoCargado)">
                                        <i class="bi bi-check-lg me-1"></i> Guardar en Histórico
                                    </button>
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string pestanaActiva = "historico";
    private string? mensajeExito;
    private string? nombreArchivoCargado;
    private string busqueda = "";
    private string filtroTipo = "";

    private void CambiarPestana(string nuevaPestana)
    {
        pestanaActiva = nuevaPestana;
    }

    private class DocumentoInstitucional
    {
        public string Tipo { get; set; } = "Acta de Asamblea";
        public string Titulo { get; set; } = "";
        public DateTime Fecha { get; set; } = DateTime.Today;
        public string Descripcion { get; set; } = "";
        public string ArchivoNombre { get; set; } = "";
    }

    private DocumentoInstitucional nuevoDocumento = new();

    private List<DocumentoInstitucional> listaDocumentos = new()
    {
        new DocumentoInstitucional
        {
            Tipo = "Acta de Asamblea",
            Titulo = "Acta N° 014 - Asamblea Ordinaria Anual 2024",
            Fecha = new DateTime(2024, 2, 10),
            Descripcion = "Aprobación de estados financieros y plan de inversión.",
            ArchivoNombre = "Acta_014_2024.pdf"
        },
        new DocumentoInstitucional
        {
            Tipo = "Acta de Asamblea",
            Titulo = "Acta N° 013 - Nombramiento Revisor Fiscal",
            Fecha = new DateTime(2023, 11, 5),
            Descripcion = "Elección del nuevo revisor fiscal para el periodo 2024.",
            ArchivoNombre = "Acta_013_Revisor.pdf"
        },
        new DocumentoInstitucional
        {
            Tipo = "Estatuto Actualizado",
            Titulo = "Estatutos Generales Asoagro 2023",
            Fecha = new DateTime(2023, 3, 15),
            Descripcion = "Reforma estatutaria aprobada en Asamblea Extraordinaria.",
            ArchivoNombre = "Estatutos_2023.pdf"
        },
        new DocumentoInstitucional
        {
            Tipo = "Reglamento Interno",
            Titulo = "Reglamento Interno de Uso de Maquinaria",
            Fecha = new DateTime(2022, 8, 20),
            Descripcion = "Normas y tarifas para el préstamo de herramientas.",
            ArchivoNombre = "Reglamento_Maquinaria.pdf"
        }
    };

    private IEnumerable<DocumentoInstitucional> documentosFiltrados =>
        listaDocumentos.Where(d =>
            (string.IsNullOrWhiteSpace(busqueda) || 
             d.Titulo.Contains(busqueda, StringComparison.OrdinalIgnoreCase) || 
             d.Descripcion.Contains(busqueda, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(filtroTipo) || d.Tipo == filtroTipo)
        );

    private void LimpiarFiltros()
    {
        busqueda = "";
        filtroTipo = "";
    }

    private void CargarArchivo(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo != null)
        {
            nombreArchivoCargado = archivo.Name;
            nuevoDocumento.ArchivoNombre = archivo.Name;
        }
    }

    private void GuardarDocumento()
    {
        if (string.IsNullOrWhiteSpace(nuevoDocumento.Titulo)) return;

        listaDocumentos.Insert(0, new DocumentoInstitucional
        {
            Tipo = nuevoDocumento.Tipo,
            Titulo = nuevoDocumento.Titulo,
            Fecha = nuevoDocumento.Fecha,
            Descripcion = nuevoDocumento.Descripcion,
            ArchivoNombre = nuevoDocumento.ArchivoNombre
        });

        mensajeExito = $"El documento '{nuevoDocumento.Titulo}' fue guardado correctamente en el histórico.";
        nuevoDocumento = new();
        nombreArchivoCargado = null;
        pestanaActiva = "historico";
    }

    private string ObtenerBadgeColor(string tipo) => tipo switch
    {
        "Acta de Asamblea" => "bg-primary text-white",
        "Estatuto Actualizado" => "bg-success text-white",
        "Reglamento Interno" => "bg-warning text-dark",
        "Resolución Legal" => "bg-info text-dark",
        _ => "bg-secondary text-white"
    };
}