@page "/subir-actas-estatutos"
@page "/actas-estatutos/documentos"
@page "/actas-estatutos/registrar"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Secretaria,Secretaría,Presidenta,Presidente,Administrador,Admin")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Web
@using Asoagro.Services
@using Microsoft.AspNetCore.Components.Authorization
@inject IDocumentoInstitucionalService DocumentoService
@inject IAsociadoService RegistroAsociados
@inject NotificacionService Notificaciones
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(PestanaActiva == "formulario" ? "Registrar documento" : "Repositorio de actas")</PageTitle>

<div class="ai" @onkeydown="ManejarTeclaModal">
    <svg class="ai-sprite" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="ico-mas" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
            <symbol id="ico-flecha-derecha" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
            <symbol id="ico-buscar" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="7" /><path d="m16 16 5 5" /></symbol>
            <symbol id="ico-limpiar" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 2.64-6.36L3 8M3 3v5h5" /><path d="M12 7v5l3 2" /></symbol>
            <symbol id="ico-calendario" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M16 3v4M8 3v4M3 10h18" /></symbol>
            <symbol id="ico-version" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h10" /><circle cx="18" cy="17" r="3" /></symbol>
            <symbol id="ico-ojo" viewBox="0 0 24 24"><path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></symbol>
            <symbol id="ico-descargar" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></symbol>
            <symbol id="ico-exportar" viewBox="0 0 24 24"><path d="M12 3v12M7 10l5 5 5-5M4 17v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" /></symbol>
            <symbol id="ico-cerrar" viewBox="0 0 24 24"><path d="m18 6-12 12M6 6l12 12" /></symbol>
            <symbol id="ico-archivo" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6M8 13h8M8 17h8" /></symbol>
            <symbol id="ico-pdf" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8zM14 2v6h6" /><path d="M7 16h2a1.5 1.5 0 0 0 0-3H7v5M13 18v-5h1.5a2.5 2.5 0 0 1 0 5H13M18 18v-5h3M18 15h2" /></symbol>
            <symbol id="ico-imagen" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="m21 15-5-5L5 21" /></symbol>
            <symbol id="ico-restaurar" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 2.64-6.36L3 8M3 3v5h5" /><path d="M12 7v5l3 2" /></symbol>
            <symbol id="ico-editar" viewBox="0 0 24 24"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4z" /></symbol>
            <symbol id="ico-anular" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m6 6 12 12" /></symbol>
            <symbol id="ico-guardar" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2zM17 21v-8H7v8M7 3v5h8" /></symbol>
        </defs>
    </svg>

    @if (PestanaActiva == "lista")
    {
        <div class="card aso-hero-card mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="aso-hero-icon-box">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
                                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
                            </svg>
                        </div>
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="aso-hero-kicker">FAAUA · Centro Documental</span>
                                <span class="text-white-50" style="font-size: 0.75rem; font-weight: 600;">@Documentos.Count registrados (@Documentos.Count(d => d.Estado == EstadosDocumento.Vigente) vigentes)</span>
                            </div>
                            <h1 class="aso-hero-title">Repositorio de actas y estatutos</h1>
                            <p class="aso-hero-desc">Busca, inspecciona, edita y conserva los documentos institucionales con trazabilidad de cambios y descargas.</p>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (Documentos.Count > 0)
                        {
                            <button type="button" class="aso-btn-hero-secondary" @onclick="ExportarCsvAsync">
                                <svg class="ai-icon" width="16" height="16"><use href="#ico-exportar" /></svg>
                                <span>Exportar CSV</span>
                            </button>
                        }
                        <button type="button" class="aso-btn-hero-primary" @onclick="IniciarNuevo">
                            <svg class="ai-icon" width="16" height="16"><use href="#ico-mas" /></svg>
                            <span>Registrar nuevo</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <header class="ai-form-route-heading mb-3">
            <a href="/actas-estatutos">Centro documental</a>
            <span aria-hidden="true">/</span>
            <a href="/actas-estatutos/documentos">Repositorio</a>
            <span aria-hidden="true">/</span>
            <strong>@(Editando ? "Editar documento" : "Registrar documento")</strong>
        </header>
    }

    @if (!string.IsNullOrWhiteSpace(MensajeExito))
    {
        <div class="ai-alert ai-alert-success" role="status">
            <svg class="ai-icon"><use href="#ico-check" /></svg>
            <span>@MensajeExito</span>
            <button type="button" class="ai-alert-close" @onclick="() => MensajeExito = null" aria-label="Cerrar">&times;</button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(MensajeError))
    {
        <div class="ai-alert ai-alert-error" role="alert">
            <svg class="ai-icon"><use href="#ico-alerta" /></svg>
            <span>@MensajeError</span>
            <button type="button" class="ai-alert-close" @onclick="() => MensajeError = null" aria-label="Cerrar">&times;</button>
        </div>
    }

    @if (PestanaActiva == "lista")
    {
        var documentosFiltrados = DocumentosFiltrados;

        <!-- FRANJA EJECUTIVA DE INDICADORES DEL REPOSITORIO -->
        <div class="aso-kpi-grid">
            <div class="aso-kpi-card kpi-emerald" style="cursor: pointer;" @onclick='() => FiltroEstado = ""'>
                <div class="aso-kpi-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                </div>
                <div class="aso-kpi-meta">
                    <span class="aso-kpi-label">Total Repositorio</span>
                    <strong class="aso-kpi-value">@Documentos.Count</strong>
                    <span class="aso-kpi-sub">Actas, estatutos y reglamentos</span>
                </div>
            </div>

            <div class="aso-kpi-card kpi-sky" style="cursor: pointer;" @onclick='() => FiltroEstado = EstadosDocumento.Vigente'>
                <div class="aso-kpi-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                </div>
                <div class="aso-kpi-meta">
                    <span class="aso-kpi-label">Estado Vigente</span>
                    <strong class="aso-kpi-value">@Documentos.Count(d => d.Estado == EstadosDocumento.Vigente)</strong>
                    <span class="aso-kpi-sub">Con validez institucional activa</span>
                </div>
            </div>

            <div class="aso-kpi-card kpi-amber" style="cursor: pointer;" @onclick='() => FiltroEstado = ""'>
                <div class="aso-kpi-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                </div>
                <div class="aso-kpi-meta">
                    <span class="aso-kpi-label">Con Soporte Digital</span>
                    <strong class="aso-kpi-value">@Documentos.Count(d => d.Archivo is not null)</strong>
                    <span class="aso-kpi-sub">Archivos listos para descarga</span>
                </div>
            </div>

            <div class="aso-kpi-card kpi-rose" style="cursor: pointer;" @onclick='() => FiltroEstado = ""'>
                <div class="aso-kpi-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
                <div class="aso-kpi-meta">
                    <span class="aso-kpi-label">En Revisión / Histórico</span>
                    <strong class="aso-kpi-value">@Documentos.Count(d => d.Estado != EstadosDocumento.Vigente)</strong>
                    <span class="aso-kpi-sub">Borradores o versiones anteriores</span>
                </div>
            </div>
        </div>

        <!-- ESTACIÓN DE BÚSQUEDA Y FILTROS DEL REPOSITORIO -->
        <div class="aso-filter-workbench">
            <div class="aso-filter-top-row">
                <div class="aso-search-wrap">
                    <span class="aso-search-icon">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </span>
                    <input type="text" class="aso-search-input"
                           aria-label="Buscar documentos"
                           placeholder="Buscar documento por título, asociado vinculado, código interno o referencia..."
                           @bind="Busqueda" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(Busqueda))
                    {
                        <button type="button" class="aso-search-clear" @onclick='() => Busqueda = ""' title="Limpiar búsqueda">
                            &times;
                        </button>
                    }
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="aso-table-count-pill">
                        @documentosFiltrados.Count de @Documentos.Count documento(s)
                    </span>
                    <button type="button" class="aso-btn-action" @onclick="LimpiarFiltros">
                        <svg class="ai-icon" width="14" height="14"><use href="#ico-limpiar" /></svg>
                        <span>Restablecer filtros</span>
                    </button>
                </div>
            </div>

            <div class="aso-filter-grid-3">
                <div class="aso-field-group">
                    <label class="aso-field-label">Tipo de documento institucional</label>
                    <select class="aso-select-modern" @bind="FiltroTipo" aria-label="Filtrar por tipo">
                        <option value="">Todos los tipos documentales</option>
                        @foreach (var tipo in TiposDocumento)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>

                <div class="aso-field-group">
                    <label class="aso-field-label">Estado de vigencia</label>
                    <select class="aso-select-modern" @bind="FiltroEstado" aria-label="Filtrar por estado">
                        <option value="">Todos los estados</option>
                        @foreach (var estado in EstadosFiltro)
                        {
                            <option value="@estado">@estado</option>
                        }
                    </select>
                </div>

                <div class="aso-field-group">
                    <label class="aso-field-label">Acción rápida</label>
                    <button type="button" class="aso-btn-action aso-btn-action-primary w-100 justify-content-center" style="height: 40px; border-radius: 11px;" @onclick="IniciarNuevo">
                        <svg class="ai-icon" width="15" height="15"><use href="#ico-mas" /></svg>
                        <span>Incorporar nuevo documento</span>
                    </button>
                </div>
            </div>
        </div>

        <section class="ai-list-section">
            @if (documentosFiltrados.Count > 0)
            {
                <div class="aso-table-card">
                    <div class="aso-table-header-bar">
                        <div class="aso-table-header-title">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#15803d" stroke-width="2.2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                            <span>Catálogo General de Actas y Estatutos</span>
                            <span class="aso-table-count-pill">@documentosFiltrados.Count registros</span>
                        </div>
                        <span class="text-muted" style="font-size: 0.78rem; font-weight: 500;">Haz clic en los encabezados de columna para ordenar</span>
                    </div>
                    <div class="aso-table-wrap" role="region" aria-label="Resultados del repositorio" tabindex="0">
                        <table class="table aso-table-grid align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col" class="text-start" style="width: 34%; min-width: 240px;" aria-sort="@AriaOrden("titulo")">
                                        <button type="button" class="btn btn-link p-0 text-white text-decoration-none fw-bold text-uppercase d-inline-flex align-items-center gap-1" style="font-size: 0.74rem; letter-spacing: 0.04em;" @onclick='() => CambiarOrden("titulo")'>
                                            Documento <span aria-hidden="true">@IndicadorOrden("titulo")</span>
                                        </button>
                                    </th>
                                    <th scope="col" class="text-start" style="width: 18%; min-width: 150px;" aria-sort="@AriaOrden("fecha")">
                                        <button type="button" class="btn btn-link p-0 text-white text-decoration-none fw-bold text-uppercase d-inline-flex align-items-center gap-1" style="font-size: 0.74rem; letter-spacing: 0.04em;" @onclick='() => CambiarOrden("fecha")'>
                                            Fecha y Versión <span aria-hidden="true">@IndicadorOrden("fecha")</span>
                                        </button>
                                    </th>
                                    <th scope="col" class="text-center" style="width: 12%; min-width: 100px;" aria-sort="@AriaOrden("estado")">
                                        <button type="button" class="btn btn-link p-0 text-white text-decoration-none fw-bold text-uppercase d-inline-flex align-items-center gap-1" style="font-size: 0.74rem; letter-spacing: 0.04em;" @onclick='() => CambiarOrden("estado")'>
                                            Estado <span aria-hidden="true">@IndicadorOrden("estado")</span>
                                        </button>
                                    </th>
                                    <th scope="col" class="text-start" style="width: 18%; min-width: 165px;">Archivo digital</th>
                                    <th scope="col" class="text-end" style="width: 18%; min-width: 185px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var documento in documentosFiltrados)
                                {
                                    <tr class="@(DocumentoSeleccionado?.Id == documento.Id ? "selected" : "")">
                                        <td class="text-start">
                                            <div class="d-flex flex-column gap-0.5">
                                                <div class="d-flex align-items-center gap-1.5 flex-wrap">
                                                    <span class="badge bg-white text-dark border font-monospace" style="font-size: 0.7rem; border-color: #dce4d8 !important; color: #17603a !important;">@documento.Codigo</span>
                                                    <span class="badge bg-success-subtle text-success-emphasis rounded-pill" style="font-size: 0.7rem;">@documento.Tipo</span>
                                                </div>
                                                <strong class="text-dark mt-0.5" style="font-size: 0.88rem; line-height: 1.3;">@documento.Titulo</strong>
                                                <small class="text-muted d-inline-flex align-items-center gap-1" style="font-size: 0.75rem;">
                                                    @(string.IsNullOrWhiteSpace(documento.NombreAsociado) ? "Documento institucional" : documento.NombreAsociado)
                                                </small>
                                                @if (!string.IsNullOrWhiteSpace(documento.Descripcion))
                                                {
                                                    <small class="text-secondary text-truncate" style="max-width: 340px; font-size: 0.74rem;" title="@documento.Descripcion">@documento.Descripcion</small>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-start">
                                            <div class="d-flex flex-column gap-0.5" style="font-size: 0.8rem;">
                                                <strong class="text-dark">@documento.Fecha.ToString("dd MMM yyyy")</strong>
                                                <small class="text-muted">Versión @documento.Version</small>
                                                @if (documento.FechaVencimiento is DateTime fechaVencimiento)
                                                {
                                                    <small class="text-warning-emphasis fw-semibold">Vence: @fechaVencimiento.ToString("dd MMM yyyy")</small>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-center">
                                            <span class="@(documento.Estado == EstadosDocumento.Vigente ? "aso-badge-activa" : documento.Estado == EstadosDocumento.Anulado ? "aso-badge-vencida" : "aso-badge-pendiente")">
                                                @documento.Estado
                                            </span>
                                        </td>
                                        <td class="text-start">
                                            @if (documento.Archivo is not null)
                                            {
                                                <div class="d-flex align-items-center gap-2">
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" class="flex-shrink-0"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
                                                    <div class="d-flex flex-column" style="min-width: 0;">
                                                        <span class="text-dark fw-semibold text-truncate" style="max-width: 170px; font-size: 0.8rem;" title="@documento.Archivo.Nombre">@documento.Archivo.Nombre</span>
                                                        <small class="text-muted" style="font-size: 0.72rem;">@TamanoLegible(documento.Archivo.Tamano)</small>
                                                    </div>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="aso-badge-neutro">Sin archivo adjunto</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            <div class="aso-actions-group">
                                                <button type="button" class="aso-btn-action" @onclick="() => AbrirDetalleAsync(documento.Id)">
                                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                                                    <span>Detalles</span>
                                                </button>
                                                @if (documento.Archivo is not null)
                                                {
                                                    <button type="button" class="aso-btn-action aso-btn-action-primary" title="Descargar archivo" aria-label="@($"Descargar {documento.Archivo.Nombre}")" @onclick="() => DescargarAsync(documento.Id)">
                                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                                                        <span>Descargar</span>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
            else
            {
                <div class="ai-empty">
                    <span class="ai-empty-icon"><svg class="ai-icon"><use href="#ico-lista" /></svg></span>
                    <h3>@(Documentos.Count == 0 ? "Aún no hay documentos" : "No hay coincidencias")</h3>
                    <p>@(Documentos.Count == 0 ? "Registra el primer documento institucional para iniciar el repositorio." : "Prueba con otros términos o filtros para encontrar el documento.")</p>
                    @if (Documentos.Count == 0)
                    {
                        <button type="button" class="ai-btn ai-btn-primary" @onclick="IniciarNuevo">Registrar documento</button>
                    }
                    else
                    {
                        <button type="button" class="ai-btn ai-btn-light" @onclick="LimpiarFiltros">Limpiar filtros</button>
                    }
                </div>
            }
        </section>

        @if (DocumentoSeleccionado is not null)
        {
            var documento = DocumentoSeleccionado;
            <div class="ai-modal-backdrop" role="presentation" @onclick="CerrarDetalle">
                <section class="ai-detail ai-detail-modal" role="dialog" aria-modal="true" aria-labelledby="ai-detail-title" @onclick:stopPropagation="true">
                <header class="ai-detail-heading">
                    <div>
                        <span class="ai-eyebrow">Ficha de inspección · @documento.Codigo</span>
                        <h2 id="ai-detail-title">@documento.Titulo</h2>
                    </div>
                    <button type="button" class="ai-icon-btn" @onclick="CerrarDetalle" @onclick:stopPropagation="true" aria-label="Cerrar ficha" title="Cerrar ficha">
                        <svg class="ai-icon"><use href="#ico-cerrar" /></svg>
                    </button>
                </header>

                <div class="ai-detail-body">
                <div class="ai-detail-layout">
                    <div class="ai-preview">
                        <div class="ai-preview-heading">
                            <div>
                                <strong>Vista previa</strong>
                                <small>@(documento.Archivo?.Nombre ?? "Este registro no tiene archivo adjunto")</small>
                            </div>
                            @if (documento.Archivo is not null)
                            {
                                <button type="button" class="ai-btn ai-btn-light" @onclick="VerificarArchivo">
                                    <svg class="ai-icon"><use href="#ico-escudo" /></svg>
                                    Verificar integridad
                                </button>
                            }
                        </div>

                        @if (documento.Archivo is not null && !string.IsNullOrWhiteSpace(VistaPreviaUrl))
                        {
                            @if (documento.Archivo.TipoMime == "application/pdf")
                            {
                                <iframe class="ai-preview-frame" src="@VistaPreviaUrl" title="@($"Vista previa de {documento.Archivo.Nombre}")"></iframe>
                            }
                            else
                            {
                                <img class="ai-preview-image" src="@VistaPreviaUrl" alt="@($"Vista previa de {documento.Archivo.Nombre}")" />
                            }
                        }
                        else
                        {
                            <div class="ai-preview-empty">
                                <svg class="ai-icon"><use href="#ico-archivo" /></svg>
                                <strong>Sin vista previa disponible</strong>
                                <span>Adjunta un PDF o una imagen al editar este registro.</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(EstadoVerificacion))
                        {
                            <div class="ai-integrity @(ArchivoIntegro ? "integrity-ok" : "integrity-error")" role="status">
                                <svg class="ai-icon"><use href="@(ArchivoIntegro ? "#ico-check" : "#ico-alerta")" /></svg>
                                <span>@EstadoVerificacion</span>
                            </div>
                        }
                    </div>

                    <aside class="ai-facts">
                        <span class="ai-eyebrow">Datos del documento</span>
                        <dl>
                            <div><dt>Tipo</dt><dd>@documento.Tipo</dd></div>
                            <div><dt>Estado</dt><dd><span class="ai-status @ClaseEstado(documento.Estado)">@documento.Estado</span></dd></div>
                            <div><dt>Fecha del documento</dt><dd>@documento.Fecha.ToString("dd/MM/yyyy")</dd></div>
                            <div><dt>Fecha de vencimiento</dt><dd>@(documento.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No aplica")</dd></div>
                            <div><dt>Número de referencia</dt><dd>@(string.IsNullOrWhiteSpace(documento.NumeroReferencia) ? "—" : documento.NumeroReferencia)</dd></div>
                            <div><dt>Asociado relacionado</dt><dd>@(string.IsNullOrWhiteSpace(documento.NombreAsociado) ? "Documento institucional / no aplica" : $"{documento.NombreAsociado} · CC {documento.CedulaAsociado}")</dd></div>
                            <div><dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(documento.Descripcion) ? "—" : documento.Descripcion)</dd></div>
                            <div><dt>Versión del archivo</dt><dd>@documento.Version</dd></div>
                            <div><dt>Última actualización</dt><dd>@documento.FechaActualizacion.ToString("dd/MM/yyyy HH:mm") · @documento.ActualizadoPor</dd></div>
                        </dl>

                        @if (documento.Compromisos.Any())
                        {
                            <div class="ai-compromisos-card mt-3 p-3 bg-light rounded-3 border">
                                <span class="ai-eyebrow d-block mb-1 text-success fw-bold" style="font-size: 0.72rem; text-transform: uppercase;">
                                    <svg class="ai-icon me-1" width="14" height="14" viewBox="0 0 24 24"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                                    Compromisos derivados del acta
                                </span>
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.76rem;">
                                        <thead>
                                            <tr class="text-muted">
                                                <th>Compromiso</th>
                                                <th>Responsable</th>
                                                <th>Fecha límite</th>
                                                <th>Estado</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var comp in documento.Compromisos)
                                            {
                                                <tr>
                                                    <td class="fw-semibold text-dark">@comp.Descripcion</td>
                                                    <td>@comp.Responsable</td>
                                                    <td>@comp.FechaLimite.ToString("dd/MM/yyyy")</td>
                                                    <td>
                                                        <span class="badge @(comp.Estado == "Cumplido" ? "bg-success" : comp.Estado == "Atrasado" ? "bg-danger" : "bg-warning text-dark")" style="font-size: 0.68rem;">
                                                            @comp.Estado
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }

                        @if (documento.Archivo is not null)
                        {
                            <div class="ai-file-info">
                                <span>Huella SHA-256</span>
                                <code>@documento.Archivo.Sha256</code>
                                <small>@TamanoLegible(documento.Archivo.Tamano) · @documento.Archivo.TipoMime</small>
                            </div>
                        }

                        <div class="ai-detail-actions">
                            @if (documento.Archivo is not null)
                            {
                                <button type="button" class="ai-btn ai-btn-primary" @onclick="() => DescargarAsync(documento.Id)">
                                    <svg class="ai-icon"><use href="#ico-descargar" /></svg>
                                    Descargar archivo
                                </button>
                            }
                            @if (documento.Estado == EstadosDocumento.Anulado)
                            {
                                <button type="button" class="ai-btn ai-btn-success" @onclick="() => Restaurar(documento.Id)">
                                    <svg class="ai-icon"><use href="#ico-restaurar" /></svg>
                                    Restaurar registro
                                </button>
                            }
                            else
                            {
                                <button type="button" class="ai-btn ai-btn-light" @onclick="() => IniciarEdicion(documento.Id)">
                                    <svg class="ai-icon"><use href="#ico-editar" /></svg>
                                    Editar ficha
                                </button>
                                <button type="button" class="ai-btn ai-btn-danger-outline" @onclick="IniciarAnulacion">
                                    <svg class="ai-icon"><use href="#ico-anular" /></svg>
                                    Anular
                                </button>
                            }
                        </div>

                        @if (SolicitaMotivoAnulacion)
                        {
                            <div class="ai-cancel-box">
                                <label for="ai-motivo">Motivo de anulación <span>*</span></label>
                                <textarea id="ai-motivo" rows="3" maxlength="500" @bind="MotivoAnulacion" placeholder="Explica por qué se anula este registro…"></textarea>
                                <small>La anulación se conserva en el historial y no elimina el archivo.</small>
                                <div>
                                    <button type="button" class="ai-btn ai-btn-light" @onclick="CancelarAnulacion">Cancelar</button>
                                    <button type="button" class="ai-btn ai-btn-danger" @onclick="ConfirmarAnulacion">Confirmar anulación</button>
                                </div>
                            </div>
                        }
                    </aside>
                </div>

                <section class="ai-history">
                    <div class="ai-history-heading">
                        <div>
                            <span class="ai-eyebrow">Trazabilidad</span>
                            <h3>Historial de actividad</h3>
                        </div>
                        <span class="ai-history-count">@HistorialSeleccionado.Count eventos</span>
                    </div>
                    @if (HistorialSeleccionado.Count > 0)
                    {
                        <ol class="ai-timeline">
                            @foreach (var entrada in HistorialSeleccionado)
                            {
                                <li>
                                    <span class="ai-timeline-dot"></span>
                                    <div class="ai-timeline-content">
                                        <div><strong>@entrada.Accion</strong><time>@entrada.Fecha.ToString("dd/MM/yyyy HH:mm")</time></div>
                                        <p>@entrada.Detalle</p>
                                        <small>@entrada.Usuario</small>
                                    </div>
                                </li>
                            }
                        </ol>
                    }
                    else
                    {
                        <p class="ai-history-empty">Todavía no hay movimientos registrados para este documento.</p>
                    }
                </section>
                </div>
                </section>
            </div>
        }
    }
    else
    {
        <section class="ai-form-shell">
            <div class="ai-form-heading">
                <div class="ai-form-heading-icon"><svg class="ai-icon"><use href="@(Editando ? "#ico-editar" : "#ico-mas")" /></svg></div>
                <div>
                    <span class="ai-eyebrow">@(Editando ? "Actualización de ficha" : "Nuevo registro")</span>
                    <h2>@(Editando ? "Editar documento institucional" : "Registrar acta o documento")</h2>
                    <p>@(Editando ? "Actualiza los datos o reemplaza el archivo. El cambio quedará en el historial." : "Completa la información y revisa el archivo antes de guardarlo.")</p>
                </div>
            </div>

            <EditForm Model="Formulario" OnValidSubmit="GuardarAsync" class="ai-form">
                <DataAnnotationsValidator />
                <ValidationSummary class="ai-validation-summary" />
                <nav class="ai-form-steps" aria-label="Pasos del formulario">
                    <div class="ai-form-progress"><span style="width: @($"{(PasoFormulario - 1) * 50}%")"></span></div>
                    @foreach (var paso in PasosFormulario)
                    {
                        <div class="ai-form-step @(PasoFormulario == paso.Numero ? "active" : PasoFormulario > paso.Numero ? "complete" : "")" aria-current="@(PasoFormulario == paso.Numero ? "step" : null)">
                            <span>@(PasoFormulario > paso.Numero ? "✓" : paso.Numero.ToString())</span>
                            <div><strong>@paso.Titulo</strong><small>@paso.Subtitulo</small></div>
                        </div>
                    }
                </nav>

                @if (PasoFormulario == 1)
                {
                    <section class="ai-form-step-panel" aria-labelledby="ai-step-title">
                        <div class="ai-step-heading">
                            <span>01</span>
                            <div><h3 id="ai-step-title">Identificación del documento</h3><p>Indica qué se va a registrar y a quién corresponde.</p></div>
                        </div>
                        <div class="ai-form-grid">
                            <div class="ai-field">
                                <label for="ai-tipo">Tipo de documento <span>*</span></label>
                                <InputSelect id="ai-tipo" class="ai-input" @bind-Value="Formulario.Tipo">
                                    <option value="">Selecciona un tipo</option>
                                    @foreach (var tipo in TiposDocumento)
                                    {
                                        <option value="@tipo">@tipo</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => Formulario.Tipo)" />
                            </div>
                            <div class="ai-field">
                                <label for="ai-estado">Estado</label>
                                <InputSelect id="ai-estado" class="ai-input" @bind-Value="Formulario.Estado">
                                    @foreach (var estado in EstadosEditables)
                                    {
                                        <option value="@estado">@estado</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="ai-field ai-field-wide">
                                <label for="ai-titulo">Título del documento <span>*</span></label>
                                <InputText id="ai-titulo" class="ai-input" @bind-Value="Formulario.Titulo" placeholder="Ej. Acta 015 · Asamblea ordinaria" />
                                <ValidationMessage For="@(() => Formulario.Titulo)" />
                            </div>
                            <div class="ai-field ai-field-wide">
                                <label for="ai-asociado">Asociado relacionado</label>
                                <div class="ai-associate-picker">
                                    <input id="ai-asociado"
                                           class="ai-input"
                                           type="text"
                                           role="combobox"
                                           aria-autocomplete="list"
                                           aria-controls="ai-asociado-opciones"
                                           aria-expanded="@MostrarSugerenciasAsociado.ToString().ToLowerInvariant()"
                                           aria-activedescendant="@IdAsociadoActivo"
                                           autocomplete="off"
                                           placeholder="Escribe un nombre o una cédula"
                                           value="@BusquedaAsociado"
                                           @oninput="FiltrarAsociados"
                                           @onfocus="AbrirSugerenciasAsociado"
                                           @onblur="CerrarSugerenciasAsociado"
                                           @onkeydown="ManejarTeclaAsociado" />
                                    @if (MostrarSugerenciasAsociado)
                                    {
                                        <div id="ai-asociado-opciones" class="ai-associate-suggestions" role="listbox" aria-label="Asociados disponibles">
                                            @if (AsociadosFiltrados.Count == 0)
                                            {
                                                <p class="ai-associate-empty" role="status">No se encontraron asociados con ese nombre o cédula.</p>
                                            }
                                            else
                                            {
                                                @for (var indice = 0; indice < AsociadosFiltrados.Count; indice++)
                                                {
                                                    var asociado = AsociadosFiltrados[indice];
                                                    <button id="@($"ai-asociado-opcion-{indice}")"
                                                            type="button"
                                                            class="ai-associate-option @(indice == IndiceAsociadoActivo ? "active" : "")"
                                                            role="option"
                                                            aria-selected="@(indice == IndiceAsociadoActivo)"
                                                            @onmousedown:preventDefault="true"
                                                            @onclick="() => SeleccionarAsociado(asociado)">
                                                        <span>@asociado.NombreCompleto</span>
                                                        <small>CC @asociado.Cedula</small>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(Formulario.CedulaAsociado))
                                    {
                                        <button type="button" class="ai-associate-clear" @onclick="LimpiarAsociado">Quitar asociado relacionado</button>
                                    }
                                </div>
                                <small class="ai-field-help">Escribe para filtrar por nombre o cédula y selecciona un resultado. Si no corresponde a una persona, déjalo vacío; los documentos pueden quedar como institucionales.</small>
                            </div>
                            <div class="ai-field ai-field-third">
                                <label for="ai-fecha">Fecha del documento <span>*</span></label>
                                <InputDate id="ai-fecha" class="ai-input" @bind-Value="Formulario.Fecha" />
                                <ValidationMessage For="@(() => Formulario.Fecha)" />
                            </div>
                            <div class="ai-field ai-field-third">
                                <label for="ai-referencia">Número o referencia</label>
                                <InputText id="ai-referencia" class="ai-input" @bind-Value="Formulario.NumeroReferencia" placeholder="Ej. ACT-015-2025" />
                                <ValidationMessage For="@(() => Formulario.NumeroReferencia)" />
                            </div>
                            <div class="ai-field ai-field-third">
                                <label for="ai-vencimiento">Fecha de vencimiento <span class="ai-optional">(opcional)</span></label>
                                <InputDate id="ai-vencimiento" class="ai-input" @bind-Value="Formulario.FechaVencimiento" />
                                <small class="ai-field-help">Déjala vacía si este documento no vence. Si indicas una fecha, recibirás avisos antes y al vencerse.</small>
                            </div>
                        </div>
                    </section>
                }
                else if (PasoFormulario == 2)
                {
                    <section class="ai-form-step-panel" aria-labelledby="ai-step-title">
                        <div class="ai-step-heading">
                            <span>02</span>
                            <div><h3 id="ai-step-title">Descripción y archivo</h3><p>Resume el contenido y revisa el documento digital antes de guardarlo.</p></div>
                        </div>
                        <div class="ai-form-grid">
                            <div class="ai-field ai-field-wide">
                                <label for="ai-descripcion">Descripción o acuerdos principales</label>
                                <InputTextArea id="ai-descripcion" class="ai-input ai-textarea" @bind-Value="Formulario.Descripcion" rows="4" placeholder="Resume los puntos importantes del documento…" />
                                <ValidationMessage For="@(() => Formulario.Descripcion)" />
                            </div>
                            <div class="ai-field ai-field-wide">
                                <label for="ai-archivo">Archivo digital <span>@(Editando ? "(opcional para reemplazar)" : "*")</span></label>
                                <InputFile id="ai-archivo" class="ai-file-input" OnChange="SeleccionarArchivoAsync" accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" />
                                <small class="ai-field-help">PDF, PNG o JPG · máximo 10 MB. Selecciona un archivo para ver su vista previa.</small>
                                <ValidationMessage For="@(() => Formulario.ArchivoNombre)" />
                            </div>
                        </div>

                        @if (ArchivoPendiente is not null)
                        {
                            <div class="ai-selected-file">
                                <div class="ai-selected-file-icon"><svg class="ai-icon"><use href="@IconoArchivo(ArchivoPendiente.TipoMime)" /></svg></div>
                                <div class="ai-selected-file-info">
                                    <strong>@ArchivoPendiente.Nombre</strong>
                                    <small>@TamanoLegible(ArchivoPendiente.Tamano) · @ArchivoPendiente.TipoMime · SHA-256: @ArchivoPendiente.Sha256</small>
                                </div>
                                <button type="button" class="ai-btn ai-btn-light" @onclick="VerificarArchivoPendiente">
                                    <svg class="ai-icon"><use href="#ico-escudo" /></svg>Verificar
                                </button>
                                <button type="button" class="ai-icon-btn" title="Quitar archivo seleccionado" aria-label="Quitar archivo seleccionado" @onclick="QuitarArchivoPendienteAsync">
                                    <svg class="ai-icon"><use href="#ico-cerrar" /></svg>
                                </button>
                            </div>
                        }
                        else if (Editando && DocumentoSeleccionado?.Archivo is not null)
                        {
                            <div class="ai-current-file">
                                <svg class="ai-icon"><use href="@IconoArchivo(DocumentoSeleccionado.Archivo.TipoMime)" /></svg>
                                <span>Archivo actual: <strong>@DocumentoSeleccionado.Archivo.Nombre</strong> · versión @DocumentoSeleccionado.Version</span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(VistaPreviaUrl))
                        {
                            <div class="ai-form-preview">
                                <div class="ai-preview-heading">
                                    <div><strong>Vista previa del archivo</strong><small>@NombreArchivoVistaPrevia</small></div>
                                    <button type="button" class="ai-icon-btn" title="Cerrar vista previa" aria-label="Cerrar vista previa" @onclick="LimpiarVistaPreviaAsync">
                                        <svg class="ai-icon"><use href="#ico-cerrar" /></svg>
                                    </button>
                                </div>
                                @if (MimeVistaPrevia == "application/pdf")
                                {
                                    <iframe class="ai-preview-frame ai-preview-form-frame" src="@VistaPreviaUrl" title="Vista previa del archivo seleccionado"></iframe>
                                }
                                else
                                {
                                    <img class="ai-preview-image ai-preview-form-image" src="@VistaPreviaUrl" alt="Vista previa del archivo seleccionado" />
                                }
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(EstadoVerificacion))
                        {
                            <div class="ai-integrity @(ArchivoIntegro ? "integrity-ok" : "integrity-error")" role="status">
                                <svg class="ai-icon"><use href="@(ArchivoIntegro ? "#ico-check" : "#ico-alerta")" /></svg>
                                <span>@EstadoVerificacion</span>
                            </div>
                        }
                    </section>
                }
                else
                {
                    <section class="ai-form-step-panel" aria-labelledby="ai-step-title">
                        <div class="ai-step-heading">
                            <span>03</span>
                            <div><h3 id="ai-step-title">Revisión final</h3><p>Confirma los datos antes de guardar el documento.</p></div>
                        </div>
                        <dl class="ai-review-grid">
                            <div><dt>Tipo y estado</dt><dd>@Formulario.Tipo · @Formulario.Estado</dd></div>
                            <div><dt>Título</dt><dd>@(string.IsNullOrWhiteSpace(Formulario.Titulo) ? "Pendiente" : Formulario.Titulo)</dd></div>
                            <div><dt>Asociado</dt><dd>@(string.IsNullOrWhiteSpace(Formulario.NombreAsociado) ? "Institucional / no corresponde" : $"{Formulario.NombreAsociado} · CC {Formulario.CedulaAsociado}")</dd></div>
                            <div><dt>Fecha y referencia</dt><dd>@Formulario.Fecha.ToString("dd/MM/yyyy") · @(string.IsNullOrWhiteSpace(Formulario.NumeroReferencia) ? "Sin referencia" : Formulario.NumeroReferencia)</dd></div>
                            <div><dt>Vencimiento</dt><dd>@(Formulario.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "No aplica")</dd></div>
                            <div class="ai-review-wide"><dt>Descripción</dt><dd>@(string.IsNullOrWhiteSpace(Formulario.Descripcion) ? "Sin descripción adicional." : Formulario.Descripcion)</dd></div>
                            <div class="ai-review-wide"><dt>Archivo</dt><dd>@(ArchivoPendiente?.Nombre ?? (Editando ? DocumentoSeleccionado?.Archivo?.Nombre ?? "Sin archivo" : "Sin archivo seleccionado"))</dd></div>
                        </dl>
                    </section>
                }

                <div class="ai-form-actions">
                    <button type="button" class="ai-btn ai-btn-light ai-form-cancel" @onclick="CancelarFormulario">
                        <svg class="ai-icon"><use href="#ico-cerrar" /></svg>
                        Cancelar
                    </button>
                    <div class="ai-form-nav-actions">
                        @if (PasoFormulario > 1)
                        {
                            <button type="button" class="ai-btn ai-btn-light" @onclick="PasoAnteriorFormulario">Anterior</button>
                        }
                        @if (PasoFormulario < 3)
                        {
                            <button type="button" class="ai-btn ai-btn-primary ai-form-continue" @onclick="SiguientePasoFormulario">
                                Continuar
                                <svg class="ai-icon"><use href="#ico-flecha-derecha" /></svg>
                            </button>
                        }
                        else
                        {
                            <button type="submit" class="ai-btn ai-btn-primary ai-form-continue" disabled="@Guardando">
                                <svg class="ai-icon"><use href="@(Editando ? "#ico-guardar" : "#ico-check")" /></svg>
                                @(Guardando ? "Guardando…" : Editando ? "Guardar cambios" : "Registrar documento")
                            </button>
                        }
                    </div>
                </div>
            </EditForm>
        </section>
    }
</div>

@code {
    private const long MaximoArchivoBytes = 10 * 1024 * 1024;
    private static readonly string[] TiposDocumento =
    {
        "Acta de Asamblea",
        "Estatuto Actualizado",
        "Reglamento Interno",
        "Resolución Legal"
    };
    private static readonly string[] EstadosEditables =
    {
        EstadosDocumento.Vigente,
        EstadosDocumento.EnRevision,
        EstadosDocumento.Derogado
    };
    private static readonly string[] EstadosFiltro =
    {
        EstadosDocumento.Vigente,
        EstadosDocumento.EnRevision,
        EstadosDocumento.Derogado,
        EstadosDocumento.Anulado
    };
    private static readonly (int Numero, string Titulo, string Subtitulo)[] PasosFormulario =
    {
        (1, "Identificación", "Datos principales"),
        (2, "Archivo", "Descripción y vista previa"),
        (3, "Confirmación", "Revisar antes de guardar")
    };

    private string PestanaActiva = "lista";
    private int PasoFormulario = 1;
    private string Busqueda = string.Empty;
    private string FiltroTipo = string.Empty;
    private string FiltroEstado = string.Empty;
    private string OrdenColumna = "fecha";
    private bool OrdenAscendente;
    private string? MensajeExito;
    private string? MensajeError;
    private string? VistaPreviaUrl;
    private string? MimeVistaPrevia;
    private string? NombreArchivoVistaPrevia;
    private string? EstadoVerificacion;
    private string UsuarioActual = "Presidencia";
    private bool ArchivoIntegro;
    private bool Guardando;
    private bool Editando;
    private bool SolicitaMotivoAnulacion;
    private string MotivoAnulacion = string.Empty;
    private Guid? IdEnEdicion;
    private DocumentoInstitucional? DocumentoSeleccionado;
    private ArchivoAdjunto? ArchivoPendiente;
    private IReadOnlyList<EntradaAuditoria> HistorialSeleccionado = Array.Empty<EntradaAuditoria>();
    private IJSObjectReference? ModuloJavaScript;
    private FormularioDocumento Formulario = new();
    private IReadOnlyList<OpcionAsociado> AsociadosDisponibles = Array.Empty<OpcionAsociado>();
    private string BusquedaAsociado = string.Empty;
    private IReadOnlyList<OpcionAsociado> AsociadosFiltrados = Array.Empty<OpcionAsociado>();
    private bool MostrarSugerenciasAsociado;
    private int IndiceAsociadoActivo = -1;
    private string? IdAsociadoActivo => MostrarSugerenciasAsociado
        && IndiceAsociadoActivo >= 0
        && IndiceAsociadoActivo < AsociadosFiltrados.Count
            ? $"ai-asociado-opcion-{IndiceAsociadoActivo}"
            : null;

    private IReadOnlyList<DocumentoInstitucional> Documentos => DocumentoService.ObtenerTodos();

    protected override async Task OnInitializedAsync()
    {
        ActualizarAsociadosDisponibles();
        UsuarioActual = await ObtenerUsuarioActualAsync();
    }

    protected override void OnParametersSet()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/');
        PestanaActiva = ruta.Equals("actas-estatutos/registrar", StringComparison.OrdinalIgnoreCase)
            ? "formulario"
            : "lista";
    }

    private IReadOnlyList<DocumentoInstitucional> DocumentosFiltrados
    {
        get
        {
            var filtrados = Documentos.Where(documento =>
                (string.IsNullOrWhiteSpace(Busqueda)
                    || Contiene(documento.Titulo, Busqueda)
                    || Contiene(documento.Codigo, Busqueda)
                    || Contiene(documento.NumeroReferencia, Busqueda)
                    || Contiene(documento.Descripcion, Busqueda)
                    || Contiene(documento.NombreAsociado, Busqueda)
                    || Contiene(documento.CedulaAsociado, Busqueda)
                    || (documento.Archivo is not null && Contiene(documento.Archivo.Nombre, Busqueda)))
                && (string.IsNullOrWhiteSpace(FiltroTipo) || documento.Tipo == FiltroTipo)
                && (string.IsNullOrWhiteSpace(FiltroEstado) || documento.Estado == FiltroEstado))
                .ToList();

            return (OrdenColumna, OrdenAscendente) switch
            {
                ("titulo", true) => filtrados.OrderBy(documento => documento.Titulo, StringComparer.CurrentCultureIgnoreCase).ToList(),
                ("titulo", false) => filtrados.OrderByDescending(documento => documento.Titulo, StringComparer.CurrentCultureIgnoreCase).ToList(),
                ("estado", true) => filtrados.OrderBy(documento => documento.Estado, StringComparer.CurrentCultureIgnoreCase).ThenBy(documento => documento.Titulo).ToList(),
                ("estado", false) => filtrados.OrderByDescending(documento => documento.Estado, StringComparer.CurrentCultureIgnoreCase).ThenBy(documento => documento.Titulo).ToList(),
                ("fecha", true) => filtrados.OrderBy(documento => documento.Fecha).ThenBy(documento => documento.Titulo).ToList(),
                _ => filtrados.OrderByDescending(documento => documento.Fecha).ThenBy(documento => documento.Titulo).ToList()
            };
        }
    }

    private void CambiarOrden(string columna)
    {
        if (OrdenColumna == columna)
        {
            OrdenAscendente = !OrdenAscendente;
            return;
        }

        OrdenColumna = columna;
        OrdenAscendente = columna != "fecha";
    }

    private string AriaOrden(string columna) =>
        OrdenColumna != columna ? "none" : OrdenAscendente ? "ascending" : "descending";

    private string IndicadorOrden(string columna) =>
        OrdenColumna != columna ? "↕" : OrdenAscendente ? "↑" : "↓";

