    private async Task SeleccionarArchivoAsync(InputFileChangeEventArgs args)
    {
        MensajeError = null;
        EstadoVerificacion = null;
        ArchivoPendiente = null;
        Formulario.ArchivoNombre = Editando ? DocumentoSeleccionado?.Archivo?.Nombre ?? string.Empty : string.Empty;
        await LimpiarVistaPreviaAsync();
        var archivo = args.File;
        var extension = Path.GetExtension(archivo.Name).ToLowerInvariant();
        if (archivo.Size <= 0 || archivo.Size > MaximoArchivoBytes)
        {
            MensajeError = "El archivo está vacío o supera el límite de 10 MB.";
            await RestaurarVistaPreviaDeFichaAsync();
            return;
        }

        if (extension is not (".pdf" or ".png" or ".jpg" or ".jpeg"))
        {
            MensajeError = "Formato no permitido. Selecciona un archivo PDF, PNG o JPG.";
            await RestaurarVistaPreviaDeFichaAsync();
            return;
        }

        try
        {
            await using var stream = archivo.OpenReadStream(MaximoArchivoBytes);
            using var buffer = new MemoryStream((int)archivo.Size);
            await stream.CopyToAsync(buffer);
            var contenido = buffer.ToArray();
            var mime = ObtenerMime(extension);
            if (!CoincideContenido(extension, contenido))
            {
                MensajeError = "El contenido no coincide con la extensión del archivo. Selecciona un PDF, PNG o JPG válido.";
                await RestaurarVistaPreviaDeFichaAsync();
                return;
            }

            ArchivoPendiente = ArchivoAdjunto.Crear(Path.GetFileName(archivo.Name), mime, contenido);
            Formulario.ArchivoNombre = archivo.Name;
            await CrearVistaPreviaAsync(ArchivoPendiente);
        }
        catch (IOException)
        {
            MensajeError = "No fue posible leer el archivo seleccionado. Intenta seleccionarlo de nuevo.";
            await RestaurarVistaPreviaDeFichaAsync();
        }
        catch (InvalidOperationException)
        {
            MensajeError = "El archivo supera el límite de 10 MB.";
            await RestaurarVistaPreviaDeFichaAsync();
        }
    }

    private async Task RestaurarVistaPreviaDeFichaAsync()
    {
        if (Editando && DocumentoSeleccionado?.Archivo is not null)
        {
            await CrearVistaPreviaAsync(DocumentoSeleccionado.Archivo);
        }
    }

    private async Task CrearVistaPreviaAsync(ArchivoAdjunto archivo)
    {
        await LimpiarVistaPreviaAsync();
        ModuloJavaScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/actas-archivos.js");
        using var contenido = new MemoryStream(archivo.Contenido, writable: false);
        using var referencia = new DotNetStreamReference(contenido);
        VistaPreviaUrl = await ModuloJavaScript.InvokeAsync<string>("crearVista", referencia, archivo.TipoMime);
        MimeVistaPrevia = archivo.TipoMime;
        NombreArchivoVistaPrevia = archivo.Nombre;
    }

    private async Task LimpiarVistaPreviaAsync()
    {
        if (!string.IsNullOrWhiteSpace(VistaPreviaUrl) && ModuloJavaScript is not null)
        {
            await ModuloJavaScript.InvokeVoidAsync("liberarVista", VistaPreviaUrl);
        }

        VistaPreviaUrl = null;
        MimeVistaPrevia = null;
        NombreArchivoVistaPrevia = null;
    }

    private async Task QuitarArchivoPendienteAsync()
    {
        ArchivoPendiente = null;
        Formulario.ArchivoNombre = Editando ? DocumentoSeleccionado?.Archivo?.Nombre ?? string.Empty : string.Empty;
        EstadoVerificacion = null;
        await LimpiarVistaPreviaAsync();
        if (Editando && DocumentoSeleccionado?.Archivo is not null)
        {
            await CrearVistaPreviaAsync(DocumentoSeleccionado.Archivo);
        }
    }

    private async Task GuardarAsync()
    {
        if (PasoFormulario != 3)
        {
            return;
        }

        MensajeError = null;
        MensajeExito = null;

        if (!Editando && ArchivoPendiente is null)
        {
            MensajeError = "Selecciona y revisa un archivo antes de registrar el documento.";
            return;
        }

        if (Guardando)
        {
            return;
        }

        Guardando = true;
        try
        {
            var usuario = await ObtenerUsuarioActualAsync();
            var datos = new DatosDocumento(
                Formulario.Titulo.Trim(),
                Formulario.Tipo,
                Formulario.Estado,
                Formulario.Fecha,
                Formulario.NumeroReferencia.Trim(),
                Formulario.Descripcion.Trim(),
                Formulario.CedulaAsociado.Trim(),
                Formulario.NombreAsociado.Trim(),
                Formulario.FechaVencimiento);

            if (Editando && IdEnEdicion is Guid id)
            {
                var resultado = DocumentoService.Actualizar(id, datos, ArchivoPendiente, usuario);
                if (!resultado.Exitoso)
                {
                    MensajeError = resultado.Mensaje;
                    return;
                }

                MensajeExito = resultado.Cambios.Count == 0
                    ? resultado.Mensaje
                    : $"Ficha actualizada. {resultado.Cambios.Count} cambio(s) registrado(s) en la trazabilidad.";
                if (resultado.Cambios.Count > 0)
                {
                    var actualizado = DocumentoService.ObtenerPorId(id);
                    if (actualizado is not null)
                    {
                        PublicarNotificacionDocumento("Documento actualizado", actualizado);
                    }
                }
                await AbrirDetalleAsync(id);
            }
            else
            {
                var creado = DocumentoService.Crear(datos, ArchivoPendiente, usuario);
                MensajeExito = $"“{creado.Titulo}” quedó registrado con el código {creado.Codigo}.";
                PublicarNotificacionDocumento("Documento registrado", creado);
                await AbrirDetalleAsync(creado.Id);
            }

            Editando = false;
            IdEnEdicion = null;
            ArchivoPendiente = null;
            PestanaActiva = "lista";
            PasoFormulario = 1;
            Navigation.NavigateTo("/actas-estatutos/documentos");
        }
        catch (JSException)
        {
            MensajeError = "El documento se guardó, pero no se pudo actualizar la vista previa. Cierra la ficha y vuelve a abrirla.";
        }
        finally
        {
            Guardando = false;
        }
    }

    private void SiguientePasoFormulario()
    {
        MensajeError = null;

        if (PasoFormulario == 1
            && (string.IsNullOrWhiteSpace(Formulario.Tipo) || string.IsNullOrWhiteSpace(Formulario.Titulo)))
        {
            MensajeError = "Completa el tipo y el título del documento para continuar.";
            return;
        }

        if (PasoFormulario == 2 && !Editando && ArchivoPendiente is null)
        {
            MensajeError = "Selecciona el archivo del documento antes de continuar.";
            return;
        }

        if (PasoFormulario < 3)
        {
            PasoFormulario++;
        }
    }

    private void PasoAnteriorFormulario()
    {
        if (PasoFormulario > 1)
        {
            PasoFormulario--;
            MensajeError = null;
        }
    }

    private void FiltrarAsociados(ChangeEventArgs args)
    {
        BusquedaAsociado = args.Value?.ToString() ?? string.Empty;
        Formulario.CedulaAsociado = string.Empty;
        Formulario.NombreAsociado = string.Empty;
        MostrarSugerenciasAsociado = true;
        IndiceAsociadoActivo = 0;
        ActualizarOpcionesFiltradas();
    }

    private void AbrirSugerenciasAsociado()
    {
        MostrarSugerenciasAsociado = true;
        ActualizarOpcionesFiltradas();
        IndiceAsociadoActivo = AsociadosFiltrados.Count > 0 ? 0 : -1;
    }

    private void CerrarSugerenciasAsociado()
    {
        MostrarSugerenciasAsociado = false;
        IndiceAsociadoActivo = -1;
    }

    private void ManejarTeclaAsociado(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            CerrarSugerenciasAsociado();
            return;
        }

        if (args.Key is "ArrowDown" or "ArrowUp")
        {
            if (!MostrarSugerenciasAsociado)
            {
                AbrirSugerenciasAsociado();
            }

            if (AsociadosFiltrados.Count == 0)
            {
                return;
            }

            IndiceAsociadoActivo = args.Key == "ArrowDown"
                ? (IndiceAsociadoActivo + 1) % AsociadosFiltrados.Count
                : (IndiceAsociadoActivo <= 0 ? AsociadosFiltrados.Count - 1 : IndiceAsociadoActivo - 1);
            return;
        }

        if (args.Key == "Enter"
            && MostrarSugerenciasAsociado
            && IndiceAsociadoActivo >= 0
            && IndiceAsociadoActivo < AsociadosFiltrados.Count)
        {
            SeleccionarAsociado(AsociadosFiltrados[IndiceAsociadoActivo]);
        }
    }

    private void ActualizarOpcionesFiltradas()
    {
        var termino = BusquedaAsociado.Trim();
        AsociadosFiltrados = AsociadosDisponibles
            .Where(asociado => string.IsNullOrWhiteSpace(termino)
                || asociado.NombreCompleto.Contains(termino, StringComparison.OrdinalIgnoreCase)
                || asociado.Cedula.Contains(termino, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    private void SeleccionarAsociado(OpcionAsociado asociado)
    {
        Formulario.CedulaAsociado = asociado.Cedula;
        Formulario.NombreAsociado = asociado.NombreCompleto;
        BusquedaAsociado = $"{asociado.NombreCompleto} · CC {asociado.Cedula}";
        CerrarSugerenciasAsociado();
    }

    private void LimpiarAsociado()
    {
        Formulario.CedulaAsociado = string.Empty;
        Formulario.NombreAsociado = string.Empty;
        BusquedaAsociado = string.Empty;
        CerrarSugerenciasAsociado();
    }

    private void ActualizarAsociadosDisponibles()
    {
        var asociadosRegistrados = RegistroAsociados.ObtenerTodos()
            .Where(asociado => !string.IsNullOrWhiteSpace(asociado.NombreCompleto)
                && !string.IsNullOrWhiteSpace(asociado.Cedula))
            .Select(asociado => new OpcionAsociado(asociado.NombreCompleto, asociado.Cedula.Trim()));

        AsociadosDisponibles = asociadosRegistrados
            .GroupBy(asociado => asociado.Cedula, StringComparer.OrdinalIgnoreCase)
            .Select(grupo => grupo.First())
            .OrderBy(asociado => asociado.NombreCompleto)
            .ToList();
    }

    private void PublicarNotificacionDocumento(string accion, DocumentoInstitucional documento)
    {
        var relacionado = string.IsNullOrWhiteSpace(documento.NombreAsociado)
            ? "Documento institucional"
            : $"Asociado: {documento.NombreAsociado}";

        Notificaciones.Publicar(new Asoagro.Models.Notificacion
        {
            Titulo = accion,
            Descripcion = $"{documento.Titulo} · {relacionado} · por {ObtenerUsuarioActual()}.",
            Etiqueta = accion,
            Enlace = "/actas-estatutos/documentos",
            Icono = "doc",
            Categoria = Asoagro.Models.CategoriaNotificacion.Documentos,
            Nivel = Asoagro.Models.NivelNotificacion.Informativa,
            RolesDestino = new[] { "Presidenta", "Administrador", "Secretaria", "Tesorero" },
            RolesEnlace = new[] { "Presidenta" }
        });
    }

    private async Task CancelarFormulario()
    {
        Editando = false;
        IdEnEdicion = null;
        ArchivoPendiente = null;
        MensajeError = null;
        EstadoVerificacion = null;
        PasoFormulario = 1;
        PestanaActiva = "lista";
        Navigation.NavigateTo("/actas-estatutos/documentos");
        await LimpiarVistaPreviaAsync();
        if (DocumentoSeleccionado?.Archivo is not null)
