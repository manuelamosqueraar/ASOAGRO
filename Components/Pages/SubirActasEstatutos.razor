    private async Task LiberarScrollModalAsync()
    {
        if (ModuloJavaScript is not null)
        {
            await ModuloJavaScript.InvokeVoidAsync("bloquearScroll", false);
        }
    }

    private async Task ManejarTeclaModal(KeyboardEventArgs args)
    {
        if (DocumentoSeleccionado is not null && args.Key == "Escape")
        {
            await CerrarDetalle();
        }
    }

    private void LimpiarFiltros()
    {
        Busqueda = string.Empty;
        FiltroTipo = string.Empty;
        FiltroEstado = string.Empty;
    }

    private async Task<string> ObtenerUsuarioActualAsync()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        return estado.User.FindFirst(ClaimTypes.Email)?.Value
            ?? estado.User.Identity?.Name
            ?? "Presidencia";
    }

    private string ObtenerUsuarioActual() => UsuarioActual;

    private static bool Contiene(string? valor, string consulta) =>
        !string.IsNullOrEmpty(valor) && valor.Contains(consulta, StringComparison.OrdinalIgnoreCase);

    private static string ClaseEstado(string estado) => estado switch
    {
        EstadosDocumento.Vigente => "status-current",
        EstadosDocumento.EnRevision => "status-review",
        EstadosDocumento.Derogado => "status-repealed",
        EstadosDocumento.Anulado => "status-cancelled",
        _ => "status-review"
    };

    private static string ClaseTarjeta(string estado) => estado switch
    {
        EstadosDocumento.Vigente => "card-current",
        EstadosDocumento.EnRevision => "card-review",
        EstadosDocumento.Derogado => "card-repealed",
        EstadosDocumento.Anulado => "card-cancelled",
        _ => "card-current"
    };

    private static string IconoArchivo(string mime) => mime switch
    {
        "application/pdf" => "#ico-pdf",
        "image/png" or "image/jpeg" => "#ico-imagen",
        _ => "#ico-archivo"
    };

    private static string ObtenerMime(string extension) => extension switch
    {
        ".pdf" => "application/pdf",
        ".png" => "image/png",
        ".jpg" or ".jpeg" => "image/jpeg",
        _ => "application/octet-stream"
    };

    private static bool CoincideContenido(string extension, byte[] contenido) => extension switch
    {
        ".pdf" => contenido.Length >= 5 && contenido.AsSpan(0, 5).SequenceEqual("%PDF-"u8),
        ".png" => contenido.Length >= 8 && contenido.AsSpan(0, 8).SequenceEqual(new byte[] { 137, 80, 78, 71, 13, 10, 26, 10 }),
        ".jpg" or ".jpeg" => contenido.Length >= 3 && contenido[0] == 0xFF && contenido[1] == 0xD8 && contenido[2] == 0xFF,
        _ => false
    };

    private static string TamanoLegible(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024d:0.#} KB",
        _ => $"{bytes / (1024d * 1024):0.##} MB"
    };

    public async ValueTask DisposeAsync()
    {
        try
        {
            await LimpiarVistaPreviaAsync();
            await LiberarScrollModalAsync();
        }
        catch (JSDisconnectedException)
        {
        }

        if (ModuloJavaScript is not null)
        {
            try
            {
                await ModuloJavaScript.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private sealed class FormularioDocumento
    {
        [Required(ErrorMessage = "Selecciona el tipo de documento.")]
        public string Tipo { get; set; } = string.Empty;

        public string Estado { get; set; } = EstadosDocumento.Vigente;

        [Required(ErrorMessage = "Escribe el título del documento.")]
        [StringLength(160, ErrorMessage = "El título no puede superar 160 caracteres.")]
        public string Titulo { get; set; } = string.Empty;

        [Required(ErrorMessage = "Selecciona la fecha del documento.")]
        public DateTime Fecha { get; set; } = DateTime.Today;

        public DateTime? FechaVencimiento { get; set; }

        [StringLength(80, ErrorMessage = "La referencia no puede superar 80 caracteres.")]
        public string NumeroReferencia { get; set; } = string.Empty;

        [StringLength(2000, ErrorMessage = "La descripción no puede superar 2000 caracteres.")]
        public string Descripcion { get; set; } = string.Empty;

        public string CedulaAsociado { get; set; } = string.Empty;
        public string NombreAsociado { get; set; } = string.Empty;

        public string ArchivoNombre { get; set; } = string.Empty;
    }

    private sealed record OpcionAsociado(string NombreCompleto, string Cedula);
}
