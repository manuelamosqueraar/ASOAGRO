            : "La huella SHA-256 no coincide con el contenido del archivo.";
    }

    private void VerificarArchivoPendiente()
    {
        if (ArchivoPendiente is null)
        {
            MensajeError = "Selecciona un archivo antes de verificarlo.";
            return;
        }

        ArchivoIntegro = ArchivoPendiente.Verificar();
        EstadoVerificacion = ArchivoIntegro
            ? "Integridad comprobada: la huella SHA-256 coincide."
            : "La huella SHA-256 no coincide con el contenido del archivo.";
    }

    private void ActualizarDetalleSeleccionado()
    {
        if (DocumentoSeleccionado is null)
        {
            return;
