@page "/"
@using Microsoft.JSInterop

@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Inicio - Asoagro</PageTitle>

<HeadContent>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=Playfair+Display:ital,wght@1,400;1,600;1,700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />
</HeadContent>

<style>
    html, body { margin: 0 !important; padding: 0 !important; width: 100% !important; background-color: #0e2612 !important; overflow-x: hidden !important; }
    html { scroll-behavior: smooth; }
    .page, main, main > article.content { width: 100% !important; max-width: 100% !important; margin-left: 0 !important; margin-right: 0 !important; padding-left: 0 !important; padding-right: 0 !important; flex: 1 1 100% !important; }
</style>

<div class="ag-home eco-home">
    <div class="ag-progreso" data-progreso></div>

    <!-- ===== SPRITE GLOBAL DE ICONOS DEL HOME ===== -->
    <svg class="eco-sprite" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="eco-flecha-der" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
            <symbol id="eco-flecha-diag" viewBox="0 0 24 24"><path d="M7 17L17 7M9 7h8v8" /></symbol>
            <symbol id="eco-play" viewBox="0 0 24 24"><polygon points="8 5 19 12 8 19 8 5" fill="currentColor" stroke="none" /></symbol>
            <symbol id="gob-calendario" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4" /></symbol>
            <symbol id="gob-recibo" viewBox="0 0 24 24"><path d="M4 2v20l3-2 3 2 3-2 3 2 3-2 3 2V2l-3 2-3-2-3 2-3-2-3 2z" /><path d="M8 8h8M8 12h8M8 16h5" /></symbol>
            <symbol id="gob-red" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="18" r="2.5" /><circle cx="19" cy="18" r="2.5" /><path d="M12 7.5v4M12 11.5l-5 4M12 11.5l5 4" /></symbol>
            <symbol id="gob-mapa" viewBox="0 0 24 24"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2z" /><path d="M9 4v14M15 6v14" /></symbol>
            <symbol id="gob-grafico" viewBox="0 0 24 24"><path d="M3 3v18h18" /><path d="M7 15l4-4 3 3 5-6" /></symbol>
            <symbol id="gob-usuario" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></symbol>
            <symbol id="gob-izq" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6" /></symbol>
            <symbol id="gob-der" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6" /></symbol>
            <symbol id="art-check" viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" /></symbol>
            <symbol id="fin-carpeta" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M8 13l2.5 2.5L16 10" /></symbol>
            <symbol id="fin-doc" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><path d="M14 3v6h6M8 13h8M8 17h5" /></symbol>
            <symbol id="fin-reloj" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></symbol>
            <symbol id="fin-escudo" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></symbol>
        </defs>
    </svg>

    <!-- ===== 1. HERO (ESTILO LAWN BUSTER: ALINEADO A LA IZQUIERDA CON RATING, CHIPS Y SERIF ITÁLICA) ===== -->
    <section class="eco-hero">
        <div class="ag-capa">
            <video class="ag-hero-video" autoplay muted loop playsinline preload="auto" aria-hidden="true">
                <source src="/videos/hero-asoagro.mp4" type="video/mp4" />
            </video>
        </div>
        <div class="eco-hero-velo"></div>

        <div class="eco-contenedor eco-hero-inner">
            <!-- Columna Izquierda: Información, titular y botones -->
            <!-- Columna Izquierda: Información, titular y botones -->
            <div class="eco-hero-caja">
                <!-- Rating badge arriba -->
                <div class="eco-hero-rating ag-entra" style="--d: .1s;">
                    <div class="eco-rating-icono">
                        <span>FAAUA</span>
                    </div>
                    <div class="eco-rating-texto">
                        <div class="eco-rating-estrellas">
                            <span class="eco-estrella">★</span>
                            <span class="eco-estrella">★</span>
                            <span class="eco-estrella">★</span>
                            <span class="eco-estrella">★</span>
                            <span class="eco-estrella">★</span>
                            <strong>4.9</strong>
                        </div>
                        <small>98% de asociaciones al día</small>
                    </div>
                </div>

                <!-- Chips de categorías -->
                <div class="eco-hero-chips ag-entra" style="--d: .2s;">
                    <span class="eco-chip-hero">Gobernanza</span>
                    <span class="eco-chip-hero">Trazabilidad</span>
                    <span class="eco-chip-hero">Financiación</span>
                </div>

                <!-- Titular con la tipografía de la imagen -->
                <h1 class="eco-hero-titulo ag-entra" style="--d: .35s;">
                    Gestión y gobernanza<br />
                    del agro, <em class="eco-serif-italica">hecho</em><br />
                    <em class="eco-serif-italica">a tiempo</em>
                </h1>

                <p class="eco-hero-desc ag-entra" style="--d: .5s;">
                    Simplifica y articula cada aspecto de tus asociaciones de base, desde la administración, legalidad y estatutos hasta la gestión de asociados y el acceso a financiamiento en una plataforma integrada.
                </p>

                <div class="eco-hero-acciones ag-entra" style="--d: .65s;">
                    <a class="eco-btn-lb" href="/login">
                        <span>Pruebe ASOAGRO</span>
                        <span class="eco-btn-lb-flecha" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><use href="#eco-flecha-diag" /></svg>
                        </span>
                    </a>
                    <a class="eco-link-secundario" href="#gobernanza">
                        <span>Ver módulos</span>
                        <svg viewBox="0 0 24 24" class="eco-ico-diag"><use href="#eco-flecha-diag" /></svg>
                    </a>
                </div>
            </div>

            <!-- Bloque Inferior Derecho (como la tarjeta 2K+ Customers de la imagen) -->
            <div class="eco-hero-der ag-entra" style="--d: .7s;">
                <div class="eco-garantia-badge">
                    <svg viewBox="0 0 24 24" class="eco-garantia-ico"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                    <div>
                        <strong>100% Elegibilidad</strong>
                        <small>Estatutos y juntas al día en convocatorias</small>
                    </div>
                </div>

                <div class="eco-card-flotante">
                    <div class="eco-card-flotante-info">
                        <strong>37+</strong>
                        <span>Asociaciones</span>
                        <div class="eco-card-avatares">
                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=120&q=80" alt="" />
                            <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=120&q=80" alt="" />
                            <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=120&q=80" alt="" />
                        </div>
                    </div>
                    <button type="button" class="eco-card-miniatura" @onclick='() => NavegarA("historia/impacto")' aria-label="Ver video de impacto">
                        <img src="https://images.unsplash.com/photo-1592982537447-7440770cbfc9?auto=format&fit=crop&w=300&q=80" alt="" />
                        <span class="eco-mini-play"><svg viewBox="0 0 24 24"><use href="#eco-play" /></svg></span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== 2. FRANJA AMARILLA / MOSTAZA CON SELLO CENTRAL (COMO EN LA IMAGEN) ===== -->
    <section class="eco-banda" aria-label="Indicadores regionales de Asoagro">
        <div class="eco-contenedor eco-banda-grid">
            <!-- Izquierda: Avatares apilados + cifra de asociaciones y productores -->
            <div class="eco-banda-izq">
                <div class="eco-avatares" aria-hidden="true">
                    <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=160&q=80" alt="" />
                    <img src="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=160&q=80" alt="" />
                    <img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=160&q=80" alt="" />
                </div>
                <div class="eco-banda-txt-izq">
                    <strong>37+ Asociaciones de Base</strong>
                    <span>Articuladas en el Urabá Antioqueño</span>
                </div>
            </div>

            <!-- Centro: Sello circular con texto curvo y flecha diagonal verde -->
            <div class="eco-banda-centro">
                <a href="#gobernanza" class="eco-sello-circular" aria-label="Explorar gobernanza y módulos">
                    <svg class="eco-sello-anillo" viewBox="0 0 120 120" aria-hidden="true">
                        <defs>
                            <path id="eco-texto-curvo" d="M 60, 60 m -43, 0 a 43,43 0 1,1 86,0 a 43,43 0 1,1 -86,0" />
                        </defs>
                        <text>
                            <textPath href="#eco-texto-curvo" startOffset="0%">
                                • FEDERACIÓN FAAUA • AGRO URABÁ • GESTIÓN
                            </textPath>
                        </text>
                    </svg>
                    <span class="eco-sello-centro">
                        <svg viewBox="0 0 24 24"><use href="#eco-flecha-diag" /></svg>
                    </span>
                </a>
            </div>

            <!-- Derecha: Texto + miniatura de campo con botón de reproducción/acción -->
            <div class="eco-banda-der">
                <div class="eco-banda-txt-der">
                    <strong>Campo Conectado con</strong>
                    <span>Trazabilidad y Gobernanza</span>
                </div>
                <button type="button" class="eco-video-card" @onclick='() => NavegarA("historia/impacto")' aria-label="Explorar trazabilidad comercial">
                    <img src="https://images.unsplash.com/photo-1592982537447-7440770cbfc9?auto=format&fit=crop&w=400&q=80" alt="Productores del Urabá" />
                    <span class="eco-video-play" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><use href="#eco-play" /></svg>
                    </span>
                </button>
            </div>
        </div>

    </section>

    <!-- ===== 3. GOBERNANZA Y CUMPLIMIENTO (SECCIÓN BLANCA CON TARJETAS VERDES VERTICALES) ===== -->
    <section id="gobernanza" class="eco-servicios">
        <div class="eco-contenedor">
            <div class="eco-servicios-cab">
                <div class="eco-servicios-titulos">
                    <span class="eco-tag-claro">Nuestros Servicios</span>
                    <h2 class="eco-h2-oscuro">Control Oportuno de Obligaciones y Estatutos</h2>
                </div>

                <div class="eco-carrusel-botones" aria-label="Controles del carrusel">
                    <button type="button"
                            class="eco-nav-circulo"
                            aria-label="Pilar anterior"
                            onclick="const c = document.getElementById('carruselGobernanza'); if(c) c.scrollBy({ left: -380, behavior: 'smooth' });">
                        <svg viewBox="0 0 24 24"><use href="#gob-izq" /></svg>
                    </button>
                    <button type="button"
                            class="eco-nav-circulo"
                            aria-label="Pilar siguiente"
                            onclick="const c = document.getElementById('carruselGobernanza'); if(c) c.scrollBy({ left: 380, behavior: 'smooth' });">
                        <svg viewBox="0 0 24 24"><use href="#gob-der" /></svg>
                    </button>
                </div>
            </div>

            <div id="carruselGobernanza" class="eco-tarjetas-carrusel">
                <!-- Tarjeta 1 -->
                <article class="eco-card-verde">
                    <div class="eco-card-foto">
                        <img src="https://images.unsplash.com/photo-1592982537447-7440770cbfc9?auto=format&fit=crop&w=900&q=80" alt="Asambleas al Día" />
                    </div>
                    <div class="eco-card-cuerpo">
                        <span class="eco-card-pastilla">Componente Estatutario</span>
                        <h3 class="eco-card-titulo">Asambleas al Día</h3>
                        <p class="eco-card-texto">
                            Control de fechas límite para la renovación de juntas directivas, actas y quórum estatutario.
                        </p>
                    </div>
                </article>

                <!-- Tarjeta 2 -->
                <article class="eco-card-verde">
                    <div class="eco-card-foto">
                        <img src="https://images.unsplash.com/photo-1574943320219-553eb213f72d?auto=format&fit=crop&w=900&q=80" alt="Obligaciones Tributarias" />
                    </div>
                    <div class="eco-card-cuerpo">
                        <span class="eco-card-pastilla">Componente Fiscal</span>
                        <h3 class="eco-card-titulo">Obligaciones Tributarias</h3>
                        <p class="eco-card-texto">
                            Monitoreo oportuno de obligaciones fiscales y declaraciones tributarias para evitar sanciones.
                        </p>
                    </div>
                </article>

                <!-- Tarjeta 3 -->
                <article class="eco-card-verde">
                    <div class="eco-card-foto">
                        <img src="https://images.unsplash.com/photo-1500595046743-cd271d694d30?auto=format&fit=crop&w=900&q=80" alt="Gobernanza Interna" />
                    </div>
                    <div class="eco-card-cuerpo">
                        <span class="eco-card-pastilla">Red de Asociaciones</span>
                        <h3 class="eco-card-titulo">Gobernanza Interna</h3>
                        <p class="eco-card-texto">
                            Articulación continua entre la directiva central de FAAUA y las 37 asociaciones de base.
                        </p>
                    </div>
                </article>

                <!-- Tarjeta 4 -->
                <article class="eco-card-verde">
                    <div class="eco-card-foto">
                        <img src="https://images.unsplash.com/photo-1500937386664-56d1dfef3854?auto=format&fit=crop&w=900&q=80" alt="Gestión de Activos y Fincas" />
                    </div>
                    <div class="eco-card-cuerpo">
                        <span class="eco-card-pastilla">Inventario Regional</span>
                        <h3 class="eco-card-titulo">Gestión de Activos y Fincas</h3>
                        <p class="eco-card-texto">
                            Inventario de predios, maquinaria e infraestructura productiva adjudicada a cada asociación.
                        </p>
                    </div>
                </article>

                <!-- Tarjeta 5 -->
                <article class="eco-card-verde">
                    <div class="eco-card-foto">
                        <img src="https://images.unsplash.com/photo-1586771107445-d3ca888129ff?auto=format&fit=crop&w=900&q=80" alt="Auditoría y Reportes" />
                    </div>
                    <div class="eco-card-cuerpo">
                        <span class="eco-card-pastilla">Transparencia</span>
                        <h3 class="eco-card-titulo">Auditoría y Reportes</h3>
                        <p class="eco-card-texto">
                            Informes de gestión y tableros de control listos para entidades aliadas y cooperantes.
                        </p>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- ===== 4. ARTICULACIÓN INTERASOCIATIVA (INVERTIDO: TEXTO IZQUIERDA, FOTOS DERECHA, BOTÓN CENTRADO) ===== -->
    <section class="art eco-articulacion">
        <div class="eco-contenedor">
            <div class="art-grid">

                <!-- Columna Izquierda: Contenido, tabla de dos columnas y botón amarillo centrado -->
                <div class="art-texto-col">
                    <h2 class="art-titulo">
                        Gestión Unificada de las <br />
                        <span class="art-titulo-acento">Asociaciones de Base</span>
                    </h2>

                    <p class="art-descripcion">
                        Resolvemos la desarticulación administrativa conectando los registros de productores, fincas y juntas directivas en un único directorio federado y confiable para toda la subregión.
                    </p>

                    <!-- Tabla / Caja de características de 2 columnas estilo referencia -->
                    <div class="art-tabla-caracteristicas">
                        <div class="art-caracteristica-item">
                            <div class="art-caract-icono">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="5" fill="currentColor" /><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
                            </div>
                            <div class="art-caract-info">
                                <strong>Directorio Centralizado</strong>
                                <p>Unificamos productores, predios y juntas locales en un registro verificado.</p>
                            </div>
                        </div>

                        <div class="art-caracteristica-item">
                            <div class="art-caract-icono">
                                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" /><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" /></svg>
                            </div>
                            <div class="art-caract-info">
                                <strong>Gobernanza y Control</strong>
                                <p>Seguimiento continuo a estatutos para garantizar elegibilidad en convocatorias.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Botón CTA amarillo centrado -->
                    <div class="art-acciones">
                        <button type="button" class="art-btn-amarillo" @onclick='() => NavegarA("historia/origenes")'>
                            <span>Conocer Orígenes</span>
                            <svg viewBox="0 0 24 24" class="art-btn-flecha"><path d="M7 17L17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        </button>
                    </div>
                </div>

                <!-- Columna Derecha: Composición fotográfica con badge flotante amarillo -->
                <div class="art-fotos-col">
                    <div class="art-marco-decorativo" aria-hidden="true"></div>

                    <!-- Foto principal de cultivo -->
                    <div class="art-foto-principal">
                        <img src="https://images.unsplash.com/photo-1625246333195-78d9c38ad449?auto=format&fit=crop&w=900&q=80" alt="Cultivos agropecuarios en hileras" />
                    </div>

                    <!-- Foto secundaria superpuesta de cultivo -->
                    <div class="art-foto-secundaria">
                        <img src="https://images.unsplash.com/photo-1574943320219-553eb213f72d?auto=format&fit=crop&w=700&q=80" alt="Plantación y brotes verdes de cultivo" />
                    </div>

                    <!-- Badge flotante amarillo -->
                    <div class="art-badge-experiencia">
                        <strong class="art-badge-cifra">37+</strong>
                        <span class="art-badge-rotulo">Asociaciones de Base Federadas</span>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- ===== 5. TRAZABILIDAD COMERCIAL (BANNER FOTOGRÁFICO CON PÍLDORA Y BOTÓN ECOLAND) ===== -->
    <section class="eco-traza">
        <div class="ag-capa" data-parallax="0.3">
            <div class="parallax-bg img-trazabilidad"></div>
        </div>
        <div class="eco-traza-velo"></div>

        <div class="eco-contenedor eco-traza-inner">
            <div class="eco-traza-caja" data-reveal>
                <h2 class="eco-h2-claro"><strong>Trazabilidad Comercial en Cadenas Productivas</strong></h2>
                <p class="eco-sub-claro">
                    Implementamos un sistema de monitoreo riguroso en los predios de plátano, banano, cacao y ganadería de la región para impulsar la inocuidad alimentaria y conectar a los productores rurales con los más altos estándares de los mercados nacionales e internacionales.
                </p>
                <div class="eco-traza-chips">
                    <span>Plátano</span>
                    <span>Banano</span>
                    <span>Cacao</span>
                    <span>Ganadería</span>
                    <span>Entre otros</span>
                </div>
                <div>
                    <button type="button" class="eco-btn eco-btn-amarillo" @onclick='() => NavegarA("historia/impacto")'>
                        <span>Explorar Trazabilidad</span>
                        <span class="eco-btn-circulo eco-btn-circulo-oscuro" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><use href="#eco-flecha-der" /></svg>
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== 6. FINANCIACIÓN (DISTRIBUCIÓN MODERNA TIPO AGRICULTURE FEATURES EN ESTILO ASOAGRO) ===== -->
    <section class="fin eco-fin" id="financiacion">
        <div class="eco-contenedor">
            <div class="fin-layout">

                <!-- FILA SUPERIOR: TEXTO DE CABECERA + FOTO PRINCIPAL -->
                <div class="fin-fila-superior">
                    <div class="fin-texto fin-rev">
                        <h2 class="eco-h2-oscuro">Acceso Oportuno a <em class="eco-serif-italica eco-subrayado-amarillo">Fuentes de Financiación</em></h2>
                        <p class="eco-sub-oscuro">
                            Evitamos que las asociaciones pierdan oportunidades de recursos externos por falta de registros listos o documentación desactualizada en convocatorias.
                        </p>
                        <div class="fin-cta-wrap">
                            <button type="button" class="eco-btn eco-btn-verde" @onclick='() => NavegarA("financiacion")'>
                                <span>Revisar elegibilidad</span>
                                <span class="eco-btn-circulo" aria-hidden="true">
                                    <svg viewBox="0 0 24 24"><use href="#eco-flecha-der" /></svg>
                                </span>
                            </button>
                        </div>
                    </div>

                    <!-- Foto principal superior derecha -->
                    <div class="fin-media-principal fin-rev fin-r2">
                        <div class="fin-foto-wrap">
                            <img src="https://images.unsplash.com/photo-1592982537447-7440770cbfc9?auto=format&fit=crop&w=1200&q=80"
                                 alt="Productores agropecuarios analizando cultivos y convocatorias de financiación"
                                 loading="lazy" />
                            <div class="fin-foto-badge">
                                <span class="fin-badge-punto"></span>
