@page "/"

<PageTitle>Inicio - Asoagro</PageTitle>

<section class="hero-panel mb-4">
    <div>
        <p class="eyebrow">Panel administrativo</p>
        <h1>Gestión confiable de productores y documentos agrícolas.</h1>
        <p class="hero-copy">
            Centraliza el registro de asociados, consulta productores y da seguimiento a documentos próximos a vencer.
        </p>
        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-success btn-lg" href="registrar-asociado">Registrar asociado</a>
            <a class="btn btn-outline-success btn-lg" href="consultar-asociados">Consultar registros</a>
        </div>
    </div>
    <div class="hero-card">
        <span class="hero-number">3</span>
        <span class="text-muted">módulos base</span>
        <strong>Asociados, documentos y alertas.</strong>
    </div>
</section>

<div class="row g-3">
    <div class="col-md-4">
        <div class="metric-card">
            <span>01</span>
            <h2>Registro</h2>
            <p>Captura datos básicos del productor y evita cédulas duplicadas.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <span>02</span>
            <h2>Consulta</h2>
            <p>Busca asociados por nombre o documento desde una tabla responsive.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="metric-card">
            <span>03</span>
            <h2>Alertas</h2>
            <p>Visualiza documentos próximos a vencer con estados por prioridad.</p>
        </div>
    </div>
</div>
