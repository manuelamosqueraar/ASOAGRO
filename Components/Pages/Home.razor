@page "/"
@inject NavigationManager Navigation

<PageTitle>Inicio - Asoagro </PageTitle>

<div class="home-container-fluid">    
 
    <!-- SECCIÓN 1: HERO PRINCIPAL (Con Imagen Renovada y Transición de Entrada) --> 
    <section class="hero-section hero-image position-relative d-flex align-items-center justify-content-center text-white text-center">
        <div class="parallax-bg img-hero-1"></div>
        <div class="overlay"></div>

        <div class="container position-relative z-2 px-3 animate-fade-in">
            <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-bold mb-3 tracking-wider text-uppercase extra-small shadow-sm">
                  Sistema de Gestión Agrícola • Asoagro FAAUA
            </span>
            <h1 class="display-3 fw-bold mb-4 text-white text-shadow font-heading">
                La Plataforma Líder de Gestión y Gobernanza para el Agro del Urabá
            </h1>
            <p class="lead mb-5 mx-auto text-light opacity-90 text-shadow-sm font-sans" style="max-width: 800px; font-size: 1.15rem;">
                Simplifica y articula cada aspecto de tus asociaciones de base, desde la administración, legalidad y gobernanza hasta la gestión de asociados y el acceso a financiamiento, todo centralizado en una sola plataforma integrada.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <button class="btn btn-success btn-lg px-5 py-3 rounded-pill shadow fw-bold hover-scale" @onclick='() => NavegarA("registrar-asociado")'>
                    Registrar Asociado
                </button>
                <button class="btn btn-outline-light btn-lg px-5 py-3 rounded-pill shadow-sm fw-bold hover-scale" @onclick='() => NavegarA("consultar-asociados")'>
                    Consultar Registros
                </button>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 2: PADRÓN E INTEGRACIÓN (Fondo Plano Corporativo con Transición al Scroll) -->
    <section class="hero-section hero-flat-bg d-flex align-items-center justify-content-center text-dark text-center">
        <div class="container px-3 scroll-reveal">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold mb-3 tracking-wider text-uppercase extra-small">
                Articulación Interasociativa
            </span>
            <h2 class="display-4 fw-bold mb-4 text-dark font-heading">
                Gestión Unificada de las Asociaciones de Base
            </h2>
            <p class="lead mb-5 mx-auto text-secondary font-sans" style="max-width: 750px; font-size: 1.1rem;">
                Resolvemos la desarticulación administrativa conectando los registros de productores, fincas y juntas directivas en un único directorio federado y confiable.
            </p>
            <div>
                <button class="btn btn-success btn-lg px-5 py-3 rounded-pill shadow fw-bold hover-scale font-heading" @onclick='() => NavegarA("historia/origenes")'>
                    Conocer Orígenes
                </button>
            </div>
        </div>
    </section>

<!-- SECCIÓN 3: GOBERNANZA Y CUMPLIMIENTO -->
<section class="d-flex align-items-center justify-content-center text-white py-5" style="background-color: #051f10; min-height: 100vh; width: 100%;">
    <div class="container px-3 py-4">
        <div class="text-center mb-5">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold mb-2 tracking-wider text-uppercase extra-small">
                Gobernanza y Legalidad
            </span>
            <h2 class="display-5 fw-bold text-white font-heading">Control Oportuno de Obligaciones y Estatutos</h2>
            <p class="text-light font-sans mt-2" style="opacity: 0.85;">Pilares fundamentales para mantener la elegibilidad de las asociaciones.</p>
        </div>

        <div class="row g-4 justify-content-center align-items-stretch">
            <!-- Tarjeta 1 -->
            <div class="col-md-4">
                <div class="card hover-card h-100 border-0">
                    <div class="icon-box rounded-3 p-3 shadow-sm mb-3" style="background-color: rgba(201, 233, 121, 0.15);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#c9e979" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold text-white font-heading mb-3">Asambleas al Día</h3>
                    <p class="text-light small font-sans mb-0" style="opacity: 0.8; line-height: 1.6;">Seguimiento automatizado de las fechas de renovación de juntas directivas y actas estatutarias.</p>
                </div>
            </div> 

            <!-- Tarjeta 2 -->
            <div class="col-md-4">
                <div class="card hover-card h-100 border-0">
                    <div class="icon-box rounded-3 p-3 shadow-sm mb-3" style="background-color: rgba(201, 233, 121, 0.15);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#c9e979" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold text-white font-heading mb-3">Obligaciones Tributarias</h3>
                    <p class="text-light small font-sans mb-0" style="opacity: 0.8; line-height: 1.6;">Control preventivo de requisitos fiscales para evitar la pérdida de beneficios gremiales.</p>
                </div>
            </div>

            <!-- Tarjeta 3 -->
            <div class="col-md-4">
                <div class="card hover-card h-100 border-0">
                    <div class="icon-box rounded-3 p-3 shadow-sm mb-3" style="background-color: rgba(201, 233, 121, 0.15);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#c9e979" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                        </svg>
                    </div>
                    <h3 class="h5 fw-bold text-white font-heading mb-3">Gobernanza Interna</h3>
                    <p class="text-light small font-sans mb-0" style="opacity: 0.8; line-height: 1.6;">Articulación directa entre la FAAUA y las juntas locales de las 37 asociaciones de base.</p>
                </div>
            </div>
        </div>
    </div>
</section>
    <!-- SECCIÓN 4: TRAZABILIDAD Y BPA (Con Imagen de Fondo Fullscreen) -->
    <section class="hero-section hero-image position-relative d-flex align-items-center justify-content-center text-white text-center">
        <div class="parallax-bg img-trazabilidad"></div>
        <div class="overlay"></div>

        <div class="container position-relative z-2 px-3 scroll-reveal">
            <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-bold mb-3 tracking-wider text-uppercase extra-small shadow-sm">
                Impacto Agrícola
            </span>
            <h2 class="display-4 fw-bold mb-4 text-white text-shadow font-heading">
                Trazabilidad Comercial en Cadenas Productivas
            </h2>
            <p class="lead mb-5 mx-auto text-light opacity-95 text-shadow-sm font-sans" style="max-width: 750px; font-size: 1.1rem;">
                Monitoreo detallado de predios en líneas de plátano, banano, cacao y ganadería, impulsando la adopción de normativas de inocuidad alimentaria.
            </p>
            <div>
                <button class="btn btn-light text-success btn-lg px-5 py-3 rounded-pill shadow fw-bold hover-scale font-heading" @onclick='() => NavegarA("historia/impacto")'>
                    Explorar Trazabilidad
                </button>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 5: ELEGIBILIDAD PARA FINANCIACIÓN (Fondo Plano Corporativo) -->
    <section class="hero-section hero-flat-bg d-flex align-items-center justify-content-center text-dark text-center">
        <div class="container px-3 scroll-reveal">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold mb-3 tracking-wider text-uppercase extra-small">
                Núcleo Estratégico
            </span>
            <h2 class="display-4 fw-bold mb-4 text-dark font-heading">
                Acceso Oportuno a Fuentes de Financiación
            </h2>
            <p class="lead mb-5 mx-auto text-secondary font-sans" style="max-width: 750px; font-size: 1.1rem;">
                Evitamos que las asociaciones pierdan oportunidades de recursos externos por falta de registros listos o documentación desactualizada en convocatorias.
            </p>
            <div>
                <button class="btn btn-success btn-lg px-5 py-3 rounded-pill shadow fw-bold hover-scale font-heading" @onclick='() => NavegarA("consultar-asociados")'>
                    Revisar Elegibilidad
                </button>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 6: ALERTAS Y VENCIMIENTOS (Con Imagen de Fondo Fullscreen) -->
    <section class="hero-section hero-image position-relative d-flex align-items-center justify-content-center text-white text-center">
        <div class="parallax-bg img-alertas"></div>
        <div class="overlay"></div>

        <div class="container position-relative z-2 px-3 scroll-reveal">
            <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-bold mb-3 tracking-wider text-uppercase extra-small shadow-sm">
                Gestión Preventiva
            </span>
            <h2 class="display-4 fw-bold mb-4 text-white text-shadow font-heading">
                Anticipación Inteligente de Vencimientos
            </h2>
            <p class="lead mb-5 mx-auto text-light opacity-95 text-shadow-sm font-sans" style="max-width: 750px; font-size: 1.1rem;">
                Sistema automatizado de alertas prioritarias para que la Dirección Ejecutiva y Tesorería actúen antes de que caduquen los documentos críticos.
            </p>
            <div>
                <button class="btn btn-light text-success btn-lg px-5 py-3 rounded-pill shadow fw-bold hover-scale font-heading" @onclick='() => NavegarA("alertas-documentos")'>
                    Ver Panel de Alertas
                </button>
            </div>
        </div>
    </section>

    <!-- SECCIÓN 7: CIERRE INSTITUCIONAL (Fondo Plano Corporativo) -->
    <section class="hero-section hero-flat-bg d-flex align-items-center justify-content-center text-dark text-center">
        <div class="container px-3 scroll-reveal">
            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold mb-3 tracking-wider text-uppercase extra-small">
                Compromiso Regional
            </span>
            <h2 class="display-4 fw-bold mb-4 text-dark font-heading">
                Impulsando el Bienestar de las Familias Productoras
            </h2>
            <p class="lead mb-5 mx-auto text-secondary font-sans" style="max-width: 750px; font-size: 1.1rem;">
                Únete a la plataforma que está transformando la administración agropecuaria en el Urabá Antioqueño bajo los estándares de la FAAUA.
            </p>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                <button class="btn btn-success btn-lg px-5 py-3 rounded-pill shadow fw-bold hover-scale font-heading" @onclick='() => NavegarA("registrar-asociado")'>
                    Empezar Ahora
                </button>
            </div>
        </div>
    </section>

</div>

@code {
    private void NavegarA(string ruta)
    {
        Navigation.NavigateTo(ruta);
    }
}