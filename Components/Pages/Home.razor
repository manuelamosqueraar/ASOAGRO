@code {
    private IJSObjectReference? _modulo;

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender) return;
        try
        {
            _modulo = await JS.InvokeAsync<IJSObjectReference>("import", "/js/asoagro-home.js");
            await _modulo.InvokeVoidAsync("iniciar");
        }
        catch (JSException)
        { 
            // Si el script no carga, la página se ve completa, solo sin animaciones.
        }
    }

    

    private void NavegarA(string ruta) => Navigation.NavigateTo(ruta);
}