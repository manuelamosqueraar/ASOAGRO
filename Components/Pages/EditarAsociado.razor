@page "/editar-asociado"
@page "/editar-asociado/{Cedula}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Secretaria,Secretaría,Presidenta,Presidente,Administrador,Admin")]
@rendermode InteractiveServer
@using System.Security.Claims
@using Asoagro.Models
@using Asoagro.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject NavigationManager NavManager
@inject IAsociadoService RegistroAsociados
@inject IDocumentoAsociacionService DocumentoService
@inject NotificacionService Notificaciones
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Asoagro - Actualización de Expediente</PageTitle>

<div class="ea">
    <!-- ENCABEZADO HERO INSTITUCIONAL ASOAGRO -->
    <div class="aso-hero-card card border-0 rounded-4 shadow-sm overflow-hidden mb-3">
        <div class="card-body position-relative">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="aso-hero-icon-box">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20h9"></path>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="aso-hero-kicker">Padrón de Productores · FAAUA</span>
                            <span class="text-white-50" style="font-size: 0.75rem; font-weight: 600;">Urabá Antioqueño</span>
                        </div>
                        <h2 class="aso-hero-title">@TituloEncabezado</h2>
                        <p class="aso-hero-desc">@DescripcionEncabezado</p>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(Cedula))
                    {
                        <a href="/editar-asociado" class="aso-btn-hero-secondary">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                            <span>Volver al listado</span>
                        </a>
                    }
                    <a href="/registrar-asociado" class="aso-btn-hero-primary">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                        <span>Registrar productor</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ALERTAS VISUALES -->
    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="ea-alerta @(esError ? "ea-alerta-error" : "ea-alerta-exito")" role="alert">
            <span class="ea-alerta-ico">
                <svg class="ea-ico"><use href="#@(esError ? "ico-alerta" : "ico-check")" /></svg>
            </span>
            <div class="ea-alerta-texto">
                <strong>@(esError ? "Verificación requerida" : "Actualización exitosa")</strong>
                <span>@mensajeAlerta</span>
            </div>
            <button type="button" class="ea-alerta-cerrar" @onclick='() => mensajeAlerta = ""' aria-label="Cerrar">&times;</button>
        </div>
    }

    @if (string.IsNullOrWhiteSpace(Cedula))
    {
        <!-- FRANJA EJECUTIVA DE INDICADORES DEL PADRÓN -->
        <div class="aso-kpi-grid">
            <div class="aso-kpi-card kpi-emerald">
                <div class="aso-kpi-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                </div>
                <div class="aso-kpi-meta">
                    <span class="aso-kpi-label">Padrón Activo</span>
                    <strong class="aso-kpi-value">@ProductoresCompletos.Count</strong>
                    <span class="aso-kpi-sub">Expedientes disponibles para edición</span>
                </div>
            </div>

            <div class="aso-kpi-card kpi-sky">
                <div class="aso-kpi-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
                </div>
                <div class="aso-kpi-meta">
                    <span class="aso-kpi-label">Con Asociación Base</span>
                    <strong class="aso-kpi-value">@ProductoresCompletos.Count(p => !string.IsNullOrWhiteSpace(p.AsociacionPertenece))</strong>
                    <span class="aso-kpi-sub">Vinculados a entidad federada</span>
                </div>
            </div>

            <div class="aso-kpi-card kpi-amber">
                <div class="aso-kpi-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
                </div>
                <div class="aso-kpi-meta">
                    <span class="aso-kpi-label">Certificación BPA</span>
                    <strong class="aso-kpi-value">@ProductoresCompletos.Count(p => p.TieneBPA)</strong>
                    <span class="aso-kpi-sub">Predios con BPA vigente</span>
                </div>
            </div>

            <div class="aso-kpi-card kpi-rose">
                <div class="aso-kpi-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </div>
                <div class="aso-kpi-meta">
                    <span class="aso-kpi-label">Sin Asociación</span>
                    <strong class="aso-kpi-value">@ProductoresCompletos.Count(p => string.IsNullOrWhiteSpace(p.AsociacionPertenece))</strong>
                    <span class="aso-kpi-sub">Pendientes de vinculación</span>
                </div>
            </div>
        </div>

        <!-- MODO 1: SELECTOR DE PRODUCTOR EN TABLA EJECUTIVA ALINEADA (/editar-asociado) -->
        <div class="aso-filter-workbench">
            <div class="aso-filter-top-row" style="margin-bottom: 0; padding-bottom: 0; border-bottom: none;">
                <div class="aso-search-wrap">
                    <span class="aso-search-icon">
                        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                    </span>
                    <input type="text" class="aso-search-input"
                           placeholder="Buscar productor por nombre completo, número de cédula, cultivo principal, municipio o vereda..."
                           @bind="textoBusqueda" @bind:event="oninput" />
                    @if (!string.IsNullOrWhiteSpace(textoBusqueda))
                    {
                        <button type="button" class="aso-search-clear" @onclick='() => textoBusqueda = ""' title="Limpiar búsqueda">
                            &times;
                        </button>
                    }
                </div>

                <div class="d-flex align-items-center gap-2">
                    <span class="aso-table-count-pill">
                        @ProductoresFiltrados.Count() de @ProductoresCompletos.Count productores
                    </span>
                </div>
            </div>
        </div>

        <div class="aso-table-card">
            <div class="aso-table-header-bar">
                <div class="aso-table-header-title">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#15803d" stroke-width="2.2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
                    <span>Directorio de Productores para Edición de Expediente</span>
                    <span class="aso-table-count-pill">@ProductoresFiltrados.Count() registros</span>
                </div>
                <span class="text-muted" style="font-size: 0.78rem; font-weight: 500;">Seleccione un productor para actualizar sus datos personales, predio o línea productiva</span>
            </div>

            @if (ProductoresFiltrados.Any())
            {
                <div class="aso-table-wrap">
                    <table class="table aso-table-grid align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col" class="text-start" style="min-width: 220px; width: 24%;">Productor</th>
                                <th scope="col" class="text-start" style="min-width: 110px; width: 12%;">Identificación</th>
                                <th scope="col" class="text-start" style="min-width: 180px; width: 20%;">Asociación Base</th>
                                <th scope="col" class="text-start" style="min-width: 130px; width: 14%;">Municipio / Predio</th>
                                <th scope="col" class="text-start" style="min-width: 115px; width: 11%;">Cultivo Principal</th>
                                <th scope="col" class="text-center" style="min-width: 80px; width: 7%;">BPA</th>
                                <th scope="col" class="text-end" style="min-width: 145px; width: 12%;">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var p in ProductoresFiltrados)
                            {
                                <tr>
                                    <!-- Productor: Avatar + Nombre + Estado social -->
                                    <td class="text-start">
                                        <div class="d-flex align-items-center gap-2.5">
                                            <div class="d-flex align-items-center justify-content-center text-white fw-bold shadow-xs flex-shrink-0"
                                                 style="width: 40px; height: 40px; min-width: 40px; border-radius: 11px; background: linear-gradient(135deg, #0b2e1c 0%, #1e7043 100%); font-size: 0.82rem; border: 1px solid rgba(185, 231, 122, 0.35);">
                                                @ObtenerIniciales(p.NombreCompleto)
                                            </div>
                                            <div class="flex-grow-1" style="min-width: 0;">
                                                <a href="@($"/editar-asociado/{p.Cedula}")" class="fw-bold text-dark text-decoration-none d-block text-truncate"
                                                   style="font-size: 0.88rem;" title="Abrir y editar expediente de @p.NombreCompleto">
                                                    @p.NombreCompleto
                                                </a>
                                                <small class="text-muted d-block" style="font-size: 0.74rem;">
                                                    @(p.GruposVulnerables.Count > 0 ? $"{p.GruposVulnerables.Count} cond. social(es)" : (p.EsVictima == "Si" ? "Víctima" : "Padrón general"))
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- Identificación -->
                                    <td class="text-start">
                                        <span class="font-monospace fw-bold text-secondary" style="font-size: 0.84rem;">CC @p.Cedula</span>
                                    </td>

                                    <!-- Asociación Base -->
                                    <td class="text-start">
                                        @if (!string.IsNullOrWhiteSpace(p.AsociacionPertenece))
                                        {
                                            <span class="badge bg-white text-dark border fw-semibold px-2.5 py-1 text-truncate d-inline-block"
                                                  style="max-width: 220px; font-size: 0.74rem; border-color: #dce4d8 !important; color: #17603a !important;"
                                                  title="@p.AsociacionPertenece">
                                                @p.AsociacionPertenece
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="aso-badge-pendiente">
                                                Pendiente
                                            </span>
                                        }
                                    </td>

                                    <!-- Municipio / Predio -->
                                    <td class="text-start">
                                        <div class="d-flex flex-column" style="line-height: 1.25;">
                                            <strong class="text-dark" style="font-size: 0.84rem;">@p.Municipio</strong>
                                            <small class="text-muted" style="font-size: 0.73rem;">@p.NombrePredio (@p.HectareasPredio.ToString("0.#") ha)</small>
                                        </div>
                                    </td>

                                    <!-- Cultivo Principal -->
                                    <td class="text-start">
                                        <span class="fw-semibold text-success" style="font-size: 0.82rem;">
                                            @AsociadoModel.FormatearNombreCultivo(p.CultivoPrincipal)
                                        </span>
                                    </td>

                                    <!-- BPA -->
                                    <td class="text-center">
                                        @if (p.TieneBPA)
                                        {
                                            <span class="aso-badge-activa">
                                                Vigente
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="aso-badge-neutro">
                                                Sin BPA
                                            </span>
                                        }
                                    </td>

                                    <!-- Acción: Botón Editar claramente identificable -->
                                    <td class="text-end">
                                        <div class="aso-actions-group">
                                            <a href="@($"/editar-asociado/{p.Cedula}")"
                                               class="aso-btn-action aso-btn-action-primary"
                                               title="Abrir y editar expediente de @p.NombreCompleto">
                                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                                                <span>Editar expediente</span>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-5 text-center">
                    <i class="bi bi-person-x text-muted" style="font-size: 3rem;"></i>
                    <h5 class="fw-bold text-dark mt-3">No se encontraron productores</h5>
                    <p class="text-muted small mb-3">
                        @(string.IsNullOrWhiteSpace(textoBusqueda)
                            ? "Aún no hay asociados registrados en el padrón."
                            : $"No se encontraron coincidencias para '{textoBusqueda}'. Pruebe con otro nombre o cédula.")
                    </p>
                    <a href="/registrar-asociado" class="btn btn-success rounded-pill px-4 py-1.5 fw-bold" style="background-color: #17603a;">
                        <i class="bi bi-plus-circle me-1"></i> Registrar nuevo productor
                    </a>
                </div>
            }
        </div>
    }
    else if (!encontrado || asociadoActual is null)
    {
        <section class="ea-vacio">
            <span class="ea-vacio-ico"><svg class="ea-ico"><use href="#ico-alerta" /></svg></span>
            <h3>No encontramos este expediente</h3>
            <p>La cédula <strong>@Cedula</strong> no se encuentra registrada actualmente.</p>
            <a class="ea-btn ea-btn-secundario" href="/editar-asociado">
                <span>Volver al selector de productores</span>
            </a>
        </section>
    }
    else
    {
        <!-- MODO 2: EDICIÓN INTEGRAL DEL EXPEDIENTE (/editar-asociado/{Cedula}) -->
        <div class="ea-barra-navegacion">
            <a href="/editar-asociado" class="ea-btn ea-btn-secundario">
                <svg class="ea-ico ea-ico-izquierda"><use href="#ico-flecha" /></svg>
                <span>Cambiar productor</span>
            </a>
            <a href="/consultar-asociados" class="ea-btn ea-btn-secundario">
                <svg class="ea-ico"><use href="#ico-lista" /></svg>
                <span>Ir al directorio general</span>
            </a>
        </div>

        <div class="ea-secciones-grid">
            <!-- SECCIÓN 1: IDENTIFICACIÓN -->
            <section class="ea-panel">
                <header class="ea-seccion-cab">
                    <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-usuario" /></svg></span>
                    <div>
                        <span class="ea-kicker">Sección 1 · Titularidad</span>
                        <h2>Datos Personales y Contacto</h2>
                    </div>
                </header>

                <div class="ea-campos-grid">
                    <div class="ea-campo ea-ancho-total">
                        <label class="ea-label">Nombre completo <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" @bind="asociadoActual.NombreCompleto" />
                    </div>
                    <div class="ea-campo ea-ancho-total">
                        <label class="ea-label">Asociación a la que pertenece <span class="ea-req">*</span></label>
                        <select class="ea-input" @bind="asociadoActual.AsociacionPertenece">
                            @if (string.IsNullOrWhiteSpace(asociadoActual.AsociacionPertenece))
                            {
                                <option value="" selected>⚠️ Pendiente de asignar (Seleccionar asociación obligatoria)</option>
                            }
                            else
                            {
                                <option value="">-- Seleccionar asociación registrada --</option>
                            }
                            @foreach (var asoc in listaAsociacionesRegistradas)
                            {
                                <option value="@asoc">@asoc</option>
                            }
                        </select>
                    </div>
                    <div class="ea-campo">
                        <label class="ea-label">Cédula / NIT <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" @bind="asociadoActual.Cedula" />
                        <div class="ea-bpa-der" style="margin-top:0.5rem; justify-content:flex-start; flex-wrap:wrap; gap:0.45rem;">
                            @if (!string.IsNullOrWhiteSpace(asociadoActual.CedulaArchivoNombre))
                            {
                                <div class="ea-archivo-pildora">
                                    <svg class="ea-ico"><use href="#ico-check" /></svg>
                                    <span title="@asociadoActual.CedulaArchivoNombre">@asociadoActual.CedulaArchivoNombre</span>
                                </div>
                                <button type="button"
                                        class="ea-btn ea-btn-ver"
                                        @onclick='() => AbrirVisor("Fotocopia de la cédula o NIT", asociadoActual.CedulaArchivoNombre, asociadoActual.CedulaArchivoUrl)'>
                                    <svg class="ea-ico"><use href="#ico-doc" /></svg>
                                    <span>Ver</span>
                                </button>
                            }
                            <label class="ea-btn ea-btn-adjuntar">
                                <InputFile OnChange="CargarFotocopiaCedula"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           style="display:none !important; position:absolute; width:0; height:0; opacity:0; pointer-events:none;" />
                                <svg class="ea-ico"><use href="#ico-doc" /></svg>
                                <span>@(string.IsNullOrWhiteSpace(asociadoActual.CedulaArchivoNombre) ? "Adjuntar fotocopia de cédula o NIT" : "Cambiar")</span>
                            </label>
                        </div>
                    </div>
                    <div class="ea-campo">
                        <label class="ea-label">Teléfono celular <span class="ea-req">*</span></label>
                        <input type="tel" class="ea-input" @bind="asociadoActual.Telefono" />
                    </div>
                    <div class="ea-campo ea-ancho-total">
                        <label class="ea-label">Correo electrónico</label>
                        <input type="email" class="ea-input" @bind="asociadoActual.Correo" />
                    </div>
                </div>
            </section>

            <!-- SECCIÓN 2: PREDIO Y MEMBRESÍA -->
            <section class="ea-panel">
                <header class="ea-seccion-cab">
                    <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-mapa" /></svg></span>
                    <div>
                        <span class="ea-kicker">Sección 2 · Georreferenciación</span>
                        <h2>Predio Rural y Estado</h2>
                    </div>
                </header>

                <div class="ea-campos-grid">
                    <div class="ea-campo">
                        <label class="ea-label">Nombre del predio <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" @bind="asociadoActual.NombrePredio" />
                    </div>
                    <div class="ea-campo">
                        <label class="ea-label">Vereda o sector <span class="ea-req">*</span></label>
                        <input type="text" class="ea-input" @bind="asociadoActual.VeredaSector" />
                    </div>
                    <div class="ea-campo">
                        <label class="ea-label">Municipio <span class="ea-req">*</span></label>
                        <select class="ea-input" @bind="asociadoActual.Municipio">
                            <option value="">Seleccione...</option>
                            <option value="Apartado">Apartadó</option>
                            <option value="Turbo">Turbo</option>
                            <option value="Carepa">Carepa</option>
                            <option value="Chigorodo">Chigorodó</option>
                            <option value="Mutata">Mutatá</option>
                            <option value="Necocli">Necoclí</option>
                            <option value="San Pedro de Uraba">San Pedro de Urabá</option>
                        </select>
                    </div>
                    <div class="ea-campo">
                        <label class="ea-label">Área total del predio (ha) <span class="ea-req">*</span></label>
                        <input type="number" step="0.1" min="0.1" class="ea-input" @bind="asociadoActual.HectareasPredio" />
                    </div>
                    <div class="ea-campo">
                        <label class="ea-label">Tenencia del terreno <span class="ea-req">*</span></label>
                        <select class="ea-input" @bind="asociadoActual.TenenciaTerreno">
                            <option value="">Seleccione...</option>
                            @foreach (var opcion in AsociadoModel.OpcionesTenenciaTerreno)
                            {
                                <option value="@opcion">@opcion</option>
                            }
                        </select>
                    </div>
                    <div class="ea-campo">
                        <label class="ea-label">Estado de membresía</label>
                        <select class="ea-input" @bind="asociadoActual.EstadoMembresia">
                            <option value="AlDia">Activo · Al día</option>
                            <option value="Pendiente">En revisión · Período de gracia</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                    </div>
                </div>
            </section>

            <!-- SECCIÓN 3: LÍNEA PRODUCTIVA, HECTÁREAS Y BPA -->
            <section class="ea-panel ea-span-total">
                <header class="ea-seccion-cab">
                    <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-brote" /></svg></span>
                    <div>
                        <span class="ea-kicker">Sección 3 · Caracterización Agropecuaria</span>
                        <h2>Línea Productiva (Selección Múltiple), Hectáreas y Certificado BPA</h2>
                    </div>
                </header>

                <div class="ea-campos-grid">
                    <div class="ea-campo">
                        <label class="ea-label">Lista desplegable de cultivos (Selección múltiple) <span class="ea-req">*</span></label>
                        <button type="button"
                                class="ea-desplegable-btn"
                                @onclick="() => desplegableAbierto = !desplegableAbierto">
                            <span class="ea-desplegable-texto">
                                @(asociadoActual.CultivosSeleccionados.Count == 0
                                    ? "Seleccione uno o varios cultivos..."
                                    : string.Join(", ", asociadoActual.CultivosSeleccionados.Select(AsociadoModel.TraducirCodigoCultivo)))
                            </span>
                            <span class="ea-desplegable-pill">@(desplegableAbierto ? "Cerrar" : "Desplegar")</span>
                        </button>

                        @if (desplegableAbierto)
                        {
                            <div class="ea-desplegable-lista">
                                @foreach (var cultivo in AsociadoModel.CatalogoCultivos)
                                {
                                    var marcado = EstaCultivoSeleccionado(cultivo.Codigo);
                                    <div class="ea-opcion-item @(marcado ? "activo" : "")"
                                         @onclick="() => AlternarCultivo(cultivo.Codigo)">
                                        <span class="ea-casilla @(marcado ? "activa" : "")">
                                            @if (marcado)
                                            {
                                                <svg class="ea-ico"><use href="#ico-check" /></svg>
                                            }
                                        </span>
                                        <div class="ea-opcion-info">
                                            <strong>@cultivo.Nombre</strong>
                                            <small>@cultivo.Subtitulo</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (asociadoActual.CultivosSeleccionados.Count > 0)
                        {
                            <div class="ea-chips-fila">
                                @foreach (var c in asociadoActual.CultivosSeleccionados)
                                {
                                    <span class="ea-chip">
                                        <span>@AsociadoModel.TraducirCodigoCultivo(c)</span>
                                        <button type="button" @onclick="() => AlternarCultivo(c)">&times;</button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="ea-campo">
                        <label class="ea-label">Hectáreas de la línea productiva <span class="ea-req">*</span></label>
                        <input type="number"
                               step="0.1"
                               min="0.1"
                               class="ea-input"
                               @bind="asociadoActual.HectareasLineaProductiva" />
                        <small class="ea-ayuda">Hectáreas dedicadas a la línea productiva (Área total del predio: @asociadoActual.HectareasPredio.ToString("0.#") ha).</small>
                    </div>

                    <div class="ea-campo">
                        <label class="ea-label">Actividad productiva <span class="ea-req">*</span></label>
                        <select class="ea-input" @bind="asociadoActual.TipoActividadProductiva">
                            <option value="">Seleccione...</option>
                            @foreach (var actividad in AsociadoModel.OpcionesTipoActividad)
                            {
                                <option value="@actividad">@actividad</option>
                            }
                        </select>
                    </div>

                    <div class="ea-campo">
                        <label class="ea-label">Producción aproximada <span class="ea-req">*</span></label>
                        <input type="text"
                               class="ea-input"
                               placeholder="Ej. 15 toneladas/año, 120 racimos/mes..."
                               @bind="asociadoActual.ProduccionAproximada" />
                    </div>
                </div>

                <div class="ea-bpa-bloque @(asociadoActual.TieneBPA ? "activo" : "")">
                    <div class="ea-bpa-izq">
                        <div class="ea-bpa-check" @onclick="AlternarBpa">
                            <span class="ea-casilla @(asociadoActual.TieneBPA ? "activa" : "")">
                                @if (asociadoActual.TieneBPA)
                                {
                                    <svg class="ea-ico"><use href="#ico-check" /></svg>
                                }
                            </span>
                            <div>
                                <strong>Cuenta con Buenas Prácticas Agrícolas (BPA)</strong>
                                <small>Active esta opción para anexar o actualizar el certificado digital BPA.</small>
                            </div>
                        </div>
                    </div>

                    @if (asociadoActual.TieneBPA)
                    {
                        <div class="ea-bpa-der">
                            @if (!string.IsNullOrWhiteSpace(asociadoActual.CertificadoBpaNombre))
                            {
                                <div class="ea-archivo-pildora">
                                    <svg class="ea-ico"><use href="#ico-check" /></svg>
                                    <span title="@asociadoActual.CertificadoBpaNombre">@asociadoActual.CertificadoBpaNombre</span>
                                </div>
                                <button type="button"
                                        class="ea-btn ea-btn-ver"
                                        @onclick='() => AbrirVisor("Certificado BPA", asociadoActual.CertificadoBpaNombre, asociadoActual.CertificadoBpaUrl)'>
                                    <svg class="ea-ico"><use href="#ico-doc" /></svg>
                                    <span>Ver</span>
                                </button>
                            }
                            <label class="ea-btn ea-btn-adjuntar">
                                <InputFile OnChange="CargarCertificadoBpa"
                                           accept=".pdf,.jpg,.jpeg,.png"
                                           style="display:none !important; position:absolute; width:0; height:0; opacity:0; pointer-events:none;" />
                                <svg class="ea-ico"><use href="#ico-doc" /></svg>
                                <span>@(string.IsNullOrWhiteSpace(asociadoActual.CertificadoBpaNombre) ? "Adjuntar certificado" : "Cambiar")</span>
                            </label>
                        </div>
                    }
                </div>
            </section>

            <!-- SECCIÓN 4: COMPONENTE SOCIAL Y SOPORTES AL FRENTE -->
            <section class="ea-panel ea-span-total">
                <header class="ea-seccion-cab">
                    <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-red" /></svg></span>
                    <div>
                        <span class="ea-kicker">Sección 4 · Componente Social y Jurídico</span>
                        <h2>Grupos Vulnerables en Colombia y Documentos Soporte</h2>
                    </div>
                </header>

                <div class="ea-vulnerables-lista">
                    @foreach (var grupo in AsociadoModel.CatalogoGruposVulnerables)
                    {
                        var marcado = EstaGrupoSeleccionado(grupo.Codigo);
                        var archivo = ObtenerArchivoSoporte(grupo.Codigo);

                        <div class="ea-vulnerable-fila @(marcado ? "seleccionada" : "")">
                            <div class="ea-vulnerable-izq" @onclick="() => AlternarGrupoVulnerable(grupo.Codigo)">
                                <span class="ea-casilla @(marcado ? "activa" : "")">
                                    @if (marcado)
                                    {
                                        <svg class="ea-ico"><use href="#ico-check" /></svg>
                                    }
                                </span>
                                <div class="ea-vulnerable-texto">
                                    <strong>@grupo.Nombre</strong>
                                    <small>@grupo.Subtitulo · Soporte: @grupo.DocumentoSugerido</small>
                                </div>
                            </div>

                            <div class="ea-vulnerable-der">
                                @if (marcado)
                                {
                                    @if (!string.IsNullOrWhiteSpace(archivo))
                                    {
                                        <div class="ea-archivo-pildora">
                                            <svg class="ea-ico"><use href="#ico-check" /></svg>
                                            <span title="@archivo">@archivo</span>
                                        </div>
                                        <button type="button"
                                                class="ea-btn ea-btn-ver"
                                                @onclick="() => AbrirVisor(grupo.Nombre, archivo, ObtenerUrlSoporte(grupo.Codigo))">
                                            <svg class="ea-ico"><use href="#ico-doc" /></svg>
                                            <span>Ver</span>
                                        </button>
                                    }
                                    <label class="ea-btn ea-btn-adjuntar">
                                        <InputFile OnChange="@(e => CargarSoporteGrupo(grupo.Codigo, e))"
                                                   accept=".pdf,.jpg,.jpeg,.png"
                                                   style="display:none !important; position:absolute; width:0; height:0; opacity:0; pointer-events:none;" />
                                        <svg class="ea-ico"><use href="#ico-doc" /></svg>
                                        <span>@(string.IsNullOrWhiteSpace(archivo) ? "Adjuntar soporte" : "Cambiar")</span>
                                    </label>
                                }
                                else
                                {
                                    <span class="ea-nota-inactiva">No aplica</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- SECCIÓN 5: CUOTAS SOCIALES Y APORTES -->
            <section class="ea-panel ea-span-total">
                <header class="ea-seccion-cab">
                    <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-doc" /></svg></span>
                    <div>
                        <span class="ea-kicker">Sección 5 · Obligaciones Económicas</span>
                        <h2>Cuotas Sociales, Aportes y Comprobantes</h2>
                    </div>
                </header>

                <div class="ea-campos-grid" style="margin-bottom: 1rem;">
                    <div class="ea-campo">
                        <label class="ea-label">Total pagado acumulado</label>
                        <input type="text" class="ea-input" readonly value="$@asociadoActual.ValorTotalPagadoAcumulado.ToString("N0")" />
                    </div>
                    <div class="ea-campo">
                        <label class="ea-label">Total pendiente acumulado</label>
                        <input type="text" class="ea-input" readonly value="$@asociadoActual.ValorTotalPendienteAcumulado.ToString("N0") (@asociadoActual.TotalCuotasPendientes cuota(s))" />
                    </div>
                </div>

                <div class="ea-cuotas-lista">
                    @foreach (var cuota in asociadoActual.CuotasAportes)
                    {
                        var estadoCuota = cuota.CalcularEstadoAutomatico();
                        <div class="ea-cuota-card" @key="cuota.Id">
                            <div class="ea-cuota-card-cab">
                                <div class="ea-cuota-card-titulo">
                                    <strong>Cuota / Aporte: @cuota.TipoCuota (@cuota.Periodicidad)</strong>
                                </div>
                                <div class="ea-cuota-card-acciones">
                                    <span class="ea-cuota-pill @ObtenerClaseEstadoCuota(estadoCuota)">@estadoCuota</span>
                                    @if (asociadoActual.CuotasAportes.Count > 1)
                                    {
                                        <button type="button" class="ea-btn-quitar" @onclick="() => EliminarCuotaEdicion(cuota.Id)" title="Eliminar este registro de cuota">
                                            <span>Quitar cuota</span>
                                        </button>
                                    }
                                </div>
                            </div>

                            <!-- Grupo 1: Tipo de cuota, Periodicidad, Valor y Fecha -->
                            <div class="ea-cuota-bloque-campos">
                                <span class="ea-cuota-subtitulo">Definición y programación de la cuota</span>
                                <div class="ea-cuotas-grid-4">
                                    <div class="ea-campo">
                                        <label class="ea-label">Tipo de cuota o aporte <span class="ea-req">*</span></label>
                                        <select class="ea-input" @bind="cuota.TipoCuota" @bind:after="cuota.ActualizarEstadoYSoportes">
                                            @foreach (var tipo in AsociadoModel.OpcionesTipoCuota)
                                            {
                                                <option value="@tipo">@tipo</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="ea-campo">
                                        <label class="ea-label">Periodicidad <span class="ea-req">*</span></label>
                                        <select class="ea-input" @bind="cuota.Periodicidad" @bind:after="cuota.ActualizarEstadoYSoportes">
                                            @foreach (var per in AsociadoModel.OpcionesPeriodicidadCuota)
                                            {
                                                <option value="@per">@per</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="ea-campo">
                                        <label class="ea-label">Valor de la cuota ($) <span class="ea-req">*</span></label>
                                        <input type="number" min="0" step="1000" class="ea-input" @bind="cuota.ValorCuota" @bind:after="cuota.RecalcularAutomaticamente" />
                                    </div>
                                    <div class="ea-campo">
                                        <label class="ea-label">Fecha de vencimiento / próximo pago <span class="ea-req">*</span></label>
                                        <input type="date" class="ea-input" @bind="cuota.FechaVencimiento" @bind:after="cuota.ActualizarEstadoYSoportes" />
                                    </div>
                                </div>
                            </div>

                            <!-- Grupo 2: Valores pendientes, pagados y el estado -->
                            <div class="ea-cuota-bloque-campos">
                                <span class="ea-cuota-subtitulo">Estado de cuenta y saldos registrados</span>
                                <div class="ea-cuotas-grid-4">
                                    <div class="ea-campo">
                                        <label class="ea-label">Cantidad de cuotas pendientes</label>
                                        <input type="number" min="0" step="1" class="ea-input" @bind="cuota.CantidadCuotasPendientes" @bind:after="cuota.RecalcularAutomaticamente" />
                                    </div>
                                    <div class="ea-campo">
                                        <label class="ea-label">Valor total pendiente (calculado)</label>
                                        <input type="number" min="0" step="1000" class="ea-input" @bind="cuota.ValorTotalPendiente" @bind:after="cuota.ActualizarEstadoYSoportes" />
                                    </div>
                                    <div class="ea-campo">
                                        <label class="ea-label">Valor total pagado ($)</label>
                                        <input type="number" min="0" step="1000" class="ea-input" @bind="cuota.ValorTotalPagado" @bind:after="() => { cuota.PagadoEditadoManualmente = true; cuota.ActualizarEstadoYSoportes(); }" />
                                    </div>
                                    <div class="ea-campo">
                                        <label class="ea-label">Estado de pago</label>
                                        <input type="text" class="ea-input ea-input-readonly-estado" readonly value="@estadoCuota" />
                                    </div>
                                </div>
                            </div>

                            <!-- Comprobante obligatorio de la cuota -->
                            <div class="ea-cuota-soporte-seccion">
                                <div class="ea-cuota-soporte-cab">
                                    <label class="ea-label" style="margin-bottom: 0;">
                                        Documento / comprobante obligatorio de @cuota.TipoCuota <span class="ea-req">*</span>
                                    </label>
                                </div>
                                <div class="ea-cuota-soporte-fila">
                                    @foreach (var sop in cuota.Soportes)
                                    {
                                        <div class="ea-soporte-item-grupo">
                                            <div class="ea-archivo-pildora" title="@sop.ArchivoNombre">
                                                <svg class="ea-ico"><use href="#ico-check" /></svg>
                                                <span>@sop.ArchivoNombre</span>
                                            </div>
                                            <button type="button"
                                                    class="ea-btn ea-btn-ver"
                                                    @onclick='() => AbrirVisor($"Comprobante de {cuota.TipoCuota}", sop.ArchivoNombre, sop.ArchivoUrl)'
                                                    title="Previsualizar comprobante">
                                                <svg class="ea-ico"><use href="#ico-doc" /></svg>
                                                <span>Ver</span>
                                            </button>
                                        </div>
                                    }
                                    <label class="ea-btn ea-btn-adjuntar">
                                        <InputFile OnChange="@(e => CargarSoporteCuotaEdicion(cuota, e))"
                                                   multiple
                                                   accept=".pdf,.jpg,.jpeg,.png"
                                                   style="display:none !important; position:absolute; width:0; height:0; opacity:0; pointer-events:none;" />
                                        <svg class="ea-ico"><use href="#ico-doc" /></svg>
                                        <span>+ Adjuntar comprobante de @cuota.TipoCuota</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div style="margin-top: 0.85rem;">
                    <button type="button" class="ea-btn ea-btn-secundario" @onclick="AgregarCuotaEdicion">
                        <span>+ Agregar otra cuota o aporte</span>
                    </button>
                </div>

                <footer class="ea-acciones">
                    <a href="/consultar-asociados" class="ea-btn ea-btn-secundario">
                        <span>Cancelar</span>
                    </a>
                    <button type="button" class="ea-btn ea-btn-primario" @onclick="GuardarCambios">
                        <svg class="ea-ico"><use href="#ico-check" /></svg>
                        <span>Guardar Cambios del Expediente</span>
                    </button>
                </footer>
            </section>
        </div>
    }

    @if (mostrarVisor)
    {
        <div class="ea-modal-velo" role="dialog" aria-modal="true" @onclick="() => mostrarVisor = false">
            <div class="ea-visor-modal" @onclick:stopPropagation="true">
                <header class="ea-visor-cab">
                    <div>
                        <span class="ea-visor-kicker">@visorCategoria</span>
                        <h3>@visorNombre</h3>
                    </div>
                    <button type="button" class="ea-visor-cerrar" @onclick="() => mostrarVisor = false">&times;</button>
                </header>
                <div class="ea-visor-cuerpo">
                    @if (!string.IsNullOrWhiteSpace(visorUrl))
                    {
                        @if (visorUrl.StartsWith("data:image/", StringComparison.OrdinalIgnoreCase))
                        {
                            <img src="@visorUrl" alt="@visorNombre" class="ea-visor-img" />
                        }
                        else
                        {
                            <iframe src="@visorUrl" class="ea-visor-iframe" title="@visorNombre"></iframe>
                        }
                    }
                    else
                    {
                        <div class="ea-visor-resumen">
                            <span class="ea-visor-sello">SOPORTE REGISTRADO EN EXPEDIENTE</span>
                            <h4>@visorCategoria</h4>
                            <p>@visorNombre</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string? Cedula { get; set; }

    private List<AsociadoModel> ProductoresCompletos = new();
    private List<string> listaAsociacionesRegistradas = new();
    private bool esAdminSupervisor;
    private AsociadoModel? asociadoActual;
    private string? cedulaCargada;
    private string textoBusqueda = string.Empty;
    private string mensajeAlerta = string.Empty;
    private bool esError;
    private bool encontrado;
    private bool desplegableAbierto;
    private bool mostrarVisor;
    private string visorCategoria = string.Empty;
    private string visorNombre = string.Empty;
    private string visorUrl = string.Empty;

    private string TituloEncabezado =>
        string.IsNullOrWhiteSpace(Cedula)
            ? "Actualización de Expedientes de Asociados"
            : encontrado && asociadoActual is not null
                ? asociadoActual.NombreCompleto
                : "Expediente no encontrado";

    private string DescripcionEncabezado =>
        string.IsNullOrWhiteSpace(Cedula)
            ? "Seleccione un productor del padrón para actualizar sus cultivos, hectáreas productivas, certificado BPA y soportes sociales."
            : encontrado && asociadoActual is not null
                ? $"Edición integral del expediente CC {asociadoActual.Cedula} · Predio {asociadoActual.NombrePredio}."
                : "Verifique la cédula consultada o regrese al listado general.";

    private IEnumerable<AsociadoModel> ProductoresFiltrados =>
        ProductoresCompletos.Where(p =>
            string.IsNullOrWhiteSpace(textoBusqueda) ||
            p.NombreCompleto.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            p.Cedula.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            p.VeredaSector.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            p.AsociacionPertenece.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            AsociadoModel.FormatearNombreCultivo(p.CultivoPrincipal).Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        listaAsociacionesRegistradas = DocumentoService.ObtenerAsociaciones().ToList();
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        esAdminSupervisor = auth.User.IsInRole("Administrador") || auth.User.IsInRole("Admin");
        CargarProductores();
    }

    protected override void OnParametersSet()
    {
        if (cedulaCargada == Cedula) return;
        cedulaCargada = Cedula;
        mensajeAlerta = string.Empty;
        esError = false;
        desplegableAbierto = false;

        CargarProductores();

        if (string.IsNullOrWhiteSpace(Cedula))
        {
            asociadoActual = null;
            encontrado = false;
            return;
        }

        var prod = ProductoresCompletos.FirstOrDefault(
            a => string.Equals(a.Cedula, Cedula, StringComparison.OrdinalIgnoreCase));

        encontrado = prod is not null;
        if (prod is not null)
        {
            asociadoActual = prod;
            asociadoActual.SincronizarListaDesdeCultivoPrincipal();
            if (asociadoActual.HectareasLineaProductiva <= 0 && asociadoActual.HectareasPredio > 0)
            {
                asociadoActual.HectareasLineaProductiva = asociadoActual.HectareasPredio;
            }
        }
    }

    private void CargarProductores()
    {
        ProductoresCompletos = RegistroAsociados.ObtenerTodos()
            .Select(AsociadoMapper.ToModel)
            .Where(a => !string.IsNullOrWhiteSpace(a.NombreCompleto)
                     && !string.IsNullOrWhiteSpace(a.Cedula))
            .ToList();
    }

    private bool EstaCultivoSeleccionado(string codigo) =>
        asociadoActual?.CultivosSeleccionados.Any(c => string.Equals(c, codigo, StringComparison.OrdinalIgnoreCase)) == true;

    private void AlternarCultivo(string codigo)
    {
        if (asociadoActual is null) return;

        if (EstaCultivoSeleccionado(codigo))
        {
            asociadoActual.CultivosSeleccionados.RemoveAll(c => string.Equals(c, codigo, StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            asociadoActual.CultivosSeleccionados.Add(codigo);
        }

        asociadoActual.SincronizarCultivosDesdeLista();
    }

    private void AlternarBpa()
    {
        if (asociadoActual is null) return;
        asociadoActual.TieneBPA = !asociadoActual.TieneBPA;
    }

    private async Task CargarFotocopiaCedula(InputFileChangeEventArgs e)
    {
        if (asociadoActual is null || e.File is null) return;
        asociadoActual.CedulaArchivoNombre = e.File.Name;
        var kb = Math.Max(1, e.File.Size / 1024.0);
        asociadoActual.CedulaArchivoTamano = kb >= 1024 ? $"{kb / 1024.0:0.0} MB" : $"{kb:0} KB";
        asociadoActual.CedulaArchivoUrl = await LeerArchivoDataUrlAsync(e.File);
    }

    private async Task CargarCertificadoBpa(InputFileChangeEventArgs e)
    {
        if (asociadoActual is null || e.File is null) return;
        asociadoActual.TieneBPA = true;
        asociadoActual.CertificadoBpaNombre = e.File.Name;
        asociadoActual.CertificadoBpaUrl = await LeerArchivoDataUrlAsync(e.File);
    }

    private bool EstaGrupoSeleccionado(string codigo) =>
        asociadoActual?.GruposVulnerables.Any(g => string.Equals(g, codigo, StringComparison.OrdinalIgnoreCase)) == true;

    private void AlternarGrupoVulnerable(string codigo)
    {
        if (asociadoActual is null) return;

        if (EstaGrupoSeleccionado(codigo))
        {
            asociadoActual.GruposVulnerables.RemoveAll(g => string.Equals(g, codigo, StringComparison.OrdinalIgnoreCase));
            asociadoActual.SoportesGruposVulnerables.Remove(codigo);
            asociadoActual.SoportesGruposUrls.Remove(codigo);
        }
        else
        {
            asociadoActual.GruposVulnerables.Add(codigo);
        }

        asociadoActual.EsVictima = asociadoActual.GruposVulnerables.Count > 0 ? "Si" : "No";
    }

    private string ObtenerArchivoSoporte(string codigo) =>
        asociadoActual is not null && asociadoActual.SoportesGruposVulnerables.TryGetValue(codigo, out var archivo)
            ? archivo
            : string.Empty;

    private string ObtenerUrlSoporte(string codigo) =>
        asociadoActual is not null && asociadoActual.SoportesGruposUrls.TryGetValue(codigo, out var url)
            ? url
            : string.Empty;

    private async Task CargarSoporteGrupo(string codigo, InputFileChangeEventArgs e)
    {
        if (asociadoActual is null || e.File is null) return;

        if (!EstaGrupoSeleccionado(codigo))
        {
            asociadoActual.GruposVulnerables.Add(codigo);
        }

        asociadoActual.SoportesGruposVulnerables[codigo] = e.File.Name;
        asociadoActual.SoportesGruposUrls[codigo] = await LeerArchivoDataUrlAsync(e.File);
        asociadoActual.EsVictima = "Si";
    }

    private void AbrirVisor(string categoria, string nombre, string? url)
    {
        visorCategoria = categoria;
        visorNombre = nombre;
        visorUrl = url ?? string.Empty;
        mostrarVisor = true;
    }

    private void AgregarCuotaEdicion()
    {
        if (asociadoActual is null) return;
        asociadoActual.CuotasAportes.Add(new CuotaAporteAsociado
        {
            TipoCuota = "Sostenimiento",
            Periodicidad = "Mensual",
            ValorCuota = 35000m,
            FechaVencimiento = DateTime.Today.AddMonths(1),
            CantidadCuotasPendientes = 1,
            ValorTotalPendiente = 35000m,
            ValorTotalPagado = 0m,
            EstadoPago = "Pendiente de pago"
        });
    }

    private void EliminarCuotaEdicion(string id)
    {
        if (asociadoActual is null || asociadoActual.CuotasAportes.Count <= 1) return;
        asociadoActual.CuotasAportes.RemoveAll(c => c.Id == id);
    }

    private static string ObtenerClaseEstadoCuota(string estado)
    {
        if (estado.Contains("Pagado", StringComparison.OrdinalIgnoreCase) || estado.Contains("Al día", StringComparison.OrdinalIgnoreCase))
            return "ea-estado-ok";
        if (estado.Contains("Vencido", StringComparison.OrdinalIgnoreCase) || estado.Contains("mora", StringComparison.OrdinalIgnoreCase))
            return "ea-estado-mora";
        if (estado.Contains("parcial", StringComparison.OrdinalIgnoreCase))
            return "ea-estado-parcial";
        return "ea-estado-pendiente";
    }

    private async Task CargarSoporteCuotaEdicion(CuotaAporteAsociado cuota, InputFileChangeEventArgs e)
    {
        var archivos = e.GetMultipleFiles(10);
        if (archivos is null) return;
        foreach (var archivo in archivos)
        {
            var kb = Math.Max(1, archivo.Size / 1024.0);
            cuota.Soportes.Add(new SoporteCuotaAsociado
            {
                CuotaId = cuota.Id,
                TipoCuota = cuota.TipoCuota,
                Periodicidad = cuota.Periodicidad,
                ArchivoNombre = archivo.Name,
                ArchivoTamano = kb >= 1024 ? $"{kb / 1024.0:0.0} MB" : $"{kb:0} KB",
                ArchivoUrl = await LeerArchivoDataUrlAsync(archivo),
                FechaCarga = DateTime.Now
            });
        }
        cuota.ActualizarEstadoYSoportes();
    }

    private static async Task<string> LeerArchivoDataUrlAsync(IBrowserFile archivo)
    {
        try
        {
            await using var s = archivo.OpenReadStream(10 * 1024 * 1024);
            using var ms = new MemoryStream();
            await s.CopyToAsync(ms);
            var ext = Path.GetExtension(archivo.Name).ToLowerInvariant();
            var mime = !string.IsNullOrWhiteSpace(archivo.ContentType)
                ? archivo.ContentType
                : ext == ".pdf" ? "application/pdf" : ext == ".png" ? "image/png" : "image/jpeg";
            return $"data:{mime};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch
        {
            return string.Empty;
        }
    }

    private async Task GuardarCambios()
    {
        if (asociadoActual is null) return;

        if (esAdminSupervisor)
        {
            mensajeAlerta = "Modo supervisión: el rol Administrador supervisa y consulta el padrón. La edición del expediente corresponde a Secretaría.";
            esError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(asociadoActual.AsociacionPertenece))
        {
            mensajeAlerta = "Debe asignar la asociación a la que pertenece el productor (campo obligatorio).";
            esError = true;
            return;
        }

        asociadoActual.SincronizarCultivosDesdeLista();

        if (string.IsNullOrWhiteSpace(asociadoActual.CedulaArchivoNombre))
        {
            mensajeAlerta = "Es obligatorio adjuntar la fotocopia de la cédula o el documento correspondiente al NIT.";
            esError = true;
            return;
        }

        if (string.IsNullOrWhiteSpace(asociadoActual.NombreCompleto) ||
            string.IsNullOrWhiteSpace(asociadoActual.Cedula) ||
            string.IsNullOrWhiteSpace(asociadoActual.Telefono) ||
            string.IsNullOrWhiteSpace(asociadoActual.NombrePredio) ||
            string.IsNullOrWhiteSpace(asociadoActual.VeredaSector) ||
            string.IsNullOrWhiteSpace(asociadoActual.Municipio) ||
            asociadoActual.HectareasPredio <= 0 ||
            asociadoActual.HectareasLineaProductiva <= 0 ||
            asociadoActual.CultivosSeleccionados.Count == 0)
        {
            mensajeAlerta = "Verifique que los datos obligatorios, al menos un cultivo y las hectáreas productivas estén completos.";
            esError = true;
            return;
        }

        var cuotasSinSoporte = asociadoActual.CuotasAportes
            .Select((c, idx) => (Cuota: c, Numero: idx + 1))
            .Where(x => x.Cuota.Soportes.Count == 0 || x.Cuota.Soportes.All(s => string.IsNullOrWhiteSpace(s.ArchivoNombre)))
            .Select(x => $"#{x.Numero} ({x.Cuota.TipoCuota} · {x.Cuota.Periodicidad})")
            .ToList();

        if (cuotasSinSoporte.Count > 0)
        {
            mensajeAlerta = $"Cada cuota o aporte debe tener su propio documento adjunto obligatorio. Falta adjuntar el comprobante en: {string.Join(", ", cuotasSinSoporte)}.";
            esError = true;
            return;
        }

        var autor = await ObtenerUsuarioActualAsync();
        var resultado = RegistroAsociados.Actualizar(AsociadoMapper.ToEntity(asociadoActual, autor));

        if (!resultado.Exitoso)
        {
            mensajeAlerta = resultado.Mensaje;
            esError = true;
            return;
        }

        CargarProductores();

        Notificaciones.Publicar(new Asoagro.Models.Notificacion
        {
            Titulo = "Expediente actualizado",
            Descripcion = $"{asociadoActual.NombreCompleto} · {asociadoActual.NombrePredio}. Modificado por {autor}.",
            Etiqueta = "Edición",
            Enlace = $"/editar-asociado/{asociadoActual.Cedula}",
            Icono = "ajustes",
            Categoria = Asoagro.Models.CategoriaNotificacion.Productores,
            Nivel = Asoagro.Models.NivelNotificacion.Informativa,
            RolesEnlace = new[] { "Secretaria", "Administrador" }
        });

        mensajeAlerta = $"El expediente de {asociadoActual.NombreCompleto} se actualizó correctamente.";
        esError = false;
    }

    private static string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var p = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return p.Length >= 2 ? $"{p[0][0]}{p[1][0]}".ToUpperInvariant() : p[0][0].ToString().ToUpperInvariant();
    }

    private async Task<string> ObtenerUsuarioActualAsync()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        return estado.User.Identity?.Name
            ?? estado.User.FindFirst(ClaimTypes.Email)?.Value
            ?? "Secretaría";
    }
