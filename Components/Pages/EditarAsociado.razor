@page "/editar-asociado"
@page "/editar-asociado/{Cedula}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Director")]
@rendermode InteractiveServer
@using Asoagro.Services
@using System.ComponentModel.DataAnnotations
@inject AsociadoService AsociadoService
@inject NavigationManager Navigation

<PageTitle>Editar Expediente de Asociado - Asoagro & FAAUA</PageTitle>

<div class="asoagro-editar-wrapper container-fluid px-0 pb-5">
    
    <!-- BANNER HERO EJECUTIVO -->
    <div class="asoagro-hero-banner p-4 p-md-5 mb-4 position-relative overflow-hidden rounded-4">
        <div class="hero-bg-shapes"></div>
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="badge-agri-pill">
                        <i class="bi bi-pencil-square me-1"></i> FAAUA · Gestión Administrativa
                    </span>
                    <span class="badge-agri-pill-sub">
                        <i class="bi bi-shield-fill-check me-1"></i> Actualización Integral de Expediente
                    </span>
                </div>
                <h1 class="fw-extrabold text-white mb-2 tracking-tight" style="font-size: 1.85rem; font-weight: 800;">
                    Modificando Expediente: @asociado.NombreCompleto
                </h1>
                <p class="text-white-50 mb-0 small" style="max-width: 600px; line-height: 1.6;">
                    Actualice la caracterización predial, hectáreas, estado fitosanitario (BPA - ICA) y el componente social y jurídico del asociado seleccionado.
                </p>
            </div>
            
            <div class="col-lg-4 mt-4 mt-lg-0 text-lg-end">
                <div class="hero-stats-glass p-3 rounded-4 d-inline-block text-start w-100" style="max-width: 260px;">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="hero-stat-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div>
                            <span class="d-block extra-small text-white-50">Estado de Cuenta</span>
                            <span class="fw-bold text-success small d-flex align-items-center gap-1.5">
                                <span class="pulse-dot"></span> Sincronizado
                            </span>
                        </div>
                    </div>
                    <div class="d-flex align-items-center justify-content-between gap-3 pt-2 border-top border-white border-opacity-10">
                        <span class="extra-small text-white-50">Cédula Titular</span>
                        <span class="fw-bold text-white small">@asociado.Cedula</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ALERTA DE ÉXITO DINÁMICA -->
    @if (mensajeExito)
    {
        <div class="toast-banner toast-success p-3 mb-4 d-flex align-items-center justify-content-between animate-fade-in">
            <div class="d-flex align-items-center gap-3">
                <div class="toast-icon-box bg-success text-white"><i class="bi bi-check2-all fs-4"></i></div>
                <div>
                    <h6 class="fw-bold mb-0 text-dark">¡Expediente Actualizado con Éxito!</h6>
                    <span class="small text-secondary">Los cambios han sido guardados y se reflejan en el historial de consulta general.</span>
                </div>
            </div>
            <button type="button" class="btn-close" @onclick="() => mensajeExito = false"></button>
        </div>
    }

    <EditForm Model="@asociado" OnValidSubmit="GuardarCambios">
        <DataAnnotationsValidator />

        <div class="row g-4">
            <!-- COLUMNA IZQUIERDA: FORMULARIO MODULAR -->
            <div class="col-lg-8">
                <div class="unified-form-panel p-4 p-md-5">
                    
                    <!-- BLOQUE 1: IDENTIFICACIÓN Y CONTACTO -->
                    <div class="mb-4">
                        <div class="section-header-title mb-3">
                            <div class="section-icon-badge icon-purple"><i class="bi bi-person-vcard-fill"></i></div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">1. Identificación y Contacto</h6>
                                <span class="extra-small text-muted">Datos personales, celular y correo del titular</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-modern">Cédula (No Modificable)</label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-lock-fill input-icon text-muted"></i>
                                    <input type="text" class="form-control form-control-modern bg-light text-muted" value="@asociado.Cedula" disabled />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-modern">Nombre Completo <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-person-fill input-icon"></i>
                                    <InputText @bind-Value="asociado.NombreCompleto" class="form-control form-control-modern" />
                                </div>
                                <ValidationMessage For="@(() => asociado.NombreCompleto)" class="validation-msg" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-modern">Número de Celular <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-phone-fill input-icon"></i>
                                    <InputText @bind-Value="asociado.Telefono" class="form-control form-control-modern" />
                                </div>
                                <ValidationMessage For="@(() => asociado.Telefono)" class="validation-msg" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-modern">Correo Electrónico</label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-envelope-fill input-icon"></i>
                                    <InputText @bind-Value="asociado.Correo" class="form-control form-control-modern" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="section-divider my-4"></div>

                    <!-- BLOQUE 2: UBICACIÓN GEOGRÁFICA Y HECTÁREAS -->
                    <div class="mb-4">
                        <div class="section-header-title mb-3">
                            <div class="section-icon-badge icon-emerald"><i class="bi bi-geo-alt-fill"></i></div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">2. Ubicación Predial & Extensión</h6>
                                <span class="extra-small text-muted">Actualización de finca, vereda, municipio y hectáreas</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-modern">Nombre del Predio / Finca <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-house-door-fill input-icon"></i>
                                    <InputText @bind-Value="asociado.NombrePredio" class="form-control form-control-modern" />
                                </div>
                                <ValidationMessage For="@(() => asociado.NombrePredio)" class="validation-msg" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-modern">Vereda / Sector <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-pin-map-fill input-icon"></i>
                                    <InputText @bind-Value="asociado.VeredaSector" class="form-control form-control-modern" />
                                </div>
                                <ValidationMessage For="@(() => asociado.VeredaSector)" class="validation-msg" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-modern">Municipio <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-map-fill input-icon"></i>
                                    <InputText @bind-Value="asociado.Municipio" class="form-control form-control-modern" />
                                </div>
                                <ValidationMessage For="@(() => asociado.Municipio)" class="validation-msg" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-modern">Extensión (Hectáreas) <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-rulers input-icon"></i>
                                    <InputNumber @bind-Value="asociado.HectareasPredio" class="form-control form-control-modern" min="1" step="0.1" />
                                </div>
                                <ValidationMessage For="@(() => asociado.HectareasPredio)" class="validation-msg" />
                            </div>
                        </div>
                    </div>

                    <div class="section-divider my-4"></div>

                    <!-- BLOQUE 3: CULTIVOS Y BPA -->
                    <div class="mb-4">
                        <div class="section-header-title mb-3">
                            <div class="section-icon-badge icon-amber"><i class="bi bi-tree-fill"></i></div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">3. Caracterización Agrícola & BPA</h6>
                                <span class="extra-small text-muted">Línea productiva y estatus de certificación fitosanitaria ICA</span>
                            </div>
                        </div>

                        <div class="row g-3 align-items-center">
                            <div class="col-md-6">
                                <label class="form-label-modern">Línea Productiva Principal <span class="text-danger">*</span></label>
                                <div class="input-modern-wrapper">
                                    <i class="bi bi-flower2 input-icon"></i>
                                    <InputSelect @bind-Value="asociado.CultivoPrincipal" class="form-select form-control-modern">
                                        <option value="Platano">Plátano de Exportación</option>
                                        <option value="Banano">Banano Comercial</option>
                                        <option value="Cacao">Cacao Fino de Aroma</option>
                                        <option value="Ganaderia">Ganadería Sostenible</option>
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="bpa-interactive-card @(asociado.TieneBPA ? "bpa-active" : "bpa-inactive") p-3 mt-3 mt-md-0" @onclick="AlternarBPA">
                                    <div class="d-flex align-items-center justify-content-between gap-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="bpa-icon-circle">
                                                <i class="bi @(asociado.TieneBPA ? "bi-patch-check-fill" : "bi-shield-exclamation")"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 small">Certificación BPA (ICA)</h6>
                                                <p class="extra-small mb-0 mt-1 opacity-75">
                                                    @(asociado.TieneBPA ? "Predio con aval vigente." : "Sin aval fitosanitario.")
                                                </p>
                                            </div>
                                        </div>
                                        <div class="form-check form-switch fs-4 mb-0" @onclick:stopPropagation="true">
                                            <InputCheckbox @bind-Value="asociado.TieneBPA" class="form-check-input" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="section-divider my-4"></div>

                    <!-- BLOQUE 4: SOCIAL Y GOBERNANZA -->
                    <div class="mb-4">
                        <div class="section-header-title mb-3">
                            <div class="section-icon-badge icon-indigo"><i class="bi bi-shield-shaded"></i></div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">4. Componente Social & Membresía</h6>
                                <span class="extra-small text-muted">Certificado Unidad de Víctimas y estado de cuota social</span>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label-modern">Certificado Unidad de Víctimas</label>
                                <InputSelect @bind-Value="asociado.EsVictima" class="form-select form-control-modern">
                                    <option value="No">No registra</option>
                                    <option value="Si">Sí, cuenta con certificado activo</option>
                                </InputSelect>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label-modern">Estado de Cuota Social</label>
                                <InputSelect @bind-Value="asociado.EstadoMembresia" class="form-select form-control-modern">
                                    <option value="AlDia">Al Día (Habilitado)</option>
                                    <option value="Gracia">En Período de Gracia</option>
                                </InputSelect>
                            </div>
                        </div>
                    </div>

                    <!-- BOTÓN DE GUARDAR CAMBIOS -->
                    <div class="d-flex justify-content-between align-items-center pt-4 mt-4 border-top">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4 py-2 small fw-bold" @onclick='() => Navigation.NavigateTo("/consultar-asociados")'>
                            <i class="bi bi-arrow-left me-1"></i> Cancelar y Volver
                        </button>
                        <button type="submit" class="btn btn-asoagro-submit d-flex align-items-center gap-2">
                            <i class="bi bi-cloud-arrow-up-fill fs-5"></i>
                            <span>Guardar y Actualizar Padrón</span>
                        </button>
                    </div>

                </div>
            </div>

            <!-- COLUMNA DERECHA: TARJETA DE RESUMEN EJECUTIVO -->
            <div class="col-lg-4">
                <div class="sticky-top" style="top: 20px;">
                    <div class="id-card-container">
                        <div class="id-card-header">
                            <div class="id-card-pattern"></div>
                            
                            <div class="d-flex justify-content-between align-items-center position-relative mb-3" style="z-index: 2;">
                                <span class="badge-credential-type">
                                    <i class="bi bi-person-badge-fill me-1"></i> EDICIÓN ACTIVA
                                </span>
                                <span class="extra-small text-white-50 fw-semibold">
                                    CC: @asociado.Cedula
                                </span>
                            </div>

                            <div class="id-card-avatar-wrapper mb-2 position-relative" style="z-index: 2;">
                                <div class="id-card-avatar avatar-ready">
                                    @ObtenerIniciales(asociado.NombreCompleto)
                                </div>
                                @if (asociado.TieneBPA)
                                {
                                    <span class="bpa-avatar-verified" title="BPA Vigente">
                                        <i class="bi bi-patch-check-fill"></i>
                                    </span>
                                }
                            </div>

                            <h6 class="fw-bolder text-white mb-0 position-relative text-truncate px-2" style="z-index: 2;">
                                @(string.IsNullOrWhiteSpace(asociado.NombreCompleto) ? "Nombre del Productor" : asociado.NombreCompleto)
                            </h6>
                            <span class="text-white-50 extra-small d-block mt-1 position-relative" style="z-index: 2;">
                                <i class="bi bi-telephone-fill me-1"></i>Tel: @asociado.Telefono
                            </span>
                        </div>

                        <div class="id-card-body">
                            <div class="id-data-row">
                                <span class="text-muted extra-small"><i class="bi bi-house-door-fill text-success me-1"></i>Predio:</span>
                                <span class="fw-bold text-dark extra-small text-end text-truncate" style="max-width: 150px;">
                                    @(string.IsNullOrWhiteSpace(asociado.NombrePredio) ? "Sin registrar" : $"{asociado.NombrePredio} ({asociado.HectareasPredio} ha)")
                                </span>
                            </div>

                            <div class="id-data-row">
                                <span class="text-muted extra-small"><i class="bi bi-tree-fill text-success me-1"></i>Cultivo Eje:</span>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill extra-small fw-bold">
                                    @asociado.CultivoPrincipal
                                </span>
                            </div>

                            <div class="id-data-row">
                                <span class="text-muted extra-small"><i class="bi bi-shield-check text-success me-1"></i>Certificación BPA:</span>
                                @if (asociado.TieneBPA)
                                {
                                    <span class="badge bg-success text-white rounded-pill extra-small"><i class="bi bi-check-circle me-1"></i>Vigente ICA</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border rounded-pill extra-small">Sin aval</span>
                                }
                            </div>

                            <div class="text-center pt-3 mt-2 border-top">
                                <span class="extra-small text-muted">
                                    <i class="bi bi-clock-history me-1 text-success"></i>Modificando en tiempo real
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public string? Cedula { get; set; }

    private AsociadoModel asociado = new();
    private bool mensajeExito = false;

    protected override void OnInitialized()
    {
        var lista = AsociadoService.ObtenerAsociados();

        if (!string.IsNullOrWhiteSpace(Cedula))
        {
            var encontrado = lista.FirstOrDefault(a => a.Cedula == Cedula);
            if (encontrado != null)
            {
                asociado = new AsociadoModel
                {
                    Cedula = encontrado.Cedula,
                    NombreCompleto = encontrado.NombreCompleto,
                    Telefono = encontrado.Telefono,
                    Correo = encontrado.Correo,
                    NombrePredio = encontrado.NombrePredio,
                    VeredaSector = encontrado.VeredaSector,
                    Municipio = encontrado.Municipio,
                    HectareasPredio = encontrado.HectareasPredio,
                    CultivoPrincipal = encontrado.CultivoPrincipal,
                    TieneBPA = encontrado.TieneBPA,
                    EsVictima = encontrado.EsVictima,
                    EstadoMembresia = encontrado.EstadoMembresia,
                    FechaRegistro = encontrado.FechaRegistro
                };
                return;
            }
        }

        // Si no se pasa cédula o no se encuentra, toma el primero de la lista de ejemplo
        if (lista.Any())
        {
            var primero = lista.First();
            asociado = new AsociadoModel
            {
                Cedula = primero.Cedula,
                NombreCompleto = primero.NombreCompleto,
                Telefono = primero.Telefono,
                Correo = primero.Correo,
                NombrePredio = primero.NombrePredio,
                VeredaSector = primero.VeredaSector,
                Municipio = primero.Municipio,
                HectareasPredio = primero.HectareasPredio,
                CultivoPrincipal = primero.CultivoPrincipal,
                TieneBPA = primero.TieneBPA,
                EsVictima = primero.EsVictima,
                EstadoMembresia = primero.EstadoMembresia,
                FechaRegistro = primero.FechaRegistro
            };
        }
    }

    private void AlternarBPA() => asociado.TieneBPA = !asociado.TieneBPA;

    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();
        return $"{partes[0][0]}{partes[1][0]}".ToUpper();
    }

    private void GuardarCambios()
    {
        var lista = AsociadoService.ObtenerAsociados();
        var targetCedula = !string.IsNullOrWhiteSpace(Cedula) ? Cedula : asociado.Cedula;
        var index = lista.FindIndex(a => a.Cedula == targetCedula);
        
        if (index != -1)
        {
            lista[index] = asociado; // Actualiza el registro en la memoria compartida
        }
        mensajeExito = true;
    }
}