@page "/editar-asociado"
@page "/editar-asociado/{Cedula}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Director")]
@rendermode InteractiveServer
@using Asoagro.Services
@using System.ComponentModel.DataAnnotations
@inject AsociadoService AsociadoService

<PageTitle>Actualización de datos</PageTitle>
 
<div class="ea">
 
    <!-- ENCABEZADO --> 
    <section class="ea-hero">
        <div class="ea-hero-texto">
            <div class="ea-etiquetas">
                <span class="ea-etiqueta"><svg class="ea-ico"><use href="#ico-ajustes" /></svg>FAAUA · Gestión administrativa</span>
                <span class="ea-etiqueta ea-etiqueta-suave"><svg class="ea-ico"><use href="#ico-escudo" /></svg>Actualización integral</span>
            </div>
            <h1 class="ea-titulo">@TituloEncabezado</h1>
            <p class="ea-descripcion">@DescripcionEncabezado</p>
        </div>

        <div class="ea-hero-resumen">
            <span class="ea-resumen-etiqueta">Productores en padrón</span>
            <strong class="ea-resumen-valor">@ProductoresCompletos.Count</strong>
            <div class="ea-resumen-estado">
                <span class="ea-punto"></span>
                <span>Sincronizado</span>
            </div>
        </div>
    </section>

    <!-- ALERTAS -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="ea-alerta ea-alerta-exito">
            <svg class="ea-ico"><use href="#ico-check" /></svg>
            <span>@mensajeExito</span>
            <button type="button" class="ea-alerta-cerrar" @onclick="() => mensajeExito = string.Empty" aria-label="Cerrar">&times;</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="ea-alerta ea-alerta-error">
            <svg class="ea-ico"><use href="#ico-alerta" /></svg>
            <span>@mensajeError</span>
            <button type="button" class="ea-alerta-cerrar" @onclick="() => mensajeError = string.Empty" aria-label="Cerrar">&times;</button>
        </div>
    }

    @if (string.IsNullOrWhiteSpace(Cedula))
    {
        <!-- SELECTOR DE PRODUCTOR -->
        <section class="ea-panel ea-selector">
            <div class="ea-buscador">
                <svg class="ea-ico ea-buscador-ico"><use href="#ico-lista" /></svg>
                <input class="ea-input" placeholder="Buscar por nombre, cédula o vereda…" @bind="textoBusqueda" @bind:event="oninput" aria-label="Buscar productor" />
            </div>
            <p class="ea-ayuda">Seleccione un productor para revisar y actualizar su expediente.</p>
        </section>

        @if (ProductoresFiltrados.Any())
        {
            <div class="ea-grid">
                @foreach (var p in ProductoresFiltrados)
                {
                    <a class="ea-tarjeta" href="@($"/editar-asociado/{p.Cedula}")">
                        <header class="ea-tarjeta-cab">
                            <span class="ea-avatar">@ObtenerIniciales(p.NombreCompleto)</span>
                            <div class="ea-tarjeta-id">
                                <h3>@p.NombreCompleto</h3>
                                <small>CC @p.Cedula</small>
                            </div>
                        </header>

                        <dl class="ea-datos">
                            <div><dt>Predio</dt><dd>@p.NombrePredio</dd></div>
                            <div><dt>Cultivo</dt><dd>@NombreCultivo(p.CultivoPrincipal)</dd></div>
                        </dl>

                        <footer class="ea-tarjeta-pie">
                            <span class="ea-tarjeta-accion">Editar expediente</span>
                            <svg class="ea-ico ea-tarjeta-flecha"><use href="#ico-flecha" /></svg>
                        </footer>
                    </a>
                }
            </div>
        }
        else
        {
            <section class="ea-vacio">
                <span class="ea-vacio-ico"><svg class="ea-ico"><use href="#ico-brote" /></svg></span>
                <h3>No hay productores para editar</h3>
                <p>Registre un asociado o ajuste la búsqueda.</p>
                <a class="ea-btn ea-btn-primario" href="registrar-asociado">
                    <svg class="ea-ico"><use href="#ico-usuario-mas" /></svg>
                    Registrar asociado
                </a>
            </section>
        }
    }
    else if (!encontrado)
    {
        <section class="ea-vacio">
            <span class="ea-vacio-ico"><svg class="ea-ico"><use href="#ico-alerta" /></svg></span>
            <h3>No encontramos este expediente</h3>
            <p>La cédula <strong>@Cedula</strong> no está registrada en el padrón.</p>
            <a class="ea-btn ea-btn-primario" href="editar-asociado">
                <svg class="ea-ico"><use href="#ico-lista" /></svg>
                Elegir otro productor
            </a>
        </section>
    }
    else
    {
        <EditForm Model="asociado" OnValidSubmit="GuardarCambios" class="ea-layout">
            <DataAnnotationsValidator />

            <!-- FORMULARIO -->
            <div class="ea-panel ea-formulario">

                <div class="ea-acciones-superiores">
                    <a class="ea-btn ea-btn-secundario ea-btn-pequeno" href="editar-asociado">
                        <svg class="ea-ico ea-ico-izquierda"><use href="#ico-flecha" /></svg>
                        Cambiar productor
                    </a>
                </div>

                <!-- BLOQUE 1 -->
                <div class="ea-seccion">
                    <header class="ea-seccion-cab">
                        <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-usuario" /></svg></span>
                        <div class="ea-seccion-texto">
                            <h2>Identificación y contacto</h2>
                            <p>Datos personales, celular y correo del titular.</p>
                        </div>
                    </header>

                    <div class="ea-campos">
                        <div class="ea-campo">
                            <label class="ea-label">Cédula <span class="ea-opcional">(no modificable)</span></label>
                            <input class="ea-input ea-input-bloqueado" value="@asociado.Cedula" disabled />
                        </div>

                        <div class="ea-campo">
                            <label class="ea-label" for="ea-nombre">Nombre completo <span class="ea-req">*</span></label>
                            <InputText id="ea-nombre" class="ea-input" @bind-Value="asociado.NombreCompleto" />
                            <ValidationMessage For="@(() => asociado.NombreCompleto)" class="ea-validacion" />
                        </div>

                        <div class="ea-campo">
                            <label class="ea-label" for="ea-telefono">Número de celular <span class="ea-req">*</span></label>
                            <InputText id="ea-telefono" class="ea-input" @bind-Value="asociado.Telefono" />
                            <ValidationMessage For="@(() => asociado.Telefono)" class="ea-validacion" />
                        </div>

                        <div class="ea-campo">
                            <label class="ea-label" for="ea-correo">Correo electrónico <span class="ea-opcional">(opcional)</span></label>
                            <InputText id="ea-correo" class="ea-input" @bind-Value="asociado.Correo" />
                        </div>
                    </div>
                </div>

                <!-- BLOQUE 2 -->
                <div class="ea-seccion">
                    <header class="ea-seccion-cab">
                        <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-mapa" /></svg></span>
                        <div class="ea-seccion-texto">
                            <h2>Ubicación y predio</h2>
                            <p>Finca, vereda, municipio y extensión rural.</p>
                        </div>
                    </header>

                    <div class="ea-campos">
                        <div class="ea-campo">
                            <label class="ea-label" for="ea-predio">Nombre del predio o finca <span class="ea-req">*</span></label>
                            <InputText id="ea-predio" class="ea-input" @bind-Value="asociado.NombrePredio" />
                            <ValidationMessage For="@(() => asociado.NombrePredio)" class="ea-validacion" />
                        </div>

                        <div class="ea-campo">
                            <label class="ea-label" for="ea-vereda">Vereda o sector <span class="ea-req">*</span></label>
                            <InputText id="ea-vereda" class="ea-input" @bind-Value="asociado.VeredaSector" />
                            <ValidationMessage For="@(() => asociado.VeredaSector)" class="ea-validacion" />
                        </div>

                        <div class="ea-campo">
                            <label class="ea-label" for="ea-municipio">Municipio <span class="ea-req">*</span></label>
                            <InputText id="ea-municipio" class="ea-input" @bind-Value="asociado.Municipio" />
                            <ValidationMessage For="@(() => asociado.Municipio)" class="ea-validacion" />
                        </div>

                        <div class="ea-campo">
                            <label class="ea-label" for="ea-hectareas">Área del predio (hectáreas) <span class="ea-req">*</span></label>
                            <InputNumber id="ea-hectareas" class="ea-input" @bind-Value="asociado.HectareasPredio" min="1" step="0.1" />
                            <ValidationMessage For="@(() => asociado.HectareasPredio)" class="ea-validacion" />
                        </div>
                    </div>
                </div>

                <!-- BLOQUE 3 -->
                <div class="ea-seccion">
                    <header class="ea-seccion-cab">
                        <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-brote" /></svg></span>
                        <div class="ea-seccion-texto">
                            <h2>Línea productiva y BPA</h2>
                            <p>Caracterización agrícola y certificación fitosanitaria ICA.</p>
                        </div>
                    </header>

                    <div class="ea-campos">
                        <div class="ea-campo ea-ancho-total">
                            <label class="ea-label" for="ea-cultivo">Línea productiva principal <span class="ea-req">*</span></label>
                            <InputSelect id="ea-cultivo" class="ea-input" @bind-Value="asociado.CultivoPrincipal">
                                <option value="Platano">Plátano de exportación</option>
                                <option value="Banano">Banano comercial</option>
                                <option value="Cacao">Cacao fino de aroma</option>
                                <option value="Ganaderia">Ganadería sostenible</option>
                            </InputSelect>
                        </div>

                        <div class="ea-campo ea-ancho-total">
                            <div class="ea-bpa @(asociado.TieneBPA ? "activo" : "")" role="switch" tabindex="0" aria-checked="@(asociado.TieneBPA ? "true" : "false")" @onclick="AlternarBPA">
                                <span class="ea-bpa-ico"><svg class="ea-ico"><use href="#ico-escudo" /></svg></span>
                                <span class="ea-bpa-texto">
                                    <strong>Buenas Prácticas Agrícolas (BPA - ICA)</strong>
                                    <small>@(asociado.TieneBPA ? "Predio con aval fitosanitario vigente." : "Actívalo si el predio tiene aval vigente.")</small>
                                </span>
                                <span class="ea-switch"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BLOQUE 4 -->
                <div class="ea-seccion">
                    <header class="ea-seccion-cab">
                        <span class="ea-seccion-ico"><svg class="ea-ico"><use href="#ico-red" /></svg></span>
                        <div class="ea-seccion-texto">
                            <h2>Componente social y membresía</h2>
                            <p>Certificado de la Unidad de Víctimas y estado de cuota social.</p>
                        </div>
                    </header>

                    <div class="ea-campos">
                        <div class="ea-campo">
                            <label class="ea-label" for="ea-victima">Certificado Unidad de Víctimas</label>
                            <InputSelect id="ea-victima" class="ea-input" @bind-Value="asociado.EsVictima">
                                <option value="No">No registra / prefiere no indicar</option>
                                <option value="Si">Sí, cuenta con certificado activo</option>
                            </InputSelect>
                        </div>

                        <div class="ea-campo">
                            <label class="ea-label" for="ea-membresia">Estado de cuota social</label>
                            <InputSelect id="ea-membresia" class="ea-input" @bind-Value="asociado.EstadoMembresia">
                                <option value="AlDia">Al día (habilitado para convocatorias)</option>
                                <option value="Gracia">En período de gracia</option>
                            </InputSelect>
                        </div>
                    </div>
                </div>

                <!-- ACCIONES -->
                <div class="ea-acciones">
                    <a class="ea-btn ea-btn-secundario" href="consultar-asociados">
                        <svg class="ea-ico ea-ico-izquierda"><use href="#ico-flecha" /></svg>
                        Cancelar y volver
                    </a>
                    <button type="submit" class="ea-btn ea-btn-guardar">
                        <svg class="ea-ico"><use href="#ico-check" /></svg>
                        Guardar cambios
                    </button>
                </div>
            </div>

            <!-- CARNET RESUMEN -->
            <aside class="ea-carnet" aria-label="Resumen del expediente">
                <div class="ea-carnet-tarjeta">
                    <div class="ea-carnet-cab">
                        <span class="ea-carnet-sello">Edición activa</span>
                        <span class="ea-carnet-cc">CC @asociado.Cedula</span>

                        <div class="ea-carnet-avatar listo">
                            @ObtenerIniciales(asociado.NombreCompleto)
                            @if (asociado.TieneBPA)
                            {
                                <span class="ea-carnet-bpa" title="BPA vigente"><svg class="ea-ico"><use href="#ico-check" /></svg></span>
                            }
                        </div>

                        <h3>@(string.IsNullOrWhiteSpace(asociado.NombreCompleto) ? "Nombre del productor" : asociado.NombreCompleto)</h3>
                        <small>@(string.IsNullOrWhiteSpace(asociado.Telefono) ? "Teléfono pendiente" : asociado.Telefono)</small>
                    </div>

                    <div class="ea-carnet-cuerpo">
                        <div class="ea-carnet-fila">
                            <span>Predio</span>
                            <strong>@(string.IsNullOrWhiteSpace(asociado.NombrePredio) ? "Sin registrar" : $"{asociado.NombrePredio} ({asociado.HectareasPredio} ha)")</strong>
                        </div>
                        <div class="ea-carnet-fila">
                            <span>Cultivo eje</span>
                            <strong>@NombreCultivo(asociado.CultivoPrincipal)</strong>
                        </div>
                        <div class="ea-carnet-fila">
                            <span>Certificación BPA</span>
                            @if (asociado.TieneBPA)
                            {
                                <span class="ea-pildora-ok">Vigente ICA</span>
                            }
                            else
                            {
                                <span class="ea-pildora-no">Sin aval</span>
                            }
                        </div>

                        <div class="ea-carnet-progreso">
                            <div class="ea-carnet-progreso-cab">
                                <span>Datos completos</span>
                                <strong>@PorcentajeCompleto%</strong>
                            </div>
                            <div class="ea-barra"><div class="ea-barra-relleno" style="width: @(PorcentajeCompleto)%;"></div></div>
                        </div>

                        <div class="ea-carnet-pie">
                            <div>
                                <strong>ASOAGRO · FAAUA</strong>
                                <small>Gestión de asociados</small>
                            </div>
                            <span class="ea-carnet-qr" title="Código QR oficial"><svg class="ea-ico"><use href="#ico-mapa" /></svg></span>
                        </div>
                    </div>
                </div>
            </aside>

        </EditForm>
    }
</div>

@code {
    [Parameter]
    public string? Cedula { get; set; }

    private AsociadoModel asociado = new();
    private bool encontrado;
    private string textoBusqueda = string.Empty;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;

    // Solo se consideran expedientes completos (pasos 1, 2 y 3 terminados)
    private List<AsociadoModel> ProductoresCompletos => AsociadoService.ObtenerAsociados()
        .Where(a => !string.IsNullOrWhiteSpace(a.NombreCompleto)
                 && !string.IsNullOrWhiteSpace(a.Cedula)
                 && !string.IsNullOrWhiteSpace(a.Telefono)
                 && !string.IsNullOrWhiteSpace(a.NombrePredio)
                 && !string.IsNullOrWhiteSpace(a.VeredaSector)
                 && !string.IsNullOrWhiteSpace(a.Municipio)
                 && a.HectareasPredio >= 1
                 && !string.IsNullOrWhiteSpace(a.CultivoPrincipal))
        .ToList();

    private IEnumerable<AsociadoModel> ProductoresFiltrados =>
        ProductoresCompletos.Where(a =>
            string.IsNullOrWhiteSpace(textoBusqueda) ||
            a.NombreCompleto.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            a.Cedula.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            a.VeredaSector.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase));

    private string TituloEncabezado => string.IsNullOrWhiteSpace(Cedula)
        ? "Editar expediente"
        : (encontrado ? $"Editando a {asociado.NombreCompleto}" : "Expediente no encontrado");

    private string DescripcionEncabezado => string.IsNullOrWhiteSpace(Cedula)
        ? "Seleccione un productor del padrón para actualizar su caracterización predial, su certificación BPA y su componente social."
        : "Actualice la caracterización predial, las hectáreas, el estado fitosanitario y el componente social del asociado.";

    private int PorcentajeCompleto
    {
        get
        {
            int llenos = 0;
            if (!string.IsNullOrWhiteSpace(asociado.NombreCompleto)) llenos++;
            if (!string.IsNullOrWhiteSpace(asociado.Cedula)) llenos++;
            if (!string.IsNullOrWhiteSpace(asociado.Telefono)) llenos++;
            if (!string.IsNullOrWhiteSpace(asociado.NombrePredio)) llenos++;
            if (!string.IsNullOrWhiteSpace(asociado.VeredaSector)) llenos++;
            if (!string.IsNullOrWhiteSpace(asociado.Municipio)) llenos++;
            if (asociado.HectareasPredio >= 1) llenos++;
            if (!string.IsNullOrWhiteSpace(asociado.CultivoPrincipal)) llenos++;
            return llenos * 100 / 8;
        }
    }

    protected override void OnParametersSet()
    {
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        if (string.IsNullOrWhiteSpace(Cedula))
        {
            asociado = new();
            encontrado = false;
            return;
        }

        var registro = AsociadoService.ObtenerAsociados()
            .FirstOrDefault(a => a.Cedula == Cedula);

        encontrado = registro is not null;
        asociado = registro is not null ? Copiar(registro) : new();
    }

    private void AlternarBPA() => asociado.TieneBPA = !asociado.TieneBPA;

    private void GuardarCambios()
    {
        var lista = AsociadoService.ObtenerAsociados();
        var index = lista.FindIndex(a => a.Cedula == asociado.Cedula);

        if (index == -1)
        {
            mensajeError = "No fue posible encontrar el expediente. Intenta de nuevo.";
            return;
        }

        // Se guarda una copia, no el objeto del formulario
        lista[index] = Copiar(asociado);
        mensajeExito = $"El expediente de {asociado.NombreCompleto} se actualizó correctamente.";
    }

    private static AsociadoModel Copiar(AsociadoModel origen) => new()
    {
        Cedula = origen.Cedula,
        NombreCompleto = origen.NombreCompleto,
        Telefono = origen.Telefono,
        Correo = origen.Correo,
        NombrePredio = origen.NombrePredio,
        VeredaSector = origen.VeredaSector,
        Municipio = origen.Municipio,
        HectareasPredio = origen.HectareasPredio,
        CultivoPrincipal = origen.CultivoPrincipal,
        TieneBPA = origen.TieneBPA,
        EsVictima = origen.EsVictima,
        EstadoMembresia = origen.EstadoMembresia,
        FechaRegistro = origen.FechaRegistro
    };

    private string NombreCultivo(string valor) => valor switch
    {
        "Platano" => "Plátano",
        "Banano" => "Banano",
        "Cacao" => "Cacao",
        "Ganaderia" => "Ganadería",
        _ => string.IsNullOrWhiteSpace(valor) ? "Pendiente" : valor
    };

    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();
        return $"{partes[0][0]}{partes[1][0]}".ToUpper();
    }
}