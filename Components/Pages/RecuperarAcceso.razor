@page "/recuperar"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Asoagro.Services
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@inject AdminSistemaService AdminService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>@(esPrimerAcceso ? "Configurar contraseña personal · ASOAGRO" : "Recuperar acceso · ASOAGRO")</PageTitle>

<div class="container py-5" style="max-width: 520px; font-family: 'Inter', system-ui, sans-serif;">
    <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
        <div class="d-flex align-items-center gap-3 mb-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background: #14532D;">
                <i class="bi bi-shield-lock-fill fs-5"></i>
            </div>
            <div>
                <h1 class="h5 fw-bold text-dark mb-0">
                    @(esPrimerAcceso ? "Cambio obligatorio de contraseña" : "Recuperación segura de acceso")
                </h1>
                <small class="text-muted">
                    @(esPrimerAcceso
                        ? "Primer inicio de sesión del Administrador del Sistema"
                        : "Restablecimiento de credencial autorizado por Administración")
                </small>
            </div>
        </div>

        <p class="text-muted small mb-4">
            @if (esPrimerAcceso)
            {
                <span>Por seguridad, debes reemplazar la contraseña inicial configurada antes de acceder a los paneles de ASOAGRO. La nueva contraseña se almacenará únicamente mediante hash seguro.</span>
            }
            else
            {
                <span>Por seguridad, ASOAGRO no genera ni envía contraseñas en texto visible. Si el Administrador del sistema habilitó una ventana de recuperación para tu cuenta (vigente por 30 minutos), define aquí tu nueva contraseña.</span>
            }
        </p>

        @if (!string.IsNullOrWhiteSpace(mensajeResultado))
        {
            <div class="alert @(exito ? "alert-success" : "alert-danger") rounded-3 small fw-semibold" role="alert">
                @mensajeResultado
            </div>
        }

        <EditForm Model="modelo" OnValidSubmit="CompletarRecuperacion">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label small fw-bold" for="recCorreo">Correo institucional</label>
                <InputText id="recCorreo" class="form-control" placeholder="usuario@asoagro-faaua.org" readonly="@esPrimerAcceso" @bind-Value="modelo.Correo" />
                <ValidationMessage For="@(() => modelo.Correo)" class="text-danger small" />
            </div>

            @if (esPrimerAcceso)
            {
                <div class="mb-3">
                    <label class="form-label small fw-bold" for="recActual">Contraseña inicial actual</label>
                    <InputText id="recActual" type="password" class="form-control" placeholder="••••••••" @bind-Value="modelo.ContrasenaActual" />
                </div>
            }

            <div class="mb-3">
                <label class="form-label small fw-bold" for="recPass">Nueva contraseña (mínimo 8 caracteres)</label>
                <InputText id="recPass" type="password" class="form-control" placeholder="••••••••" @bind-Value="modelo.NuevaContrasena" />
                <ValidationMessage For="@(() => modelo.NuevaContrasena)" class="text-danger small" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-bold" for="recPassConf">Confirmar nueva contraseña</label>
                <InputText id="recPassConf" type="password" class="form-control" placeholder="••••••••" @bind-Value="modelo.ConfirmarContrasena" />
                <ValidationMessage For="@(() => modelo.ConfirmarContrasena)" class="text-danger small" />
            </div>

            <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold py-2" style="background: #17603a; border-color: #17603a;" disabled="@procesando">
                @(procesando
                    ? "Actualizando credencial..."
                    : (esPrimerAcceso ? "Guardar contraseña y continuar al panel" : "Actualizar contraseña de forma segura"))
            </button>
        </EditForm>

        <div class="mt-3 pt-3 border-top text-center">
            @if (esPrimerAcceso)
            {
                <a href="/Auth/logout" data-enhance-nav="false" class="text-muted small fw-semibold text-decoration-none">
                    <i class="bi bi-box-arrow-left me-1"></i> Cerrar sesión
                </a>
            }
            else
            {
                <a href="/login" class="text-success small fw-semibold text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Volver al inicio de sesión
                </a>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "primerAcceso")]
    private string? PrimerAccesoParam { get; set; }

    private readonly ModeloRecuperacion modelo = new();
    private string mensajeResultado = string.Empty;
    private bool exito;
    private bool procesando;
    private bool esPrimerAcceso;

    protected override async Task OnInitializedAsync()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        var user = estado.User;
        if (user.Identity?.IsAuthenticated == true)
        {
            var correo = user.FindFirst(ClaimTypes.Email)?.Value ?? string.Empty;
            if (!string.IsNullOrWhiteSpace(correo) && AdminService.RequiereCambioContrasena(correo))
            {
                esPrimerAcceso = true;
                modelo.Correo = correo;
            }
        }
    }

    private async Task CompletarRecuperacion()
    {
        if (modelo.NuevaContrasena != modelo.ConfirmarContrasena)
        {
            exito = false;
            mensajeResultado = "Las contraseñas ingresadas no coinciden.";
            return;
        }

        procesando = true;
        try
        {
            if (esPrimerAcceso)
            {
                var resPrimer = await AdminService.CompletarPrimerCambioContrasenaAsync(
                    modelo.Correo,
                    modelo.ContrasenaActual,
                    modelo.NuevaContrasena);
                exito = resPrimer.Exitoso;
                mensajeResultado = resPrimer.Mensaje;
                if (exito)
                {
                    modelo.ContrasenaActual = string.Empty;
                    modelo.NuevaContrasena = string.Empty;
                    modelo.ConfirmarContrasena = string.Empty;
                    Navigation.NavigateTo("/Auth/refrescar-sesion", forceLoad: true);
                }
                return;
            }

            var res = await AdminService.CompletarRecuperacionAccesoAsync(modelo.Correo, modelo.NuevaContrasena);
            exito = res.Exitoso;
            mensajeResultado = res.Mensaje;
            if (exito)
            {
                modelo.NuevaContrasena = string.Empty;
                modelo.ConfirmarContrasena = string.Empty;
            }
        }
        finally
        {
            procesando = false;
        }
    }

    private sealed class ModeloRecuperacion
    {
        [Required(ErrorMessage = "Ingresa tu correo institucional.")]
        [EmailAddress(ErrorMessage = "El formato del correo no es válido.")]
        public string Correo { get; set; } = string.Empty;

        public string ContrasenaActual { get; set; } = string.Empty;

        [Required(ErrorMessage = "Ingresa la nueva contraseña.")]
        [MinLength(8, ErrorMessage = "Debe tener al menos 8 caracteres.")]
        public string NuevaContrasena { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirma la nueva contraseña.")]
        public string ConfirmarContrasena { get; set; } = string.Empty;
    }
}
