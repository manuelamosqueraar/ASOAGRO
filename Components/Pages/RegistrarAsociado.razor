    private bool TieneErrorVisible(string clave)
    {
        if (!camposTocados.Contains(clave)) return false;
        return !string.IsNullOrEmpty(ObtenerErrorPorClave(clave));
    }

    private string ObtenerErrorPorClave(string clave)
    {
        switch (clave)
        {
            case "nombre": return ValidarNombreCompleto();
            case "cedula": return ValidarDocumentoIdentidad();
            case "cedulaArchivo": return ValidarArchivoIdentidad();
            case "telefono": return ValidarTelefono();
            case "correo": return ValidarCorreo();
            case "predio": return ValidarNombrePredio();
            case "vereda": return ValidarVereda();
            case "municipio": return ValidarMunicipio();
            case "hectareasPredio": return ValidarHectareasPredio();
            case "tenencia": return ValidarTenenciaTerreno();
            case "tipoActividad": return ValidarTipoActividad();
            case "cultivos": return ValidarCultivosLineaProductiva();
            case "hectareasProductiva": return ValidarHectareasProductivas();
            case "produccion": return ValidarProduccionAproximada();
            case "certificadoBpa": return ValidarCertificadoBpa();
        }

        if (clave.StartsWith("vulnerable_", StringComparison.OrdinalIgnoreCase))
        {
            var codigo = clave["vulnerable_".Length..];
            var nombre = AsociadoModel.TraducirGrupoVulnerable(codigo);
            return ValidarSoporteGrupoVulnerable(codigo, nombre);
        }

        if (clave.StartsWith("cuota_", StringComparison.OrdinalIgnoreCase))
        {
            var partes = clave.Split('_', 3);
            if (partes.Length == 3)
            {
                var cuotaId = partes[1];
                var subcampo = partes[2];
                var idx = nuevoAsociado.CuotasAportes.FindIndex(c => c.Id == cuotaId);
                if (idx >= 0)
                {
                    var cuota = nuevoAsociado.CuotasAportes[idx];
                    return subcampo switch
                    {
                        "tipo" => ValidarTipoCuota(cuota),
                        "periodicidad" => ValidarPeriodicidadCuota(cuota),
                        "valor" => ValidarValorCuota(cuota),
                        "fecha" => ValidarFechaVencimientoCuota(cuota),
                        "cantidad" => ValidarCantidadPendientesCuota(cuota),
                        "pagado" => ValidarValorPagadoCuota(cuota),
                        "soporte" => ValidarSoporteCuota(cuota, idx + 1),
                        _ => string.Empty
                    };
                }
            }
        }

        return string.Empty;
    }

    private bool TieneErroresActivosPaso(int paso) => paso switch
    {
        1 => TieneErroresPaso1(),
        2 => TieneErroresPaso2(),
        3 => TieneErroresPaso3(),
        4 => TieneErroresPaso4(),
        5 => TieneErroresPaso5(),
        _ => false
    };

    private bool TieneErroresPaso1() =>
        !string.IsNullOrEmpty(ValidarNombreCompleto()) ||
        !string.IsNullOrEmpty(ValidarDocumentoIdentidad()) ||
        !string.IsNullOrEmpty(ValidarArchivoIdentidad()) ||
        !string.IsNullOrEmpty(ValidarAsociacionPertenece()) ||
        !string.IsNullOrEmpty(ValidarTelefono()) ||
        !string.IsNullOrEmpty(ValidarCorreo());

    private bool TieneErroresPaso2() =>
        !string.IsNullOrEmpty(ValidarNombrePredio()) ||
        !string.IsNullOrEmpty(ValidarVereda()) ||
        !string.IsNullOrEmpty(ValidarMunicipio()) ||
        !string.IsNullOrEmpty(ValidarHectareasPredio()) ||
        !string.IsNullOrEmpty(ValidarTenenciaTerreno());

    private bool TieneErroresPaso3() =>
        !string.IsNullOrEmpty(ValidarTipoActividad()) ||
        !string.IsNullOrEmpty(ValidarCultivosLineaProductiva()) ||
        !string.IsNullOrEmpty(ValidarHectareasProductivas()) ||
        !string.IsNullOrEmpty(ValidarProduccionAproximada()) ||
        !string.IsNullOrEmpty(ValidarCertificadoBpa());

    private bool TieneErroresPaso4() =>
        !string.IsNullOrEmpty(ValidarEstadoMembresia()) ||
        nuevoAsociado.GruposVulnerables.Any(g =>
            !string.IsNullOrEmpty(ValidarSoporteGrupoVulnerable(g, AsociadoModel.TraducirGrupoVulnerable(g))));

    private bool TieneErroresPaso5()
    {
        if (nuevoAsociado.CuotasAportes.Count == 0) return true;
        for (var i = 0; i < nuevoAsociado.CuotasAportes.Count; i++)
        {
            var c = nuevoAsociado.CuotasAportes[i];
            if (!string.IsNullOrEmpty(ValidarTipoCuota(c)) ||
                !string.IsNullOrEmpty(ValidarPeriodicidadCuota(c)) ||
                !string.IsNullOrEmpty(ValidarValorCuota(c)) ||
                !string.IsNullOrEmpty(ValidarFechaVencimientoCuota(c)) ||
                !string.IsNullOrEmpty(ValidarCantidadPendientesCuota(c)) ||
                !string.IsNullOrEmpty(ValidarValorPagadoCuota(c)) ||
                !string.IsNullOrEmpty(ValidarSoporteCuota(c, i + 1)))
            {
                return true;
            }
        }
        return false;
    }

    private void MarcarCamposPasoComoTocados(int paso)
    {
        switch (paso)
        {
            case 1:
                camposTocados.Add("nombre");
                camposTocados.Add("cedula");
                camposTocados.Add("cedulaArchivo");
                camposTocados.Add("telefono");
                camposTocados.Add("correo");
                break;
            case 2:
                camposTocados.Add("predio");
                camposTocados.Add("vereda");
                camposTocados.Add("municipio");
                camposTocados.Add("hectareasPredio");
                camposTocados.Add("tenencia");
                break;
            case 3:
                camposTocados.Add("tipoActividad");
                camposTocados.Add("cultivos");
                camposTocados.Add("hectareasProductiva");
                camposTocados.Add("produccion");
                camposTocados.Add("certificadoBpa");
                break;
            case 4:
                foreach (var g in nuevoAsociado.GruposVulnerables)
                {
                    camposTocados.Add($"vulnerable_{g}");
                }
                break;
            case 5:
                foreach (var c in nuevoAsociado.CuotasAportes)
                {
                    camposTocados.Add($"cuota_{c.Id}_tipo");
                    camposTocados.Add($"cuota_{c.Id}_periodicidad");
                    camposTocados.Add($"cuota_{c.Id}_valor");
                    camposTocados.Add($"cuota_{c.Id}_fecha");
                    camposTocados.Add($"cuota_{c.Id}_cantidad");
                    camposTocados.Add($"cuota_{c.Id}_pagado");
                    camposTocados.Add($"cuota_{c.Id}_soporte");
                }
                break;
        }
    }

