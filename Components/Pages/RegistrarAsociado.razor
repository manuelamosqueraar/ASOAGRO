    private int CalcularPorcentajeAvance()
    {
        if (registroExitoso) return 100;
        var puntos = 0;
        if (Paso1Completo) puntos += 20;
        if (Paso2Completo) puntos += 20;
        if (Paso3Completo) puntos += 20;
        if ((pasoActual >= 4 || Paso4Completo) && Paso3Completo) puntos += 20;
        if (pasoActual == 5 && Paso5Completo) puntos += 20;
        return puntos;
    }

