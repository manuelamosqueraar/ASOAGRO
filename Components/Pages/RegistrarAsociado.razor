@page "/registrar-asociado"
@rendermode InteractiveServer

<h3>Registro de Asociado Productor</h3>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}

<EditForm Model="@asociado" OnValidSubmit="ManejarValidacion">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="nombre" class="form-label">Nombre Completo:</label>
        <InputText id="nombre" class="form-control" @bind-Value="asociado.Nombre" />
        <ValidationMessage For="@(() => asociado.Nombre)" />
    </div>

    <div class="mb-3">
        <label for="documento" class="form-label">Número de Documento:</label>
        <InputText id="documento" class="form-control" @bind-Value="asociado.Documento" />
        <ValidationMessage For="@(() => asociado.Documento)" />
    </div>

    <div class="mb-3">
        <label for="finca" class="form-label">Nombre de la Finca:</label>
        <InputText id="finca" class="form-control" @bind-Value="asociado.Finca" />
        <ValidationMessage For="@(() => asociado.Finca)" />
    </div>

    <div class="mb-3">
        <label for="cultivo" class="form-label">Línea Productiva / Cultivo:</label>
        <InputSelect id="cultivo" class="form-select" @bind-Value="asociado.Cultivo">
            <option value="">Seleccione un cultivo...</option>
            <option value="Platano">Plátano</option>
            <option value="Banano">Banano</option>
            <option value="Cacao">Cacao</option>
            <option value="Ganaderia">Ganadería</option>
        </InputSelect>
        <ValidationMessage For="@(() => asociado.Cultivo)" />
    </div>

    <button type="submit" class="btn btn-primary">Registrar Asociado</button>
</EditForm>

@code {
    private AsociadoModel asociado = new();
    private string mensajeExito = string.Empty;

    private void ManejarValidacion()
    {
        // Aquí se confirma la creación exitosa cumpliendo el criterio de Jira
        mensajeExito = $"¡Asociado {asociado.Nombre} registrado con éxito en la finca {asociado.Finca}!";
        
        // Limpiamos el formulario para uno nuevo
        asociado = new();
    }

    public class AsociadoModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre es obligatorio.")]
        public string Nombre { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El documento es obligatorio.")]
        public string Documento { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "El nombre de la finca es obligatorio.")]
        public string Finca { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Debe seleccionar un cultivo.")]
        public string Cultivo { get; set; } = string.Empty;
    }
}