    private async Task CargarFotocopiaCedula(InputFileChangeEventArgs e)
    {
        var archivo = e.File;
        if (archivo is null) return;

        camposTocados.Add("cedulaArchivo");
        var errorValidacion = ValidarArchivoSubido(archivo);
        if (!string.IsNullOrEmpty(errorValidacion))
        {
            erroresArchivos["cedulaArchivo"] = errorValidacion;
            return;
        }

        var dataUrl = await ConvertirArchivoADataUrlAsync(archivo);
        if (string.IsNullOrEmpty(dataUrl))
        {
            erroresArchivos["cedulaArchivo"] = "No fue posible procesar el archivo seleccionado. Verifique que sea un PDF, JPG o PNG válido de máximo 10 MB.";
            return;
        }

        erroresArchivos.Remove("cedulaArchivo");
