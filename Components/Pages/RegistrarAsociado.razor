    private string ValidarPeriodicidadCuota(CuotaAporteAsociado cuota)
    {
        if (string.IsNullOrWhiteSpace(cuota.Periodicidad))
        {
            return "Seleccione la periodicidad de la cuota o aporte.";
        }

        if (cuota.TipoCuota == "Sostenimiento")
        {
            if (!PeriodicidadesSostenimientoValidas.Contains(cuota.Periodicidad))
            {
                return "Para Sostenimiento, la periodicidad debe ser Mensual, Bimensual o Anual.";
            }
        }
        else if (!PeriodicidadesGeneralesValidas.Contains(cuota.Periodicidad))
        {
            return "Seleccione una periodicidad válida (Pago único, Mensual, Bimensual o Anual).";
        }

        return string.Empty;
    }

    private string ValidarValorCuota(CuotaAporteAsociado cuota)
    {
        var raw = ObtenerTextoValorCuota(cuota);
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "El valor de la cuota es obligatorio.";
        }

        var errorNumero = ValidarMontoDesdeCeroConDosDecimales(raw, "El valor de la cuota");
        if (!string.IsNullOrEmpty(errorNumero))
        {
            return errorNumero;
        }

        if (cuota.ValorCuota <= 0m)
        {
            return "El valor de la cuota o aporte debe ser mayor a $0.";
        }

        return string.Empty;
    }

    private string ValidarFechaVencimientoCuota(CuotaAporteAsociado cuota)
    {
        var raw = ObtenerTextoFechaCuota(cuota);
        if (string.IsNullOrWhiteSpace(raw) || !cuota.FechaVencimiento.HasValue)
        {
            return "Ingrese una fecha real de pago o próximo vencimiento.";
        }

        if (cuota.FechaVencimiento.Value.Date < DateTime.Today)
        {
            return "No se permiten fechas pasadas como fecha de próximo vencimiento.";
        }

        return string.Empty;
    }

    private string ValidarCantidadPendientesCuota(CuotaAporteAsociado cuota)
    {
        var raw = ObtenerTextoCantidadCuota(cuota);
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "Ingrese la cantidad de cuotas pendientes (número entero desde 0).";
        }

        var limpio = raw.Trim();
        if (limpio.StartsWith('-'))
        {
            return "La cantidad de cuotas pendientes no puede ser negativa.";
        }

        if (limpio.Contains('.') || limpio.Contains(','))
        {
            return "La cantidad de cuotas pendientes debe ser un número entero sin decimales.";
        }

        if (!limpio.All(char.IsAsciiDigit) || !int.TryParse(limpio, out var cantidad) || cantidad < 0)
        {
            return "Ingrese únicamente números enteros desde 0 para las cuotas pendientes.";
        }

        return string.Empty;
    }

    private string ValidarValorPagadoCuota(CuotaAporteAsociado cuota)
    {
        var raw = ObtenerTextoPagadoCuota(cuota);
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "El valor pagado es obligatorio (ingrese 0 si aún no registra pagos).";
        }

        var errorNumero = ValidarMontoDesdeCeroConDosDecimales(raw, "El valor pagado");
        if (!string.IsNullOrEmpty(errorNumero))
        {
            return errorNumero;
        }

        if (cuota.TotalEstablecido > 0m && cuota.ValorTotalPagado > cuota.TotalEstablecido)
        {
            return $"El valor pagado (${cuota.ValorTotalPagado:N0}) no puede superar el total establecido (${cuota.TotalEstablecido:N0}).";
        }

        return string.Empty;
    }

    private string ValidarSoporteCuota(CuotaAporteAsociado cuota, int numeroRegistro)
    {
        var claveErr = $"cuota_{cuota.Id}_soporte";
        if (erroresArchivos.TryGetValue(claveErr, out var err) && !string.IsNullOrEmpty(err))
        {
            return err;
        }

        if (cuota.Soportes.Count == 0 || cuota.Soportes.All(s => string.IsNullOrWhiteSpace(s.ArchivoNombre) || string.IsNullOrWhiteSpace(s.ArchivoUrl)))
        {
            return $"El Registro #{numeroRegistro} ({cuota.TipoCuota} · {cuota.Periodicidad}) no tiene documento de soporte adjunto.";
        }

        return string.Empty;
    }

    // ==================== UTILIDADES DE VALIDACIÓN NUMÉRICA Y DE ARCHIVOS ====================

    private static string ValidarTextoAreaHectareas(string raw, string etiquetaCampo)
    {
        var limpio = raw.Trim();
        if (limpio.StartsWith('-'))
        {
            return $"{etiquetaCampo} debe ser un número positivo mayor a 0.";
        }

        if (!IntentarParsearDecimalPositivoConDosDecimales(limpio, out var valor))
        {
            if (limpio.Any(c => !char.IsAsciiDigit(c) && c != '.' && c != ','))
            {
                return $"{etiquetaCampo} solo acepta números positivos (sin letras ni símbolos).";
            }
            return $"{etiquetaCampo} permite máximo 2 decimales.";
        }

        if (valor <= 0m)
        {
            return $"{etiquetaCampo} debe ser mayor a 0 ha.";
        }

        if (valor > 10_000_000m)
        {
            return $"{etiquetaCampo} no puede superar 10.000.000 ha.";
        }

        return string.Empty;
    }

    private static string ValidarMontoDesdeCeroConDosDecimales(string raw, string etiquetaCampo)
    {
        var limpio = raw.Trim().Replace("$", "").Replace("COP", "", StringComparison.OrdinalIgnoreCase).Trim();
        if (limpio.StartsWith('-'))
        {
            return $"{etiquetaCampo} no puede ser un valor negativo.";
        }

        if (!IntentarParsearDecimalPositivoConDosDecimales(limpio, out _))
        {
            if (limpio.Any(c => !char.IsAsciiDigit(c) && c != '.' && c != ','))
            {
                return $"{etiquetaCampo} solo permite números válidos desde cero (sin letras ni símbolos).";
            }
            return $"{etiquetaCampo} permite números enteros o con máximo 2 decimales (ej: 50000 o 50.000).";
        }

        return string.Empty;
    }

    public static bool IntentarParsearDecimalPositivoConDosDecimales(string texto, out decimal valor)
    {
        valor = 0m;
        if (string.IsNullOrWhiteSpace(texto)) return false;

        var limpio = texto.Trim()
            .Replace("$", "")
            .Replace("COP", "", StringComparison.OrdinalIgnoreCase)
            .Trim();

        if (string.IsNullOrWhiteSpace(limpio)) return false;
        if (limpio.StartsWith('-')) return false;

        if (limpio.Any(c => !char.IsAsciiDigit(c) && c != '.' && c != ','))
        {
            return false;
        }

        var tienePunto = limpio.Contains('.');
        var tieneComa = limpio.Contains(',');

        if (tienePunto && tieneComa)
        {
            var ultimoPunto = limpio.LastIndexOf('.');
            var ultimaComa = limpio.LastIndexOf(',');

            if (ultimaComa > ultimoPunto)
            {
                // Formato es-CO: 1.500.000,50 -> quitar puntos de miles, cambiar coma por punto
                limpio = limpio.Replace(".", "").Replace(',', '.');
            }
            else
            {
                // Formato en-US: 1,500,000.50 -> quitar comas de miles
                limpio = limpio.Replace(",", "");
            }
        }
        else if (tienePunto)
        {
            var partes = limpio.Split('.');
            if (partes.Length > 2)
            {
                // Múltiples puntos: "1.500.000" -> miles
                limpio = limpio.Replace(".", "");
            }
            else if (partes.Length == 2)
            {
                // Si la parte derecha tiene 3 dígitos ("50.000"), en COP son miles
                if (partes[1].Length == 3 && partes[0].Length > 0 && partes[0].All(char.IsAsciiDigit) && partes[1].All(char.IsAsciiDigit))
                {
                    limpio = limpio.Replace(".", "");
                }
                else if (partes[1].Length > 2)
                {
                    return false;
                }
            }
        }
        else if (tieneComa)
        {
            var partes = limpio.Split(',');
            if (partes.Length > 2)
            {
                // Múltiples comas: "1,500,000" -> miles
                limpio = limpio.Replace(",", "");
            }
            else if (partes.Length == 2)
            {
                // Si la parte derecha tiene 3 dígitos ("50,000"), en COP son miles
                if (partes[1].Length == 3 && partes[0].Length > 0 && partes[0].All(char.IsAsciiDigit) && partes[1].All(char.IsAsciiDigit))
                {
                    limpio = limpio.Replace(",", "");
                }
                else if (partes[1].Length <= 2)
                {
                    limpio = limpio.Replace(',', '.');
                }
                else
                {
                    return false;
                }
            }
        }

        if (!decimal.TryParse(
            limpio,
            System.Globalization.NumberStyles.AllowDecimalPoint,
            System.Globalization.CultureInfo.InvariantCulture,
            out valor))
        {
            return false;
        }

        if (valor < 0m) return false;

        valor = Math.Round(valor, 2);
        return true;
    }

    private static string ValidarArchivoSubido(IBrowserFile archivo)
    {
        const long maxBytes = 10L * 1024L * 1024L;
        if (archivo.Size <= 0)
        {
            return $"El archivo \"{archivo.Name}\" está vacío (0 bytes). Seleccione un archivo válido.";
        }

        if (archivo.Size > maxBytes)
        {
            return $"El archivo \"{archivo.Name}\" supera el tamaño máximo permitido de 10 MB.";
        }

        var extension = Path.GetExtension(archivo.Name);
        if (string.IsNullOrWhiteSpace(extension) || !ExtensionesPermitidas.Contains(extension))
        {
            return $"Formato no permitido ({extension}). Solo se aceptan archivos PDF, JPG o PNG.";
        }

        return string.Empty;
    }

