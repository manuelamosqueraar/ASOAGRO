    private static string ObtenerClaseEstadoCuota(string estado)
    {
        if (estado.Contains("Pagado", StringComparison.OrdinalIgnoreCase) || estado.Contains("Al día", StringComparison.OrdinalIgnoreCase))
            return "ok";
        if (estado.Contains("Vencido", StringComparison.OrdinalIgnoreCase) || estado.Contains("mora", StringComparison.OrdinalIgnoreCase))
            return "mora";
        if (estado.Contains("parcial", StringComparison.OrdinalIgnoreCase))
            return "parcial";
        return "pendiente";
    }

    private static async Task<string> ConvertirArchivoADataUrlAsync(IBrowserFile archivo)
    {
        try
        {
            const long maxBytes = 15L * 1024L * 1024L;
            await using var stream = archivo.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var bytes = ms.ToArray();
            var mime = string.IsNullOrWhiteSpace(archivo.ContentType)
                ? ObtenerMimePorExtension(archivo.Name)
                : archivo.ContentType;
            return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            return string.Empty;
        }
    }

    private static string ObtenerMimePorExtension(string nombre)
    {
        var ext = Path.GetExtension(nombre).ToLowerInvariant();
        return ext switch
        {
            ".pdf" => "application/pdf",
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            _ => "application/octet-stream"
        };
    }

