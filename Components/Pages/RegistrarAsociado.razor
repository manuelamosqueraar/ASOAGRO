@page "/registrar-asociado"
@rendermode InteractiveServer
@inject HttpClient Http

<div class="page-header">
    <div>
        <p class="eyebrow text-success">Asociados</p>
        <h1>Registrar productor</h1>
        <p>Captura la información base del asociado y deja trazabilidad inicial del registro.</p>
    </div>
    <span class="status-chip">Validación activa</span>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger" role="alert">
        @mensajeError
    </div>
}

<div class="content-card">
    <div class="form-intro">
        <div>
            <h2>Datos del asociado</h2>
            <p>Los campos de cédula y nombre son obligatorios para crear el registro.</p>
        </div>
    </div>

    <EditForm Model="@asociado" OnValidSubmit="ManejarValidacion">
        <DataAnnotationsValidator />
        

        <div class="row g-3">
            <div class="col-md-6">
                <label for="nombre" class="form-label">Nombre Completo</label>
                <InputText id="nombre" class="form-control" @bind-Value="asociado.NombreCompleto" />
                <ValidationMessage For="@(() => asociado.NombreCompleto)" />
            </div>

            <div class="col-md-6">
                <label for="documento" class="form-label">Cédula</label>
                <InputText id="documento" class="form-control" @bind-Value="asociado.Cedula" />
                <ValidationMessage For="@(() => asociado.Cedula)" />
            </div>

            <div class="col-md-6">
                <label for="finca" class="form-label">Finca / Vereda</label>
                <InputText id="finca" class="form-control" @bind-Value="asociado.FincaVereda" />
                <ValidationMessage For="@(() => asociado.FincaVereda)" />
            </div>

            <div class="col-md-6">
                <label for="cultivo" class="form-label">Línea Productiva / Cultivo</label>
                <InputSelect id="cultivo" class="form-select" @bind-Value="asociado.CultivoPrincipal">
                    <option value="">Seleccione un cultivo...</option>
                    <option value="Platano">Plátano</option>
                    <option value="Banano">Banano</option>
                    <option value="Cacao">Cacao</option>
                    <option value="Ganaderia">Ganadería</option>
                </InputSelect>
                <ValidationMessage For="@(() => asociado.CultivoPrincipal)" />
            </div>
        </div>

        <div class="form-check my-4">
            <InputCheckbox id="bpa" class="form-check-input" @bind-Value="asociado.TieneBPA" />
            <label for="bpa" class="form-check-label">Cuenta con Buenas Prácticas Agrícolas (BPA)</label>
        </div>

        <button type="submit" class="btn btn-primary btn-lg" disabled="@guardando">
            @(guardando ? "Registrando..." : "Registrar Asociado")
        </button>
    </EditForm>
</div>

@code {
    private Asociado asociado = new();
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private bool guardando;

    private async Task ManejarValidacion()
    {
        guardando = true;
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/asociados", asociado);

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeExito = $"¡Asociado {asociado.NombreCompleto} registrado con éxito!";
                asociado = new();
                return;
            }

            var apiError = await respuesta.Content.ReadFromJsonAsync<ApiError>();
            mensajeError = apiError?.Message ?? "No fue posible registrar el asociado. Intenta nuevamente.";
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        finally
        {
            guardando = false;
        }
    }
}
