    private void CambiarPaso(int destino)
    {
        if (registroExitoso) return;

        if (destino < pasoActual)
        {
            pasoActual = destino;
            desplegableCultivosAbierto = false;
            municipioAbierto = false;
            mensajeAlerta = "";
            return;
        }

        while (pasoActual < destino)
        {
            if (!ValidarPasoActual()) return;
            if (pasoActual == 2 && string.IsNullOrWhiteSpace(hectareasProductivasTexto) && nuevoAsociado.HectareasPredio > 0)
            {
                nuevoAsociado.HectareasLineaProductiva = nuevoAsociado.HectareasPredio;
                hectareasProductivasTexto = nuevoAsociado.HectareasPredio.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
            }
            pasoActual++;
        }
        desplegableCultivosAbierto = false;
        municipioAbierto = false;
    }

    private void SiguientePaso()
    {
        if (!ValidarPasoActual()) return;

        if (pasoActual == 2 && string.IsNullOrWhiteSpace(hectareasProductivasTexto) && nuevoAsociado.HectareasPredio > 0)
        {
            nuevoAsociado.HectareasLineaProductiva = nuevoAsociado.HectareasPredio;
            hectareasProductivasTexto = nuevoAsociado.HectareasPredio.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
        }

        desplegableCultivosAbierto = false;
        municipioAbierto = false;
        pasoActual++;
    }

    private void PasoAnterior()
    {
        mensajeAlerta = "";
        desplegableCultivosAbierto = false;
        municipioAbierto = false;
        if (pasoActual > 1) pasoActual--;
    }

    private string ObtenerPrimerErrorPaso(int paso)
    {
        switch (paso)
        {
            case 1:
                return FirstNonEmpty(
                    ValidarNombreCompleto(),
                    ValidarDocumentoIdentidad(),
                    ValidarArchivoIdentidad(),
                    ValidarAsociacionPertenece(),
                    ValidarTelefono(),
                    ValidarCorreo());
            case 2:
                return FirstNonEmpty(
                    ValidarNombrePredio(),
                    ValidarVereda(),
                    ValidarMunicipio(),
                    ValidarHectareasPredio(),
                    ValidarTenenciaTerreno());
            case 3:
                return FirstNonEmpty(
                    ValidarCultivosLineaProductiva(),
                    ValidarHectareasProductivas(),
                    ValidarTipoActividad(),
                    ValidarProduccionAproximada(),
                    ValidarCertificadoBpa());
            case 4:
                var errorEstado = ValidarEstadoMembresia();
                if (!string.IsNullOrEmpty(errorEstado)) return errorEstado;
                foreach (var g in nuevoAsociado.GruposVulnerables)
                {
                    var err = ValidarSoporteGrupoVulnerable(g, AsociadoModel.TraducirGrupoVulnerable(g));
                    if (!string.IsNullOrEmpty(err)) return err;
                }
                return string.Empty;
            case 5:
                if (nuevoAsociado.CuotasAportes.Count == 0)
                {
                    return "Registre al menos una cuota social o aporte económico.";
                }
                for (var i = 0; i < nuevoAsociado.CuotasAportes.Count; i++)
                {
                    var c = nuevoAsociado.CuotasAportes[i];
                    var err = FirstNonEmpty(
                        ValidarTipoCuota(c),
                        ValidarPeriodicidadCuota(c),
                        ValidarValorCuota(c),
                        ValidarFechaVencimientoCuota(c),
                        ValidarCantidadPendientesCuota(c),
                        ValidarValorPagadoCuota(c),
                        ValidarSoporteCuota(c, i + 1));
                    if (!string.IsNullOrEmpty(err)) return err;
                }
                return string.Empty;
            default:
                return string.Empty;
        }
    }

    private static string FirstNonEmpty(params string[] mensajes) =>
        mensajes.FirstOrDefault(m => !string.IsNullOrWhiteSpace(m)) ?? string.Empty;

    private bool ValidarPasoActual()
    {
        mensajeAlerta = "";
        esError = false;
        MarcarCamposPasoComoTocados(pasoActual);

        var error = ObtenerPrimerErrorPaso(pasoActual);
        if (!string.IsNullOrEmpty(error))
        {
            mensajeAlerta = error;
            esError = true;
            return false;
        }

        return true;
    }

    private async Task GuardarRegistro()
    {
        if (esAdminSupervisor)
        {
            mensajeAlerta = "Modo supervisión: el rol Administrador supervisa y consulta el padrón. La inscripción oficial de asociados corresponde a Secretaría.";
            esError = true;
            return;
        }

        for (var p = 1; p <= 5; p++)
        {
            MarcarCamposPasoComoTocados(p);
        }

        for (var p = 1; p <= 5; p++)
        {
            var errPaso = ObtenerPrimerErrorPaso(p);
            if (!string.IsNullOrEmpty(errPaso))
            {
                pasoActual = p;
                mensajeAlerta = errPaso;
                esError = true;
                return;
            }
        }

        foreach (var cuota in nuevoAsociado.CuotasAportes)
        {
            cuota.ActualizarEstadoYSoportes();
        }

        guardando = true;
        try
        {
            nuevoAsociado.SincronizarCultivosDesdeLista();
            nuevoAsociado.EsVictima = nuevoAsociado.GruposVulnerables.Count > 0 ? "Si" : "No";
            nuevoAsociado.FechaRegistro = DateTime.Now;

            var autor = await ObtenerUsuarioActualAsync();
            var resultado = RegistroAsociados.Registrar(AsociadoMapper.ToEntity(nuevoAsociado, autor));

            if (!resultado.Exitoso)
            {
                mensajeAlerta = resultado.Mensaje;
                esError = true;
                return;
            }

            Notificaciones.Publicar(new Asoagro.Models.Notificacion
            {
                Titulo = "Nuevo productor registrado",
                Descripcion = $"{nuevoAsociado.NombreCompleto} · {nuevoAsociado.NombrePredio}, {nuevoAsociado.VeredaSector}. Registrado por {autor}.",
                Etiqueta = "Registro",
                Enlace = "/consultar-asociados",
                Icono = "usuario-mas",
                Categoria = Asoagro.Models.CategoriaNotificacion.Productores,
                Nivel = Asoagro.Models.NivelNotificacion.Informativa,
                RolesEnlace = new[] { "Secretaria", "Administrador" }
            });

            expedienteGuardado = new AsociadoModel
            {
                NombreCompleto = nuevoAsociado.NombreCompleto,
                TipoDocumentoIdentidad = nuevoAsociado.TipoDocumentoIdentidad,
                Cedula = nuevoAsociado.Cedula,
                AsociacionPertenece = nuevoAsociado.AsociacionPertenece,
                Telefono = nuevoAsociado.Telefono,
                Correo = nuevoAsociado.Correo,
                CedulaArchivoNombre = nuevoAsociado.CedulaArchivoNombre,
                CedulaArchivoTamano = nuevoAsociado.CedulaArchivoTamano,
                CedulaArchivoUrl = nuevoAsociado.CedulaArchivoUrl,
                NombrePredio = nuevoAsociado.NombrePredio,
                VeredaSector = nuevoAsociado.VeredaSector,
                Municipio = nuevoAsociado.Municipio,
                TenenciaTerreno = nuevoAsociado.TenenciaTerreno,
                HectareasPredio = nuevoAsociado.HectareasPredio,
                HectareasLineaProductiva = nuevoAsociado.HectareasLineaProductiva,
                TipoActividadProductiva = nuevoAsociado.TipoActividadProductiva,
                ProduccionAproximada = nuevoAsociado.ProduccionAproximada,
                CultivoPrincipal = nuevoAsociado.CultivoPrincipal,
                CultivosSeleccionados = new List<string>(nuevoAsociado.CultivosSeleccionados),
                TieneBPA = nuevoAsociado.TieneBPA,
                CertificadoBpaNombre = nuevoAsociado.CertificadoBpaNombre,
                CertificadoBpaTamano = nuevoAsociado.CertificadoBpaTamano,
                CertificadoBpaUrl = nuevoAsociado.CertificadoBpaUrl,
                EsVictima = nuevoAsociado.EsVictima,
                GruposVulnerables = new List<string>(nuevoAsociado.GruposVulnerables),
                SoportesGruposVulnerables = new Dictionary<string, string>(
                    nuevoAsociado.SoportesGruposVulnerables,
                    StringComparer.OrdinalIgnoreCase),
                SoportesGruposUrls = new Dictionary<string, string>(
                    nuevoAsociado.SoportesGruposUrls,
                    StringComparer.OrdinalIgnoreCase),
                CuotasAportes = nuevoAsociado.CuotasAportes.Select(c => c.Clonar()).ToList(),
                EstadoMembresia = nuevoAsociado.EstadoMembresia,
                FechaRegistro = DateTime.Now
            };

            mensajeAlerta = "";
            esError = false;
            registroExitoso = true;
            mostrarModalFicha = false;
            await BloquearScrollModalAsync(true);
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar el guardado del asociado: {ex.Message}";
            esError = true;
        }
        finally
        {
            guardando = false;
            StateHasChanged();
        }
    }

    private async Task ReiniciarFormulario()
    {
        nuevoAsociado = new AsociadoModel();
        expedienteGuardado = null;
        pasoActual = 1;
        registroExitoso = false;
        mostrarModalFicha = false;
        mostrarVisorDocumento = false;
        desplegableCultivosAbierto = false;
        municipioAbierto = false;
        hectareasPredioTexto = "";
        hectareasProductivasTexto = "";
        camposTocados.Clear();
        erroresArchivos.Clear();
        textosValorCuota.Clear();
        textosCantidadCuota.Clear();
        textosPagadoCuota.Clear();
        textosFechaCuota.Clear();
        mensajeAlerta = "";
        await BloquearScrollModalAsync(false);
    }

    private async Task BloquearScrollModalAsync(bool bloquear)
    {
        if (bloquear)
        {
            ModuloJavaScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/actas-archivos.js");
            await ModuloJavaScript.InvokeVoidAsync("bloquearScroll", true);
        }
        else if (ModuloJavaScript is not null)
        {
            await ModuloJavaScript.InvokeVoidAsync("bloquearScroll", false);
        }
    }

    private static string FormatearTamanoArchivo(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        var kb = bytes / 1024.0;
        if (kb < 1024) return $"{kb:0.#} KB";
        var mb = kb / 1024.0;
        return $"{mb:0.##} MB";
    }

    private static string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length >= 2
            ? $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant()
            : partes[0][0].ToString().ToUpperInvariant();
    }

    private async Task<string> ObtenerUsuarioActualAsync()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        return estado.User.Identity?.Name
            ?? estado.User.FindFirst(ClaimTypes.Email)?.Value
            ?? "Secretaría";
    }

    public async ValueTask DisposeAsync()
    {
        if (ModuloJavaScript is null) return;
        try
        {
            await ModuloJavaScript.InvokeVoidAsync("bloquearScroll", false);
            await ModuloJavaScript.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
