    // ==================== VALIDACIONES DE IDENTIFICACIÓN (PASO 1) ====================

    private string ValidarNombreCompleto()
    {
        var raw = nuevoAsociado.NombreCompleto ?? string.Empty;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "Los nombres y apellidos son obligatorios.";
        }

        var limpio = raw.Trim();
        if (limpio.Length > 60)
        {
            return "El nombre completo no puede superar los 60 caracteres.";
        }

        foreach (var ch in limpio)
        {
            if (char.IsLetter(ch) || ch == ' ' || ch == '-')
            {
                continue;
            }
            return "Solo se permiten letras, tildes, espacios y guiones (sin números, emojis ni símbolos como @, # o $).";
        }

        var palabras = limpio.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (palabras.Length < 2)
        {
            return "Ingrese al menos un nombre y un apellido (mínimo 2 caracteres cada uno).";
        }

        foreach (var palabra in palabras)
        {
            var partesGuion = palabra.Split('-', StringSplitOptions.RemoveEmptyEntries);
            if (partesGuion.Length == 0 || palabra.StartsWith('-') || palabra.EndsWith('-') || palabra.Contains("--"))
            {
                return "Cada nombre o apellido debe tener al menos 2 letras válidas.";
            }

            var letrasEnPalabra = palabra.Count(char.IsLetter);
            if (letrasEnPalabra < 2)
            {
                return "Cada nombre y apellido debe tener mínimo 2 caracteres.";
            }
        }

        return string.Empty;
    }

    private string ValidarDocumentoIdentidad()
    {
        var raw = nuevoAsociado.Cedula ?? string.Empty;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return nuevoAsociado.TipoDocumentoIdentidad == "NIT"
                ? "El número de NIT es obligatorio."
                : "La cédula de ciudadanía es obligatoria.";
        }

        if (nuevoAsociado.TipoDocumentoIdentidad == "NIT")
        {
            return ValidarNitColombiano(raw);
        }

        // Cédula de ciudadanía: aceptar solo números, sin puntos, espacios ni guiones; mínimo 6 y máximo 10 dígitos.
        foreach (var ch in raw)
        {
            if (!char.IsAsciiDigit(ch))
            {
                return "La cédula debe contener solo números, sin puntos, espacios ni guiones.";
            }
        }

        if (raw.Length < 6 || raw.Length > 10)
        {
            return "La cédula debe tener entre 6 y 10 dígitos.";
        }

        if (EsMismoDigitoRepetido(raw))
        {
            return "El número de documento no puede consistir únicamente en el mismo dígito repetido.";
        }

        return string.Empty;
    }

    private static string ValidarNitColombiano(string raw)
    {
        // NIT: aceptar entre 9 y 10 dígitos, con dígito de verificación opcional separado por guion (ej. 900123456-8) o en el décimo dígito.
        if (raw.Any(char.IsWhiteSpace) || raw.Contains('.'))
        {
            return "El NIT no debe contener espacios ni puntos (ej: 900123456-8 o 900123456).";
        }

        var partes = raw.Split('-');
        if (partes.Length > 2)
        {
            return "Formato de NIT inválido. Ingrese 9 o 10 dígitos (ej: 900123456-8).";
        }

        var soloDigitos = raw.Replace("-", "");
        if (soloDigitos.Length == 0 || !soloDigitos.All(char.IsAsciiDigit))
        {
            return "El NIT solo puede contener números y opcionalmente un guion para el dígito de verificación.";
        }

        if (EsMismoDigitoRepetido(soloDigitos))
        {
            return "El número de documento no puede consistir únicamente en el mismo dígito repetido.";
        }

        if (partes.Length == 2)
        {
            var baseNit = partes[0];
            var dvTexto = partes[1];
            if (baseNit.Length != 9 || dvTexto.Length != 1)
            {
                return "Cuando incluye guion, el NIT debe tener 9 dígitos base más 1 dígito de verificación (ej: 900123456-8).";
            }

            if (EsMismoDigitoRepetido(baseNit))
            {
                return "El número de NIT no puede consistir en el mismo dígito repetido.";
            }

            var dvEsperado = CalcularDigitoVerificacionNit(baseNit);
            var dvIngresado = dvTexto[0] - '0';
            if (dvIngresado != dvEsperado)
            {
                return $"El dígito de verificación del NIT no es válido (para {baseNit} corresponde -{dvEsperado}).";
            }

            return string.Empty;
        }

        if (raw.Length < 9 || raw.Length > 10)
        {
            return "El NIT debe tener entre 9 y 10 dígitos.";
        }

        if (raw.Length == 10)
        {
            var baseNit = raw[..9];
            var dvIngresado = raw[9] - '0';
            var dvEsperado = CalcularDigitoVerificacionNit(baseNit);
            if (dvIngresado != dvEsperado)
            {
                return $"El dígito de verificación del NIT no coincide (para {baseNit} el dígito válido es {dvEsperado}).";
            }
        }

        return string.Empty;
    }

    private static int CalcularDigitoVerificacionNit(string baseNit)
    {
        int[] pesos = { 3, 7, 13, 17, 19, 23, 29, 37, 41, 43, 47, 53, 59, 67, 71 };
        var suma = 0;
        var longitud = baseNit.Length;
        for (var i = 0; i < longitud; i++)
        {
            var digito = baseNit[longitud - 1 - i] - '0';
            suma += digito * pesos[i];
        }

        var residuo = suma % 11;
        return residuo > 1 ? 11 - residuo : residuo;
    }

    private static bool EsMismoDigitoRepetido(string digitos)
    {
        if (string.IsNullOrEmpty(digitos)) return false;
        var primero = digitos[0];
        return digitos.All(c => c == primero);
    }

    private string ValidarArchivoIdentidad()
    {
        if (erroresArchivos.TryGetValue("cedulaArchivo", out var errArchivo) && !string.IsNullOrEmpty(errArchivo))
        {
            return errArchivo;
        }

        if (string.IsNullOrWhiteSpace(nuevoAsociado.CedulaArchivoNombre) || string.IsNullOrWhiteSpace(nuevoAsociado.CedulaArchivoUrl))
        {
            return nuevoAsociado.TipoDocumentoIdentidad == "NIT"
                ? "Es obligatorio adjuntar el documento del NIT (PDF, JPG o PNG, máx. 10 MB)."
                : "Es obligatorio adjuntar la fotocopia de la cédula de ciudadanía (PDF, JPG o PNG, máx. 10 MB).";
        }

        return string.Empty;
    }

    private string ValidarTelefono()
    {
        var raw = nuevoAsociado.Telefono ?? string.Empty;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "El número de celular es obligatorio.";
        }

        foreach (var ch in raw)
        {
            if (!char.IsAsciiDigit(ch))
            {
                return "El celular solo debe contener números (sin espacios, letras ni símbolos).";
            }
        }

        if (!raw.StartsWith('3'))
        {
            return "El número de celular debe comenzar por 3.";
        }

        if (raw.Length != 10)
        {
            return "El celular debe tener exactamente 10 dígitos y comenzar por 3.";
        }

        return string.Empty;
    }

    private string ValidarCorreo()
    {
        var raw = nuevoAsociado.Correo ?? string.Empty;
        if (string.IsNullOrEmpty(raw))
        {
            return string.Empty;
        }

        if (raw.Any(char.IsWhiteSpace))
        {
            return "El correo electrónico no puede contener espacios.";
        }

        var partesArroba = raw.Split('@');
        if (partesArroba.Length != 2)
        {
            return "El correo electrónico debe incluir usuario, un símbolo @ y un dominio válido.";
        }

        var usuario = partesArroba[0];
        var dominio = partesArroba[1];
        if (string.IsNullOrWhiteSpace(usuario) || usuario.StartsWith('.') || usuario.EndsWith('.') || usuario.Contains(".."))
        {
            return "Ingrese un nombre de usuario válido antes del @ en el correo electrónico.";
        }

        if (string.IsNullOrWhiteSpace(dominio) || !dominio.Contains('.') || dominio.StartsWith('.') || dominio.EndsWith('.') || dominio.Contains(".."))
        {
            return "El correo electrónico debe tener un dominio válido (ej: @dominio.com).";
        }

        var etiquetasDominio = dominio.Split('.');
        if (etiquetasDominio.Any(e => e.Length == 0) || etiquetasDominio[^1].Length < 2)
        {
            return "El dominio del correo electrónico no es válido.";
        }

        return string.Empty;
    }

