@page "/registrar-asociado"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Director")]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Asoagro.Services
@inject AsociadoService AsociadoService

<div class="ra">

    <!-- ENCABEZADO -->
    <section class="ra-hero">
        <div class="ra-hero-texto">
            <div class="ra-etiquetas">
                <span class="ra-etiqueta"><svg class="ra-ico"><use href="#ico-brote" /></svg>FAAUA · Urabá Antioqueño</span>
                <span class="ra-etiqueta ra-etiqueta-suave"><svg class="ra-ico"><use href="#ico-escudo" /></svg>Módulo directivo</span>
            </div>
            <h1 class="ra-titulo">Nuevos productores</h1>
            <p class="ra-descripcion">Caracteriza el predio, registra la línea productiva y vincula al asociado al padrón de la federación.</p>
        </div>

        <div class="ra-hero-progreso">
            <span class="ra-hero-etiqueta">Avance del expediente</span>
            <strong class="ra-hero-valor">@(Progreso)%</strong>
            <div class="ra-barra"><div class="ra-barra-relleno" style="width: @(Progreso)%;"></div></div>
            <span class="ra-hero-pie">@(RegistroCompleto ? "Listo para guardar" : "Faltan datos obligatorios")</span>
        </div>
    </section>

    <!-- PASOS -->
    <nav class="ra-pasos" aria-label="Pasos del registro">
        <div class="ra-pasos-linea"><div class="ra-pasos-relleno" style="width: @(ProgresoPasos)%;"></div></div>

        <button type="button" class="ra-paso @(PasoActual == 1 ? "activo" : "") @(Paso1Completo ? "completo" : "")" @onclick="() => IrAlPaso(1)">
            <span class="ra-paso-num">
                @if (Paso1Completo) { <svg class="ra-ico"><use href="#ico-check" /></svg> } else { <span>1</span> }
            </span>
            <span class="ra-paso-titulo">Identificación</span>
            <span class="ra-paso-sub">Datos y contacto</span>
        </button>

        <button type="button" class="ra-paso @(PasoActual == 2 ? "activo" : "") @(Paso2Completo ? "completo" : "")" @onclick="() => IrAlPaso(2)">
            <span class="ra-paso-num">
                @if (Paso2Completo) { <svg class="ra-ico"><use href="#ico-check" /></svg> } else { <span>2</span> }
            </span>
            <span class="ra-paso-titulo">Predio</span>
            <span class="ra-paso-sub">Finca, vereda y área</span>
        </button>

        <button type="button" class="ra-paso @(PasoActual == 3 ? "activo" : "") @(Paso3Completo ? "completo" : "")" @onclick="() => IrAlPaso(3)">
            <span class="ra-paso-num">
                @if (Paso3Completo) { <svg class="ra-ico"><use href="#ico-check" /></svg> } else { <span>3</span> }
            </span>
            <span class="ra-paso-titulo">Cultivo y BPA</span>
            <span class="ra-paso-sub">Línea y aval ICA</span>
        </button>

        <button type="button" class="ra-paso @(PasoActual == 4 ? "activo" : "")" @onclick="() => IrAlPaso(4)">
            <span class="ra-paso-num"><span>4</span></span>
            <span class="ra-paso-titulo">Social y jurídico</span>
            <span class="ra-paso-sub">Víctimas y membresía</span>
        </button>
    </nav>

    <!-- ALERTAS -->
    @if (!string.IsNullOrEmpty(mensajeExito))
    {
        <div class="ra-alerta ra-alerta-exito">
            <svg class="ra-ico"><use href="#ico-check" /></svg>
            <span>@mensajeExito</span>
            <button type="button" class="ra-alerta-cerrar" @onclick="() => mensajeExito = string.Empty" aria-label="Cerrar">&times;</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(mensajeError))
    {
        <div class="ra-alerta ra-alerta-error">
            <svg class="ra-ico"><use href="#ico-alerta" /></svg>
            <span>@mensajeError</span>
            <button type="button" class="ra-alerta-cerrar" @onclick="() => mensajeError = string.Empty" aria-label="Cerrar">&times;</button>
        </div>
    }

    <EditForm Model="asociado" OnValidSubmit="ManejarEnvio" class="ra-layout">
        <DataAnnotationsValidator />

        <!-- FORMULARIO -->
        <div class="ra-panel">

            @if (PasoActual == 1)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-usuario" /></svg></span>
                        <div class="ra-seccion-texto">
                            <h2>Identificación y contacto</h2>
                            <p>Datos personales y medios de contacto del titular.</p>
                        </div>
                        <span class="ra-estado @(Paso1Completo ? "ra-estado-ok" : "")">@(Paso1Completo ? "Completo" : "Pendiente")</span>
                    </header>

                    <div class="ra-grid">
                        <div class="ra-campo ra-ancho-total">
                            <label class="ra-label" for="ra-nombre">Nombre completo <span class="ra-req">*</span></label>
                            <InputText id="ra-nombre" class="ra-input" placeholder="Ej: Juan Antonio Pérez Mosquera" @bind-Value="asociado.NombreCompleto" />
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-cedula">Cédula de ciudadanía <span class="ra-req">*</span></label>
                            <InputText id="ra-cedula" class="ra-input" placeholder="Ej: 1045123890" @bind-Value="asociado.Cedula" />
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-telefono">Número de celular <span class="ra-req">*</span></label>
                            <InputText id="ra-telefono" class="ra-input" placeholder="Ej: 3104567890" @bind-Value="asociado.Telefono" />
                        </div>

                        <div class="ra-campo ra-ancho-total">
                            <label class="ra-label" for="ra-correo">Correo electrónico <span class="ra-opcional">(opcional)</span></label>
                            <InputText id="ra-correo" class="ra-input" placeholder="Ej: juan.perez@email.com" @bind-Value="asociado.Correo" />
                        </div>
                    </div>

                    <div class="ra-acciones">
                        <span></span>
                        <button type="button" class="ra-btn ra-btn-primario" @onclick="SiguientePaso">
                            Siguiente: predio
                            <svg class="ra-ico ra-ico-derecha"><use href="#ico-flecha" /></svg>
                        </button>
                    </div>
                </div>
            }

            @if (PasoActual == 2)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-mapa" /></svg></span>
                        <div class="ra-seccion-texto">
                            <h2>Ubicación y predio</h2>
                            <p>Detalle de la finca, la vereda y la extensión rural.</p>
                        </div>
                        <span class="ra-estado @(Paso2Completo ? "ra-estado-ok" : "")">@(Paso2Completo ? "Completo" : "Pendiente")</span>
                    </header>

                    <div class="ra-grid">
                        <div class="ra-campo">
                            <label class="ra-label" for="ra-predio">Nombre del predio o finca <span class="ra-req">*</span></label>
                            <InputText id="ra-predio" class="ra-input" placeholder="Ej: Finca La Esperanza" @bind-Value="asociado.NombrePredio" />
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-vereda">Vereda o sector <span class="ra-req">*</span></label>
                            <InputText id="ra-vereda" class="ra-input" placeholder="Ej: Vereda El Tres" @bind-Value="asociado.VeredaSector" />
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-municipio">Municipio <span class="ra-req">*</span></label>
                            <InputText id="ra-municipio" class="ra-input" placeholder="Ej: Carepa / Apartadó" @bind-Value="asociado.Municipio" />
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-hectareas">Área del predio (hectáreas) <span class="ra-req">*</span></label>
                            <InputNumber id="ra-hectareas" class="ra-input" placeholder="Ej: 4.5" @bind-Value="asociado.HectareasPredio" min="1" step="0.1" />
                        </div>
                    </div>

                    <div class="ra-acciones">
                        <button type="button" class="ra-btn ra-btn-secundario" @onclick="AnteriorPaso">
                            <svg class="ra-ico ra-ico-izquierda"><use href="#ico-flecha" /></svg>
                            Anterior
                        </button>
                        <button type="button" class="ra-btn ra-btn-primario" @onclick="SiguientePaso">
                            Siguiente: cultivo
                            <svg class="ra-ico ra-ico-derecha"><use href="#ico-flecha" /></svg>
                        </button>
                    </div>
                </div>
            }

            @if (PasoActual == 3)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-brote" /></svg></span>
                        <div class="ra-seccion-texto">
                            <h2>Línea productiva y BPA</h2>
                            <p>Caracterización exigida por la asociación.</p>
                        </div>
                        <span class="ra-estado @(Paso3Completo ? "ra-estado-ok" : "")">@(Paso3Completo ? "Completo" : "Seleccione")</span>
                    </header>

                    <p class="ra-subtitulo">Línea productiva principal <span class="ra-req">*</span></p>
                    <div class="ra-cultivos">
                        @foreach (var item in LineasCultivo)
                        {
                            bool seleccionado = asociado.CultivoPrincipal == item.Valor;
                            <div class="ra-cultivo @(seleccionado ? "seleccionado" : "")" role="button" tabindex="0" @onclick="() => SeleccionarCultivo(item.Valor)">
                                <span class="ra-cultivo-ico"><svg class="ra-ico"><use href="#ico-@item.Icono" /></svg></span>
                                <span class="ra-cultivo-texto">
                                    <strong>@item.Titulo</strong>
                                    <small>@item.Subtitulo</small>
                                </span>
                                <span class="ra-radio @(seleccionado ? "activo" : "")"></span>
                            </div>
                        }
                    </div>

                    <div class="ra-bpa @(asociado.TieneBPA ? "activo" : "")" role="switch" tabindex="0" aria-checked="@(asociado.TieneBPA ? "true" : "false")" @onclick="AlternarBPA">
                        <span class="ra-bpa-ico"><svg class="ra-ico"><use href="#ico-escudo" /></svg></span>
                        <span class="ra-bpa-texto">
                            <strong>Buenas Prácticas Agrícolas (BPA - ICA)</strong>
                            <small>@(asociado.TieneBPA ? "Predio con aval fitosanitario vigente." : "Actívalo si el predio cumple la norma.")</small>
                        </span>
                        <span class="ra-switch"></span>
                    </div>

                    <div class="ra-acciones">
                        <button type="button" class="ra-btn ra-btn-secundario" @onclick="AnteriorPaso">
                            <svg class="ra-ico ra-ico-izquierda"><use href="#ico-flecha" /></svg>
                            Anterior
                        </button>
                        <button type="button" class="ra-btn ra-btn-primario" @onclick="SiguientePaso">
                            Siguiente: social
                            <svg class="ra-ico ra-ico-derecha"><use href="#ico-flecha" /></svg>
                        </button>
                    </div>
                </div>
            }

            @if (PasoActual == 4)
            {
                <div class="ra-seccion">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-red" /></svg></span>
                        <div class="ra-seccion-texto">
                            <h2>Componente social y jurídico</h2>
                            <p>Requisito de enfoque diferencial y estado de membresía.</p>
                        </div>
                        <span class="ra-estado ra-estado-ok">Final</span>
                    </header>

                    <div class="ra-grid">
                        <div class="ra-campo">
                            <label class="ra-label" for="ra-victima">¿Cuenta con certificado de la Unidad de Víctimas?</label>
                            <InputSelect id="ra-victima" class="ra-input" @bind-Value="asociado.EsVictima">
                                <option value="No">No registra / prefiere no indicar</option>
                                <option value="Si">Sí, cuenta con certificado activo</option>
                            </InputSelect>
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-membresia">Estado de cuota social</label>
                            <InputSelect id="ra-membresia" class="ra-input" @bind-Value="asociado.EstadoMembresia">
                                <option value="AlDia">Al día (habilitado para convocatorias)</option>
                                <option value="Gracia">En período de gracia</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="ra-acciones">
                        <button type="button" class="ra-btn ra-btn-secundario" @onclick="AnteriorPaso">
                            <svg class="ra-ico ra-ico-izquierda"><use href="#ico-flecha" /></svg>
                            Anterior
                        </button>
                        <button type="submit" class="ra-btn ra-btn-guardar" disabled="@guardando">
                            @if (guardando)
                            {
                                <span class="ra-spinner" aria-hidden="true"></span>
                                <span>Registrando en el sistema…</span>
                            }
                            else
                            {
                                <svg class="ra-ico"><use href="#ico-check" /></svg>
                                <span>Finalizar y guardar expediente</span>
                            }
                        </button>
                    </div>
                </div>
            }
        </div>

        <!-- CARNET DIGITAL -->
        <aside class="ra-carnet" aria-label="Vista previa de la credencial">
            <div class="ra-carnet-tarjeta">
                <div class="ra-carnet-cab">
                    <span class="ra-carnet-sello">Credencial provisional</span>
                    <span class="ra-carnet-cc">CC @(string.IsNullOrWhiteSpace(asociado.Cedula) ? "—" : asociado.Cedula)</span>

                    <div class="ra-carnet-avatar @(Paso1Completo ? "listo" : "")">
                        @ObtenerIniciales(asociado.NombreCompleto)
                        @if (asociado.TieneBPA)
                        {
                            <span class="ra-carnet-bpa" title="BPA vigente"><svg class="ra-ico"><use href="#ico-check" /></svg></span>
                        }
                    </div>

                    <h3>@(string.IsNullOrWhiteSpace(asociado.NombreCompleto) ? "Nombre del productor" : asociado.NombreCompleto)</h3>
                    <small>@(string.IsNullOrWhiteSpace(asociado.Telefono) ? "Teléfono pendiente" : asociado.Telefono)</small>
                </div>

                <div class="ra-carnet-cuerpo">
                    <div class="ra-carnet-fila">
                        <span>Predio</span>
                        <strong>@(string.IsNullOrWhiteSpace(asociado.NombrePredio) ? "Sin registrar" : $"{asociado.NombrePredio} ({asociado.HectareasPredio} ha)")</strong>
                    </div>
                    <div class="ra-carnet-fila">
                        <span>Cultivo eje</span>
                        <strong>@(string.IsNullOrWhiteSpace(asociado.CultivoPrincipal) ? "Pendiente" : asociado.CultivoPrincipal)</strong>
                    </div>
                    <div class="ra-carnet-fila">
                        <span>Certificación BPA</span>
                        @if (asociado.TieneBPA)
                        {
                            <span class="ra-pildora-ok">Vigente ICA</span>
                        }
                        else
                        {
                            <span class="ra-pildora-no">No registra</span>
                        }
                    </div>

                    <div class="ra-carnet-progreso">
                        <div class="ra-carnet-progreso-cab">
                            <span>Estado del expediente</span>
                            <strong>@(Progreso)%</strong>
                        </div>
                        <div class="ra-barra ra-barra-oscura"><div class="ra-barra-relleno" style="width: @(Progreso)%;"></div></div>
                    </div>

                    <div class="ra-carnet-pie">
                        <div>
                            <strong>ASOAGRO · FAAUA</strong>
                            <small>Gestión de asociados</small>
                        </div>
                        <span class="ra-carnet-qr" title="Código QR oficial"><svg class="ra-ico"><use href="#ico-mapa" /></svg></span>
                    </div>
                </div>
            </div>
        </aside>

    </EditForm>
</div>

@code {
    public class Asociado
    {
        public string NombreCompleto { get; set; } = string.Empty;
        public string Cedula { get; set; } = string.Empty;
        public string Telefono { get; set; } = string.Empty;
        public string Correo { get; set; } = string.Empty;
        public string NombrePredio { get; set; } = string.Empty;
        public string VeredaSector { get; set; } = string.Empty;
        public string Municipio { get; set; } = string.Empty;
        public double HectareasPredio { get; set; } = 1.0;
        public string CultivoPrincipal { get; set; } = string.Empty;
        public bool TieneBPA { get; set; }
        public string EsVictima { get; set; } = "No";
        public string EstadoMembresia { get; set; } = "AlDia";
    }

    private record OpcionCultivo(string Valor, string Titulo, string Subtitulo, string Icono);

    private readonly List<OpcionCultivo> LineasCultivo = new()
    {
        new("Platano", "Plátano de exportación", "Hartón / Dominico", "brote"),
        new("Banano", "Banano comercial", "Cavendish tipo exportación", "mapa"),
        new("Cacao", "Cacao fino de aroma", "Agroforestal sostenible", "red"),
        new("Ganaderia", "Ganadería sostenible", "Doble propósito", "escudo")
    };

    private Asociado asociado = new();
    private int PasoActual = 1;
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private bool guardando;

    private bool Paso1Completo => !string.IsNullOrWhiteSpace(asociado.NombreCompleto)
        && !string.IsNullOrWhiteSpace(asociado.Cedula)
        && !string.IsNullOrWhiteSpace(asociado.Telefono);

    private bool Paso2Completo => !string.IsNullOrWhiteSpace(asociado.NombrePredio)
        && !string.IsNullOrWhiteSpace(asociado.VeredaSector)
        && !string.IsNullOrWhiteSpace(asociado.Municipio)
        && asociado.HectareasPredio >= 1;

    private bool Paso3Completo => !string.IsNullOrWhiteSpace(asociado.CultivoPrincipal);

    // El expediente solo está listo cuando los pasos obligatorios 1, 2 y 3 están completos
    private bool RegistroCompleto => Paso1Completo && Paso2Completo && Paso3Completo;

    private string? PasoFaltante => !Paso1Completo ? "1" : !Paso2Completo ? "2" : !Paso3Completo ? "3" : null;

    private int Progreso =>
        (Paso1Completo ? 25 : 0) +
        (Paso2Completo ? 25 : 0) +
        (Paso3Completo ? 25 : 0) +
        (RegistroCompleto && PasoActual == 4 ? 25 : 0);

    private int ProgresoPasos => (PasoActual - 1) * 100 / 3;

    private bool PuedeIrA(int paso) => paso switch
    {
        1 => true,
        2 => Paso1Completo,
        3 => Paso1Completo && Paso2Completo,
        _ => RegistroCompleto
    };

    private void SiguientePaso()
    {
        if (PasoActual < 4) PasoActual++;
    }

    private void AnteriorPaso()
    {
        if (PasoActual > 1) PasoActual--;
    }

    private void IrAlPaso(int paso)
    {
        if (paso <= PasoActual || PuedeIrA(paso))
        {
            PasoActual = paso;
            mensajeError = string.Empty;
        }
    }

    private void SeleccionarCultivo(string valor) => asociado.CultivoPrincipal = valor;
    private void AlternarBPA() => asociado.TieneBPA = !asociado.TieneBPA;

    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();
        return $"{partes[0][0]}{partes[1][0]}".ToUpper();
    }

    private async Task ManejarEnvio()
    {
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        // Un productor con registro incompleto no se guarda, así no aparece en Consultar Asociados
        if (!RegistroCompleto)
        {
            PasoActual = int.Parse(PasoFaltante ?? "1");
            mensajeError = $"Completa el paso {PasoFaltante} antes de guardar el expediente.";
            return;
        }

        guardando = true;

        try
        {
            await Task.Delay(600);

            AsociadoService.AgregarAsociado(new AsociadoModel
            {
                NombreCompleto = asociado.NombreCompleto,
                Cedula = asociado.Cedula,
                Telefono = asociado.Telefono,
                Correo = asociado.Correo,
                NombrePredio = asociado.NombrePredio,
                VeredaSector = asociado.VeredaSector,
                Municipio = asociado.Municipio,
                HectareasPredio = asociado.HectareasPredio,
                CultivoPrincipal = asociado.CultivoPrincipal,
                TieneBPA = asociado.TieneBPA,
                EsVictima = asociado.EsVictima,
                EstadoMembresia = asociado.EstadoMembresia,
                FechaRegistro = DateTime.Now
            });

            mensajeExito = $"{asociado.NombreCompleto} quedó vinculado al padrón FAAUA.";
            asociado = new();
            PasoActual = 1;
        }
        catch
        {
            mensajeError = "No fue posible guardar el expediente. Intenta de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }
}