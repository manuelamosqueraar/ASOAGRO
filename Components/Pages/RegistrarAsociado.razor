    private async Task CargarSoportesCuota(CuotaAporteAsociado cuota, int numeroRegistro, InputFileChangeEventArgs e)
    {
        var claveSoporte = $"cuota_{cuota.Id}_soporte";
        camposTocados.Add(claveSoporte);
        erroresArchivos.Remove(claveSoporte);

        IReadOnlyList<IBrowserFile> archivos;
        try
        {
            archivos = e.GetMultipleFiles(10);
        }
        catch
        {
            archivos = e.File != null ? new[] { e.File } : Array.Empty<IBrowserFile>();
        }

        if (archivos is null || archivos.Count == 0) return;

        foreach (var archivo in archivos)
        {
            var err = ValidarArchivoSubido(archivo);
            if (!string.IsNullOrEmpty(err))
            {
                erroresArchivos[claveSoporte] = $"Registro #{numeroRegistro}: {err}";
                mensajeAlerta = erroresArchivos[claveSoporte];
                esError = true;
                StateHasChanged();
                return;
            }
        }

        foreach (var archivo in archivos)
        {
            var dataUrl = await ConvertirArchivoADataUrlAsync(archivo);
            if (string.IsNullOrEmpty(dataUrl))
            {
                erroresArchivos[claveSoporte] = $"Registro #{numeroRegistro}: No se pudo leer el archivo \"{archivo.Name}\".";
                mensajeAlerta = erroresArchivos[claveSoporte];
                esError = true;
                StateHasChanged();
                return;
            }

            cuota.Soportes.Add(new SoporteCuotaAsociado
            {
                Id = Guid.NewGuid().ToString("N"),
                CuotaId = cuota.Id,
                TipoCuota = cuota.TipoCuota,
                Periodicidad = cuota.Periodicidad,
                ArchivoNombre = archivo.Name,
                ArchivoTamano = FormatearTamanoArchivo(archivo.Size),
                ArchivoUrl = dataUrl,
                FechaCarga = DateTime.Now
            });
        }

        erroresArchivos.Remove(claveSoporte);
        cuota.ActualizarEstadoYSoportes();
        mensajeAlerta = "";
        esError = false;
        StateHasChanged();
    }

