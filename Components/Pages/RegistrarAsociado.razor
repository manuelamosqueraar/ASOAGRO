@page "/registrar-asociado"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Secretaria,Secretaría,Presidenta,Presidente")]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Security.Claims
@using Asoagro.Models
@using Asoagro.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject NavigationManager NavManager
@inject IAsociadoService RegistroAsociados
@inject IDocumentoAsociacionService DocumentoService
@inject NotificacionService Notificaciones
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS

<PageTitle>Asoagro - Registro de Asociado</PageTitle>

<div class="ra">
    <div class="ra-shell"><aside class="ra-rail"><!-- ENCABEZADO PREMIUM UNIFICADO -->
    <div class="card aso-hero-card mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="aso-hero-icon-box">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                            <circle cx="8.5" cy="7" r="4"></circle>
                            <line x1="20" y1="8" x2="20" y2="14"></line>
                            <line x1="23" y1="11" x2="17" y2="11"></line>
                        </svg>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="aso-hero-kicker">FAAUA · Urabá</span>
                            <span class="text-white-50" style="font-size: 0.75rem; font-weight: 600;">Gestión de Secretaría · Paso @pasoActual de 5</span>
                        </div>
                        <h1 class="aso-hero-title">Registro de asociado</h1>
                        <p class="aso-hero-desc">Diligencie los datos del productor, predio, línea productiva, componente social y cuotas en 5 pasos.</p>
                    </div>
                </div>

                <div class="d-flex flex-column gap-1.5 px-3 py-2 rounded-3" style="min-width: 220px; background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(185, 231, 122, 0.35);">
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="text-uppercase fw-bold" style="font-size: 0.68rem; letter-spacing: 0.08em; color: #b9e77a;">Avance del registro</span>
                        <strong class="text-white fw-bold" style="font-size: 1.05rem;">@(CalcularPorcentajeAvance())%</strong>
                    </div>
                    <div class="rounded-pill overflow-hidden" style="height: 7px; background: rgba(255, 255, 255, 0.18);">
                        <div style="height: 100%; width: @(CalcularPorcentajeAvance())%; background: #b9e77a; transition: width 0.35s ease;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- NAVEGACIÓN DE PASOS (STEPPER) -->
    <nav class="ra-pasos" aria-label="Pasos del registro">
        <div class="ra-pasos-linea">
            <div class="ra-pasos-relleno" style="width: @((pasoActual - 1) * 100 / 4)%;"></div>
        </div>

        <button type="button"
                class="ra-paso @(pasoActual == 1 ? "activo" : "") @(Paso1Completo ? "completo" : "")"
                @onclick="() => CambiarPaso(1)">
            <span class="ra-paso-num">
                @if (Paso1Completo && pasoActual != 1)
                {
                    <svg class="ra-ico"><use href="#ico-check" /></svg>
                }
                else
                {
                    <span>1</span>
                }
            </span>
            <span class="ra-paso-info">
                <span class="ra-paso-titulo">Identificación</span>
                <span class="ra-paso-sub">Titular y CC/NIT</span>
            </span>
        </button>

        <button type="button"
                class="ra-paso @(pasoActual == 2 ? "activo" : "") @(Paso2Completo ? "completo" : "")"
                @onclick="() => CambiarPaso(2)">
            <span class="ra-paso-num">
                @if (Paso2Completo && pasoActual != 2)
                {
                    <svg class="ra-ico"><use href="#ico-check" /></svg>
                }
                else
                {
                    <span>2</span>
                }
            </span>
            <span class="ra-paso-info">
                <span class="ra-paso-titulo">Predio Rural</span>
                <span class="ra-paso-sub">Ubicación y área</span>
            </span>
        </button>

        <button type="button"
                class="ra-paso @(pasoActual == 3 ? "activo" : "") @(Paso3Completo ? "completo" : "")"
                @onclick="() => CambiarPaso(3)">
            <span class="ra-paso-num">
                @if (Paso3Completo && pasoActual != 3)
                {
                    <svg class="ra-ico"><use href="#ico-check" /></svg>
                }
                else
                {
                    <span>3</span>
                }
            </span>
            <span class="ra-paso-info">
                <span class="ra-paso-titulo">Línea Productiva</span>
                <span class="ra-paso-sub">Cultivos, ha y BPA</span>
            </span>
        </button>

        <button type="button"
                class="ra-paso @(pasoActual == 4 ? "activo" : "") @(Paso4Completo && pasoActual != 4 ? "completo" : "")"
                @onclick="() => CambiarPaso(4)">
            <span class="ra-paso-num">
                @if (Paso4Completo && pasoActual != 4)
                {
                    <svg class="ra-ico"><use href="#ico-check" /></svg>
                }
                else
                {
                    <span>4</span>
                }
            </span>
            <span class="ra-paso-info">
                <span class="ra-paso-titulo">Social y Jurídico</span>
                <span class="ra-paso-sub">Enfoque y soportes</span>
            </span>
        </button>

        <button type="button"
                class="ra-paso @(pasoActual == 5 ? "activo" : "") @(Paso5Completo && pasoActual == 5 ? "completo" : "")"
                @onclick="() => CambiarPaso(5)">
            <span class="ra-paso-num">
                <span>5</span>
            </span>
            <span class="ra-paso-info">
                <span class="ra-paso-titulo">Cuotas y Aportes</span>
                <span class="ra-paso-sub">Pagos y soportes</span>
            </span>
        </button>
    </nav>

    </aside><div class="ra-main"><!-- ALERTA DE VALIDACIÓN -->
    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="ra-alerta @(esError ? "ra-alerta-error" : "ra-alerta-exito")" role="alert">
            <span class="ra-alerta-ico">
                <svg class="ra-ico"><use href="#@(esError ? "ico-alerta" : "ico-check")" /></svg>
            </span>
            <div class="ra-alerta-texto">
                <strong>@(esError ? "Atención requerida" : "Operación exitosa")</strong>
                <span>@mensajeAlerta</span>
            </div>
            <button type="button" class="ra-alerta-cerrar" @onclick='() => mensajeAlerta = ""' aria-label="Cerrar">&times;</button>
        </div>
    }

    <!-- PANEL PRINCIPAL DEL FORMULARIO -->
    <section class="ra-panel">
            @if (pasoActual != 1)
            {
                <button type="button" class="ra-fila-paso @(Paso1Completo ? "completo" : "")" @onclick="() => CambiarPaso(1)">
                    <span class="ra-fila-num">
                        @if (Paso1Completo) { <svg class="ra-ico"><use href="#ico-check" /></svg> } else { <span>1</span> }
                    </span>
                    <span class="ra-fila-texto"><strong>Identificación</strong><small>@ResumenPaso(1)</small></span>
                    <span class="ra-fila-accion">@(Paso1Completo ? "Editar" : "Completar")</span>
                </button>
            }

            @if (pasoActual == 1)
            {
                <div class="ra-seccion" @key="1">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-usuario" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Paso 1 de 5</span>
                            <h2>Datos del Productor</h2>
                        </div>
                        <span class="ra-estado @(Paso1Completo ? "ra-estado-ok" : "")">
                            @(Paso1Completo ? "Completo" : "En curso")
                        </span>
                    </header>

                    <div class="ra-grid">
                        <div class="ra-campo">
                            <label class="ra-label" for="ra-nombre">Nombres y apellidos <span class="ra-req">*</span></label>
                            <input id="ra-nombre"
                                   type="text"
                                   maxlength="60"
                                   class="ra-input @(TieneErrorVisible("nombre") ? "ra-input-error" : "")"
                                   placeholder="Ej: Carlos Julio Ramírez Pérez"
                                   value="@nuevoAsociado.NombreCompleto"
                                   @oninput="OnInputNombreCompleto"
                                   @onblur='() => TocarCampo("nombre")' />
                            @if (TieneErrorVisible("nombre"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarNombreCompleto()</span>
                            }
                        </div>

                        <div class="ra-campo">
                            <div class="ra-label-fila">
                                <label class="ra-label" for="ra-cedula">@(nuevoAsociado.TipoDocumentoIdentidad == "NIT" ? "Número de NIT" : "Cédula de ciudadanía") <span class="ra-req">*</span></label>
                                <div class="ra-tipo-doc-switch" role="group" aria-label="Tipo de documento de identificación">
                                    <button type="button"
                                            class="ra-tipo-doc-btn @(nuevoAsociado.TipoDocumentoIdentidad != "NIT" ? "activo" : "")"
                                            @onclick='() => CambiarTipoDocumento("CC")'>
                                        Cédula (CC)
                                    </button>
                                    <button type="button"
                                            class="ra-tipo-doc-btn @(nuevoAsociado.TipoDocumentoIdentidad == "NIT" ? "activo" : "")"
                                            @onclick='() => CambiarTipoDocumento("NIT")'>
                                        NIT
                                    </button>
                                </div>
                            </div>
                            <input id="ra-cedula"
                                   type="text"
                                   inputmode="numeric"
                                   class="ra-input @(TieneErrorVisible("cedula") ? "ra-input-error" : "")"
                                   placeholder="@(nuevoAsociado.TipoDocumentoIdentidad == "NIT" ? "Ej: 900123456-8 o 9001234568" : "Ej: 1023456789")"
                                   value="@nuevoAsociado.Cedula"
                                   @oninput="OnInputCedula"
                                   @onblur='() => TocarCampo("cedula")' />
                            @if (TieneErrorVisible("cedula"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarDocumentoIdentidad()</span>
                            }

                            @if (productorExistenteIdentificado != null)
                            {
                                <div class="ra-alerta-existente p-3 rounded-3 my-2" style="background: rgba(46, 154, 91, 0.08); border: 1.5px solid #2e9a5b;">
                                    <div class="d-flex align-items-start gap-2">
                                        <span class="fs-5" style="color: #2e9a5b;">ℹ️</span>
                                        <div>
                                            <strong class="d-block" style="color: #17603a; font-size: 0.85rem;">Productor identificado en el padrón único de ASOAGRO</strong>
                                            <p class="mb-1 small text-dark" style="font-size: 0.78rem; line-height: 1.4;">
                                                Se encontró el perfil personal de <strong>@productorExistenteIdentificado.NombreCompleto</strong> (Doc: @productorExistenteIdentificado.Cedula). Al continuar, se creará una <strong>nueva afiliación</strong> a la asociación seleccionada sin duplicar su persona ni perder su historial.
                                            </p>
                                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill fw-bold py-1 px-3 mt-1" style="font-size: 0.72rem;" @onclick="AutocompletarDesdeExistente">
                                                Cargar datos personales existentes
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="ra-cedula-adjunto @(string.IsNullOrWhiteSpace(nuevoAsociado.CedulaArchivoNombre) ? "pendiente" : "cargado") @(TieneErrorVisible("cedulaArchivo") ? "con-error" : "")">
                                <div class="ra-cedula-adjunto-cab">
                                    <div class="ra-cedula-adjunto-titulo">
                                        <strong>@(nuevoAsociado.TipoDocumentoIdentidad == "NIT" ? "Documento soporte del NIT" : "Fotocopia de la cédula de ciudadanía") <span class="ra-req">*</span></strong>
                                        @if (string.IsNullOrWhiteSpace(nuevoAsociado.CedulaArchivoNombre))
                                        {
                                            <span class="ra-badge-pendiente">Obligatorio</span>
                                        }
                                    </div>
                                    <small>Asociado a @(nuevoAsociado.TipoDocumentoIdentidad == "NIT" ? "NIT" : "Cédula de ciudadanía"). Formatos permitidos: PDF, JPG o PNG (máx. 10 MB).</small>
                                </div>
                                @if (string.IsNullOrWhiteSpace(nuevoAsociado.CedulaArchivoNombre))
                                {
                                    <label class="ra-btn ra-btn-adjuntar ra-btn-adjuntar-cedula" for="cedula_file_input">
                                        <InputFile id="cedula_file_input"
                                                   OnChange="CargarFotocopiaCedula"
                                                   accept=".pdf,.jpg,.jpeg,.png"
                                                   class="ra-hidden-file-input"
                                                   style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; opacity: 0;" />
                                        <svg class="ra-ico"><use href="#ico-doc" /></svg>
                                        <span>Adjuntar @(nuevoAsociado.TipoDocumentoIdentidad == "NIT" ? "documento de NIT" : "fotocopia de cédula")</span>
                                    </label>
                                }
                                else
                                {
                                    <div class="ra-archivo-barra">
                                        <div class="ra-archivo-info">
                                            <span class="ra-archivo-ico">
                                                <svg class="ra-ico"><use href="#ico-check" /></svg>
                                            </span>
                                            <div class="ra-archivo-datos">
                                                <strong title="@nuevoAsociado.CedulaArchivoNombre">@nuevoAsociado.CedulaArchivoNombre</strong>
                                                <small>@(nuevoAsociado.TipoDocumentoIdentidad == "NIT" ? "Soporte NIT" : "Fotocopia CC") · @(string.IsNullOrWhiteSpace(nuevoAsociado.CedulaArchivoTamano) ? "Documento anexado" : nuevoAsociado.CedulaArchivoTamano)</small>
                                            </div>
                                        </div>
                                        <div class="ra-archivo-acciones">
                                            <button type="button"
                                                    class="ra-btn-accion ra-btn-accion-ver"
                                                    title="Ver documento de identificación"
                                                    @onclick='() => AbrirVisorDocumento(nuevoAsociado.TipoDocumentoIdentidad == "NIT" ? "Documento NIT" : "Fotocopia de Cédula", nuevoAsociado.CedulaArchivoNombre, nuevoAsociado.CedulaArchivoUrl)'>
                                                <svg class="ra-ico"><use href="#ico-doc" /></svg>
                                                <span>Ver</span>
                                            </button>
                                            <label class="ra-btn-accion ra-btn-accion-cambiar" title="Reemplazar documento" for="cedula_replace_file_input">
                                                <InputFile id="cedula_replace_file_input"
                                                           OnChange="CargarFotocopiaCedula"
                                                           accept=".pdf,.jpg,.jpeg,.png"
                                                           class="ra-hidden-file-input"
                                                           style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; opacity: 0;" />
                                                <span>Cambiar</span>
                                            </label>
                                            <button type="button"
                                                    class="ra-btn-accion ra-btn-accion-quitar"
                                                    title="Quitar documento"
                                                    @onclick="EliminarFotocopiaCedula">
                                                <span>Quitar</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                                @if (TieneErrorVisible("cedulaArchivo"))
                                {
                                    <span class="ra-error-campo" role="alert">@ValidarArchivoIdentidad()</span>
                                }
                            </div>
                        </div>

                        <div class="ra-campo ra-campo-asociacion">
                            <label class="ra-label" for="ra-asociacion">Asociación a la que pertenece <span class="ra-req">*</span></label>
                            <select id="ra-asociacion"
                                    class="ra-input @(TieneErrorVisible("asociacionPertenece") ? "ra-input-error" : "")"
                                    value="@nuevoAsociado.AsociacionPertenece"
                                    @onchange="OnInputAsociacionPertenece"
                                    @onblur='() => TocarCampo("asociacionPertenece")'>
                                <option value="">-- Seleccionar asociación registrada (Obligatorio) --</option>
                                @foreach (var asoc in listaAsociacionesRegistradas)
                                {
                                    <option value="@asoc">@asoc</option>
                                }
                            </select>
                            @if (TieneErrorVisible("asociacionPertenece"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarAsociacionPertenece()</span>
                            }
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-telefono">Celular / WhatsApp <span class="ra-req">*</span></label>
                            <input id="ra-telefono"
                                   type="tel"
                                   inputmode="numeric"
                                   class="ra-input @(TieneErrorVisible("telefono") ? "ra-input-error" : "")"
                                   placeholder="Ej: 3104567890"
                                   value="@nuevoAsociado.Telefono"
                                   @oninput="OnInputTelefono"
                                   @onblur='() => TocarCampo("telefono")' />
                            @if (TieneErrorVisible("telefono"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarTelefono()</span>
                            }
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-correo">Correo electrónico <span class="ra-opcional">(opcional)</span></label>
                            <input id="ra-correo"
                                   type="email"
                                   class="ra-input @(TieneErrorVisible("correo") ? "ra-input-error" : "")"
                                   placeholder="Ej: productor@asoagro.org"
                                   value="@nuevoAsociado.Correo"
                                   @oninput="OnInputCorreo"
                                   @onblur='() => TocarCampo("correo")' />
                            @if (TieneErrorVisible("correo"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarCorreo()</span>
                            }
                        </div>

                        <div class="ra-campo ra-campo-full mt-3 p-3 rounded-3" style="background: #f7faf5; border: 1px solid #dbe7d5;">
                            <label class="d-flex align-items-start gap-2 cursor-pointer mb-0">
                                <input type="checkbox" @bind="nuevoAsociado.AutorizacionDatosPersonales" style="margin-top: 3px;" />
                                <span class="small text-dark" style="font-size: 0.8rem; line-height: 1.4;">
                                    <strong>Autorización Ley 1581 de 2012 (Tratamiento de Datos Personales):</strong>
                                    Certifico que el titular otorgó autorización previa y expresa para el uso y custodia de sus datos personales exclusivamente con fines gremiales agropecuarios, afiliación a la federación y convocatorias institucionales de la FAAUA.
                                </span>
                            </label>
                        </div>
                    </div>

                    <footer class="ra-acciones">
                        <a href="/consultar-asociados" class="ra-btn ra-btn-secundario">
                            <svg class="ra-ico"><use href="#ico-lista" /></svg>
                            <span>Directorio de asociados</span>
                        </a>
                        <button type="button"
                                class="ra-btn ra-btn-primario"
                                disabled="@TieneErroresActivosPaso(1)"
                                @onclick="SiguientePaso">
                            <span>Siguiente: Predio Rural</span>
                            <svg class="ra-ico ra-ico-derecha"><use href="#ico-flecha" /></svg>
                        </button>
                    </footer>
                </div>
            }

            @if (pasoActual != 2)
            {
                <button type="button" class="ra-fila-paso @(Paso2Completo ? "completo" : "")" @onclick="() => CambiarPaso(2)">
                    <span class="ra-fila-num">
                        @if (Paso2Completo) { <svg class="ra-ico"><use href="#ico-check" /></svg> } else { <span>2</span> }
                    </span>
                    <span class="ra-fila-texto"><strong>Predio rural</strong><small>@ResumenPaso(2)</small></span>
                    <span class="ra-fila-accion">@(Paso2Completo ? "Editar" : "Completar")</span>
                </button>
            }

            @if (pasoActual == 2)
            {
                <div class="ra-seccion" @key="2">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-mapa" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Paso 2 de 5</span>
                            <h2>Ubicación y Área del Predio</h2>
                        </div>
                        <span class="ra-estado @(Paso2Completo ? "ra-estado-ok" : "")">
                            @(Paso2Completo ? "Completo" : "Pendiente")
                        </span>
                    </header>

                    <div class="ra-grid">
                        <div class="ra-campo">
                            <label class="ra-label" for="ra-predio">Nombre del predio o finca <span class="ra-req">*</span></label>
                            <input id="ra-predio"
                                   type="text"
                                   maxlength="100"
                                   class="ra-input @(TieneErrorVisible("predio") ? "ra-input-error" : "")"
                                   placeholder="Ej: Finca La Esperanza"
                                   value="@nuevoAsociado.NombrePredio"
                                   @oninput="OnInputNombrePredio"
                                   @onblur='() => TocarCampo("predio")' />
                            @if (TieneErrorVisible("predio"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarNombrePredio()</span>
                            }
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-vereda">Vereda o sector <span class="ra-req">*</span></label>
                            <input id="ra-vereda"
                                   type="text"
                                   maxlength="100"
                                   class="ra-input @(TieneErrorVisible("vereda") ? "ra-input-error" : "")"
                                   placeholder="Ej: Vereda El Silencio"
                                   value="@nuevoAsociado.VeredaSector"
                                   @oninput="OnInputVereda"
                                   @onblur='() => TocarCampo("vereda")' />
                            @if (TieneErrorVisible("vereda"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarVereda()</span>
                            }
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-municipio">Municipio <span class="ra-req">*</span></label>
                            <div class="ra-desplegable-contenedor">
                                <button type="button"
                                        id="ra-municipio"
                                        class="ra-desplegable-boton ra-muni-boton @(municipioAbierto ? "abierto" : "") @(!string.IsNullOrEmpty(nuevoAsociado.Municipio) ? "con-datos" : "") @(TieneErrorVisible("municipio") ? "ra-input-error" : "")"
                                        aria-expanded="@municipioAbierto"
                                        @onclick="AlternarDesplegableMunicipio"
                                        @onblur='() => TocarCampo("municipio")'>
                                    <span class="ra-desplegable-izq">
                                        <span class="ra-muni-pin"></span>
                                        @if (string.IsNullOrEmpty(nuevoAsociado.Municipio))
                                        {
                                            <span class="ra-desplegable-placeholder">Seleccione municipio</span>
                                        }
                                        else
                                        {
                                            <span class="ra-desplegable-resumen">@NombreMunicipioSeleccionado</span>
                                        }
                                    </span>
                                    <span class="ra-muni-flecha @(municipioAbierto ? "abierta" : "")"></span>
                                </button>

                                @if (municipioAbierto)
                                {
                                    <div class="ra-muni-panel" role="listbox">
                                        @foreach (var m in MunicipiosUraba)
                                        {
                                            var activo = m.Valor == nuevoAsociado.Municipio;
                                            <div class="ra-muni-opcion @(activo ? "activa" : "")"
                                                 role="option"
                                                 aria-selected="@activo"
                                                 @onclick="() => SeleccionarMunicipio(m.Valor)">
                                                <span class="ra-muni-punto"></span>
                                                <span class="ra-muni-nombre">@m.Nombre</span>
                                                @if (activo)
                                                {
                                                    <svg class="ra-ico"><use href="#ico-check" /></svg>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            @if (TieneErrorVisible("municipio"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarMunicipio()</span>
                            }
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-hectareas-total">Extensión total del predio <span class="ra-req">*</span></label>
                            <div class="ra-input-unidad">
                                <input id="ra-hectareas-total"
                                       type="text"
                                       inputmode="decimal"
                                       class="ra-input @(TieneErrorVisible("hectareasPredio") ? "ra-input-error" : "")"
                                       placeholder="Ej: 6.5"
                                       value="@hectareasPredioTexto"
                                       @oninput="OnInputHectareasPredio"
                                       @onblur='() => TocarCampo("hectareasPredio")' />
                                <span class="ra-unidad-badge">ha totales</span>
                            </div>
                            @if (TieneErrorVisible("hectareasPredio"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarHectareasPredio()</span>
                            }
                        </div>

                        <div class="ra-campo">
                            <label class="ra-label" for="ra-tenencia">Tenencia del terreno <span class="ra-req">*</span></label>
                            <select id="ra-tenencia"
                                    class="ra-input @(TieneErrorVisible("tenencia") ? "ra-input-error" : "")"
                                    value="@nuevoAsociado.TenenciaTerreno"
                                    @onchange="OnChangeTenencia"
                                    @onblur='() => TocarCampo("tenencia")'>
                                <option value="">Seleccione tenencia</option>
                                <option value="Propio">Propio</option>
                                <option value="Arrendado">Arrendado</option>
                                <option value="Prestado">Prestado</option>
                            </select>
                            @if (TieneErrorVisible("tenencia"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarTenenciaTerreno()</span>
                            }
                        </div>
                    </div>

                    <footer class="ra-acciones">
                        <button type="button" class="ra-btn ra-btn-secundario" @onclick="PasoAnterior">
                            <svg class="ra-ico ra-ico-izquierda"><use href="#ico-flecha" /></svg>
                            <span>Anterior</span>
                        </button>
                        <button type="button"
                                class="ra-btn ra-btn-primario"
                                disabled="@TieneErroresActivosPaso(2)"
                                @onclick="SiguientePaso">
                            <span>Siguiente: Línea Productiva</span>
                            <svg class="ra-ico ra-ico-derecha"><use href="#ico-flecha" /></svg>
                        </button>
                    </footer>
                </div>
            }

            @if (pasoActual != 3)
            {
                <button type="button" class="ra-fila-paso @(Paso3Completo ? "completo" : "")" @onclick="() => CambiarPaso(3)">
                    <span class="ra-fila-num">
                        @if (Paso3Completo) { <svg class="ra-ico"><use href="#ico-check" /></svg> } else { <span>3</span> }
                    </span>
                    <span class="ra-fila-texto"><strong>Línea productiva</strong><small>@ResumenPaso(3)</small></span>
                    <span class="ra-fila-accion">@(Paso3Completo ? "Editar" : "Completar")</span>
                </button>
            }

            @if (pasoActual == 3)
            {
                <div class="ra-seccion" @key="3">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-brote" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Paso 3 de 5</span>
                            <h2>Línea Productiva y Certificación BPA</h2>
                        </div>
                        <span class="ra-estado @(Paso3Completo ? "ra-estado-ok" : "")">
                            @(Paso3Completo ? "Completo" : "Requerido")
                        </span>
                    </header>

                    <!-- CULTIVOS Y HECTÁREAS PERFECTAMENTE ALINEADOS -->
                    <div class="ra-subtarjeta">
                        <div class="ra-grid ra-grid-productiva">
                            <!-- LISTA DESPLEGABLE DE CULTIVOS (SELECCIÓN MÚLTIPLE, SIN BARRA DE BÚSQUEDA INTERNA) -->
                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label">Cultivos o actividad pecuaria <span class="ra-req">*</span></label>
                                    <span class="ra-contador-pildora">
                                        @nuevoAsociado.CultivosSeleccionados.Count @(nuevoAsociado.CultivosSeleccionados.Count == 1 ? "seleccionado" : "seleccionados")
                                    </span>
                                </div>

                                <div class="ra-desplegable-contenedor">
                                    <button type="button"
                                            class="ra-desplegable-boton @(desplegableCultivosAbierto ? "abierto" : "") @(nuevoAsociado.CultivosSeleccionados.Count > 0 ? "con-datos" : "") @(TieneErrorVisible("cultivos") ? "ra-input-error" : "")"
                                            @onclick="AlternarDesplegableCultivos"
                                            @onblur='() => TocarCampo("cultivos")'
                                            aria-expanded="@desplegableCultivosAbierto">
                                        <span class="ra-desplegable-izq">
                                            <svg class="ra-ico"><use href="#ico-brote" /></svg>
                                            @if (nuevoAsociado.CultivosSeleccionados.Count == 0)
                                            {
                                                <span class="ra-desplegable-placeholder">Seleccionar uno o más cultivos...</span>
                                            }
                                            else
                                            {
                                                <span class="ra-desplegable-resumen">
                                                    @string.Join(", ", nuevoAsociado.CultivosSeleccionados.Select(AsociadoModel.TraducirCodigoCultivo))
                                                </span>
                                            }
                                        </span>
                                        <span class="ra-desplegable-der">
                                            <span class="ra-desplegable-accion">@(desplegableCultivosAbierto ? "Cerrar" : "Desplegar")</span>
                                            <svg class="ra-ico @(desplegableCultivosAbierto ? "ra-rotar-180" : "")"><use href="#ico-flecha" /></svg>
                                        </span>
                                    </button>

                                    @if (desplegableCultivosAbierto)
                                    {
                                        <div class="ra-desplegable-panel" role="listbox" aria-multiselectable="true">
                                            <div class="ra-desplegable-barra ra-desplegable-barra-acciones">
                                                <span class="ra-opcional">Seleccione las opciones de la línea productiva</span>
                                                <div class="ra-desplegable-botones">
                                                    @if (nuevoAsociado.CultivosSeleccionados.Count > 0)
                                                    {
                                                        <button type="button" class="ra-btn-mini ra-btn-mini-peligro" @onclick="LimpiarCultivosSeleccionados">
                                                            Limpiar
                                                        </button>
                                                    }
                                                    <button type="button" class="ra-btn-mini ra-btn-mini-ok" @onclick="CerrarDesplegableCultivos">
                                                        Listo
                                                    </button>
                                                </div>
                                            </div>

                                            <div class="ra-desplegable-grid">
                                                @foreach (var cultivo in AsociadoModel.CatalogoCultivos)
                                                {
                                                    var marcado = EstaCultivoSeleccionado(cultivo.Codigo);
                                                    <div class="ra-opcion-cultivo @(marcado ? "seleccionado" : "")"
                                                         role="option"
                                                         aria-selected="@marcado"
                                                         @onclick="() => AlternarCultivo(cultivo.Codigo)">
                                                        <span class="ra-casilla @(marcado ? "activa" : "")">
                                                            @if (marcado)
                                                            {
                                                                <svg class="ra-ico"><use href="#ico-check" /></svg>
                                                            }
                                                        </span>
                                                        <span class="ra-opcion-emoji" aria-hidden="true">@EmojiCultivo(cultivo.Codigo)</span><div class="ra-opcion-texto">
                                                            <strong>@cultivo.Nombre</strong>
                                                            <small>@cultivo.Subtitulo</small>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                                @if (TieneErrorVisible("cultivos"))
                                {
                                    <span class="ra-error-campo" role="alert">@ValidarCultivosLineaProductiva()</span>
                                }
                            </div>

                            <!-- CAMPO NUMÉRICO DE HECTÁREAS DE LA LÍNEA PRODUCTIVA -->
                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="ra-hectareas-prod">Hectáreas de la línea productiva <span class="ra-req">*</span></label>
                                    @if (nuevoAsociado.HectareasPredio > 0)
                                    {
                                        <button type="button" class="ra-link-accion" @onclick="AsignarAreaTotalAPrd">
                                            Usar total (@nuevoAsociado.HectareasPredio.ToString("0.##") ha)
                                        </button>
                                    }
                                </div>

                                <div class="ra-input-unidad">
                                    <input id="ra-hectareas-prod"
                                           type="text"
                                           inputmode="decimal"
                                           class="ra-input @(TieneErrorVisible("hectareasProductiva") ? "ra-input-error" : "")"
                                           placeholder="Ej: 4.5"
                                           value="@hectareasProductivasTexto"
                                           @oninput="OnInputHectareasProductivas"
                                           @onblur='() => TocarCampo("hectareasProductiva")' />
                                    <span class="ra-unidad-badge">ha productivas</span>
                                </div>

                                @if (TieneErrorVisible("hectareasProductiva"))
                                {
                                    <span class="ra-error-campo" role="alert">@ValidarHectareasProductivas()</span>
                                }
                            </div>

                            <!-- ACTIVIDAD PRODUCTIVA (AGRÍCOLA, PECUARIA O MIXTA) -->
                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="ra-tipo-actividad">Actividad productiva <span class="ra-req">*</span></label>
                                </div>
                                <select id="ra-tipo-actividad"
                                        class="ra-input @(TieneErrorVisible("tipoActividad") ? "ra-input-error" : "")"
                                        value="@nuevoAsociado.TipoActividadProductiva"
                                        @onchange="OnChangeTipoActividad"
                                        @onblur='() => TocarCampo("tipoActividad")'>
                                    <option value="">Seleccione actividad</option>
                                    <option value="Agrícola">Agrícola</option>
                                    <option value="Pecuaria">Pecuaria</option>
                                    <option value="Mixta">Mixta</option>
                                </select>
                                @if (TieneErrorVisible("tipoActividad"))
                                {
                                    <span class="ra-error-campo" role="alert">@ValidarTipoActividad()</span>
                                }
                            </div>

                            <!-- PRODUCCIÓN APROXIMADA -->
                            <div class="ra-campo">
                                <div class="ra-label-fila">
                                    <label class="ra-label" for="ra-produccion-aprox">Producción aproximada <span class="ra-req">*</span></label>
                                </div>
                                <input id="ra-produccion-aprox"
                                       type="text"
                                       class="ra-input @(TieneErrorVisible("produccion") ? "ra-input-error" : "")"
                                       placeholder="Ej: 15 toneladas/año o 800 kg/mes"
                                       value="@nuevoAsociado.ProduccionAproximada"
                                       @oninput="OnInputProduccionAproximada"
                                       @onblur='() => TocarCampo("produccion")' />
                                @if (TieneErrorVisible("produccion"))
                                {
                                    <span class="ra-error-campo" role="alert">@ValidarProduccionAproximada()</span>
                                }
                            </div>
                        </div>

                        @if (nuevoAsociado.CultivosSeleccionados.Count > 0)
                        {
                            <div class="ra-chips-contenedor">
                                @foreach (var codigo in nuevoAsociado.CultivosSeleccionados)
                                {
                                    <span class="ra-chip-cultivo">
                                        <span>@AsociadoModel.TraducirCodigoCultivo(codigo)</span>
                                        <button type="button"
                                                class="ra-chip-quitar"
                                                title="Quitar"
                                                @onclick="() => QuitarCultivo(codigo)">&times;</button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <!-- OPCIÓN BPA Y CERTIFICADO DIGITAL CON PREVISUALIZACIÓN -->
                    <div class="ra-subtarjeta @(nuevoAsociado.TieneBPA ? "ra-subtarjeta-bpa-activa" : "")">
                        <div class="ra-bpa-cabecera">
                            <div class="ra-bpa-info">
                                <span class="ra-bpa-icono">
                                    <svg class="ra-ico"><use href="#ico-escudo" /></svg>
                                </span>
                                <div class="ra-bpa-textos">
                                    <h3>Buenas Prácticas Agrícolas (BPA)</h3>
                                    <p>¿Cuenta con certificación vigente?</p>
                                </div>
                            </div>

                            <div class="ra-bpa-selector" role="group" aria-label="¿Cuenta con Buenas Prácticas Agrícolas?">
                                <button type="button"
                                        class="ra-btn-toggle @(nuevoAsociado.TieneBPA ? "activo-si" : "")"
                                        @onclick="() => CambiarEstadoBpa(true)">
                                    <svg class="ra-ico"><use href="#ico-check" /></svg>
                                    <span>Sí tiene BPA</span>
                                </button>
                                <button type="button"
                                        class="ra-btn-toggle @(!nuevoAsociado.TieneBPA ? "activo-no" : "")"
                                        @onclick="() => CambiarEstadoBpa(false)">
                                    <span>No tiene BPA</span>
                                </button>
                            </div>
                        </div>

                        @if (nuevoAsociado.TieneBPA)
                        {
                            <div class="ra-bpa-anexo">
                                <div class="ra-bpa-anexo-texto">
                                    <strong>Certificado BPA <span class="ra-req">*</span></strong>
                                    <span>Formato PDF, JPG o PNG (máx. 10 MB)</span>
                                </div>

                                <div class="ra-bpa-anexo-control">
                                    @if (string.IsNullOrWhiteSpace(nuevoAsociado.CertificadoBpaNombre))
                                    {
                                        <label class="ra-btn ra-btn-adjuntar" for="bpa_file_input">
                                            <InputFile id="bpa_file_input"
                                                       OnChange="CargarCertificadoBpa"
                                                       accept=".pdf,.jpg,.jpeg,.png"
                                                       class="ra-hidden-file-input"
                                                       style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; opacity: 0;" />
                                            <svg class="ra-ico"><use href="#ico-doc" /></svg>
                                            <span>Adjuntar certificado BPA</span>
                                        </label>
                                    }
                                    else
                                    {
                                        <div class="ra-archivo-barra">
                                            <div class="ra-archivo-info">
                                                <span class="ra-archivo-ico">
                                                    <svg class="ra-ico"><use href="#ico-check" /></svg>
                                                </span>
                                                <div class="ra-archivo-datos">
                                                    <strong title="@nuevoAsociado.CertificadoBpaNombre">@nuevoAsociado.CertificadoBpaNombre</strong>
                                                    <small>@(string.IsNullOrWhiteSpace(nuevoAsociado.CertificadoBpaTamano) ? "Documento anexado" : nuevoAsociado.CertificadoBpaTamano)</small>
                                                </div>
                                            </div>
                                            <div class="ra-archivo-acciones">
                                                <button type="button"
                                                        class="ra-btn-accion ra-btn-accion-ver"
                                                        title="Ver certificado anexado"
                                                        @onclick='() => AbrirVisorDocumento("Certificado BPA", nuevoAsociado.CertificadoBpaNombre, nuevoAsociado.CertificadoBpaUrl)'>
                                                    <svg class="ra-ico"><use href="#ico-doc" /></svg>
                                                    <span>Ver</span>
                                                </button>
                                                <label class="ra-btn-accion ra-btn-accion-cambiar" title="Reemplazar certificado" for="bpa_replace_file_input">
                                                    <InputFile id="bpa_replace_file_input"
                                                               OnChange="CargarCertificadoBpa"
                                                               accept=".pdf,.jpg,.jpeg,.png"
                                                               class="ra-hidden-file-input"
                                                               style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; opacity: 0;" />
                                                    <span>Cambiar</span>
                                                </label>
                                                <button type="button"
                                                        class="ra-btn-accion ra-btn-accion-quitar"
                                                        title="Eliminar certificado"
                                                        @onclick="EliminarCertificadoBpa">
                                                    <span>Quitar</span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            @if (TieneErrorVisible("certificadoBpa"))
                            {
                                <span class="ra-error-campo" role="alert">@ValidarCertificadoBpa()</span>
                            }
                        }
                    </div>

                    <footer class="ra-acciones">
                        <button type="button" class="ra-btn ra-btn-secundario" @onclick="PasoAnterior">
                            <svg class="ra-ico ra-ico-izquierda"><use href="#ico-flecha" /></svg>
                            <span>Anterior</span>
                        </button>
                        <button type="button"
                                class="ra-btn ra-btn-primario"
                                disabled="@TieneErroresActivosPaso(3)"
                                @onclick="SiguientePaso">
                            <span>Siguiente: Social y Jurídico</span>
                            <svg class="ra-ico ra-ico-derecha"><use href="#ico-flecha" /></svg>
                        </button>
                    </footer>
                </div>
            }

            @if (pasoActual != 4)
            {
                <button type="button" class="ra-fila-paso @(nuevoAsociado.GruposVulnerables.Count > 0 ? "completo" : "")" @onclick="() => CambiarPaso(4)">
                    <span class="ra-fila-num">
                        @if (nuevoAsociado.GruposVulnerables.Count > 0) { <svg class="ra-ico"><use href="#ico-check" /></svg> } else { <span>4</span> }
                    </span>
                    <span class="ra-fila-texto"><strong>Social y jurídico</strong><small>@ResumenPaso(4)</small></span>
                    <span class="ra-fila-accion">@(nuevoAsociado.GruposVulnerables.Count > 0 ? "Editar" : "Completar")</span>
                </button>
            }

            @if (pasoActual == 4)
            {
                <div class="ra-seccion" @key="4">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-red" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Paso 4 de 5</span>
                            <h2>Componente Social y Jurídico</h2>
                        </div>
                        <div class="ra-resumen-social-badges">
                            <span class="ra-contador-pildora">
                                @nuevoAsociado.GruposVulnerables.Count @(nuevoAsociado.GruposVulnerables.Count == 1 ? "seleccionado" : "seleccionados")
                            </span>
                            @if (nuevoAsociado.GruposVulnerables.Count > 0)
                            {
                                <span class="ra-contador-pildora trigo">
                                    @ContarSoportesCargados()/@nuevoAsociado.GruposVulnerables.Count soportes
                                </span>
                            }
                        </div>
                    </header>

                    <!-- GRUPOS VULNERABLES CON BOTÓN DE SOPORTE AL FRENTE Y OPCIÓN DE VER DOCUMENTO -->
                    <div class="ra-subtarjeta">
                        <div class="ra-vulnerables-encabezado">
                            <span>Grupo vulnerable (Selección múltiple)</span>
                            <span>Documento soporte</span>
                        </div>

                        <div class="ra-vulnerables-lista">
                            @foreach (var grupo in AsociadoModel.CatalogoGruposVulnerables)
                            {
                                var seleccionado = EstaGrupoSeleccionado(grupo.Codigo);
                                var archivoSoporte = ObtenerArchivoSoporte(grupo.Codigo);
                                var urlSoporte = ObtenerUrlSoporte(grupo.Codigo);

                                <div class="ra-vulnerable-fila @(seleccionado ? "seleccionada" : "")">
                                    <div class="ra-vulnerable-izq"
                                         role="checkbox"
                                         aria-checked="@seleccionado"
                                         tabindex="0"
                                         @onclick="() => AlternarGrupoVulnerable(grupo.Codigo)">
                                        <span class="ra-casilla @(seleccionado ? "activa" : "")">
                                            @if (seleccionado)
                                            {
                                                <svg class="ra-ico"><use href="#ico-check" /></svg>
                                            }
                                        </span>
                                        <div class="ra-vulnerable-textos">
                                            <strong>@grupo.Nombre</strong>
                                            <small>@grupo.DocumentoSugerido</small>
                                        </div>
                                    </div>

                                    <div class="ra-vulnerable-der">
                                        @if (seleccionado)
                                        {
                                            @if (string.IsNullOrWhiteSpace(archivoSoporte))
                                            {
                                                <div class="ra-soporte-acciones-vacio">
                                                    <span class="ra-badge-pendiente">Requerido</span>
                                                    <label class="ra-btn ra-btn-adjuntar-fila" for="@($"grupo_soporte_input_{grupo.Codigo}")">
                                                        <InputFile id="@($"grupo_soporte_input_{grupo.Codigo}")"
                                                                   OnChange="@(e => CargarSoporteGrupoVulnerable(grupo.Codigo, e))"
                                                                   accept=".pdf,.jpg,.jpeg,.png"
                                                                   class="ra-hidden-file-input"
                                                                   style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; opacity: 0;" />
                                                        <svg class="ra-ico"><use href="#ico-doc" /></svg>
                                                        <span>Adjuntar soporte</span>
                                                    </label>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ra-archivo-barra">
                                                    <div class="ra-archivo-info">
                                                        <span class="ra-archivo-ico">
                                                            <svg class="ra-ico"><use href="#ico-check" /></svg>
                                                        </span>
                                                        <div class="ra-archivo-datos">
                                                            <strong title="@archivoSoporte">@archivoSoporte</strong>
                                                            <small>Soporte anexado</small>
                                                        </div>
                                                    </div>
                                                    <div class="ra-archivo-acciones">
                                                        <button type="button"
                                                                class="ra-btn-accion ra-btn-accion-ver"
                                                                title="Ver documento anexado"
                                                                @onclick="() => AbrirVisorDocumento(grupo.Nombre, archivoSoporte, urlSoporte)">
                                                            <svg class="ra-ico"><use href="#ico-doc" /></svg>
                                                            <span>Ver</span>
                                                        </button>
                                                        <label class="ra-btn-accion ra-btn-accion-cambiar" title="Reemplazar documento" for="@($"grupo_replace_input_{grupo.Codigo}")">
                                                            <InputFile id="@($"grupo_replace_input_{grupo.Codigo}")"
                                                                       OnChange="@(e => CargarSoporteGrupoVulnerable(grupo.Codigo, e))"
                                                                       accept=".pdf,.jpg,.jpeg,.png"
                                                                       class="ra-hidden-file-input"
                                                                       style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; opacity: 0;" />
                                                            <span>Cambiar</span>
                                                        </label>
                                                        <button type="button"
                                                                class="ra-btn-accion ra-btn-accion-quitar"
                                                                title="Quitar soporte"
                                                                @onclick="() => QuitarSoporteGrupoVulnerable(grupo.Codigo)">
                                                            <span>Quitar</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                            @if (TieneErrorVisible($"vulnerable_{grupo.Codigo}"))
                                            {
                                                <span class="ra-error-campo" role="alert">@ValidarSoporteGrupoVulnerable(grupo.Codigo, grupo.Nombre)</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="ra-soporte-inactivo">No aplica</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- ESTADO DE MEMBRESÍA -->
                    <div class="ra-subtarjeta">
                        <label class="ra-label">Estado de membresía <span class="ra-requerido">*</span></label>
                        <div class="ra-membresia-grid">
                            <button type="button"
                                    class="ra-membresia-card @(nuevoAsociado.EstadoMembresia is "Activo" or "AlDia" ? "activa" : "")"
                                    @onclick='() => nuevoAsociado.EstadoMembresia = "Activo"'>
                                <span class="ra-membresia-punto verde"></span>
                                <div class="ra-membresia-texto">
                                    <strong>Activo</strong>
                                    <small>Habilitado en padrón</small>
                                </div>
                            </button>

                            <button type="button"
                                    class="ra-membresia-card @(nuevoAsociado.EstadoMembresia == "Inactivo" ? "activa" : "")"
                                    @onclick='() => nuevoAsociado.EstadoMembresia = "Inactivo"'>
                                <span class="ra-membresia-punto gris"></span>
                                <div class="ra-membresia-texto">
                                    <strong>Inactivo</strong>
                                    <small>Sin actividad en padrón</small>
                                </div>
                            </button>

                            <button type="button"
                                    class="ra-membresia-card @(nuevoAsociado.EstadoMembresia == "Suspendido" ? "activa" : "")"
                                    @onclick='() => nuevoAsociado.EstadoMembresia = "Suspendido"'>
                                <span class="ra-membresia-punto ambar"></span>
                                <div class="ra-membresia-texto">
                                    <strong>Suspendido</strong>
                                    <small>Suspensión estatutaria</small>
                                </div>
                            </button>

                            <button type="button"
                                    class="ra-membresia-card @(nuevoAsociado.EstadoMembresia == "Retirado" ? "activa" : "")"
                                    @onclick='() => nuevoAsociado.EstadoMembresia = "Retirado"'>
                                <span class="ra-membresia-punto rojo"></span>
                                <div class="ra-membresia-texto">
                                    <strong>Retirado</strong>
                                    <small>Desvinculado del padrón</small>
                                </div>
                            </button>
                        </div>
                    </div>

                    <footer class="ra-acciones">
                        <button type="button" class="ra-btn ra-btn-secundario" @onclick="PasoAnterior">
                            <svg class="ra-ico ra-ico-izquierda"><use href="#ico-flecha" /></svg>
                            <span>Anterior</span>
                        </button>
                        <button type="button"
                                class="ra-btn ra-btn-primario"
                                disabled="@TieneErroresActivosPaso(4)"
                                @onclick="SiguientePaso">
                            <span>Siguiente: Cuotas y Aportes</span>
                            <svg class="ra-ico ra-ico-derecha"><use href="#ico-flecha" /></svg>
                        </button>
                    </footer>
                </div>
            }

            @if (pasoActual != 5)
            {
                <button type="button" class="ra-fila-paso @(Paso5Completo ? "completo" : "")" @onclick="() => CambiarPaso(5)">
                    <span class="ra-fila-num">
                        @if (Paso5Completo) { <svg class="ra-ico"><use href="#ico-check" /></svg> } else { <span>5</span> }
                    </span>
                    <span class="ra-fila-texto"><strong>Cuotas sociales y aportes</strong><small>@ResumenPaso(5)</small></span>
                    <span class="ra-fila-accion">@(Paso5Completo ? "Editar" : "Completar")</span>
                </button>
            }

            @if (pasoActual == 5)
            {
                <div class="ra-seccion ra-seccion-cuotas" @key="5">
                    <header class="ra-seccion-cab">
                        <span class="ra-seccion-ico"><svg class="ra-ico"><use href="#ico-doc" /></svg></span>
                        <div class="ra-seccion-texto">
                            <span class="ra-kicker">Paso 5 de 5</span>
                            <h2>Cuotas Sociales y Aportes</h2>
                        </div>
                        <div class="ra-resumen-social-badges">
                            <span class="ra-contador-pildora">
                                @nuevoAsociado.CuotasAportes.Count @(nuevoAsociado.CuotasAportes.Count == 1 ? "obligación" : "obligaciones")
                            </span>
                            <span class="ra-contador-pildora trigo">
                                @nuevoAsociado.TotalSoportesCuotas @(nuevoAsociado.TotalSoportesCuotas == 1 ? "comprobante" : "comprobantes")
                            </span>
                        </div>
                    </header>

                    <div class="ra-subtarjeta">
                        <!-- RESUMEN ECONÓMICO AUTOMÁTICO DEL ASOCIADO -->
                        <div class="ra-cuotas-resumen-grid">
                            <div class="ra-cuotas-kpi">
                                <span class="ra-cuotas-kpi-etiqueta">Valor total pagado</span>
                                <strong class="ra-cuotas-kpi-valor ok">$@nuevoAsociado.ValorTotalPagadoAcumulado.ToString("N0")</strong>
                                <small>Acumulado de cuotas y aportes</small>
                            </div>
                            <div class="ra-cuotas-kpi">
                                <span class="ra-cuotas-kpi-etiqueta">Valor total pendiente</span>
                                <strong class="ra-cuotas-kpi-valor @(nuevoAsociado.ValorTotalPendienteAcumulado > 0 ? "pendiente" : "")">$@nuevoAsociado.ValorTotalPendienteAcumulado.ToString("N0")</strong>
                                <small>Calculado automáticamente</small>
                            </div>
                            <div class="ra-cuotas-kpi">
                                <span class="ra-cuotas-kpi-etiqueta">Cuotas pendientes</span>
                                <strong class="ra-cuotas-kpi-valor">@nuevoAsociado.TotalCuotasPendientes</strong>
                                <small>Obligaciones por cancelar</small>
                            </div>
                            <div class="ra-cuotas-kpi">
                                <span class="ra-cuotas-kpi-etiqueta">Estado de pago</span>
                                <strong class="ra-cuotas-kpi-valor estado">@nuevoAsociado.EstadoGeneralCuotas</strong>
                                <small>@nuevoAsociado.TotalSoportesCuotas soporte(s) anexado(s)</small>
                            </div>
                        </div>

                        <div class="ra-cuotas-barra-top">
                            <div>
                                <h3 class="ra-cuotas-subtitulo">Obligaciones económicas y comprobantes por cuota</h3>
                                <p class="ra-cuotas-ayuda">Registre cada cuota o aporte (afiliación, sostenimiento, ordinaria o extraordinaria) y adjunte los comprobantes que respaldan ese registro.</p>
                            </div>
                            <button type="button" class="ra-btn ra-btn-secundario ra-btn-agregar-cuota" @onclick="AgregarNuevaCuota">
                                <span>+ Agregar otra cuota o aporte</span>
                            </button>
                        </div>

                        <div class="ra-cuotas-lista">
                            @for (var index = 0; index < nuevoAsociado.CuotasAportes.Count; index++)
                            {
                                var indiceCuota = index;
                                var cuota = nuevoAsociado.CuotasAportes[indiceCuota];
                                var estadoCalculado = cuota.CalcularEstadoAutomatico();

                                <div class="ra-cuota-card" @key="cuota.Id">
                                    <div class="ra-cuota-card-cab">
                                        <div class="ra-cuota-card-titulo">
                                            <span class="ra-cuota-num">Registro #@(indiceCuota + 1)</span>
                                            <strong>Cuota / Aporte de @cuota.TipoCuota</strong>
                                            <span class="ra-cuota-periodicidad-tag">@cuota.Periodicidad</span>
                                        </div>
                                        <div class="ra-cuota-card-acciones">
                                            <span class="ra-cuota-estado-pill @ObtenerClaseEstadoCuota(estadoCalculado)">
                                                @estadoCalculado
                                            </span>
                                            @if (nuevoAsociado.CuotasAportes.Count > 1)
                                            {
                                                <button type="button"
                                                        class="ra-btn-accion ra-btn-accion-quitar"
                                                        title="Eliminar esta cuota o aporte"
                                                        @onclick="() => EliminarCuota(cuota.Id)">
                                                    <span>Quitar registro</span>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <div class="ra-grid ra-cuota-grid">
                                        <!-- 1. TIPO DE CUOTA O APORTE -->
                                        <div class="ra-campo">
                                            <label class="ra-label">Tipo de cuota o aporte <span class="ra-req">*</span></label>
                                            <select class="ra-input @(TieneErrorVisible($"cuota_{cuota.Id}_tipo") ? "ra-input-error" : "")"
                                                    value="@cuota.TipoCuota"
                                                    @onchange="e => CambiarTipoCuota(cuota, e.Value?.ToString())"
                                                    @onblur='() => TocarCampo($"cuota_{cuota.Id}_tipo")'>
                                                @foreach (var tipo in AsociadoModel.OpcionesTipoCuota)
                                                {
                                                    <option value="@tipo">@tipo</option>
                                                }
                                            </select>
                                            @if (TieneErrorVisible($"cuota_{cuota.Id}_tipo"))
                                            {
                                                <span class="ra-error-campo" role="alert">@ValidarTipoCuota(cuota)</span>
                                            }
                                        </div>

                                        <!-- 2. PERIODICIDAD -->
                                        <div class="ra-campo">
                                            <div class="ra-label-fila">
                                                <label class="ra-label">Periodicidad <span class="ra-req">*</span></label>
                                                <span class="ra-opcional">@(cuota.TipoCuota == "Sostenimiento" ? "Mensual, bimensual o anual" : "Frecuencia o pago único")</span>
                                            </div>
                                            <select class="ra-input @(TieneErrorVisible($"cuota_{cuota.Id}_periodicidad") ? "ra-input-error" : "")"
                                                    value="@cuota.Periodicidad"
                                                    @onchange="e => CambiarPeriodicidadCuota(cuota, e.Value?.ToString())"
                                                    @onblur='() => TocarCampo($"cuota_{cuota.Id}_periodicidad")'>
                                                @if (cuota.TipoCuota == "Sostenimiento")
                                                {
                                                    <option value="Mensual">Mensual</option>
                                                    <option value="Bimensual">Bimensual</option>
                                                    <option value="Anual">Anual</option>
                                                }
                                                else
                                                {
                                                    <option value="Pago único">Pago único</option>
                                                    <option value="Mensual">Mensual</option>
                                                    <option value="Bimensual">Bimensual</option>
                                                    <option value="Anual">Anual</option>
                                                }
                                            </select>
                                            @if (TieneErrorVisible($"cuota_{cuota.Id}_periodicidad"))
                                            {
                                                <span class="ra-error-campo" role="alert">@ValidarPeriodicidadCuota(cuota)</span>
                                            }
                                        </div>

                                        <!-- 3. VALOR DE LA CUOTA -->
                                        <div class="ra-campo">
                                            <label class="ra-label">Valor de la cuota o aporte <span class="ra-req">*</span></label>
                                            <div class="ra-input-unidad">
                                                <input type="text"
                                                       inputmode="decimal"
                                                       class="ra-input @(TieneErrorVisible($"cuota_{cuota.Id}_valor") ? "ra-input-error" : "")"
                                                       placeholder="Ej: 50000"
                                                       value="@ObtenerTextoValorCuota(cuota)"
                                                       @oninput="e => CambiarValorCuota(cuota, e.Value?.ToString())"
                                                       @onblur='() => TocarCampo($"cuota_{cuota.Id}_valor")' />
                                                <span class="ra-unidad-badge">COP $</span>
                                            </div>
                                            @if (TieneErrorVisible($"cuota_{cuota.Id}_valor"))
                                            {
                                                <span class="ra-error-campo" role="alert">@ValidarValorCuota(cuota)</span>
                                            }
                                        </div>

                                        <!-- 4. FECHA DE VENCIMIENTO O PRÓXIMO PAGO -->
                                        <div class="ra-campo">
                                            <label class="ra-label">Fecha de vencimiento o próximo pago <span class="ra-req">*</span></label>
                                            <input type="date"
                                                   min="@DateTime.Today.ToString("yyyy-MM-dd")"
                                                   class="ra-input @(TieneErrorVisible($"cuota_{cuota.Id}_fecha") ? "ra-input-error" : "")"
                                                   value="@ObtenerTextoFechaCuota(cuota)"
                                                   @onchange="e => CambiarFechaVencimientoCuota(cuota, e.Value?.ToString())"
                                                   @onblur='() => TocarCampo($"cuota_{cuota.Id}_fecha")' />
                                            @if (TieneErrorVisible($"cuota_{cuota.Id}_fecha"))
                                            {
                                                <span class="ra-error-campo" role="alert">@ValidarFechaVencimientoCuota(cuota)</span>
                                            }
                                        </div>

                                        <!-- 5. CANTIDAD DE CUOTAS PENDIENTES -->
                                        <div class="ra-campo">
                                            <label class="ra-label">Cantidad de cuotas pendientes <span class="ra-req">*</span></label>
                                            <div class="ra-input-unidad">
                                                <input type="text"
                                                       inputmode="numeric"
                                                       class="ra-input @(TieneErrorVisible($"cuota_{cuota.Id}_cantidad") ? "ra-input-error" : "")"
                                                       placeholder="0"
                                                       value="@ObtenerTextoCantidadCuota(cuota)"
                                                       @oninput="e => CambiarCantidadPendientes(cuota, e.Value?.ToString())"
                                                       @onblur='() => TocarCampo($"cuota_{cuota.Id}_cantidad")' />
                                                <span class="ra-unidad-badge">cuota(s)</span>
                                            </div>
                                            @if (TieneErrorVisible($"cuota_{cuota.Id}_cantidad"))
                                            {
                                                <span class="ra-error-campo" role="alert">@ValidarCantidadPendientesCuota(cuota)</span>
                                            }
                                        </div>

                                        <!-- 6. VALOR TOTAL PENDIENTE (CALCULADO AUTOMÁTICAMENTE, NO EDITABLE) -->
                                        <div class="ra-campo">
                                            <div class="ra-label-fila">
                                                <label class="ra-label">Valor total pendiente (saldo)</label>
                                                <span class="ra-contador-pildora">Auto: Total $@cuota.TotalEstablecido.ToString("N0") − Pagado $@cuota.ValorTotalPagado.ToString("N0")</span>
                                            </div>
                                            <div class="ra-input-unidad">
                                                <input type="text"
                                                       readonly
                                                       disabled
                                                       class="ra-input ra-input-readonly"
                                                       value="@(cuota.ValorTotalPendiente % 1 == 0 ? cuota.ValorTotalPendiente.ToString("N0") : cuota.ValorTotalPendiente.ToString("N2"))"
                                                       aria-label="Valor total pendiente calculado automáticamente" />
                                                <span class="ra-unidad-badge">COP $</span>
                                            </div>
                                        </div>

                                        <!-- 7. VALOR TOTAL PAGADO -->
                                        <div class="ra-campo">
                                            <div class="ra-label-fila">
                                                <label class="ra-label">Valor total pagado <span class="ra-req">*</span></label>
                                                <div class="ra-cuota-atajos">
                                                    @if (cuota.TotalEstablecido > 0)
                                                    {
                                                        <button type="button"
                                                                class="ra-link-accion"
                                                                @onclick="() => AsignarPagoTotalEstablecido(cuota)">
                                                            Total ($@cuota.TotalEstablecido.ToString("N0"))
                                                        </button>
                                                    }
                                                    <button type="button"
                                                            class="ra-link-accion"
                                                            @onclick="() => AsignarCuotasPagadas(cuota, 0)">
                                                        $0
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="ra-input-unidad">
                                                <input type="text"
                                                       inputmode="decimal"
                                                       class="ra-input @(TieneErrorVisible($"cuota_{cuota.Id}_pagado") ? "ra-input-error" : "")"
                                                       value="@ObtenerTextoPagadoCuota(cuota)"
                                                       @oninput="e => CambiarValorPagado(cuota, e.Value?.ToString())"
                                                       @onblur='() => TocarCampo($"cuota_{cuota.Id}_pagado")' />
                                                <span class="ra-unidad-badge">COP $</span>
                                            </div>
                                            @if (TieneErrorVisible($"cuota_{cuota.Id}_pagado"))
                                            {
                                                <span class="ra-error-campo" role="alert">@ValidarValorPagadoCuota(cuota)</span>
                                            }
                                        </div>

                                        <!-- 8. ESTADO DE PAGO (DE ACUERDO CON LOS VALORES REGISTRADOS) -->
                                        <div class="ra-campo">
                                            <label class="ra-label">Estado de pago (según valores)</label>
                                            <div class="ra-cuota-estado-caja @ObtenerClaseEstadoCuota(estadoCalculado)">
                                                <span class="ra-cuota-estado-punto"></span>
                                                <div class="ra-cuota-estado-info">
                                                    <strong>@estadoCalculado</strong>
                                                    <small>
                                                        Pagado: $@cuota.ValorTotalPagado.ToString("N0") · Pendiente: $@cuota.ValorTotalPendiente.ToString("N0")
                                                    </small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- COMPROBANTES / DOCUMENTOS ASOCIADOS A ESTA CUOTA O APORTE -->
                                    <div class="ra-cuota-soportes @(cuota.Soportes.Count == 0 ? "pendiente" : "cargado") @(TieneErrorVisible($"cuota_{cuota.Id}_soporte") ? "con-error" : "")">
                                        <div class="ra-cuota-soportes-cab">
                                            <div>
                                                <div class="ra-cedula-adjunto-titulo">
                                                    <strong>Documento o comprobante obligatorio de @cuota.TipoCuota (@cuota.Periodicidad) <span class="ra-req">*</span></strong>
                                                    @if (cuota.Soportes.Count == 0)
                                                    {
                                                        <span class="ra-badge-pendiente">Obligatorio</span>
                                                    }
                                                </div>
                                                <small>Cada cuota o aporte registrado debe contar con su propio soporte o comprobante adjunto (PDF, JPG o PNG, máx. 10 MB).</small>
                                            </div>
                                            <label class="ra-btn ra-btn-adjuntar-fila" for="@($"cuota_soporte_input_{cuota.Id}")">
                                                <InputFile id="@($"cuota_soporte_input_{cuota.Id}")"
                                                           OnChange="@(e => CargarSoportesCuota(cuota, indiceCuota + 1, e))"
                                                           accept=".pdf,.jpg,.jpeg,.png"
                                                           class="ra-hidden-file-input"
                                                           style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; opacity: 0;" />
                                                <svg class="ra-ico"><use href="#ico-doc" /></svg>
                                                <span>+ Adjuntar comprobante(s) de @cuota.TipoCuota</span>
                                            </label>
                                        </div>

                                        @if (cuota.Soportes.Count == 0)
                                        {
                                            <div class="ra-cuota-sin-soportes">
                                                <span>Falta el documento obligatorio del <strong>Registro #@(indiceCuota + 1) (@cuota.TipoCuota · @cuota.Periodicidad)</strong>. Adjunte el comprobante o soporte correspondiente para poder finalizar el registro.</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ra-cuota-soportes-lista">
                                                @foreach (var soporte in cuota.Soportes)
                                                {
                                                    <div class="ra-archivo-barra" @key="soporte.Id">
                                                        <div class="ra-archivo-info">
                                                            <span class="ra-archivo-ico">
                                                                <svg class="ra-ico"><use href="#ico-check" /></svg>
                                                            </span>
                                                            <div class="ra-archivo-datos">
                                                                <strong title="@soporte.ArchivoNombre">@soporte.ArchivoNombre</strong>
                                                                <small>Respalda: Cuota de @cuota.TipoCuota (@cuota.Periodicidad) · @(string.IsNullOrWhiteSpace(soporte.ArchivoTamano) ? "Soporte anexado" : soporte.ArchivoTamano)</small>
                                                            </div>
                                                        </div>
                                                        <div class="ra-archivo-acciones">
                                                            <button type="button"
                                                                    class="ra-btn-accion ra-btn-accion-ver"
                                                                    title="Ver comprobante"
                                                                    @onclick='() => AbrirVisorDocumento($"Comprobante · {cuota.TipoCuota} ({cuota.Periodicidad})", soporte.ArchivoNombre, soporte.ArchivoUrl)'>
                                                                <svg class="ra-ico"><use href="#ico-doc" /></svg>
                                                                <span>Ver</span>
                                                            </button>
                                                            <label class="ra-btn-accion ra-btn-accion-cambiar" title="Reemplazar este comprobante" for="@($"replace_soporte_input_{soporte.Id}")">
                                                                <InputFile id="@($"replace_soporte_input_{soporte.Id}")"
                                                                           OnChange="@(e => ReemplazarSoporteCuota(cuota, indiceCuota + 1, soporte, e))"
                                                                           accept=".pdf,.jpg,.jpeg,.png"
                                                                           class="ra-hidden-file-input"
                                                                           style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; opacity: 0;" />
                                                                <span>Cambiar</span>
                                                            </label>
                                                            <button type="button"
                                                                    class="ra-btn-accion ra-btn-accion-quitar"
                                                                    title="Eliminar comprobante"
                                                                    @onclick="() => QuitarSoporteCuota(cuota, soporte.Id)">
                                                                <span>Quitar</span>
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (TieneErrorVisible($"cuota_{cuota.Id}_soporte"))
                                        {
                                            <span class="ra-error-campo" role="alert">@ValidarSoporteCuota(cuota, indiceCuota + 1)</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeAlerta) && esError)
                    {
                        <div class="ra-alerta ra-alerta-error my-3" role="alert">
                            <span class="ra-alerta-ico">
                                <svg class="ra-ico"><use href="#ico-alerta" /></svg>
                            </span>
                            <div class="ra-alerta-texto">
                                <strong>Atención requerida:</strong>
                                <span>@mensajeAlerta</span>
                            </div>
                            <button type="button" class="ra-alerta-cerrar" @onclick='() => mensajeAlerta = ""' aria-label="Cerrar">&times;</button>
                        </div>
                    }

                    <footer class="ra-acciones">
                        <button type="button" class="ra-btn ra-btn-secundario" @onclick="PasoAnterior">
                            <svg class="ra-ico ra-ico-izquierda"><use href="#ico-flecha" /></svg>
                            <span>Anterior</span>
                        </button>
                        <button type="button"
                                class="ra-btn ra-btn-guardar"
                                disabled="@guardando"
                                @onclick="GuardarRegistro">
                            <svg class="ra-ico"><use href="#ico-check" /></svg>
                            <span>@(guardando ? "Guardando..." : "Guardar Registro")</span>
                        </button>
                    </footer>
                </div>
            }
        </section>

    </div></div><!-- MODAL COMPACTO DE CONFIRMACIÓN DE REGISTRO EXITOSO -->
