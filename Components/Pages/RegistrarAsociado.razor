@page "/registrar-asociado"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@inject HttpClient Http

<div class="page-header">
    <div>
        <p class="eyebrow text-success">Asociados</p>
        <h1>Registrar productor</h1>
        <p>Captura la información base del asociado y deja trazabilidad inicial del registro.</p>
    </div>
    <span class="status-chip">Validación activa</span>
</div>

@if (!string.IsNullOrEmpty(mensajeExito))
{
    <div class="alert alert-success" role="alert">
        @mensajeExito
    </div>
}
@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger" role="alert">
        @mensajeError
    </div>
}

<div class="content-card">
    <div class="form-intro">
        <div>
            <h2>Datos del asociado</h2>
            <p>Todos los campos son obligatorios para crear el registro del productor.</p>
        </div>
    </div>

    <EditForm Model="@asociado" OnValidSubmit="ManejarValidacion">
        <DataAnnotationsValidator /> 

        <div class="row g-3">
            <div class="col-md-6">
                <label for="nombre" class="form-label fw-bold">Nombre Completo <span class="text-danger">*</span></label>
                <InputText id="nombre" class="form-control" placeholder="Ej: Juan Pérez" @bind-Value="asociado.NombreCompleto" />
                <ValidationMessage For="@(() => asociado.NombreCompleto)" class="text-danger small mt-1 d-block" />
            </div>

            <div class="col-md-6">
                <label for="documento" class="form-label fw-bold">Cédula <span class="text-danger">*</span></label>
                <InputText id="documento" class="form-control" placeholder="Ej: 1045123890" @bind-Value="asociado.Cedula" />
                <ValidationMessage For="@(() => asociado.Cedula)" class="text-danger small mt-1 d-block" />
            </div>

            <div class="col-md-6">
                <label for="finca" class="form-label fw-bold">Finca / Vereda <span class="text-danger">*</span></label>
                <InputText id="finca" class="form-control" placeholder="Ej: La Esperanza - Vereda El Tres" @bind-Value="asociado.FincaVereda" />
                <ValidationMessage For="@(() => asociado.FincaVereda)" class="text-danger small mt-1 d-block" />
            </div>

            <div class="col-md-6">
                <label for="cultivo" class="form-label fw-bold">Línea Productiva / Cultivo <span class="text-danger">*</span></label>
                <InputSelect id="cultivo" class="form-select" @bind-Value="asociado.CultivoPrincipal">
                    <option value="">Seleccione un cultivo...</option>
                    <option value="Platano">Plátano</option>
                    <option value="Banano">Banano</option>
                    <option value="Cacao">Cacao</option>
                    <option value="Ganaderia">Ganadería</option>
                </InputSelect>
                <ValidationMessage For="@(() => asociado.CultivoPrincipal)" class="text-danger small mt-1 d-block" />
            </div>
        </div>

        <div class="form-check my-4">
            <InputCheckbox id="bpa" class="form-check-input" @bind-Value="asociado.TieneBPA" />
            <label for="bpa" class="form-check-label">Cuenta con Buenas Prácticas Agrícolas (BPA)</label>
        </div>

        <button type="submit" class="btn btn-primary btn-lg" disabled="@guardando">
            @(guardando ? "Registrando..." : "Registrar Asociado")
        </button>
    </EditForm>
</div>

@code {
    public class Asociado
    {
        [Required(ErrorMessage = "El nombre completo es obligatorio.")]
        public string NombreCompleto { get; set; } = string.Empty;

        [Required(ErrorMessage = "La cédula es obligatoria.")]
        public string Cedula { get; set; } = string.Empty;

        [Required(ErrorMessage = "La finca o vereda es obligatoria.")]
        public string FincaVereda { get; set; } = string.Empty;

        [Required(ErrorMessage = "Debe seleccionar una línea productiva / cultivo.")]
        public string CultivoPrincipal { get; set; } = string.Empty;

        public bool TieneBPA { get; set; }
    }

    public class ApiError
    {
        public string? Message { get; set; }
    }

    private Asociado asociado = new();
    private string mensajeExito = string.Empty;
    private string mensajeError = string.Empty;
    private bool guardando;

    private async Task ManejarValidacion()
    {
        guardando = true;
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        try
        {
            var respuesta = await Http.PostAsJsonAsync("api/asociados", asociado);

            if (respuesta.IsSuccessStatusCode)
            {
                mensajeExito = $"¡Asociado {asociado.NombreCompleto} registrado con éxito!";
                asociado = new();
                return;
            }

            var apiError = await respuesta.Content.ReadFromJsonAsync<ApiError>();
            mensajeError = apiError?.Message ?? "No fue posible registrar el asociado. Intenta nuevamente.";
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible conectar con el servidor.";
        }
        finally
        {
            guardando = false;
        }
    }
} 