@code {
    private int pasoActual = 1;
    private string mensajeAlerta = "";
    private bool esError;
    private bool guardando;
    private bool registroExitoso;
    private bool mostrarModalFicha;
    private bool desplegableCultivosAbierto;
    private bool municipioAbierto;
    private bool esAdminSupervisor;
    private List<string> listaAsociacionesRegistradas = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await BloquearScrollModalAsync(false);
        }
        catch { }
        listaAsociacionesRegistradas = DocumentoService.ObtenerAsociaciones().ToList();
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        esAdminSupervisor = auth.User.IsInRole("Administrador") || auth.User.IsInRole("Admin");
    }

    private readonly HashSet<string> camposTocados = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> erroresArchivos = new(StringComparer.OrdinalIgnoreCase);

    private string hectareasPredioTexto = "";
    private string hectareasProductivasTexto = "";
    private readonly Dictionary<string, string> textosValorCuota = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> textosCantidadCuota = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> textosPagadoCuota = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> textosFechaCuota = new(StringComparer.OrdinalIgnoreCase);

    private static readonly HashSet<string> ExtensionesPermitidas = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf", ".jpg", ".jpeg", ".png"
    };

    private static readonly HashSet<string> TenenciasValidas = new(StringComparer.Ordinal)
    {
        "Propio", "Arrendado", "Prestado"
    };

    private static readonly HashSet<string> ActividadesValidas = new(StringComparer.Ordinal)
    {
        "Agrícola", "Pecuaria", "Mixta"
    };

    private static readonly HashSet<string> TiposCuotaValidos = new(StringComparer.Ordinal)
    {
        "Afiliación", "Sostenimiento", "Ordinaria", "Extraordinaria"
    };

    private static readonly HashSet<string> PeriodicidadesSostenimientoValidas = new(StringComparer.Ordinal)
    {
        "Mensual", "Bimensual", "Anual"
    };

    private static readonly HashSet<string> PeriodicidadesGeneralesValidas = new(StringComparer.Ordinal)
    {
        "Pago único", "Mensual", "Bimensual", "Anual"
    };

    private string ResumenPaso(int paso)
    {
        switch (paso)
        {
            case 1:
                return Paso1Completo
                    ? $"{nuevoAsociado.NombreCompleto} · {nuevoAsociado.TipoDocumentoIdentidad}: {nuevoAsociado.Cedula} · {nuevoAsociado.AsociacionPertenece}"
                    : "Titular, asociación y contacto";
            case 2:
                return Paso2Completo
                    ? $"{nuevoAsociado.NombrePredio} · {NombreMunicipioSeleccionado} · {nuevoAsociado.TenenciaTerreno} · {nuevoAsociado.HectareasPredio:0.##} ha"
                    : "Ubicación, tenencia y área del predio";
            case 3:
                return Paso3Completo
                    ? $"{nuevoAsociado.TipoActividadProductiva} · {nuevoAsociado.CultivosSeleccionados.Count} cultivo(s) · {nuevoAsociado.HectareasLineaProductiva:0.##} ha · {nuevoAsociado.ProduccionAproximada}"
                    : "Actividad, cultivos, producción, hectáreas y BPA";
            case 4:
                return nuevoAsociado.GruposVulnerables.Count > 0
                    ? $"{nuevoAsociado.GruposVulnerables.Count} condición(es) · {ContarSoportesCargados()} soporte(s) cargado(s)"
                    : "Enfoque social y soportes";
            default:
                return nuevoAsociado.CuotasAportes.Count > 0
                    ? $"{nuevoAsociado.CuotasAportes.Count} obligación(es) · Pagado: ${nuevoAsociado.ValorTotalPagadoAcumulado:N0} · Pendiente: ${nuevoAsociado.ValorTotalPendienteAcumulado:N0}"
                    : "Cuotas sociales, aportes y comprobantes";
        }
    }

    private static readonly (string Valor, string Nombre)[] MunicipiosUraba =
    {
        ("Apartado", "Apartadó"),
        ("Turbo", "Turbo"),
        ("Carepa", "Carepa"),
        ("Chigorodo", "Chigorodó"),
        ("Mutata", "Mutatá"),
        ("Necocli", "Necoclí"),
        ("San Pedro de Uraba", "San Pedro de Urabá")
    };

    private string NombreMunicipioSeleccionado =>
        MunicipiosUraba.FirstOrDefault(m => m.Valor == nuevoAsociado.Municipio).Nombre ?? string.Empty;

    private void AlternarDesplegableMunicipio()
    {
        municipioAbierto = !municipioAbierto;
        if (!municipioAbierto)
        {
            TocarCampo("municipio");
        }
    }

    private void SeleccionarMunicipio(string valor)
    {
        nuevoAsociado.Municipio = valor;
        municipioAbierto = false;
        TocarCampo("municipio");
    }

    private static string EmojiCultivo(string codigo) => codigo switch
