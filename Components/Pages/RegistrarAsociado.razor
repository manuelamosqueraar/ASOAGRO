    private string ValidarCultivosLineaProductiva()
    {
        if (nuevoAsociado.CultivosSeleccionados.Count == 0)
        {
            return "Seleccione al menos un cultivo o actividad pecuaria disponible.";
        }

        var codigosCatalogo = AsociadoModel.CatalogoCultivos.Select(c => c.Codigo).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (nuevoAsociado.CultivosSeleccionados.Any(c => !codigosCatalogo.Contains(c)))
        {
            return "Seleccione únicamente cultivos o actividades existentes en el catálogo.";
        }

        var actividad = nuevoAsociado.TipoActividadProductiva;
        if (actividad == "Agrícola" && nuevoAsociado.CultivosSeleccionados.Any(c => string.Equals(c, "Ganaderia", StringComparison.OrdinalIgnoreCase)))
        {
            return "Para actividad Agrícola, seleccione únicamente cultivos agrícolas (retire Ganadería o cambie a actividad Mixta/Pecuaria).";
        }

        if (actividad == "Pecuaria" && nuevoAsociado.CultivosSeleccionados.Any(c => !string.Equals(c, "Ganaderia", StringComparison.OrdinalIgnoreCase)))
        {
            return "Para actividad Pecuaria, seleccione únicamente Ganadería (o cambie el tipo de actividad a Mixta).";
        }

        return string.Empty;
    }

    private string ValidarHectareasProductivas()
    {
        var raw = hectareasProductivasTexto;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "El área productiva es obligatoria.";
        }

        var errorFormato = ValidarTextoAreaHectareas(raw, "El área productiva");
        if (!string.IsNullOrEmpty(errorFormato))
        {
            return errorFormato;
        }

        if (nuevoAsociado.HectareasPredio > 0 && nuevoAsociado.HectareasLineaProductiva > nuevoAsociado.HectareasPredio)
        {
            return $"El área productiva ({nuevoAsociado.HectareasLineaProductiva:0.##} ha) no puede superar el área total del predio ({nuevoAsociado.HectareasPredio:0.##} ha).";
        }

        return string.Empty;
    }

    private string ValidarProduccionAproximada()
    {
        var raw = nuevoAsociado.ProduccionAproximada ?? string.Empty;
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "La producción aproximada es obligatoria.";
        }

        var limpio = raw.Trim();
        if (limpio.StartsWith('-'))
        {
            return "La producción aproximada debe ser un número positivo (no se permiten valores negativos).";
        }

        // Extraer el valor numérico inicial y la unidad opcional posterior
        var idx = 0;
        while (idx < limpio.Length && (char.IsAsciiDigit(limpio[idx]) || limpio[idx] == '.' || limpio[idx] == ','))
        {
            idx++;
        }

        if (idx == 0)
        {
            return "Ingrese primero un valor numérico positivo para la producción aproximada (ej: 15 toneladas/año o 800 kg).";
        }

        var parteNumerica = limpio[..idx];
        var restoUnidad = limpio[idx..].Trim();

        if (!IntentarParsearDecimalPositivoConDosDecimales(parteNumerica, out var valorProd) || valorProd <= 0m)
        {
            return "El valor numérico de la producción debe ser mayor a 0 y tener hasta dos decimales (sin letras en el número).";
        }

        if (!string.IsNullOrEmpty(restoUnidad))
        {
            if (restoUnidad.Any(char.IsAsciiDigit) || restoUnidad.Contains('-'))
            {
                return "No mezcle letras o números adicionales dentro del valor numérico de producción. Use formato como: 12 toneladas/año.";
            }

            if (!EsUnidadProduccionCompatible(restoUnidad, nuevoAsociado.TipoActividadProductiva))
            {
                return nuevoAsociado.TipoActividadProductiva switch
                {
                    "Agrícola" => "Use unidades compatibles con la actividad agrícola (ej: kg, toneladas, t, bultos, cajas, racimos, quintales, @, arrobas o libras, opcionalmente por /mes, /año o /cosecha).",
                    "Pecuaria" => "Use unidades compatibles con la actividad pecuaria (ej: litros, cabezas, reses, kg o toneladas, opcionalmente por /día, /mes o /año).",
                    _ => "Use una unidad válida (ej: kg, toneladas, bultos, cajas, racimos, litros, cabezas o reses, opcionalmente por /día, /mes, /año o /cosecha)."
                };
            }
        }

        return string.Empty;
    }

    private static bool EsUnidadProduccionCompatible(string unidadRaw, string tipoActividad)
    {
        var normalizada = unidadRaw.Trim().ToLowerInvariant()
            .Replace(" por ", "/")
            .Replace(" al ", "/")
            .Replace(" / ", "/")
            .Replace(" /", "/")
            .Replace("/ ", "/");

        var partes = normalizada.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        if (partes.Length == 0 || partes.Length > 2) return false;

        string[] unidadesAgricolas =
        {
            "kg", "kilo", "kilos", "kilogramo", "kilogramos",
            "t", "ton", "tons", "tonelada", "toneladas",
            "bulto", "bultos", "caja", "cajas", "racimo", "racimos",
            "quintal", "quintales", "qq", "arroba", "arrobas",
            "lb", "libra", "libras", "unidad", "unidades"
        };

        string[] unidadesPecuarias =
        {
            "l", "lt", "lts", "litro", "litros",
            "cabeza", "cabezas", "res", "reses", "animal", "animales",
            "kg", "kilo", "kilos", "kilogramo", "kilogramos",
            "t", "ton", "tons", "tonelada", "toneladas",
            "lb", "libra", "libras"
        };

        string[] periodosValidos =
        {
            "dia", "día", "diario", "semana", "semanal",
            "mes", "mensual", "bimestre", "semestre",
            "año", "ano", "anual", "cosecha", "ciclo", "ha", "hectarea", "hectárea"
        };

        var u = partes[0];
        var unidadValida = tipoActividad switch
        {
            "Agrícola" => unidadesAgricolas.Contains(u),
            "Pecuaria" => unidadesPecuarias.Contains(u),
            _ => unidadesAgricolas.Contains(u) || unidadesPecuarias.Contains(u)
        };

        if (!unidadValida) return false;
        if (partes.Length == 2 && !periodosValidos.Contains(partes[1])) return false;

        return true;
    }

