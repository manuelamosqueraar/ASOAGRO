@page "/consultar-asociados"
@rendermode InteractiveServer
@inject HttpClient Http

<h3>Consultar Asociados Registrados</h3>

<div class="mb-3">
    <label for="filtro" class="form-label">Buscar por nombre o número de documento:</label>
    <input id="filtro" class="form-control" @bind="textoFiltro" @bind:event="oninput" placeholder="Escribe para buscar..." />
</div>

@if (cargando)
{
    <p><em>Cargando asociados...</em></p>
}
else if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger mt-3" role="alert">
        @mensajeError
    </div>
}
else if (AsociadosFiltrados.Any())
{
    <table class="table table-striped mt-3">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Finca</th>
                <th>Cultivo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var asociado in AsociadosFiltrados)
            {
                <tr>
                    <td>@asociado.NombreCompleto</td>
                    <td>@asociado.Cedula</td>
                    <td>@asociado.FincaVereda</td>
                    <td>@asociado.CultivoPrincipal</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning mt-3" role="alert">
        No se encontraron asociados con ese criterio de búsqueda.
    </div>
}

@code {
    private string textoFiltro = string.Empty;
    private string mensajeError = string.Empty;
    private bool cargando = true;
    private List<Asociado> listaAsociados = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            listaAsociados = await Http.GetFromJsonAsync<List<Asociado>>("api/asociados") ?? new();
        }
        catch (HttpRequestException)
        {
            mensajeError = "No fue posible cargar los asociados registrados.";
        }
        finally
        {
            cargando = false;
        }
    }

    private IEnumerable<Asociado> AsociadosFiltrados =>
        string.IsNullOrWhiteSpace(textoFiltro) 
            ? listaAsociados 
            : listaAsociados.Where(a => 
                a.NombreCompleto.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
                a.Cedula.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase));
}
