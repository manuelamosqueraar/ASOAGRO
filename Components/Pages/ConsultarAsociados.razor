@page "/consultar-asociados"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Directora,Director")]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using Asoagro.Services
@inject IAsociadoService RegistroAsociados
@inject IJSRuntime JS
 
<div class="ca">
    <!-- BARRA DE BÚSQUEDA ÚNICA SUPERIOR -->
    <div class="ca-barra-superior">
        <div class="ca-buscador">
            <svg class="ca-ico ca-buscador-ico"><use href="#ico-lista" /></svg>
            <input id="ca-filtro"
                   class="ca-input"
                   placeholder="Buscar por nombre, cédula, cultivo o vereda…"
                   @bind="textoFiltro"
                   @bind:event="oninput"
                   aria-label="Buscar productor" />
            @if (!string.IsNullOrEmpty(textoFiltro))
            {
                <button type="button" class="ca-limpiar" @onclick="() => textoFiltro = string.Empty" aria-label="Limpiar búsqueda">&times;</button>
            }
        </div>
    </div>

    <!-- ENCABEZADO -->
    <section class="ca-hero">
        <div class="ca-hero-texto">
            <div class="ca-etiquetas">
                <span class="ca-etiqueta"><svg class="ca-ico"><use href="#ico-brote" /></svg>Urabá Antioqueño</span>
                <span class="ca-etiqueta ca-etiqueta-suave"><svg class="ca-ico"><use href="#ico-escudo" /></svg>Control administrativo</span>
            </div>
            <h1 class="ca-titulo">Listado de asociados</h1>
            <p class="ca-descripcion">Consulta integral de familias productoras, líneas productivas múltiples, cumplimiento de BPA y caracterización social con soportes.</p>
        </div>

        <div class="ca-hero-resumen">
            <span class="ca-resumen-etiqueta">Total en registro</span>
            <strong class="ca-resumen-valor">@listaAsociados.Count</strong>
            <div class="ca-resumen-estado">
                <span class="ca-punto"></span>
                <span>Sincronizado</span>
            </div>
        </div>
    </section>

    <!-- FILTROS Y EXPORTACIÓN -->
    <section class="ca-panel">
        <div class="ca-filtros">
            <div class="ca-filtros-grupo">
                <span class="ca-filtros-titulo">Cultivo</span>
                <div class="ca-filtros-chips" role="group" aria-label="Filtrar por cultivo">
                    <button type="button" class="ca-chip @(filtroCultivo == "" ? "activo" : "")" @onclick='() => filtroCultivo = ""'>Todos</button>
                    @foreach (var cultivo in AsociadoModel.CatalogoCultivos)
                    {
                        <button type="button"
                                class="ca-chip @(string.Equals(filtroCultivo, cultivo.Codigo, StringComparison.OrdinalIgnoreCase) ? "activo" : "")"
                                @onclick="() => filtroCultivo = cultivo.Codigo">
                            @cultivo.Nombre
                        </button>
                    }
                </div>
            </div>

            <div class="ca-filtros-acciones">
                <span class="ca-conteo">@AsociadosFiltrados.Count() resultado(s)</span>
                <button type="button" class="ca-btn ca-btn-secundario" @onclick="ExportarReporte">
                    <svg class="ca-ico"><use href="#ico-doc" /></svg>
                    Exportar Excel
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeExportacion))
        {
            <div class="ca-exportacion-fila">
                <span class="ca-exportacion-mensaje" role="status" aria-live="polite">@mensajeExportacion</span>
            </div>
        }
    </section>

    <!-- LISTADO -->
    @if (AsociadosFiltrados.Any())
    {
        <div class="ca-tabla-marco">
            <table class="ca-tabla">
                <colgroup>
                    <col class="ca-col-asociado" />
                    <col class="ca-col-predio" />
                    <col class="ca-col-cultivo" />
                    <col class="ca-col-estado" />
                    <col class="ca-col-acciones" />
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Asociado</th>
                        <th scope="col">Predio y ubicación</th>
                        <th scope="col">Línea productiva y área</th>
                        <th scope="col">Estado y BPA</th>
                        <th scope="col" class="ca-th-acciones">Reporte del asociado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var asociado in AsociadosFiltrados)
                    {
                        <tr>
                            <td data-label="Asociado">
                                <div class="ca-tabla-asociado">
                                    <span class="ca-avatar">@ObtenerIniciales(asociado.NombreCompleto)</span>
                                    <span class="ca-fila-identidad">
                                        <strong>@asociado.NombreCompleto</strong>
                                        <small>CC @asociado.Cedula</small>
                                    </span>
                                </div>
                            </td>
                            <td data-label="Predio y ubicación">
                                <div class="ca-tabla-dato">
                                    <strong>@asociado.NombrePredio</strong>
                                    <span>@asociado.VeredaSector, @asociado.Municipio@(!string.IsNullOrWhiteSpace(asociado.TenenciaTerreno) ? $" · {asociado.TenenciaTerreno}" : "")</span>
                                </div>
                            </td>
                            <td data-label="Línea productiva y área">
                                <div class="ca-tabla-dato ca-tabla-cultivo">
                                    <span class="ca-cultivo">@NombreCultivo(asociado.CultivoPrincipal)@(!string.IsNullOrWhiteSpace(asociado.TipoActividadProductiva) ? $" · {asociado.TipoActividadProductiva}" : "")</span>
                                    <span>@(asociado.HectareasLineaProductiva > 0 ? $"{asociado.HectareasLineaProductiva:0.#} ha prod." : $"{asociado.HectareasPredio:0.#} ha") (@asociado.HectareasPredio.ToString("0.#") ha total)@(!string.IsNullOrWhiteSpace(asociado.ProduccionAproximada) ? $" · {asociado.ProduccionAproximada}" : "")</span>
                                </div>
                            </td>
                            <td data-label="Estado">
                                <div class="ca-tabla-estado">
                                    <span class="ca-estado @(asociado.EstadoMembresia == "AlDia" ? "ca-estado-ok" : "ca-estado-gracia")">
                                        @(asociado.EstadoMembresia == "AlDia" ? "Al día" : "En gracia")
                                    </span>
                                    <span class="ca-bpa @(asociado.TieneBPA ? "ca-bpa-ok" : "")">
                                        <svg class="ca-ico"><use href="#ico-escudo" /></svg>
                                        @(asociado.TieneBPA ? "BPA vigente" : "Sin BPA")
                                    </span>
                                </div>
                            </td>
                            <td data-label="Reporte del asociado">
                                <div class="ca-tabla-acciones">
                                    <button type="button"
                                            class="ca-btn ca-btn-mini"
                                            disabled="@(cedulaDescargandoPdf == asociado.Cedula)"
                                            title="Generar y descargar PDF con la información completa del asociado"
                                            @onclick="() => DescargarPdfAsociado(asociado)">
                                        <svg class="ca-ico"><use href="#ico-doc" /></svg>
                                        <span>@(cedulaDescargandoPdf == asociado.Cedula ? "Generando..." : "Descargar PDF")</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <section class="ca-vacio">
            <span class="ca-vacio-ico"><svg class="ca-ico"><use href="#ico-brote" /></svg></span>
            <h3>No se encontraron productores</h3>
            <p>No hay registros que coincidan con los filtros seleccionados.</p>
            <a class="ca-btn ca-btn-primario" href="registrar-asociado">
                <svg class="ca-ico"><use href="#ico-usuario-mas" /></svg>
                Registrar asociado
            </a>
        </section>
    }

    <!-- FICHA DEL PRODUCTOR -->
    @if (asociadoSeleccionado != null)
    {
        <div class="ca-velo" @onclick="CerrarDetalle">
            <article class="ca-ficha" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-label="Ficha del productor">

                <header class="ca-ficha-cab">
                    <div class="ca-ficha-id">
                        <span class="ca-ficha-avatar">@ObtenerIniciales(asociadoSeleccionado.NombreCompleto)</span>
                        <div>
                            <span class="ca-sello">Expediente oficial FAAUA</span>
                            <h2>@asociadoSeleccionado.NombreCompleto</h2>
                            <small>CC @asociadoSeleccionado.Cedula · Cel. @asociadoSeleccionado.Telefono</small>
                        </div>
                    </div>
                    <button type="button" class="ca-cerrar" @onclick="CerrarDetalle" aria-label="Cerrar ficha">&times;</button>
                </header>

                <div class="ca-ficha-cuerpo">
                    <section class="ca-bloque">
                        <h4><svg class="ca-ico"><use href="#ico-mapa" /></svg>I. Predio y Ubicación</h4>
                        <dl>
                            <div><dt>Predio</dt><dd>@asociadoSeleccionado.NombrePredio</dd></div>
                            <div><dt>Vereda</dt><dd>@asociadoSeleccionado.VeredaSector</dd></div>
                            <div><dt>Municipio</dt><dd>@asociadoSeleccionado.Municipio</dd></div>
                            <div><dt>Tenencia del Terreno</dt><dd>@(string.IsNullOrWhiteSpace(asociadoSeleccionado.TenenciaTerreno) ? "No especificada" : asociadoSeleccionado.TenenciaTerreno)</dd></div>
                            <div><dt>Extensión Total</dt><dd class="ca-destacado">@asociadoSeleccionado.HectareasPredio.ToString("0.#") ha</dd></div>
                            <div><dt>Fotocopia Cédula / NIT</dt><dd title="@asociadoSeleccionado.CedulaArchivoNombre">@(string.IsNullOrWhiteSpace(asociadoSeleccionado.CedulaArchivoNombre) ? "No adjunta" : asociadoSeleccionado.CedulaArchivoNombre)</dd></div>
                        </dl>
                    </section>

                    <section class="ca-bloque">
                        <h4><svg class="ca-ico"><use href="#ico-brote" /></svg>II. Línea Productiva y BPA</h4>
                        <dl>
                            <div><dt>Actividad Productiva</dt><dd>@(string.IsNullOrWhiteSpace(asociadoSeleccionado.TipoActividadProductiva) ? "No especificada" : asociadoSeleccionado.TipoActividadProductiva)</dd></div>
                            <div><dt>Cultivos</dt><dd>@NombreCultivo(asociadoSeleccionado.CultivoPrincipal)</dd></div>
                            <div><dt>Producción Aproximada</dt><dd>@(string.IsNullOrWhiteSpace(asociadoSeleccionado.ProduccionAproximada) ? "No especificada" : asociadoSeleccionado.ProduccionAproximada)</dd></div>
                            <div><dt>Área Productiva</dt><dd class="ca-destacado">@(asociadoSeleccionado.HectareasLineaProductiva > 0 ? $"{asociadoSeleccionado.HectareasLineaProductiva:0.#} ha" : $"{asociadoSeleccionado.HectareasPredio:0.#} ha")</dd></div>
                            <div>
                                <dt>Certificación BPA</dt>
                                <dd class="@(asociadoSeleccionado.TieneBPA ? "ca-destacado" : "")" title="@asociadoSeleccionado.CertificadoBpaNombre">
                                    @(asociadoSeleccionado.TieneBPA
                                        ? (!string.IsNullOrWhiteSpace(asociadoSeleccionado.CertificadoBpaNombre) ? $"Vigente ({asociadoSeleccionado.CertificadoBpaNombre})" : "Vigente ICA")
                                        : "No registra")
                                </dd>
                            </div>
                            <div><dt>Membresía</dt><dd>@(asociadoSeleccionado.EstadoMembresia == "AlDia" ? "Al día" : "En gracia")</dd></div>
                        </dl>
                    </section>

                    <section class="ca-bloque ca-bloque-completo">
                        <h4><svg class="ca-ico"><use href="#ico-escudo" /></svg>III. Componente Social y Soportes de Vulnerabilidad</h4>
                        @if (asociadoSeleccionado.GruposVulnerables.Count > 0)
                        {
                            <dl>
                                @foreach (var cod in asociadoSeleccionado.GruposVulnerables)
                                {
                                    var soporte = asociadoSeleccionado.SoportesGruposVulnerables.TryGetValue(cod, out var n) ? n : "Soporte verificado";
                                    <div>
                                        <dt>@AsociadoModel.TraducirGrupoVulnerable(cod)</dt>
                                        <dd class="ca-destacado" title="@soporte">@soporte</dd>
                                    </div>
                                }
                            </dl>
                        }
                        else
                        {
                            <dl>
                                <div>
                                    <dt>Condición de vulnerabilidad</dt>
                                    <dd>@(asociadoSeleccionado.EsVictima == "Si" ? "Víctima del conflicto armado" : "Sin condición reportada")</dd>
                                </div>
                            </dl>
                        }
                    </section>

                    <section class="ca-bloque ca-bloque-completo">
                        <h4><svg class="ca-ico"><use href="#ico-lista" /></svg>IV. Cuotas Sociales y Aportes</h4>
                        <dl>
                            <div>
                                <dt>Estado General de Pago</dt>
                                <dd class="ca-destacado">@asociadoSeleccionado.EstadoGeneralCuotas</dd>
                            </div>
                            <div>
                                <dt>Valor Total Pagado</dt>
                                <dd class="ca-destacado">$@asociadoSeleccionado.ValorTotalPagadoAcumulado.ToString("N0")</dd>
                            </div>
                            <div>
                                <dt>Valor Total Pendiente</dt>
                                <dd>$@asociadoSeleccionado.ValorTotalPendienteAcumulado.ToString("N0") (@asociadoSeleccionado.TotalCuotasPendientes cuota(s))</dd>
                            </div>
                            @foreach (var cuota in asociadoSeleccionado.CuotasAportes)
                            {
                                var nombresSoportes = cuota.Soportes.Count > 0
                                    ? string.Join(", ", cuota.Soportes.Select(s => s.ArchivoNombre))
                                    : "Sin comprobante adjunto";
                                <div>
                                    <dt>@cuota.TipoCuota (@cuota.Periodicidad) · $@cuota.ValorCuota.ToString("N0")</dt>
                                    <dd title="@nombresSoportes">
                                        @cuota.CalcularEstadoAutomatico() · Vence: @(cuota.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "N/A") · Soportes: @nombresSoportes
                                    </dd>
                                </div>
                            }
                        </dl>
                    </section>
                </div>

                <footer class="ca-ficha-pie">
                    <span>Fecha de registro: @asociadoSeleccionado.FechaRegistro.ToString("dd/MM/yyyy")</span>
                    <div class="ca-tabla-acciones">
                        <a href="@($"/editar-asociado/{asociadoSeleccionado.Cedula}")" class="ca-btn ca-btn-secundario">
                            <svg class="ca-ico"><use href="#ico-ajustes" /></svg>
                            Editar expediente
                        </a>
                        <button type="button" class="ca-btn ca-btn-primario" @onclick="CerrarDetalle">Cerrar ficha</button>
                    </div>
                </footer>
            </article>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")]
    public string? BusquedaUrl { get; set; }

    private string textoFiltro = string.Empty;
    private string filtroCultivo = string.Empty;
    private List<AsociadoModel> listaAsociados = new();
    private AsociadoModel? asociadoSeleccionado;
    private string? cedulaDescargandoPdf;
    private IJSObjectReference? ModuloJavaScript;
    private string mensajeExportacion = string.Empty;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(BusquedaUrl))
        {
            textoFiltro = BusquedaUrl;
        }
    }

    protected override void OnInitialized()
    {
        listaAsociados = RegistroAsociados.ObtenerTodos()
            .Select(AsociadoMapper.ToModel)
            .Where(a => !string.IsNullOrWhiteSpace(a.NombreCompleto)
                     && !string.IsNullOrWhiteSpace(a.Cedula)
                     && !string.IsNullOrWhiteSpace(a.Telefono)
                     && !string.IsNullOrWhiteSpace(a.NombrePredio)
                     && !string.IsNullOrWhiteSpace(a.VeredaSector)
                     && !string.IsNullOrWhiteSpace(a.Municipio)
                     && a.HectareasPredio > 0
                     && !string.IsNullOrWhiteSpace(a.CultivoPrincipal))
            .ToList();
    }

    private IEnumerable<AsociadoModel> AsociadosFiltrados =>
        listaAsociados.Where(a =>
            (string.IsNullOrWhiteSpace(textoFiltro) ||
             a.NombreCompleto.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
             a.Cedula.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
             a.VeredaSector.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
             a.Municipio.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
             a.NombrePredio.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
             a.CultivoPrincipal.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
             NombreCultivo(a.CultivoPrincipal).Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
             a.CultivosSeleccionados.Any(c =>
                 c.Contains(textoFiltro, StringComparison.OrdinalIgnoreCase) ||
                 NombreCultivo(c).Contains(textoFiltro, StringComparison.OrdinalIgnoreCase))) &&
            (string.IsNullOrWhiteSpace(filtroCultivo) ||
             a.CultivosSeleccionados.Any(c => string.Equals(c, filtroCultivo, StringComparison.OrdinalIgnoreCase)) ||
             a.CultivoPrincipal.Contains(filtroCultivo, StringComparison.OrdinalIgnoreCase)));

    private void VerDetalle(AsociadoModel asociado) => asociadoSeleccionado = asociado;
    private void CerrarDetalle() => asociadoSeleccionado = null;

    private async Task DescargarPdfAsociado(AsociadoModel asociado)
    {
        try
        {
            cedulaDescargandoPdf = asociado.Cedula;
            var fechaAhora = DateTime.Now;
            var pdfBytes = AsociadoPdfGenerator.GenerarFichaPdf(asociado, fechaAhora);
            var cedulaLimpia = string.Concat(asociado.Cedula.Where(char.IsLetterOrDigit));
            if (string.IsNullOrWhiteSpace(cedulaLimpia))
            {
                cedulaLimpia = "asociado";
            }

            var nombreArchivo = $"Reporte_Asociado_{cedulaLimpia}_{fechaAhora:yyyyMMdd_HHmm}.pdf";

            await using var stream = new MemoryStream(pdfBytes);
            using var streamRef = new DotNetStreamReference(stream);
            ModuloJavaScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/actas-archivos.js");
            await ModuloJavaScript.InvokeVoidAsync("descargar", nombreArchivo, streamRef, "application/pdf");
            mensajeExportacion = $"Se descargó el PDF del expediente de {asociado.NombreCompleto}.";
        }
        finally
        {
            cedulaDescargandoPdf = null;
        }
    }

    private async Task ExportarReporte()
    {
        var asociados = AsociadosFiltrados.ToList();
        if (asociados.Count == 0)
        {
            mensajeExportacion = "No hay asociados que coincidan con los filtros actuales.";
            return;
        }

        var lineas = new List<string>
        {
            CrearFilaCsv(
                "Nombre completo", "Cédula", "Fotocopia Cédula/NIT", "Teléfono", "Correo electrónico", "Predio",
                "Vereda o sector", "Municipio", "Tenencia del terreno", "Hectáreas predio", "Hectáreas productivas",
                "Actividad productiva", "Producción aproximada", "Cultivos", "BPA vigente",
                "Certificado BPA", "Condición vulnerable", "Estado de cuotas", "Total pagado cuotas", "Total pendiente cuotas",
                "Estado de membresía", "Fecha de registro")
        };

        lineas.AddRange(asociados.Select(asociado => CrearFilaCsv(
            asociado.NombreCompleto,
            asociado.Cedula,
            asociado.CedulaArchivoNombre,
            asociado.Telefono,
            asociado.Correo,
            asociado.NombrePredio,
            asociado.VeredaSector,
            asociado.Municipio,
            asociado.TenenciaTerreno,
            asociado.HectareasPredio.ToString(System.Globalization.CultureInfo.GetCultureInfo("es-CO")),
            asociado.HectareasLineaProductiva.ToString(System.Globalization.CultureInfo.GetCultureInfo("es-CO")),
            asociado.TipoActividadProductiva,
            asociado.ProduccionAproximada,
            NombreCultivo(asociado.CultivoPrincipal),
            asociado.TieneBPA ? "Sí" : "No",
            asociado.CertificadoBpaNombre,
            asociado.GruposVulnerables.Count > 0
                ? string.Join(", ", asociado.GruposVulnerables.Select(AsociadoModel.TraducirGrupoVulnerable))
                : asociado.EsVictima,
            asociado.EstadoGeneralCuotas,
            asociado.ValorTotalPagadoAcumulado.ToString("0"),
            asociado.ValorTotalPendienteAcumulado.ToString("0"),
            asociado.EstadoMembresia == "AlDia" ? "Al día" : asociado.EstadoMembresia,
            asociado.FechaRegistro.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture))));

        var nombre = $"asociados-{DateTime.Now:yyyyMMdd-HHmm}.csv";
        var contenido = string.Join("\r\n", lineas);
        ModuloJavaScript ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/actas-archivos.js");
        await ModuloJavaScript.InvokeVoidAsync("descargarCsv", nombre, contenido);
        mensajeExportacion = $"Se exportaron {asociados.Count} asociados.";
    }

    private static string CrearFilaCsv(params string?[] valores) =>
        string.Join(';', valores.Select(valor =>
        {
            var seguro = valor ?? string.Empty;
            if (seguro.Length > 0 && seguro[0] is '=' or '+' or '-' or '@' or '\t' or '\r')
            {
                seguro = "'" + seguro;
            }

            return $"\"{seguro.Replace("\"", "\"\"")}\"";
        }));

    private string NombreCultivo(string valor) => AsociadoModel.FormatearNombreCultivo(valor);

    private string ObtenerIniciales(string nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0].Substring(0, 1).ToUpper();
        return $"{partes[0][0]}{partes[1][0]}".ToUpper();
    }

    public async ValueTask DisposeAsync()
    {
        if (ModuloJavaScript is not null)
        {
            try
            {
                await ModuloJavaScript.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }
}
