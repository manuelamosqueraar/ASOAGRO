    private void ConfirmarQuitarArchivo()
    {
        if (!string.IsNullOrWhiteSpace(documentoAConfirmarEliminar))
        {
            var docItem = documentosIniciales.FirstOrDefault(d => d.TipoDocumento == documentoAConfirmarEliminar);
            if (docItem != null)
            {
                docItem.ArchivoNombre = null;
                docItem.ArchivoContenido = null;
                docItem.TamanoBytes = 0;
            }
            documentoAConfirmarEliminar = null;
        }
    }

    private void CancelarQuitarArchivo()
    {
        documentoAConfirmarEliminar = null;
    }

