            var existentes = DocumentoService.ObtenerPorAsociacion(clave);
            foreach (var item in documentosIniciales)
            {
                var doc = existentes.FirstOrDefault(d => string.Equals(d.TipoDocumento.Trim(), item.TipoDocumento.Trim(), StringComparison.OrdinalIgnoreCase));
                if (doc != null && !string.IsNullOrWhiteSpace(doc.ArchivoNombre))
                {
