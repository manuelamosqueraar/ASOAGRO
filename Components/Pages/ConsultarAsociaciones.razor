                    item.FechaEmision = doc.FechaEmision;
                    item.FechaVencimiento = doc.FechaVencimiento;
                    item.TieneVencimiento = doc.TieneVencimiento;
                    item.EstadoRevision = doc.EstadoRevision;
                }
            }
        }
    }

    private async Task CargarArchivoInicial(InputFileChangeEventArgs e, string tipoDocumento)
    {
        errorFormulario = "";
        var file = e.File;
        if (file == null) return;

        if (file.Size == 0)
        {
            errorFormulario = "El archivo seleccionado está vacío (0 bytes). Selecciona un archivo válido.";
            return;
        }

        const long maxBytes = 10 * 1024 * 1024; // 10 MB
        if (file.Size > maxBytes)
        {
            errorFormulario = $"El archivo '{file.Name}' supera el límite permitido de 10 MB ({file.Size / (1024 * 1024.0):F1} MB).";
            return;
        }

        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        var permitidas = new[] { ".pdf", ".jpg", ".jpeg", ".png" };
        if (!permitidas.Contains(ext))
        {
            errorFormulario = $"El formato '{ext}' no está permitido. Solo se aceptan archivos PDF, JPG y PNG.";
            return;
        }

        try
        {
            using var stream = file.OpenReadStream(maxBytes);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);

            var docItem = documentosIniciales.FirstOrDefault(d => d.TipoDocumento == tipoDocumento);
            if (docItem != null)
            {
                docItem.ArchivoNombre = file.Name;
                docItem.ArchivoContenido = ms.ToArray();
                docItem.TamanoBytes = file.Size;
                docItem.ArchivoTipoMime = file.ContentType ?? (ext == ".pdf" ? "application/pdf" : (ext == ".png" ? "image/png" : "image/jpeg"));
                docItem.EstadoRevision = "Aprobado";
            }
        }
        catch (Exception ex)
        {
            errorFormulario = $"Error al leer el archivo '{file.Name}': {ex.Message}";
        }
    }

