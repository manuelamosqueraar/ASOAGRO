    private void ActualizarNit(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? string.Empty;
        formularioModelo.Nit = Regex.Replace(raw, "[^0-9]", "");
        formularioModelo.DigitoVerificacion = CalcularDigitoVerificacionDian(formularioModelo.Nit);
    }

    private static string CalcularDigitoVerificacionDian(string nit)
    {
        if (string.IsNullOrWhiteSpace(nit)) return string.Empty;
        var nums = Regex.Replace(nit, "[^0-9]", "");
        if (nums.Length == 0) return string.Empty;

        int[] primos = { 3, 7, 13, 17, 19, 23, 29, 37, 41, 43, 47, 53, 59, 67, 71 };
        int suma = 0;
        int p = 0;
        for (int i = nums.Length - 1; i >= 0 && p < primos.Length; i--, p++)
        {
            suma += (nums[i] - '0') * primos[p];
        }

        int residuo = suma % 11;
        if (residuo == 0 || residuo == 1) return residuo.ToString();
        return (11 - residuo).ToString();
    }

    private static DateTime? ParsearFecha(string? texto)
    {
        if (DateTime.TryParse(texto, out var f)) return f.Date;
        return null;
    }

    private void AvanzarSeccion()
    {
        errorFormulario = "";

        if (seccionFormulario == 1)
        {
            if (string.IsNullOrWhiteSpace(formularioModelo.NombreLegal))
            {
                errorFormulario = "El nombre legal completo de la asociación es obligatorio.";
                return;
            }

            if (formularioModelo.NombreLegal.Trim().Length < 4)
            {
                errorFormulario = "El nombre legal debe tener al menos 4 caracteres.";
                return;
            }

            if (!Regex.IsMatch(formularioModelo.NombreLegal, @"[a-zA-ZáéíóúÁÉÍÓÚñÑ]"))
            {
                errorFormulario = "El nombre legal no puede componerse únicamente de números o caracteres especiales.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(formularioModelo.Sigla))
            {
                if (formularioModelo.Sigla.Length > 20)
                {
                    errorFormulario = "La sigla institucional no debe superar los 20 caracteres.";
                    return;
                }

                if (!Regex.IsMatch(formularioModelo.Sigla, @"^[a-zA-Z0-9áéíóúÁÉÍÓÚñÑ\s\.\-]+$"))
                {
                    errorFormulario = "La sigla institucional contiene caracteres no permitidos (solo letras, números, puntos y guiones).";
                    return;
                }
            }

            if (formularioModelo.TipoOrganizacion == "Otra" && string.IsNullOrWhiteSpace(formularioModelo.TipoOrganizacionOtro))
            {
                errorFormulario = "Por favor especifique el tipo o clasificación jurídica de la entidad.";
                return;
            }

            if (formularioModelo.ActividadProductiva == "Otro" && string.IsNullOrWhiteSpace(formularioModelo.ActividadProductivaOtro))
            {
                errorFormulario = "Por favor especifique la actividad o enfoque productivo de la entidad.";
                return;
            }

            if (!editandoExistente && DocumentoService.ExisteNombre(formularioModelo.NombreLegal, formularioModelo.Id))
            {
                errorFormulario = $"Ya existe otra asociación registrada con el nombre '{formularioModelo.NombreLegal}'. Evite registros duplicados.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(formularioModelo.Nit))
            {
                if (formularioModelo.Nit.Length < 8 || formularioModelo.Nit.Length > 10)
                {
                    errorFormulario = "El NIT institucional debe tener entre 8 y 10 dígitos numéricos (sin dígito de verificación).";
                    return;
                }

                if (DocumentoService.ExisteNit(formularioModelo.Nit, formularioModelo.Id))
                {
                    errorFormulario = $"El NIT {formularioModelo.Nit} ya se encuentra registrado por otra asociación federada. Verifique los datos.";
                    return;
                }
            }

            if (formularioModelo.FechaConstitucion.HasValue && formularioModelo.FechaConstitucion.Value.Date > DateTime.Today)
            {
                errorFormulario = "La fecha de constitución asamblearia no puede ser una fecha futura.";
                return;
            }

            if (formularioModelo.Estado != "Activa" && string.IsNullOrWhiteSpace(formularioModelo.MotivoCambioEstado))
            {
                errorFormulario = "Debe registrar el motivo de suspensión, disolución o actualización de la asociación.";
                return;
            }
        }
        else if (seccionFormulario == 2)
        {
            if (formularioModelo.FechaInscripcion.HasValue && formularioModelo.FechaInscripcion.Value.Date > DateTime.Today)
            {
                errorFormulario = "La fecha de inscripción en Cámara de Comercio no puede ser una fecha futura.";
                return;
            }
        }
        else if (seccionFormulario == 3)
        {
            if (string.IsNullOrWhiteSpace(formularioModelo.Municipio))
            {
                errorFormulario = "El municipio de sede es obligatorio.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(formularioModelo.CorreoInstitucional) &&
                !Regex.IsMatch(formularioModelo.CorreoInstitucional, @"^[^@\s]+@[^@\s]+\.[^@\s]+$"))
            {
                errorFormulario = "El correo electrónico institucional no tiene un formato válido (ejemplo: contacto@asociacion.org).";
                return;
            }

            if (!string.IsNullOrWhiteSpace(formularioModelo.TelefonoContacto) &&
                !Regex.IsMatch(formularioModelo.TelefonoContacto, @"^[0-9]{7,10}$"))
            {
                errorFormulario = "El teléfono institucional debe tener entre 7 y 10 dígitos numéricos (ej. celular o fijo de Colombia).";
                return;
            }
        }
        else if (seccionFormulario == 4)
        {
            if (string.IsNullOrWhiteSpace(formularioModelo.RepLegalNombre))
            {
                errorFormulario = "El nombre del representante legal es obligatorio.";
                return;
            }

            if (formularioModelo.RepLegalNombre.Trim().Length < 4 || !Regex.IsMatch(formularioModelo.RepLegalNombre, @"[a-zA-ZáéíóúÁÉÍÓÚñÑ]"))
            {
                errorFormulario = "El nombre del representante legal debe ser un nombre válido con al menos 4 caracteres.";
                return;
            }

            if (!formularioModelo.FiscalAplica && string.IsNullOrWhiteSpace(formularioModelo.FiscalMotivoNoAplica))
            {
                errorFormulario = "Indique el motivo por el cual no aplica revisor fiscal u órgano de control.";
                return;
            }
        }

        seccionFormulario++;
    }

    private async Task GuardarAsociacion(bool esBorrador = false)
    {
        errorFormulario = "";

        if (string.IsNullOrWhiteSpace(formularioModelo.NombreLegal))
        {
            errorFormulario = "El nombre legal de la asociación es obligatorio.";
            seccionFormulario = 1;
            return;
        }

        if (string.IsNullOrWhiteSpace(formularioModelo.RepLegalNombre))
        {
            errorFormulario = "El nombre del representante legal es obligatorio.";
            seccionFormulario = 4;
            return;
        }

        if (!string.IsNullOrWhiteSpace(formularioModelo.Nit))
        {
            if (DocumentoService.ExisteNit(formularioModelo.Nit, formularioModelo.Id))
            {
                errorFormulario = $"El NIT {formularioModelo.Nit} ya está registrado por otra asociación. Por favor verifique los datos para no duplicarla.";
                seccionFormulario = 1;
                return;
            }
        }

        if (!esBorrador && DocumentosFaltantesObligatorios.Any())
        {
            errorFormulario = $"Faltan {DocumentosFaltantesObligatorios.Count} soporte(s) requerido(s) para marcar el expediente como completo. Puedes adjuntarlos ahora o pulsar 'Guardar como Borrador'.";
            return;
        }

        formularioModelo.EstadoExpediente = esBorrador ? "Borrador" : "Completo";
        formularioModelo.ActualizadoPor = usuarioActual;
        formularioModelo.FechaActualizacion = DateTime.Now;

        var exito = DocumentoService.GuardarAsociacionInstitucional(formularioModelo, documentosIniciales);
        if (!exito)
        {
            errorFormulario = "No fue posible guardar la asociación. Verifique que no exista otra entidad con el mismo NIT.";
            return;
        }

        mensajeAlerta = editandoExistente
            ? $"El perfil y expediente de '{formularioModelo.NombreLegal}' fueron actualizados exitosamente."
            : $"La asociación '{formularioModelo.NombreLegal}' fue registrada satisfactoriamente en el directorio y su expediente documental quedó vinculado.";
        esErrorAlerta = false;

        CargarDatos();
        await CerrarModalFormulario();
    }

