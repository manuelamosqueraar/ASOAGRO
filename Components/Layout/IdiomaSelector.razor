@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="idioma @(abierto ? "abierto" : "") @(cambiando ? "cambiando" : "")" translate="no" @onkeydown="TeclaEnIdioma">

    @if (abierto)
    {
        <div class="idioma-fondo" @onclick="Cerrar"></div>

        <div class="idioma-panel" role="group" aria-label="Elegir idioma">
            <p class="idioma-cab">Idioma de la página</p>

            <button type="button" class="idioma-opcion @(EsIngles ? "" : "activo")" aria-pressed="@(EsIngles ? "false" : "true")" @onclick='() => CambiarAsync("es")'>
                <span class="idioma-bandera">
                    <svg viewBox="0 0 750 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
                        <rect width="750" height="125" fill="#c60b1e" />
                        <rect y="125" width="750" height="250" fill="#ffc400" />
                        <rect y="375" width="750" height="125" fill="#c60b1e" />
                    </svg>
                </span>
                <span class="idioma-nombre">Español</span>
                <svg class="idioma-check" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7" /></svg>
            </button>

            <button type="button" class="idioma-opcion @(EsIngles ? "activo" : "")" aria-pressed="@(EsIngles ? "true" : "false")" @onclick='() => CambiarAsync("en")'>
                <span class="idioma-bandera">
                    <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
                        <rect width="60" height="30" fill="#012169" />
                        <path d="M0 0L60 30M60 0L0 30" stroke="#fff" stroke-width="6" />
                        <path d="M0 0L60 30M60 0L0 30" stroke="#c8102e" stroke-width="4" />
                        <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
                        <path d="M30 0v30M0 15h60" stroke="#c8102e" stroke-width="6" />
                    </svg>
                </span>
                <span class="idioma-nombre">English</span>
                <svg class="idioma-check" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12.5l4.2 4.2L19 7" /></svg>
            </button>
        </div>
    }

    <button type="button" class="idioma-boton" aria-label="Cambiar idioma" aria-expanded="@(abierto ? "true" : "false")" @onclick="Alternar">
        <span class="idioma-bandera">
            @if (EsIngles)
            {
                <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
                    <rect width="60" height="30" fill="#012169" />
                    <path d="M0 0L60 30M60 0L0 30" stroke="#fff" stroke-width="6" />
                    <path d="M0 0L60 30M60 0L0 30" stroke="#c8102e" stroke-width="4" />
                    <path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10" />
                    <path d="M30 0v30M0 15h60" stroke="#c8102e" stroke-width="6" />
                </svg>
            }
            else
            {
                <svg viewBox="0 0 750 500" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
                    <rect width="750" height="125" fill="#c60b1e" />
                    <rect y="125" width="750" height="250" fill="#ffc400" />
                    <rect y="375" width="750" height="125" fill="#c60b1e" />
                </svg>
            }
        </span>
        <span class="idioma-codigo">@(EsIngles ? "EN" : "ES")</span>
        <svg class="idioma-flecha" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 9l6 6 6-6" /></svg>
    </button>
</div>

<style>
    .idioma {
        --bosque: #0b2e1c; --pino: #17603a; --hoja: #2e9a5b; --brote: #b9e77a;
        --papel: #f2f7ec; --tinta: #10261a; --gris: #5c7063;
        position: relative;
        display: inline-flex;
        flex: 0 0 auto;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--tinta);
    }
    .idioma *, .idioma *::before, .idioma *::after { box-sizing: border-box; }

    /* Botón del header: mismo alto y esquinas que "Iniciar sesión", pero más discreto */
    .idioma-boton {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        height: 2.7rem;
        padding: 0 .8rem 0 .6rem;
        border: 1px solid rgba(185, 231, 122, .35);
        border-radius: .9rem;
        background: rgba(242, 247, 236, .06);
        color: var(--papel);
        font-family: inherit;
        font-size: .88rem;
        font-weight: 700;
        letter-spacing: .08em;
        cursor: pointer;
        transition: background-color .25s ease, border-color .25s ease, box-shadow .25s ease;
    }
    .idioma-boton:focus-visible { outline: 2px solid var(--brote); outline-offset: 3px; }
    .idioma-boton:hover { background: rgba(185, 231, 122, .14); border-color: rgba(185, 231, 122, .6); }
    .idioma.abierto .idioma-boton { background: rgba(185, 231, 122, .18); border-color: rgba(185, 231, 122, .7); box-shadow: 0 0 0 4px rgba(185, 231, 122, .12); }
    .idioma.cambiando .idioma-boton { opacity: .7; pointer-events: none; }
    .idioma-codigo { line-height: 1; }
    .idioma-flecha { width: 16px; height: 16px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transition: transform .3s ease; }
    .idioma.abierto .idioma-flecha { transform: rotate(180deg); }

    /* Banderas */
    .idioma-bandera { display: block; flex: 0 0 28px; width: 28px; height: 19px; overflow: hidden; border-radius: 4px; box-shadow: 0 0 0 1px rgba(255, 255, 255, .22), 0 4px 10px -4px rgba(0, 0, 0, .6); }
    .idioma-bandera svg { display: block; width: 100%; height: 100%; }

    /* Menú que baja desde el botón */
    .idioma-fondo { position: fixed; inset: 0; z-index: 0; }
    .idioma-panel {
        position: absolute;
        top: calc(100% + 12px);
        right: 0;
        z-index: 2;
        width: 220px;
        padding: 8px;
        background: #fff;
        border: 1px solid rgba(23, 96, 58, .1);
        border-radius: 18px;
        box-shadow: 0 26px 50px -18px rgba(5, 31, 16, .6);
        transform-origin: top right;
        animation: idioma-abrir .28s cubic-bezier(.2, .7, .2, 1) both;
    }
    .idioma-cab { margin: 6px 10px 8px; font-size: .68rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--gris); }
    .idioma-opcion {
        width: 100%;
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0 0 4px;
        padding: 9px 10px;
        border: 1.5px solid transparent;
        border-radius: 12px;
        background: #fff;
        color: var(--tinta);
        font-family: inherit;
        font-size: .92rem;
        font-weight: 600;
        text-align: left;
        cursor: pointer;
        transition: background-color .2s ease, border-color .2s ease;
    }
    .idioma-opcion:last-child { margin-bottom: 0; }
    .idioma-opcion:focus-visible { outline: 2px solid var(--hoja); outline-offset: 2px; }
    .idioma-opcion:hover { background: #f2f7ec; }
    .idioma-opcion.activo { background: #e6f2dc; border-color: rgba(46, 154, 91, .35); }
    .idioma-opcion .idioma-bandera { flex-basis: 30px; width: 30px; height: 20px; }
    .idioma-nombre { flex: 1; min-width: 0; }
    .idioma-check { width: 18px; height: 18px; flex-shrink: 0; fill: none; stroke: var(--pino); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; opacity: 0; }
    .idioma-opcion.activo .idioma-check { opacity: 1; }

    @@keyframes idioma-abrir { from { opacity: 0; transform: translate3d(0, -8px, 0) scale(.96); } to { opacity: 1; transform: none; } }

    @@media (max-width: 575.98px) {
        .idioma-codigo { display: none; }
        .idioma-boton { padding: 0 .6rem; gap: .4rem; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .idioma *, .idioma *::before, .idioma *::after { animation: none !important; transition: none !important; }
    }

    /* Lo que agrega Google Translate: se oculta para que no empuje la página */
    .goog-te-banner-frame, .skiptranslate iframe, .goog-te-balloon-frame, #goog-gt-tt { display: none !important; }
    body { top: 0 !important; }
    .goog-text-highlight { background: none !important; box-shadow: none !important; }
</style>

@code {
    private IJSObjectReference? _modulo;
    private bool EsIngles;
    private bool abierto;
    private bool cambiando;

    protected override async Task OnAfterRenderAsync(bool primerRender)
    {
        if (!primerRender) return;
        try
        {
            _modulo = await JS.InvokeAsync<IJSObjectReference>("import", "/js/idioma.js");
            var idioma = await _modulo.InvokeAsync<string>("obtenerIdioma");
            EsIngles = idioma == "en";
            await _modulo.InvokeVoidAsync("iniciar");
            StateHasChanged();
        }
        catch (JSException)
        {
            // Si el archivo no carga, el selector se ve pero no traduce.
        }
    }

    private void Alternar()
    {
        if (!cambiando) abierto = !abierto;
    }

    private void Cerrar() => abierto = false;

    private void TeclaEnIdioma(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") abierto = false;
    }

    private async Task CambiarAsync(string idioma)
    {
        var quiereIngles = idioma == "en";
        abierto = false;

        if (_modulo is null || cambiando || quiereIngles == EsIngles) return;

        cambiando = true;
        EsIngles = quiereIngles;
        try
        {
            await _modulo.InvokeVoidAsync("cambiar", idioma);
        }
        catch (JSDisconnectedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        if (_modulo is null) return;
        try { await _modulo.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}