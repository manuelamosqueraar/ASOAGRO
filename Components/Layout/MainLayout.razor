@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Asoagro.Components.Pages
@using Asoagro.Models
@using Asoagro.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject NotificacionService Notificaciones
@implements IDisposable

<style>
    /* Avisos en tiempo real: campana, panel y aviso emergente */
    .ag-nv-punto { flex: 0 0 8px; width: 8px; height: 8px; align-self: center; border-radius: 50%; background: #2e9a5b; box-shadow: 0 0 0 3px rgba(46, 154, 91, .18); }
    .ag-notif.ag-nv-leida { opacity: .6; }
    .ag-notif:not([href]) { cursor: default; }
    .ag-nv-pie { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
    .ag-nv-marcar { padding: 0; border: 0; background: transparent; color: #17603a; font-family: 'Inter', system-ui, sans-serif; font-size: .84rem; font-weight: 600; cursor: pointer; }
    .ag-nv-marcar:hover:not(:disabled) { text-decoration: underline; text-underline-offset: 3px; }
    .ag-nv-marcar:disabled { color: #9aaa9f; cursor: default; }
    .ag-nv-aviso { position: fixed; top: calc(var(--ag-h, 4.25rem) + 12px); right: 16px; z-index: 1400; display: flex; align-items: flex-start; gap: 12px; width: min(360px, calc(100vw - 32px)); padding: 14px; background: #fff; border: 1px solid rgba(23, 96, 58, .12); border-radius: 16px; box-shadow: 0 22px 44px -22px rgba(11, 46, 28, .6); color: #10261a; animation: ag-nv-entra .35s cubic-bezier(.2, .7, .2, 1) both; }
    .ag-nv-icono { flex: 0 0 40px; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 12px; background: #e6f2dc; color: #17603a; }
    .ag-nv-icono.urgente { background: #fbeeee; color: #b42318; }
    .ag-nv-icono.advertencia { background: #f8efd2; color: #8a6412; }
    .ag-nv-icono svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .ag-nv-texto { flex: 1; min-width: 0; display: grid; gap: 3px; }
    .ag-nv-texto small { font-family: 'Inter', system-ui, sans-serif; font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #5c7063; }
    .ag-nv-texto strong { font-family: 'Maname', Georgia, serif; font-size: 1.02rem; font-weight: 700; line-height: 1.2; color: #0b2e1c; }
    .ag-nv-texto em { font-family: 'Asap Sharp', system-ui, sans-serif; font-style: normal; font-size: .9rem; line-height: 1.45; color: #2e3d31; }
    .ag-nv-ver { justify-self: start; margin-top: 4px; font-family: 'Inter', system-ui, sans-serif; font-size: .84rem; font-weight: 600; color: #17603a; text-decoration: none; }
    .ag-nv-ver:hover { text-decoration: underline; text-underline-offset: 3px; }
    .ag-nv-cerrar { flex: 0 0 28px; width: 28px; height: 28px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: transparent; color: #5c7063; font-size: 1.25rem; line-height: 1; cursor: pointer; }
    .ag-nv-cerrar:hover { background: #f2f7ec; }
    @@keyframes ag-nv-entra { from { opacity: 0; transform: translate3d(0, -10px, 0); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) { .ag-nv-aviso { animation: none; } }
</style>

<svg class="ag-sprite" aria-hidden="true" focusable="false">
    <defs>
        <symbol id="ico-brote" viewBox="0 0 24 24"><path d="M12 22v-9" /><path d="M12 13C12 7.5 7.5 4 2 4c0 5.5 3.5 10 10 10z" /><path d="M12 13c0-5.5 4.5-9 10-9 0 5.5-3.5 10-10 10z" /></symbol>
        <symbol id="ico-usuario" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></symbol>
        <symbol id="ico-usuario-mas" viewBox="0 0 24 24"><circle cx="9" cy="8" r="4" /><path d="M2 21c0-4 3.1-7 7-7s7 3 7 7M19 8v6M22 11h-6" /></symbol>
        <symbol id="ico-lista" viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" /></symbol>
        <symbol id="ico-alerta" viewBox="0 0 24 24"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01" /></symbol>
        <symbol id="ico-escudo" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6zM9 12l2 2 4-4" /></symbol>
        <symbol id="ico-mapa" viewBox="0 0 24 24"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14" /></symbol>
        <symbol id="ico-red" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="18" r="2.5" /><circle cx="19" cy="18" r="2.5" /><path d="M12 7.5v4M12 11.5l-5 4M12 11.5l5 4" /></symbol>
        <symbol id="ico-doc" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5" /></symbol>
        <symbol id="ico-check" viewBox="0 0 24 24"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1M22 4L12 14l-3-3" /></symbol>
        <symbol id="ico-sobre" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 6l-10 7L2 6" /></symbol>
        <symbol id="ico-entrar" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" /></symbol>
        <symbol id="ico-salir" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></symbol>
        <symbol id="ico-ajustes" viewBox="0 0 24 24"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" /></symbol>
        <symbol id="ico-campana" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" /></symbol>
        <symbol id="ico-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" /></symbol>
        <symbol id="ico-flecha" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></symbol>
    </defs>
</svg>

<div class="page @(EsInicio ? "ag-pagina-inicio" : "ag-pagina-admin")">

    @if (!EsInicio)
    {
        <div class="sidebar @(collapseNavMenu ? "sidebar-collapsed" : "") @(menuMovilAbierto ? "sidebar-open" : "")" @onclick="CerrarMenuMovil">
            <NavMenu />
        </div>
        <div class="ag-velo-menu @(menuMovilAbierto ? "visible" : "")" @onclick="CerrarMenuMovil"></div>
    }

    <header class="ag-header">
        <div class="ag-header-izq">
            @if (!EsInicio)
            {
                <button class="ag-icono-btn" @onclick="ToggleNavMenu" title="Mostrar u ocultar menú" aria-label="Mostrar u ocultar menú">
                    <svg class="ag-ico"><use href="#ico-menu" /></svg>
                </button>
            }

            <a href="/" class="ag-marca" aria-label="Ir al inicio de ASOAGRO">
                <span class="ag-marca-icono"><svg class="ag-ico"><use href="#ico-brote" /></svg></span>
                <span class="ag-marca-texto">
                    <strong>ASOAGRO</strong>
                </span>
            </a>

            @if (!EsInicio)
            {
                <div class="ag-titulo-pagina">
                    <small>Panel de gestión</small>
                    <strong>@TituloSeccion()</strong>
                </div>
            }
        </div>

        @if (EsInicio)
        {
            <nav class="ag-nav" aria-label="Navegación principal">
                @foreach (var grupo in menu)
                {
                    <div class="ag-nav-item @(grupoAbierto == grupo.Titulo ? "abierto" : "")">
                        <button class="ag-nav-btn" @onclick="() => AlternarGrupo(grupo.Titulo)" aria-expanded="@(grupoAbierto == grupo.Titulo ? "true" : "false")">
                            @grupo.Titulo
                            <svg class="ag-ico"><use href="#ico-flecha" /></svg>
                        </button>
                        <div class="ag-dd">
                            <div class="ag-dd-grid">
                                @foreach (var item in grupo.Items)
                                {
                                    <a href="@item.Ruta" class="ag-dd-link @(EsRutaActiva(item.Ruta) ? "activo" : "")" @onclick="CerrarTodo">
                                        <span class="ag-dd-ico"><svg class="ag-ico"><use href="#ico-@item.Icono" /></svg></span>
                                        <span>
                                            <strong>@item.Texto</strong>
                                            <small>@item.Descripcion</small>
                                        </span>
                                    </a>
                                }
                            </div>
                            @if (grupo.Titulo == "Plataforma")
                            {
                                <div class="ag-dd-pie">
                                    <span>¿Tu asociación está lista para las convocatorias?</span>
                                    <a href="/consultar-asociados" @onclick="CerrarTodo">Revisar elegibilidad</a>
                                </div>
                            }
                        </div>
                    </div>
                }
            </nav>
        }

        <div class="ag-header-der">
            @if (EsInicio)
            {
                <button class="ag-icono-btn ag-solo-movil" @onclick="ToggleMenuNavMovil" aria-label="Abrir menú">
                    <svg class="ag-ico"><use href="#ico-menu" /></svg>
                </button>
            }

            <IdiomaSelector />

            @if (!EsInicio && autenticado)
            {
                <div class="ag-desplegable">
                    <button type="button" class="ag-icono-btn" @onclick="ToggleNotificaciones" title="Centro de alertas" aria-label="Centro de alertas">
                        <svg class="ag-ico"><use href="#ico-campana" /></svg>
                        @if (NoLeidas > 0)
                        {
                            <span class="ag-contador">@NoLeidas</span>
                        }
                    </button>

                    @if (mostrarNotificaciones)
                    {
                        var lista = NotificacionesVisibles;

                        <div class="ag-panel">
                            <div class="ag-panel-cab">
                                <div>
                                    <strong>Alertas del sistema</strong>
                                    <small>Registros, cambios y vencimientos</small>
                                </div>
                                <span class="ag-pildora">@NoLeidas sin leer</span>
                            </div>

                            <div class="ag-filtros">
                                @foreach (var f in Filtros)
                                {
                                    <button type="button" class="ag-chip @(filtroActivo == f ? "activo" : "")" @onclick="() => FiltrarNotificaciones(f)">@f</button>
                                }
                            </div>

                            <div class="ag-lista-notif">
                                @if (lista.Count == 0)
                                {
                                    <p class="ag-vacio">No hay alertas en esta categoría.</p>
                                }
                                else
                                {
                                    @foreach (var n in lista)
                                    {
                                        var leida = EstaLeida(n);

                                        <a href="@(PuedeAbrir(n) ? n.Enlace : null)" class="ag-notif @(leida ? "ag-nv-leida" : "")" @onclick="() => AbrirNotificacion(n)">
                                            <span class="ag-notif-ico @ObtenerTono(n)"><svg class="ag-ico"><use href="#ico-@n.Icono" /></svg></span>
                                            <span>
                                                <span class="ag-notif-meta"><small>@n.Etiqueta</small><small>@TiempoTranscurrido(n.FechaCreacion)</small></span>
                                                <strong>@n.Titulo</strong>
                                                <em>@n.Descripcion</em>
                                            </span>
                                            @if (!leida)
                                            {
                                                <span class="ag-nv-punto" title="Sin leer"></span>
                                            }
                                        </a>
                                    }
                                }
                            </div>

                            <div class="ag-panel-pie ag-nv-pie">
                                <button type="button" class="ag-nv-marcar" @onclick="MarcarTodasComoLeidas" disabled="@(NoLeidas == 0)">Marcar todas como leídas</button>
                                <a href="/alertas-documentos" @onclick="CerrarTodo">Ver panel completo</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (EsInicio || !autenticado)
            {
                <a href="/login" class="ag-entrar">
                    <svg class="ag-ico"><use href="#ico-entrar" /></svg>
                    <span class="ag-texto-entrar">Iniciar sesión</span>
                </a>
            }
        </div>
    </header>

    @if (HayDesplegableAbierto)
    {
        <div class="ag-capa-cerrar" @onclick="CerrarTodo"></div>
    }

    @if (EsInicio)
    {
        <div class="ag-menu-movil @(menuNavMovilAbierto ? "abierto" : "")">
            @foreach (var grupo in menu)
            {
                <p class="ag-menu-grupo">@grupo.Titulo</p>
                @foreach (var item in grupo.Items)
                {
                    <a href="@item.Ruta" class="ag-menu-link" @onclick="CerrarTodo">
                        <svg class="ag-ico"><use href="#ico-@item.Icono" /></svg>
                        @item.Texto
                    </a>
                }
            }

            @if (!autenticado)
            {
                <a href="/login" class="ag-entrar ag-entrar-bloque" @onclick="CerrarTodo">Iniciar sesión</a>
            }
        </div>
    }

    <main class="ag-main">
        <article class="@(EsInicio ? "ag-contenido-inicio" : "ag-contenido-admin")" @onclick="CerrarTodo">
            @Body
        </article>

        @if (!EsInicio)
        {
            <footer class="ag-pie">
                <div class="ag-pie-cont">
                    <span>&copy; 2026 ASOAGRO. Federación de Asociaciones Agropecuarias (FAAUA)</span>
                    <nav class="ag-pie-links">
                        <a href="/alertas-documentos">Alertas</a>
                        <a href="/historia/origenes">Acerca de</a>
                        <a href="#">Ayuda</a>
                    </nav>
                </div>
            </footer>
        }
    </main>
</div>

@if (EsInicio)
{
    <ChatAsistente />
}

@if (avisoEmergente is not null)
{
    var aviso = avisoEmergente;

    <div class="ag-nv-aviso" role="status" aria-live="polite">
        <span class="ag-nv-icono @ObtenerClaseNivel(aviso)"><svg class="ag-ico"><use href="#ico-@aviso.Icono" /></svg></span>
        <div class="ag-nv-texto">
            <small>@aviso.Etiqueta · @TiempoTranscurrido(aviso.FechaCreacion)</small>
            <strong>@aviso.Titulo</strong>
            <em>@aviso.Descripcion</em>
            @if (PuedeAbrir(aviso))
            {
                <a href="@aviso.Enlace" class="ag-nv-ver" @onclick="CerrarAviso">Ver detalle</a>
            }
        </div>
        <button type="button" class="ag-nv-cerrar" @onclick="CerrarAviso" aria-label="Cerrar aviso">&times;</button>
    </div>
}

@code {
    private record ItemMenu(string Texto, string Descripcion, string Icono, string Ruta);
    private record GrupoMenu(string Titulo, List<ItemMenu> Items);

    private static readonly string[] Filtros = { "Todas", "Documentos", "Productores" };

    // Enlaces con "#" son de ejemplo: cámbialos por tus rutas reales.
    private readonly List<GrupoMenu> menu = new()
    {
        new("Plataforma", new()
        {
            new("Registrar asociado", "Alta de productores y fincas en la red.", "usuario-mas", "/registrar-asociado"),
            new("Consultar registros", "Busca y revisa asociados, predios y juntas.", "lista", "/consultar-asociados"),
            new("Alertas y documentos", "Vencimientos de estatutos y certificados.", "alerta", "/alertas-documentos"),
            new("Cumplimiento", "Obligaciones tributarias y asambleas al día.", "escudo", "#"),
        }),
        new("Nosotros", new()
        {
            new("Orígenes y misión", "Historia y propósito de la federación.", "brote", "/historia/origenes"),
            new("Impacto y trazabilidad", "Cadenas productivas e inocuidad alimentaria.", "mapa", "/historia/impacto"),
            new("Red de asociaciones", "Las asociaciones de base del Urabá.", "red", "#"),
        }),
        new("Recursos", new()
        {
            new("Preguntas frecuentes", "Respuestas rápidas sobre la plataforma.", "doc", "#"),
            new("Guía de elegibilidad", "Requisitos para convocatorias de financiación.", "check", "/consultar-asociados"),
            new("Contacto", "Escríbenos o llámanos a la federación.", "sobre", "#"),
        }),
    };

    // Páginas con encabezado público y sin barra lateral. Para sumar otra, agrégala a esta lista.
    private static readonly string[] RutasPublicas = { "home", "historia/origenes", "historia/impacto" };

    private bool collapseNavMenu;
    private bool menuMovilAbierto;
    private bool menuNavMovilAbierto;
    private bool mostrarNotificaciones;
    private string? grupoAbierto;
    private string filtroActivo = "Todas";

    // Usuario que inició sesión. Su correo identifica sus avisos leídos y sus roles filtran lo que ve.
    private bool autenticado;
    private string claveUsuario = string.Empty;
    private List<string> roles = new();

    // Aviso emergente que aparece cuando llega una notificación nueva
    private Notificacion? avisoEmergente;
    private bool _disposed;

    private bool EsInicio => IsHomePage();
    private bool HayDesplegableAbierto => mostrarNotificaciones || grupoAbierto is not null || menuNavMovilAbierto;
    private string RutaActual => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();

    // Se calculan en cada render, así siempre reflejan el estado actual del servicio
    private int NoLeidas => autenticado ? Notificaciones.ContarNoLeidas(claveUsuario, roles) : 0;

    private IReadOnlyList<Notificacion> NotificacionesVisibles => autenticado
        ? Notificaciones.ObtenerVisiblesPara(roles).Where(CoincideFiltro).Take(30).ToList()
        : new List<Notificacion>();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += EnCambioDeRuta;
        Notificaciones.NotificacionPublicada += EnNuevaNotificacion;
        await CargarUsuarioAsync();
    }

    private async Task CargarUsuarioAsync()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        var usuario = estado.User;

        autenticado = usuario.Identity?.IsAuthenticated == true;
        if (!autenticado)
        {
            claveUsuario = string.Empty;
            roles = new List<string>();
            return;
        }

        // El correo identifica al usuario en los avisos leídos. El nombre es solo para mostrar.
        claveUsuario = usuario.FindFirst(ClaimTypes.Email)?.Value
            ?? usuario.Identity?.Name
            ?? "usuario";

        roles = usuario.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
    }

    // Llega cuando cualquier pantalla publica un aviso, incluida la de otro navegador.
    // Se pasa a la conexión de esta pantalla para poder actualizar la interfaz.
    private void EnNuevaNotificacion(Notificacion notificacion)
    {
        if (_disposed) return;

        try
        {
            _ = InvokeAsync(() => MostrarAvisoAsync(notificacion));
        }
        catch (Exception)
        {
            // Si esta pantalla ya no está activa, no debe afectar a quien guardó el registro.
        }
    }

    private async Task MostrarAvisoAsync(Notificacion notificacion)
    {
        if (_disposed || !autenticado) return;
        if (!NotificacionService.EsVisible(notificacion, roles)) return;

        avisoEmergente = notificacion;
        StateHasChanged();

        await Task.Delay(TimeSpan.FromSeconds(8));

        if (!_disposed && avisoEmergente?.Id == notificacion.Id)
        {
            avisoEmergente = null;
            StateHasChanged();
        }
    }

    private void CerrarAviso() => avisoEmergente = null;

    private void EnCambioDeRuta(object? sender, LocationChangedEventArgs e)
    {
        CerrarTodo();
        menuMovilAbierto = false;
        InvokeAsync(StateHasChanged);
    }

    private bool IsHomePage()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
        return string.IsNullOrEmpty(ruta) || RutasPublicas.Contains(ruta);
    }

    private bool EsRutaActiva(string ruta) => ruta != "#" && RutaActual == ruta.Trim('/').ToLowerInvariant();

    private string TituloSeccion() => RutaActual switch
    {
        "registrar-asociado" => "Registrar asociado",
        "consultar-asociados" => "Consultar registros",
        "alertas-documentos" => "Alertas y documentos",
        "historia/origenes" => "Orígenes y misión",
        "historia/impacto" => "Impacto y trazabilidad",
        _ => "Inicio del panel"
    };

    // Escritorio: oculta o muestra la barra lateral. Móvil: abre o cierra el cajón.
    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
        menuMovilAbierto = !menuMovilAbierto;
    }

    private void CerrarMenuMovil() => menuMovilAbierto = false;

    private void ToggleMenuNavMovil()
    {
        var abrir = !menuNavMovilAbierto;
        CerrarTodo();
        menuNavMovilAbierto = abrir;
    }

    private void AlternarGrupo(string titulo)
    {
        var abrir = grupoAbierto != titulo;
        CerrarTodo();
        if (abrir) grupoAbierto = titulo;
    }

    private void ToggleNotificaciones()
    {
        var abrir = !mostrarNotificaciones;
        CerrarTodo();
        mostrarNotificaciones = abrir;
    }

    private void CerrarTodo()
    {
        mostrarNotificaciones = false;
        grupoAbierto = null;
        menuNavMovilAbierto = false;
    }

    private void FiltrarNotificaciones(string filtro) => filtroActivo = filtro;

    private bool CoincideFiltro(Notificacion notificacion) => filtroActivo switch
    {
        "Documentos" => notificacion.Categoria == CategoriaNotificacion.Documentos,
        "Productores" => notificacion.Categoria == CategoriaNotificacion.Productores,
        _ => true
    };

    private bool EstaLeida(Notificacion notificacion) =>
        autenticado && Notificaciones.EsLeida(claveUsuario, notificacion.Id);

    // El aviso siempre se ve; el enlace solo aparece si este usuario puede abrir la página
    private bool PuedeAbrir(Notificacion notificacion) =>
        autenticado && NotificacionService.PuedeAbrirEnlace(notificacion, roles);

    private void AbrirNotificacion(Notificacion notificacion)
    {
        if (autenticado) Notificaciones.MarcarComoLeida(claveUsuario, notificacion.Id);
        CerrarTodo();
    }

    private void MarcarTodasComoLeidas()
    {
        if (autenticado) Notificaciones.MarcarTodasComoLeidas(claveUsuario, roles);
    }

    private static string ObtenerTono(Notificacion notificacion) => notificacion.Nivel switch
    {
        NivelNotificacion.Urgente => "ag-tono-urgente",
        NivelNotificacion.Advertencia => "ag-tono-trazabilidad",
        _ => "ag-tono-registro"
    };

    private static string ObtenerClaseNivel(Notificacion notificacion) => notificacion.Nivel switch
    {
        NivelNotificacion.Urgente => "urgente",
        NivelNotificacion.Advertencia => "advertencia",
        _ => string.Empty
    };

    private static string TiempoTranscurrido(DateTime fecha)
    {
        var transcurrido = DateTime.Now - fecha;
        if (transcurrido.TotalMinutes < 1) return "Ahora";
        if (transcurrido.TotalMinutes < 60) return $"Hace {(int)transcurrido.TotalMinutes} min";
        if (transcurrido.TotalHours < 24) return $"Hace {(int)transcurrido.TotalHours} h";
        return fecha.ToString("dd/MM/yyyy");
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= EnCambioDeRuta;
        Notificaciones.NotificacionPublicada -= EnNuevaNotificacion;
    }
}