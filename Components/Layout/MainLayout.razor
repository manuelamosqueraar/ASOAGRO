@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Asoagro.Components.Pages
@using Asoagro.Models
@using Asoagro.Services
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider
@inject NotificacionService Notificaciones
@implements IDisposable

<style>
    /* Avisos en tiempo real: campana, panel y aviso emergente */
    .ag-nv-punto { flex: 0 0 8px !important; width: 8px !important; height: 8px !important; min-width: 8px !important; max-width: 8px !important; align-self: center; border-radius: 50%; background: #2e9a5b; box-shadow: 0 0 0 3px rgba(46, 154, 91, .18); }
    .ag-notif > span:nth-child(2) { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .ag-notif.ag-nv-leida { opacity: .6; }
    .ag-notif:not([href]) { cursor: default; }
    .ag-nv-pie { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; }
    .ag-nv-marcar { padding: 0; border: 0; background: transparent; color: #17603a; font-family: 'Inter', system-ui, sans-serif; font-size: .84rem; font-weight: 600; cursor: pointer; }
    .ag-nv-marcar:hover:not(:disabled) { text-decoration: underline; text-underline-offset: 3px; }
    .ag-nv-marcar:disabled { color: #9aaa9f; cursor: default; }
    .ag-nv-aviso { position: fixed; top: calc(var(--ag-h, 4.25rem) + 12px); right: 16px; z-index: 1400; display: flex; align-items: flex-start; gap: 12px; width: min(360px, calc(100vw - 32px)); padding: 14px; background: #fff; border: 1px solid rgba(23, 96, 58, .12); border-radius: 16px; box-shadow: 0 22px 44px -22px rgba(11, 46, 28, .6); color: #10261a; animation: ag-nv-entra .35s cubic-bezier(.2, .7, .2, 1) both; }
    .ag-nv-icono { flex: 0 0 40px; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 12px; background: #e6f2dc; color: #17603a; }
    .ag-nv-icono.urgente { background: #fbeeee; color: #b42318; }
    .ag-nv-icono.advertencia { background: #f8efd2; color: #8a6412; }
    .ag-nv-icono svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .ag-nv-texto { flex: 1; min-width: 0; display: grid; gap: 3px; }
    .ag-nv-texto small { font-family: 'Inter', system-ui, sans-serif; font-size: .7rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: #5c7063; }
    .ag-nv-texto strong { font-family: 'Maname', Georgia, serif; font-size: 1.02rem; font-weight: 700; line-height: 1.2; color: #0b2e1c; }
    .ag-nv-texto em { font-family: 'Asap Sharp', system-ui, sans-serif; font-style: normal; font-size: .9rem; line-height: 1.45; color: #2e3d31; }
    .ag-nv-ver { justify-self: start; margin-top: 4px; font-family: 'Inter', system-ui, sans-serif; font-size: .84rem; font-weight: 600; color: #17603a; text-decoration: none; }
    .ag-nv-ver:hover { text-decoration: underline; text-underline-offset: 3px; }
    .ag-nv-cerrar { flex: 0 0 28px; width: 28px; height: 28px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: transparent; color: #5c7063; font-size: 1.25rem; line-height: 1; cursor: pointer; }
    .ag-nv-cerrar:hover { background: #f2f7ec; }
    @@keyframes ag-nv-entra { from { opacity: 0; transform: translate3d(0, -10px, 0); } to { opacity: 1; transform: none; } }
    @@media (prefers-reduced-motion: reduce) { .ag-nv-aviso { animation: none; } }
</style>

<svg class="ag-sprite" aria-hidden="true" focusable="false">
    <defs>
        <symbol id="ico-brote" viewBox="0 0 24 24"><path d="M12 22v-9" /><path d="M12 13C12 7.5 7.5 4 2 4c0 5.5 3.5 10 10 10z" /><path d="M12 13c0-5.5 4.5-9 10-9 0 5.5-3.5 10-10 10z" /></symbol>
        <symbol id="ico-usuario" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></symbol>
        <symbol id="ico-usuario-mas" viewBox="0 0 24 24"><circle cx="9" cy="8" r="4" /><path d="M2 21c0-4 3.1-7 7-7s7 3 7 7M19 8v6M22 11h-6" /></symbol>
        <symbol id="ico-lista" viewBox="0 0 24 24"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01" /></symbol>
        <symbol id="ico-alerta" viewBox="0 0 24 24"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01" /></symbol>
        <symbol id="ico-escudo" viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6zM9 12l2 2 4-4" /></symbol>
        <symbol id="ico-mapa" viewBox="0 0 24 24"><path d="M3 6l6-2 6 2 6-2v14l-6 2-6-2-6 2zM9 4v14M15 6v14" /></symbol>
        <symbol id="ico-red" viewBox="0 0 24 24"><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="18" r="2.5" /><circle cx="19" cy="18" r="2.5" /><path d="M12 7.5v4M12 11.5l-5 4M12 11.5l5 4" /></symbol>
        <symbol id="ico-doc" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9zM14 3v6h6M8 13h8M8 17h5" /></symbol>
        <symbol id="ico-check" viewBox="0 0 24 24"><path d="M22 11.1V12a10 10 0 1 1-5.9-9.1M22 4L12 14l-3-3" /></symbol>
        <symbol id="ico-sobre" viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 6l-10 7L2 6" /></symbol>
        <symbol id="ico-entrar" viewBox="0 0 24 24"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3" /></symbol>
        <symbol id="ico-salir" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></symbol>
        <symbol id="ico-ajustes" viewBox="0 0 24 24"><path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6" /></symbol>
        <symbol id="ico-campana" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.7 21a2 2 0 0 1-3.4 0" /></symbol>
        <symbol id="ico-menu" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" /></symbol>
        <symbol id="ico-flecha" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6" /></symbol>
        <symbol id="ico-flecha-der" viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></symbol>
    </defs>
</svg>

@if (!EsInicio)
{
    <!-- ======================================================== -->
    <!--     LAYOUT UNIFICADO HARVEST (ADMINISTRADOR / EQUIPO)      -->
    <!-- ======================================================== -->
    <div class="hv-app @TemaModuloActual @(collapseNavMenu ? "hv-sidebar-collapsed" : "")">
        <!-- Barra lateral unificada con módulos en su orden original -->
        <aside class="hv-sidebar">
            <NavMenu OnToggleCollapse="ToggleNavMenu" />
        </aside>

        <!-- Columna principal con atmósfera dinámica por módulo -->
        <div class="hv-main-col @TemaModuloActual">
            @if (mostrarMenuUsuario || mostrarNotificaciones)
            {
                <div class="hv-backdrop-close" style="position: fixed; inset: 0; z-index: 950; background: transparent;" @onclick="CerrarTodo"></div>
            }

            <!-- Barra superior de navegación ejecutiva flotante -->
            <header class="hv-topbar" @onclick="CerrarTodo">
                <!-- Izquierda: Botón hamburguesa único + Categoría + Nombre del módulo actual -->
                <div class="hv-topbar-left" @onclick:stopPropagation="true">
                    <button type="button" class="hv-hamb-btn-top" @onclick="ToggleNavMenu" title="Colapsar o expandir menú lateral" aria-label="Menú hamburguesa">
                        <span class="hv-bar"></span>
                        <span class="hv-bar"></span>
                        <span class="hv-bar"></span>
                    </button>
                    <div class="hv-topbar-breadcrumb">
                        <div class="d-flex align-items-center gap-2">
                            <span class="hv-topbar-cat-pill">@CategoriaRutaActual</span>
                            <span class="hv-topbar-path d-none d-sm-inline">ASOAGRO · FEDERACIÓN FAAUA</span>
                        </div>
                        <h1 class="hv-topbar-title">@TituloRutaActual</h1>
                    </div>
                </div>

                <div class="hv-top-actions">
                    <div class="hv-topbar-region-chip d-none d-xl-inline-flex">
                        <span class="hv-region-dot"></span>
                        <span>Urabá Antioqueño · En línea</span>
                    </div>
                    <!-- Campana de notificaciones exactamente con las mismas funciones y panel de antes -->
                    <div class="ag-desplegable" @onclick:stopPropagation="true">
                        <button type="button" 
                                class="hv-action-circle" 
                                @onclick="ToggleNotificaciones" 
                                @onkeydown="ManejarTeclaNotificaciones"
                                title="Centro de alertas" 
                                aria-label="Centro de alertas y notificaciones" 
                                aria-haspopup="true"
                                aria-expanded="@(mostrarNotificaciones ? "true" : "false")">
                            <svg class="ag-ico"><use href="#ico-campana" /></svg>
                            @if (NoLeidas > 0)
                            {
                                <span class="hv-badge-count">@NoLeidas</span>
                            }
                        </button>

                        @if (mostrarNotificaciones)
                        {
                            var lista = NotificacionesVisibles;

                            <div class="ag-panel" style="z-index: 1300;" @onclick:stopPropagation @onkeydown="@(e => { if (e.Key == "Escape") CerrarTodo(); })">
                                <div class="ag-panel-cab">
                                    <div>
                                        <strong>Alertas del sistema</strong>
                                        <small>Registros, cambios y vencimientos</small>
                                    </div>
                                    <span class="ag-pildora">@NoLeidas sin leer</span>
                                </div>

                                <div class="ag-filtros">
                                    @foreach (var f in Filtros)
                                    {
                                        <button type="button" class="ag-chip @(filtroActivo == f ? "activo" : "")" @onclick="() => FiltrarNotificaciones(f)">@f</button>
                                    }
                                </div>

                                <div class="ag-lista-notif">
                                    @if (lista.Count == 0)
                                    {
                                        <p class="ag-vacio">No hay alertas en esta categoría.</p>
                                    }
                                    else
                                    {
                                        @foreach (var n in lista)
                                        {
                                            var leida = EstaLeida(n);
                                            var puedeIr = PuedeAbrir(n);

                                            <a href="@(puedeIr ? n.Enlace : null)"
                                               class="ag-notif @(leida ? "ag-nv-leida" : "")"
                                               @onclick="() => AbrirNotificacion(n)">
                                                <span class="ag-notif-ico @ObtenerTono(n)"><svg class="ag-ico"><use href="#ico-@n.Icono" /></svg></span>
                                                <span style="display: flex; flex-direction: column; flex: 1; min-width: 0;">
                                                    <span class="ag-notif-meta"><small>@n.Etiqueta</small><small>@TiempoTranscurrido(n.FechaCreacion)</small></span>
                                                    <strong>@n.Titulo</strong>
                                                    <em>@n.Descripcion</em>
                                                </span>
                                                @if (!leida)
                                                {
                                                    <span class="ag-nv-punto" style="flex: 0 0 8px; width: 8px; height: 8px; min-width: 8px; max-width: 8px;" title="Sin leer"></span>
                                                }
                                            </a>
                                        }
                                    }
                                </div>

                                <div class="ag-panel-pie ag-nv-pie">
                                    <button type="button" class="ag-nv-marcar" @onclick="MarcarTodasComoLeidas" disabled="@(NoLeidas == 0)">Marcar todas como leídas</button>
                                    <a href="/alertas-documentos" @onclick="IrAPanelCompleto">Ver panel completo</a>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Píldora de usuario dinámico con Menú Desplegable -->
                    <div class="hv-user-menu-wrap" @onclick:stopPropagation="true">
                        <button type="button" 
                                class="hv-user-badge" 
                                @onclick="ToggleMenuUsuario" 
                                @onkeydown="ManejarTeclaUsuario"
                                aria-label="Menú de perfil y cuenta de usuario" 
                                aria-haspopup="true"
                                aria-expanded="@(mostrarMenuUsuario ? "true" : "false")">
                            @if (!string.IsNullOrWhiteSpace(fotoUsuarioActual))
                            {
                                <span class="hv-user-avatar-circle"><img src="@fotoUsuarioActual" alt="@nombreUsuarioActual" onerror="this.style.display='none'" /></span>
                            }
                            else
                            {
                                <span class="hv-user-avatar-circle">@inicialesUsuarioActual</span>
                            }
                            <div class="hv-user-meta">
                                <span class="hv-user-name">@nombreUsuarioActual</span>
                                <span class="hv-user-loc">@rolUsuarioLegible · Urabá</span>
                            </div>
                            <span class="hv-user-chevron @(mostrarMenuUsuario ? "abierto" : "")">
                                <svg viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M7 10l5 5 5-5z" />
                                </svg>
                            </span>
                        </button>

                        @if (mostrarMenuUsuario)
                        {
                            <div class="hv-user-popover" @onclick:stopPropagation @onkeydown="@(e => { if (e.Key == "Escape") CerrarTodo(); })">
                                <div class="hv-user-pop-cab">
                                    @if (!string.IsNullOrWhiteSpace(fotoUsuarioActual))
                                    {
                                        <span class="hv-user-avatar-lg"><img src="@fotoUsuarioActual" alt="@nombreUsuarioActual" /></span>
                                    }
                                    else
                                    {
                                        <span class="hv-user-avatar-lg">@inicialesUsuarioActual</span>
                                    }
                                    <div>
                                        <strong>@nombreUsuarioActual</strong>
                                        <small>@correoUsuarioActual</small>
                                    </div>
                                </div>

                                <p class="hv-pop-section-title">Mi cuenta</p>
                                <button type="button" class="hv-pop-action-item" @onclick='() => AbrirModalUsuario("Perfil de usuario")'>
                                    <svg class="hv-pop-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4" /><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7" /></svg>
                                    <div>
                                        <strong>Perfil de usuario</strong>
                                        <small>Editar datos e información</small>
                                    </div>
                                </button>
                                <button type="button" class="hv-pop-action-item" @onclick='() => AbrirModalUsuario("Seguridad y clave")'>
                                    <svg class="hv-pop-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z" /></svg>
                                    <div>
                                        <strong>Seguridad y clave</strong>
                                        <small>Verificación de acceso</small>
                                    </div>
                                </button>

                                <div class="hv-pop-divider"></div>

                                <p class="hv-pop-section-title">Organización</p>
                                <button type="button" class="hv-pop-action-item" @onclick='() => AbrirModalUsuario("Asociación base")'>
                                    <svg class="hv-pop-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="2.5" /><circle cx="5" cy="18" r="2.5" /><circle cx="19" cy="18" r="2.5" /><path d="M12 7.5v4M12 11.5l-5 4M12 11.5l5 4" /></svg>
                                    <div>
                                        <strong>Asociación base</strong>
                                        <small>Asoagro · FAAUA</small>
                                    </div>
                                </button>
                                <button type="button" class="hv-pop-action-item" @onclick='() => AbrirModalUsuario("Soporte técnico")'>
                                    <svg class="hv-pop-action-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 6l-10 7L2 6" /></svg>
                                    <div>
                                        <strong>Soporte técnico</strong>
                                        <small>Asistencia de la plataforma</small>
                                    </div>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </header>

            <!-- Contenedor del contenido principal de cualquier módulo del admin -->
            <main class="hv-body-container" @onclick="CerrarTodo">
                @Body
            </main>
        </div>
    </div>
}
else
{
    <!-- ======================================================== -->
    <!--             LAYOUT PÚBLICO (HOME / NOSOTROS / ETC)       -->
    <!-- ======================================================== -->
    <div class="page ag-pagina-inicio">
        <header class="ag-header">
            <div class="ag-header-izq">
                <a href="/" class="ag-marca" aria-label="Ir al inicio de ASOAGRO">
                    <span class="ag-marca-icono"><svg class="ag-ico"><use href="#ico-brote" /></svg></span>
                    <span class="ag-marca-texto">
                        <strong>ASOAGRO</strong>
                    </span>
                </a>
            </div>

            <nav class="ag-nav" aria-label="Navegación principal">
                <a href="/" class="ag-nav-btn ag-nav-inicio @(string.IsNullOrEmpty(RutaActual) || RutaActual == "home" ? "activo-inicio" : "")" @onclick="CerrarTodo">
                    Inicio
                </a>
                @foreach (var grupo in menu)
                {
                    <div class="ag-nav-item @(grupoAbierto == grupo.Titulo ? "abierto" : "")">
                        <button class="ag-nav-btn" @onclick="() => AlternarGrupo(grupo.Titulo)" aria-expanded="@(grupoAbierto == grupo.Titulo ? "true" : "false")">
                            @grupo.Titulo
                            <svg class="ag-ico"><use href="#ico-flecha" /></svg>
                        </button>
                        <div class="ag-dd">
                            <div class="ag-dd-grid">
                                @foreach (var item in grupo.Items)
                                {
                                    <a href="@item.Ruta" class="ag-dd-link @(EsRutaActiva(item.Ruta) ? "activo" : "")" @onclick="CerrarTodo">
                                        <span class="ag-dd-ico"><svg class="ag-ico"><use href="#ico-@item.Icono" /></svg></span>
                                        <span>
                                            <strong>@item.Texto</strong>
                                            <small>@item.Descripcion</small>
                                        </span>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </nav>

            <div class="ag-header-der">
                <a href="tel:+573001234567" class="ag-call-btn" title="Llamar a la federación">
                    <span class="ag-call-ico">
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                    </span>
                    <span class="ag-call-txt">
                        <small>Contacto FAAUA</small>
                        <strong>+57 300 123 4567</strong>
                    </span>
                </a>

                <IdiomaSelector />

                <a href="/login" class="ag-entrar">
                    <span class="ag-texto-entrar">Iniciar sesión</span>
                    <span class="ag-entrar-circulo" aria-hidden="true">
                        <svg class="ag-ico"><use href="#ico-flecha-der" /></svg>
                    </span>
                </a>
            </div>
        </header>

        <main class="ag-main">
            <article class="ag-contenido-inicio" @onclick="CerrarTodo">
                @Body
            </article>
        </main>

        <ChatAsistente />
    </div>
}

<!-- ======================================================== -->
<!--             AVISO EMERGENTE EN TIEMPO REAL               -->
<!-- ======================================================== -->
@if (!EsInicio && avisoEmergente is not null)
{
    var aviso = avisoEmergente;

    <div class="ag-nv-aviso" role="status" aria-live="polite">
        <span class="ag-nv-icono @ObtenerClaseNivel(aviso)"><svg class="ag-ico"><use href="#ico-@aviso.Icono" /></svg></span>
        <div class="ag-nv-texto">
            <small>@aviso.Etiqueta · @TiempoTranscurrido(aviso.FechaCreacion)</small>
            <strong>@aviso.Titulo</strong>
            <em>@aviso.Descripcion</em>
            @if (PuedeAbrir(aviso))
            {
                <a href="@aviso.Enlace" class="ag-nv-ver" @onclick="() => AbrirAvisoEmergente(aviso)">Ver detalle</a>
            }
        </div>
        <button type="button" class="ag-nv-cerrar" @onclick="CerrarAviso" aria-label="Cerrar aviso">&times;</button>
    </div>
}

<!-- ======================================================== -->
<!--   MODALES DE USUARIO Y CONFIGURACIÓN (EXACTOS DE ANTES)   -->
<!-- ======================================================== -->
@if (modalUsuarioActivo != null)
{
    <div class="hv-modal-backdrop" @onclick="CerrarModalUsuario">
        <div class="hv-modal-dialog" @onclick:stopPropagation>
            <header class="hv-modal-head">
                <div>
                    <h3>@modalUsuarioActivo</h3>
                    <p>Configuración de cuenta y organización</p>
                </div>
                <button type="button" class="hv-modal-close" @onclick="CerrarModalUsuario">&times;</button>
            </header>

            <div class="hv-modal-body">
                @if (modalUsuarioActivo == "Perfil de usuario")
                {
                    <p class="hv-modal-desc">Información del usuario y credenciales institucionales de la sesión activa.</p>
                    <div class="hv-form-group">
                        <label>Nombre completo</label>
                        <input type="text" class="hv-form-input" value="@nombreUsuarioActual" readonly />
                    </div>
                    <div class="hv-form-group">
                        <label>Correo institucional</label>
                        <input type="email" class="hv-form-input" value="@correoUsuarioActual" readonly />
                    </div>
                    <div class="hv-form-group">
                        <label>Cargo o función</label>
                        <input type="text" class="hv-form-input" value="@($"{rolUsuarioLegible} · Federación FAAUA")" readonly />
                    </div>
                }
                else if (modalUsuarioActivo == "Seguridad y clave")
                {
                    <div class="hv-modal-security-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z" /></svg>
                        <span>Autenticación gestionada vía Google OAuth 2.0.</span>
                    </div>
                    <p class="hv-modal-desc">Tu acceso está vinculado de forma segura con tu cuenta institucional de Google.</p>
                }
                else if (modalUsuarioActivo == "Asociación base")
                {
                    <h4 style="margin: 0; color: #0d2c1c;">Asoagro</h4>
                    <p class="hv-modal-desc">Asociación de base agropecuaria adscrita a la Federación de Asociaciones Agropecuarias del Urabá Antioqueño (FAAUA).</p>
                    <p style="font-size: 0.82rem; color: #4a6152;">Jurisdicción: Subregión de Urabá (Apartadó, Turbo, Carepa, Chigorodó, Necoclí).</p>
                }
                else if (modalUsuarioActivo == "Soporte técnico")
                {
                    <p class="hv-modal-desc">¿Presentas inconvenientes técnicos con la plataforma?</p>
                    <div class="hv-modal-security-box">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="M22 6l-10 7L2 6" /></svg>
                        <strong>soporte@faaua.org</strong>
                    </div>
                }
            </div>

            <footer class="hv-modal-foot">
                <button type="button" class="hv-btn-outline" @onclick="CerrarModalUsuario">Cerrar</button>
                <button type="button" class="hv-btn-primary" @onclick="CerrarModalUsuario">Aceptar</button>
            </footer>
        </div>
    </div>
}

@code {
    private record ItemMenu(string Texto, string Descripcion, string Icono, string Ruta);
    private record GrupoMenu(string Titulo, List<ItemMenu> Items);

    private static readonly string[] Filtros = { "Todas", "Documentos", "Productores", "Seguimiento" };
    private static readonly string[] RutasPublicas = { "home", "historia/origenes", "historia/impacto", "financiacion" };

    private readonly List<GrupoMenu> menu = new()
