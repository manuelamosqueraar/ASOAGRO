@inherits LayoutComponentBase
@inject NavigationManager Navigation
@implements IDisposable

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 mb-3 d-flex justify-content-between align-items-center">
            <span class="fw-bold fs-5">Asoagro - Gestión de Productores</span>
            <span class="top-pill">@ObtenerRolSegunRuta()</span>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        // Se suscribe a los cambios de ruta/navegación para refrescar el encabezado
        Navigation.LocationChanged += EnCambioDeRuta;
    }

    private void EnCambioDeRuta(object? sender, LocationChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    private string ObtenerRolSegunRuta()
    {
        var rutaActual = Navigation.ToBaseRelativePath(Navigation.Uri).ToLower();

        // Rol Director: Control y administración de asociados (Registrar, Consultar, Editar)
        if (rutaActual.Contains("registrar-asociado") || 
            rutaActual.Contains("consultar-asociados") || 
            rutaActual.Contains("editar-asociado"))
        {
            return "Dirección Ejecutiva / Asociados";
        }
        
        // Rol Tesorería: Registro, seguimiento de estados y alertas de vencimiento de documentos
        if (rutaActual.Contains("registrar-documentos") || 
            rutaActual.Contains("consultar-estado-documentos") || 
            rutaActual.Contains("alertas-documentos") ||
            rutaActual.Contains("alertas-vencimiento"))
        {
            return "Tesorería / Gestión Documental";
        }

        // Rol Presidente: Custodia de actas e histórico documental
        if (rutaActual.Contains("subir-actas-estatutos") || 
            rutaActual.Contains("actas"))
        {
            return "Presidencia / Actas e Histórico";
        }

        // Vista por defecto (Inicio o dashboard principal)
        return "Dirección Ejecutiva / General";
    }

    public void Dispose()
    {
        // Desuscripción para evitar fugas de memoria
        Navigation.LocationChanged -= EnCambioDeRuta;
    }
}