            new("Preguntas frecuentes", "Respuestas rápidas sobre la plataforma.", "doc", "#"),
            new("Guía de financiación", "Prepárate para oportunidades y convocatorias.", "check", "/financiacion"),
            new("Contacto", "Escríbenos o llámanos a la federación.", "sobre", "#"),
        }),
    };

    private bool collapseNavMenu;
    private bool mostrarNotificaciones;
    private bool mostrarMenuUsuario;
    private string? modalUsuarioActivo;
    private string? grupoAbierto;
    private string filtroActivo = "Todas";
    private string busquedaGlobal = string.Empty;

    // Usuario que inició sesión. Su correo identifica sus avisos leídos y sus roles filtran lo que ve.
    private bool autenticado;
    private string claveUsuario = string.Empty;
    private List<string> roles = new();
    private string nombreUsuarioActual = "Manuela Andrea Mosquera";
    private string correoUsuarioActual = "admin@asoagro-faaua.org";
    private string fotoUsuarioActual = "";
    private string rolUsuarioActual = "Administrador";
    private string inicialesUsuarioActual = "MM";

    private string rolUsuarioLegible => rolUsuarioActual switch
    {
        "Administrador" or "Admin" => "Administrador de la Plataforma",
        "Presidenta" or "Presidente" => "Presidente FAAUA",
        "Secretaria" or "Secretaría" => "Secretaría FAAUA",
        "Tesorero" or "Tesorera" => "Tesorería FAAUA",
        "AdministradorPdv" or "PuntoVenta" or "Vendedor" => "Administrador Punto de Venta",
        _ => !string.IsNullOrWhiteSpace(rolUsuarioActual) ? rolUsuarioActual : "Administrador de la Plataforma"
    };

    private static string ObtenerIniciales(string? nombre)
    {
        if (string.IsNullOrWhiteSpace(nombre)) return "AS";
        var partes = nombre.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 1) return partes[0][..Math.Min(2, partes[0].Length)].ToUpperInvariant();
        return $"{partes[0][0]}{partes[1][0]}".ToUpperInvariant();
    }

    // Aviso emergente que aparece cuando llega una notificación nueva
    private Notificacion? avisoEmergente;
    private bool _disposed;

    private bool EsInicio => IsHomePage();
    private string RutaActual => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();

    private string RutaLimpiaActual => RutaActual.Split('?')[0].Trim('/').ToLowerInvariant();

    private string TituloRutaActual
    {
        get
        {
            var r = RutaLimpiaActual;
            if (r.StartsWith("editar-asociado")) return "Actualización de productor asociado";
            return r switch
            {
                "asociaciones" or "directorio-asociaciones" => "Directorio de asociaciones federadas",
                "registrar-documentos" or "expediente-documental" => "Expediente documental institucional",
                "registrar-asociado" => "Registro de productor asociado",
                "consultar-asociados" => "Directorio general de productores",
                "seguimiento-asociados" => "Seguimiento de asociados y encuentros",
                "actas-estatutos/documentos" => "Repositorio de actas y estatutos",
                "consultar-estado-documentos" => "Estado de documentación por asociación",
                "alertas-documentos" => "Alertas y vencimientos documentales",
                "actas-estatutos" => "Panel de Presidencia",
                "actas-estatutos/historial" => "Historial de actividad",
                "gestion-financiera/resumen" or "financiera/resumen" => "Resumen financiero",
                "gestion-financiera/ingresos-ventas" or "financiera/ingresos" => "Ingresos y ventas",
                "gestion-financiera/costos-gastos" or "financiera/gastos" => "Costos y gastos",
                "gestion-financiera/cuentas-por-cobrar" or "financiera/cobrar" => "Cuentas por cobrar",
                "gestion-financiera/cuentas-por-pagar" or "financiera/pagar" => "Cuentas por pagar",
                "gestion-financiera/conciliacion-movimientos" or "financiera/conciliacion" => "Revisión y conciliación",
                "gestion-financiera/facturacion-soportes" or "financiera/facturacion" => "Facturación y soportes",
                "gestion-financiera/reportes-balances" or "financiera/reportes" => "Reportes y balances",
                "punto-de-venta" or "punto-de-venta/terminal" or "pos/ventas" => "Terminal de ventas",
                "punto-de-venta/recepcion" => "Recepción de cosechas",
                "punto-de-venta/catalogo" => "Catálogo e inventario",
                "punto-de-venta/cierre-turno" => "Cierre de turno y arqueo",
                "punto-de-venta/historial" => "Historial, devoluciones y anulaciones",
                "panel-administrador" => "Supervisión central del sistema",
                "panel-administrador/usuarios" or "admin/usuarios" => "Usuarios y cuentas",
                "panel-administrador/auditoria" or "admin/auditoria" => "Auditoría técnica",
                "panel-administrador/catalogos" or "admin/catalogos" => "Catálogos y parámetros",
                _ => "Directorio de asociaciones federadas"
            };
        }
    }

    private string CategoriaRutaActual
    {
        get
        {
            var r = RutaLimpiaActual;
            if (r.StartsWith("editar-asociado")) return "Padrón de Productores";
            if (r.StartsWith("punto-de-venta")) return "Punto de Venta Agropecuario";
            return r switch
            {
                "asociaciones" or "directorio-asociaciones" => "Asociaciones Federadas",
                "registrar-documentos" or "expediente-documental" => "Custodia Documental",
                "registrar-asociado" or "consultar-asociados" => "Padrón de Productores",
                "actas-estatutos/documentos" or "consultar-estado-documentos" => "Expediente Documental",
                "alertas-documentos" => "Control de Vigencias",
                "seguimiento-asociados" => "Gestión Asociativa",
                _ => "Secretaría General"
            };
        }
    }

    private string TemaModuloActual
    {
        get
        {
            var r = RutaLimpiaActual;
            if (r.StartsWith("editar-asociado")) return "hv-theme-editar-asociado";
            if (r.StartsWith("punto-de-venta")) return "hv-theme-pos";
            return r switch
            {
                "asociaciones" or "directorio-asociaciones" => "hv-theme-asociaciones",
                "registrar-documentos" or "expediente-documental" => "hv-theme-documentos",
                "registrar-asociado" => "hv-theme-registro-asociado",
                "consultar-asociados" => "hv-theme-directorio-productores",
                "actas-estatutos/documentos" => "hv-theme-repositorio-actas",
                "consultar-estado-documentos" => "hv-theme-estado-documentos",
                "alertas-documentos" => "hv-theme-alertas",
                "seguimiento-asociados" => "hv-theme-seguimiento",
                _ => "hv-theme-asociaciones"
            };
        }
    }

    // Se calculan en cada render, así siempre reflejan el estado actual del servicio
    private int NoLeidas => autenticado ? Notificaciones.ContarNoLeidas(claveUsuario, roles) : 0;

    private IReadOnlyList<Notificacion> NotificacionesVisibles => autenticado
        ? Notificaciones.ObtenerVisiblesPara(roles).Where(CoincideFiltro).Take(30).ToList()
        : new List<Notificacion>();

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += EnCambioDeRuta;
        Notificaciones.NotificacionPublicada += EnNuevaNotificacion;
        await CargarUsuarioAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        await CargarUsuarioAsync();
    }

    private async Task CargarUsuarioAsync()
    {
        var estado = await AuthProvider.GetAuthenticationStateAsync();
        var usuario = estado.User;

        autenticado = usuario.Identity?.IsAuthenticated == true;
        if (!autenticado)
        {
            claveUsuario = string.Empty;
            roles = new List<string>();
            nombreUsuarioActual = "Invitado";
            correoUsuarioActual = "contacto@asoagro-faaua.org";
            fotoUsuarioActual = "";
            rolUsuarioActual = "Invitado";
            inicialesUsuarioActual = "IN";
            return;
        }

        roles = usuario.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();
        rolUsuarioActual = roles.FirstOrDefault() ?? "Usuario";

        correoUsuarioActual = usuario.FindFirst(ClaimTypes.Email)?.Value
            ?? usuario.FindFirst("email")?.Value
            ?? usuario.FindFirst(ClaimTypes.NameIdentifier)?.Value
            ?? "";

        claveUsuario = !string.IsNullOrWhiteSpace(correoUsuarioActual)
            ? correoUsuarioActual
            : (usuario.Identity?.Name ?? "usuario");

        var nombreClaim = usuario.FindFirst(ClaimTypes.Name)?.Value
            ?? usuario.FindFirst("name")?.Value
            ?? usuario.Identity?.Name;

        if (!string.IsNullOrWhiteSpace(nombreClaim))
        {
            nombreUsuarioActual = nombreClaim;
        }
        else if (!string.IsNullOrWhiteSpace(correoUsuarioActual))
        {
            var parteLocal = correoUsuarioActual.Split('@')[0].Replace('.', ' ');
            nombreUsuarioActual = System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(parteLocal);
        }
        else
        {
            nombreUsuarioActual = rolUsuarioLegible;
        }

        fotoUsuarioActual = usuario.FindFirst("picture")?.Value
            ?? usuario.FindFirst("urn:google:picture")?.Value
            ?? usuario.FindFirst("image")?.Value
            ?? usuario.FindFirst("avatar_url")?.Value
            ?? "";

        inicialesUsuarioActual = ObtenerIniciales(nombreUsuarioActual);
    }

    // Llega cuando cualquier pantalla publica un aviso, incluida la de otro navegador.
    // Se pasa a la conexión de esta pantalla para poder actualizar la interfaz.
    private void EnNuevaNotificacion(Notificacion notificacion)
    {
        if (_disposed) return;

        try
        {
            _ = InvokeAsync(() => MostrarAvisoAsync(notificacion));
        }
        catch (Exception)
        {
            // Si esta pantalla ya no está activa, no debe afectar a quien guardó el registro.
        }
    }

    private async Task MostrarAvisoAsync(Notificacion notificacion)
    {
        if (_disposed || !autenticado || EsInicio) return;
        if (!NotificacionService.EsVisible(notificacion, roles)) return;

        avisoEmergente = notificacion;
        StateHasChanged();

        await Task.Delay(TimeSpan.FromSeconds(8));

        if (!_disposed && avisoEmergente?.Id == notificacion.Id)
        {
            avisoEmergente = null;
            StateHasChanged();
        }
    }

    private void CerrarAviso() => avisoEmergente = null;

    private void AbrirAvisoEmergente(Notificacion aviso)
    {
        if (autenticado) Notificaciones.MarcarComoLeida(claveUsuario, aviso.Id);
        var destino = PuedeAbrir(aviso) ? aviso.Enlace : null;
        CerrarAviso();
        if (!string.IsNullOrWhiteSpace(destino))
        {
            Navigation.NavigateTo(destino);
        }
    }

    private void EnCambioDeRuta(object? sender, LocationChangedEventArgs e)
    {
        CerrarTodo();
        CerrarAviso();
        _ = InvokeAsync(async () =>
        {
            await CargarUsuarioAsync();
            StateHasChanged();
        });
    }

    private bool IsHomePage()
    {
        var ruta = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
        return string.IsNullOrEmpty(ruta) || RutasPublicas.Contains(ruta);
    }

    private bool EsRutaActiva(string ruta) => ruta != "#" && RutaActual == ruta.Trim('/').ToLowerInvariant();

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    private void ToggleNotificaciones()
    {
        var abrir = !mostrarNotificaciones;
        CerrarTodo();
        mostrarNotificaciones = abrir;
        StateHasChanged();
    }

    private void ToggleMenuUsuario()
    {
        var abrir = !mostrarMenuUsuario;
        CerrarTodo();
        mostrarMenuUsuario = abrir;
        StateHasChanged();
    }

    private void ManejarTeclaNotificaciones(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            ToggleNotificaciones();
        }
        else if (e.Key is "Escape")
        {
            CerrarTodo();
            StateHasChanged();
        }
    }

    private void ManejarTeclaUsuario(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
        {
            ToggleMenuUsuario();
        }
        else if (e.Key is "Escape")
        {
            CerrarTodo();
            StateHasChanged();
        }
    }

    private void AlternarChat()
    {
        // Canal de chat
    }

    private void AlternarGrupo(string titulo)
    {
        var abrir = grupoAbierto != titulo;
        CerrarTodo();
        if (abrir) grupoAbierto = titulo;
    }

    private void CerrarTodo()
    {
        mostrarNotificaciones = false;
        mostrarMenuUsuario = false;
        grupoAbierto = null;
        StateHasChanged();
    }

    private void AbrirModalUsuario(string modal)
    {
        CerrarTodo();
        modalUsuarioActivo = modal;
    }

    private void CerrarModalUsuario()
    {
        modalUsuarioActivo = null;
    }

    private void FiltrarNotificaciones(string filtro) => filtroActivo = filtro;

    private bool CoincideFiltro(Notificacion notificacion) => filtroActivo switch
    {
        "Documentos" => notificacion.Categoria == CategoriaNotificacion.Documentos,
        "Productores" => notificacion.Categoria == CategoriaNotificacion.Productores,
        "Seguimiento" => notificacion.Categoria == CategoriaNotificacion.Seguimiento,
        _ => true
    };

    private bool EstaLeida(Notificacion notificacion) =>
        autenticado && Notificaciones.EsLeida(claveUsuario, notificacion.Id);

    // El aviso siempre se ve; el enlace solo aparece si este usuario puede abrir la página
    private bool PuedeAbrir(Notificacion notificacion) =>
        autenticado && NotificacionService.PuedeAbrirEnlace(notificacion, roles);

    private void AbrirNotificacion(Notificacion notificacion)
    {
        if (autenticado) Notificaciones.MarcarComoLeida(claveUsuario, notificacion.Id);
        var destino = PuedeAbrir(notificacion) ? notificacion.Enlace : null;
        CerrarTodo();
        if (!string.IsNullOrWhiteSpace(destino))
        {
            Navigation.NavigateTo(destino);
        }
    }

    private void IrAPanelCompleto()
    {
        CerrarTodo();
        Navigation.NavigateTo("/alertas-documentos");
    }

    private void MarcarTodasComoLeidas()
    {
        if (autenticado) Notificaciones.MarcarTodasComoLeidas(claveUsuario, roles);
    }

    private static string ObtenerTono(Notificacion notificacion) => notificacion.Nivel switch
    {
        NivelNotificacion.Urgente => "ag-tono-urgente",
        NivelNotificacion.Advertencia => "ag-tono-trazabilidad",
        _ => "ag-tono-registro"
    };

    private static string ObtenerClaseNivel(Notificacion notificacion) => notificacion.Nivel switch
    {
        NivelNotificacion.Urgente => "urgente",
        NivelNotificacion.Advertencia => "advertencia",
        _ => string.Empty
    };

    private void ManejarBusquedaGlobal(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(busquedaGlobal))
        {
            Navigation.NavigateTo($"/consultar-asociados?q={Uri.EscapeDataString(busquedaGlobal)}");
        }
    }

    private static string TiempoTranscurrido(DateTime fecha)
    {
        var transcurrido = DateTime.Now - fecha;
        if (transcurrido.TotalMinutes < 1) return "Ahora";
        if (transcurrido.TotalMinutes < 60) return $"Hace {(int)transcurrido.TotalMinutes} min";
        if (transcurrido.TotalHours < 24) return $"Hace {(int)transcurrido.TotalHours} h";
        return fecha.ToString("dd/MM/yyyy");
    }

    public void Dispose()
    {
        _disposed = true;
        Navigation.LocationChanged -= EnCambioDeRuta;
        Notificaciones.NotificacionPublicada -= EnNuevaNotificacion;
    }
}
