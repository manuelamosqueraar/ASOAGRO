@using Microsoft.AspNetCore.Components.Authorization
@inject IJSRuntime JS

<div class="nm">

    <!-- Cabecera: no repite la marca del encabezado -->
    <div class="nm-cabecera">
        <span class="nm-cabecera-ico"><svg class="nm-ico"><use href="#ico-brote" /></svg></span>
        <div class="nm-cabecera-texto">
            <small>Federación FAAUA</small>
            <strong>Urabá · Antioquia</strong>
        </div>
    </div>

    <AuthorizeView>
        <Authorized>

            <!-- Módulos -->
            <div class="nm-scroll">
                <nav class="nm-nav" aria-label="Módulos del panel">

                    <!-- ASOCIADOS (Director) -->
                    @if (context.User.IsInRole("Director"))
                    {
                        <section class="nm-grupo @(expandirAsociados ? "abierto" : "")">
                            <button type="button" class="nm-grupo-btn" @onclick="ToggleAsociados" aria-expanded="@(expandirAsociados ? "true" : "false")">
                                <span class="nm-grupo-ico"><svg class="nm-ico"><use href="#ico-usuario" /></svg></span>
                                <span class="nm-grupo-texto">
                                    <strong>Asociados</strong>
                                    <small>Productores y fincas</small>
                                </span>
                                <svg class="nm-ico nm-chevron"><use href="#ico-flecha" /></svg>
                            </button>

                            <div class="nm-sub">
                                <div class="nm-sub-inner">
                                    <NavLink class="nm-link" href="registrar-asociado">
                                        <svg class="nm-ico"><use href="#ico-usuario-mas" /></svg>
                                        <span>Registrar asociado</span>
                                    </NavLink>
                                    <NavLink class="nm-link" href="consultar-asociados">
                                        <svg class="nm-ico"><use href="#ico-lista" /></svg>
                                        <span>Consultar asociados</span>
                                    </NavLink>
                                    <NavLink class="nm-link" href="editar-asociado">
                                        <svg class="nm-ico"><use href="#ico-ajustes" /></svg>
                                        <span>Editar asociado</span>
                                    </NavLink>
                                </div>
                            </div>
                        </section>
                    }

                    <!-- DOCUMENTOS (Tesorero y Presidente) -->
                    @if (context.User.IsInRole("Tesorero") || context.User.IsInRole("Presidente"))
                    {
                        <section class="nm-grupo nm-grupo-trigo @(expandirDocumentos ? "abierto" : "")">
                            <button type="button" class="nm-grupo-btn" @onclick="ToggleDocumentos" aria-expanded="@(expandirDocumentos ? "true" : "false")">
                                <span class="nm-grupo-ico"><svg class="nm-ico"><use href="#ico-doc" /></svg></span>
                                <span class="nm-grupo-texto">
                                    <strong>Documentos</strong>
                                    <small>Estatutos, actas y vencimientos</small>
                                </span>
                                <svg class="nm-ico nm-chevron"><use href="#ico-flecha" /></svg>
                            </button>

                            <div class="nm-sub">
                                <div class="nm-sub-inner">

                                    @if (context.User.IsInRole("Tesorero"))
                                    {
                                        <NavLink class="nm-link" href="registrar-documentos">
                                            <svg class="nm-ico"><use href="#ico-doc" /></svg>
                                            <span>Registrar documentos</span>
                                        </NavLink>
                                        <NavLink class="nm-link" href="consultar-estado-documentos">
                                            <svg class="nm-ico"><use href="#ico-check" /></svg>
                                            <span>Estado de documentación</span>
                                        </NavLink>
                                        <NavLink class="nm-link" href="alertas-documentos">
                                            <svg class="nm-ico"><use href="#ico-alerta" /></svg>
                                            <span>Alertas de vencimiento</span>
                                        </NavLink>
                                    }

                                    @if (context.User.IsInRole("Presidente"))
                                    {
                                        <NavLink class="nm-link" href="subir-actas-estatutos">
                                            <svg class="nm-ico"><use href="#ico-red" /></svg>
                                            <span>Actas e histórico</span>
                                        </NavLink>
                                    }

                                </div>
                            </div>
                        </section>
                    }

                </nav>
            </div>

            <!-- PERFIL INFERIOR -->
            <div class="nm-pie">

                @if (mostrarMenuInferior)
                {
                    <div class="nm-popup">
                        <div class="nm-popup-cab">
                            <span class="nm-avatar nm-avatar-grande">MM</span>
                            <div>
                                <strong>Manuela Andrea Mosquera</strong>
                                <small>directora@asoagro-faaua.org</small>
                            </div>
                        </div>

                        <p class="nm-popup-titulo">Mi cuenta</p>
                        <button type="button" class="nm-popup-item" @onclick='() => AbrirModal("Perfil de usuario")'>
                            <span class="nm-popup-ico"><svg class="nm-ico"><use href="#ico-usuario" /></svg></span>
                            <span>
                                <strong>Perfil de usuario</strong>
                                <small>Editar datos e información</small>
                            </span>
                        </button>
                        <button type="button" class="nm-popup-item" @onclick='() => AbrirModal("Seguridad y clave")'>
                            <span class="nm-popup-ico"><svg class="nm-ico"><use href="#ico-escudo" /></svg></span>
                            <span>
                                <strong>Seguridad y clave</strong>
                                <small>Verificación de acceso</small>
                            </span>
                        </button>

                        <div class="nm-popup-sep"></div>

                        <p class="nm-popup-titulo">Organización</p>
                        <button type="button" class="nm-popup-item" @onclick='() => AbrirModal("Asociación base")'>
                            <span class="nm-popup-ico"><svg class="nm-ico"><use href="#ico-red" /></svg></span>
                            <span>
                                <strong>Asociación base</strong>
                                <small>Asoagro · FAAUA</small>
                            </span>
                        </button>
                        <button type="button" class="nm-popup-item" @onclick='() => AbrirModal("Soporte técnico")'>
                            <span class="nm-popup-ico"><svg class="nm-ico"><use href="#ico-sobre" /></svg></span>
                            <span>
                                <strong>Soporte técnico</strong>
                                <small>Asistencia de la plataforma</small>
                            </span>
                        </button>

                        <div class="nm-popup-sep"></div>

                        <a href="/Auth/logout" class="nm-popup-item peligro">
                            <span class="nm-popup-ico"><svg class="nm-ico"><use href="#ico-salir" /></svg></span>
                            <span><strong>Cerrar sesión</strong></span>
                        </a>
                    </div>
                }

                <button type="button" class="nm-perfil" @onclick="ToggleMenuInferior" aria-expanded="@(mostrarMenuInferior ? "true" : "false")">
                    <span class="nm-avatar">MM</span>
                    <span class="nm-perfil-texto">
                        <strong>Manuela Mosquera</strong>
                        <small>Dirección Ejecutiva</small>
                    </span>
                    <svg class="nm-ico nm-chevron @(mostrarMenuInferior ? "abierto" : "")"><use href="#ico-flecha" /></svg>
                </button>
            </div>

        </Authorized>
    </AuthorizeView>

</div>

<!-- MODAL: <dialog> se muestra en la capa superior, fuera de la barra lateral -->
<dialog id="nm-dialogo" class="nm-dialogo" aria-labelledby="nm-dialogo-titulo">
    @if (modalActivo != null)
    {
        <div class="nm-dialogo-caja">
            <div class="nm-dialogo-cab">
                <strong id="nm-dialogo-titulo">@modalActivo</strong>
                <button type="button" class="nm-dialogo-cerrar" @onclick="CerrarModal" aria-label="Cerrar">&times;</button>
            </div>

            <div class="nm-dialogo-cuerpo">
                @if (modalActivo == "Perfil de usuario")
                {
                    <p class="nm-texto-suave">Actualiza tu información personal y datos de contacto.</p>
                    <div class="nm-campo">
                        <label for="nm-nombre">Nombre completo</label>
                        <input id="nm-nombre" type="text" value="Manuela Andrea Mosquera Martinez" />
                    </div>
                    <div class="nm-campo">
                        <label for="nm-correo">Correo institucional</label>
                        <input id="nm-correo" type="email" value="directora@asoagro-faaua.org" />
                    </div>
                }
                else if (modalActivo == "Seguridad y clave")
                {
                    <div class="nm-aviso">
                        <svg class="nm-ico"><use href="#ico-escudo" /></svg>
                        <span>Autenticación gestionada vía Google OAuth 2.0.</span>
                    </div>
                    <p class="nm-texto-suave">Tu acceso está vinculado de forma segura con tu cuenta institucional.</p>
                }
                else if (modalActivo == "Asociación base")
                {
                    <h4 class="nm-subtitulo">Asoagro</h4>
                    <p class="nm-texto-suave">Asociación de base agropecuaria adscrita a la Federación de Asociaciones Agropecuarias del Urabá Antioqueño (FAAUA).</p>
                }
                else if (modalActivo == "Soporte técnico")
                {
                    <p class="nm-texto-suave">¿Presentas inconvenientes técnicos con la plataforma?</p>
                    <div class="nm-soporte">
                        <svg class="nm-ico"><use href="#ico-sobre" /></svg>
                        <strong>soporte@faaua.org</strong>
                    </div>
                }
            </div>

            <div class="nm-dialogo-pie">
                <button type="button" class="nm-btn nm-btn-secundario" @onclick="CerrarModal">Cerrar</button>
                <button type="button" class="nm-btn nm-btn-primario" @onclick="CerrarModal">Guardar cambios</button>
            </div>
        </div>
    }
</dialog>

@code {
    private bool expandirAsociados = true;
    private bool expandirDocumentos = true;
    private bool mostrarMenuInferior;
    private string? modalActivo;
    private bool abrirDialogo;

    private void ToggleAsociados() => expandirAsociados = !expandirAsociados;
    private void ToggleDocumentos() => expandirDocumentos = !expandirDocumentos;
    private void ToggleMenuInferior() => mostrarMenuInferior = !mostrarMenuInferior;
 
    private void AbrirModal(string nombre)
    {
        mostrarMenuInferior = false;
        modalActivo = nombre;
        abrirDialogo = true;
    }

    private async Task CerrarModal()
    {
        modalActivo = null;
        await JS.InvokeVoidAsync("eval", "document.getElementById('nm-dialogo')?.close()");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (abrirDialogo)
        {
            abrirDialogo = false;
            await JS.InvokeVoidAsync("eval", "document.getElementById('nm-dialogo')?.showModal()");
        }
    }
}